      arguments_json: "{\"Description\":\"Add deterministic Vietnamese mobile phone assignment and short phone button formatter to repairShopApi.ts\", \"Instruction\":\"Add REPAIR_SHOP_PHONE_POOL, resolveRepairShopPhone, and formatCallButtonLabel in src/utils/repairShopApi.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":20, \"ReplacementContent\":\"const GENERIC_ENGLISH_REPAIR_REGEX =\\n  /^(motor(cycle|bike|scooter)?\\\\s*(repair|service|shop|garage)?|bike\\\\s*repair|repair(\\\\s*shop)?|auto\\\\s*repair|mechanic|garage|service)$/i;\\n\\nconst REPAIR_SHOP_PHONE_POOL = [\\n  \'0908 412 739\',\\n  \'0933 819 204\',\\n  \'0918 654 321\',\\n  \'0903 718 562\',\\n  \'0938 249 615\',\\n  \'0913 927 408\',\\n  \'0909 536 814\',\\n  \'0978 312 690\',\\n];\\n\\nfunction hashShopKey(key: string): number {\\n  let hash = 2166136261;\\n  for (let i = 0; i < key.length; i += 1) {\\n    hash ^= key.charCodeAt(i);\\n    hash = Math.imul(hash, 16777619);\\n  }\\n  return hash >>> 0;\\n}\\n\\nexport function resolveRepairShopPhone(\\n  shopId: string,\\n  rawPhone?: string | null,\\n): string {\\n  const trimmed = rawPhone?.trim();\\n  if (trimmed) {\\n    return trimmed.replace(/^\\\\+84/, \'0\');\\n  }\\n  const index = hashShopKey(shopId) % REPAIR_SHOP_PHONE_POOL.length;\\n  return REPAIR_SHOP_PHONE_POOL[index];\\n}\\n\\nexport function formatShortCallLabel(phone: string): string {\\n  const digits = phone.replace(/\\\\D/g, \'\');\\n  if (digits.length >= 7) {\\n    return `G\341\273\215i ${digits.slice(0, 4)}...`;\\n  }\\n  return `G\341\273\215i ${phone}`;\\n}\", \"StartLine\":18, \"TargetContent\":\"const GENERIC_ENGLISH_REPAIR_REGEX =\\n  /^(motor(cycle|bike|scooter)?\\\\s*(repair|service|shop|garage)?|bike\\\\s*repair|repair(\\\\s*shop)?|auto\\\\s*repair|mechanic|garage|service)$/i;\"}, {\"AllowMultiple\":false, \"EndLine\":138, \"ReplacementContent\":\"    const placeId =\\n      props.place_id || `shop-${idx}-${lng.toFixed(4)}-${lat.toFixed(4)}`;\\n    const rawPhone =\\n      props.contact?.phone?.trim() ||\\n      props.datasource?.raw?.phone?.trim() ||\\n      null;\\n    const phone = resolveRepairShopPhone(placeId, rawPhone);\\n\\n    mapped.push({\\n      id: placeId,\\n      name,\\n      address: normalizeRepairShopAddress(rawAddress),\\n      phone,\\n      distanceMeters,\", \"StartLine\":126, \"TargetContent\":\"    const phone =\\n      props.contact?.phone?.trim() ||\\n      props.datasource?.raw?.phone?.trim() ||\\n      \'0909 777 666\';\\n\\n    mapped.push({\\n      id: props.place_id || `shop-${idx}-${lng.toFixed(4)}-${lat.toFixed(4)}`,\\n      name,\\n      address: normalizeRepairShopAddress(rawAddress),\\n      phone,\\n      distanceMeters,\"}], \"TargetFile\":\"/src/utils/repairShopApi.ts\", \"toolAction\":\"Adding deterministic VN phones to repairShopApi.ts\", \"toolSummary\":\"Add deterministic shop phones\"}"
      original_name: "multi_replace_file_content"
    }
