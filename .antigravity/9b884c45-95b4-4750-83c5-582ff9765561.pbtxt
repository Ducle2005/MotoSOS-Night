      create_file {
        instruction: "import { Sparkles } from \'lucide-react\';\nimport { useRef, useState, type MouseEvent } from \'react\';\nimport { PARTNER_PERKS, type PartnerPerkItem } from \'../../data/homePromotions\';\n\ninterface PartnerPerksCarouselProps {\n  onSelectPerk: (perk: PartnerPerkItem) => void;\n}\n\nexport function PartnerPerksCarousel({ onSelectPerk }: PartnerPerksCarouselProps) {\n  const scrollerRef = useRef<HTMLDivElement | null>(null);\n  const isDownRef = useRef(false);\n  const startXRef = useRef(0);\n  const startScrollRef = useRef(0);\n  const didDragRef = useRef(false);\n  const [isDragging, setIsDragging] = useState(false);\n\n  const handleMouseDown = (event: MouseEvent<HTMLDivElement>) => {\n    const el = scrollerRef.current;\n    if (!el) return;\n    isDownRef.current = true;\n    startXRef.current = event.pageX;\n    startScrollRef.current = el.scrollLeft;\n    didDragRef.current = false;\n  };\n\n  const handleMouseMove = (event: MouseEvent<HTMLDivElement>) => {\n    const el = scrollerRef.current;\n    if (!isDownRef.current || !el) return;\n    const dx = event.pageX - startXRef.current;\n    if (Math.abs(dx) > 5) {\n      didDragRef.current = true;\n      if (!isDragging) setIsDragging(true);\n      el.scrollLeft = startScrollRef.current - dx;\n    }\n  };\n\n  const endDrag = () => {\n    if (!isDownRef.current && !isDragging) return;\n    isDownRef.current = false;\n    setIsDragging(false);\n    window.setTimeout(() => {\n      didDragRef.current = false;\n    }, 0);\n  };\n\n  return (\n    <section aria-label=\"\304\220\341\272\267c quy\341\273\201n \304\220\341\273\221i t\303\241c 24/7\" className=\"mt-5\">\n      <div className=\"flex items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-1.5\">\n          <Sparkles className=\"h-4 w-4 text-amber-500\" aria-hidden=\"true\" />\n          <h2 className=\"text-sm font-bold tracking-tight text-slate-900\">\n            \304\220\341\272\267c Quy\341\273\201n \304\220\341\273\221i T\303\241c 24/7\n          </h2>\n        </div>\n        <span className=\"text-[11px] font-semibold text-slate-400\">\306\257u \304\221\303\243i th\303\240nh vi\303\252n</span>\n      </div>\n\n      <div\n        ref={scrollerRef}\n        data-testid=\"partner-perks-carousel\"\n        onMouseDown={handleMouseDown}\n        onMouseMove={handleMouseMove}\n        onMouseUp={endDrag}\n        onMouseLeave={endDrag}\n        onDragStart={(e) => e.preventDefault()}\n        className={`-mx-5 mt-3 flex touch-pan-x snap-x snap-mandatory gap-3 overflow-x-auto scroll-pl-5 px-5 pb-2 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] ${\n          isDragging ? \'cursor-grabbing\' : \'cursor-grab scroll-smooth\'\n        }`}\n      >\n        {PARTNER_PERKS.map((perk) => (\n          <button\n            key={perk.id}\n            type=\"button\"\n            onClick={(e) => {\n              if (didDragRef.current) {\n                e.preventDefault();\n                e.stopPropagation();\n                didDragRef.current = false;\n                return;\n              }\n              onSelectPerk(perk);\n            }}\n            className=\"group w-[195px] shrink-0 snap-start select-none overflow-hidden rounded-2xl border border-slate-100 bg-white text-left shadow-sm transition-all hover:border-emerald-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500\"\n          >\n            <div className={`relative h-24 w-full overflow-hidden bg-gradient-to-br ${perk.fallbackGradient}`}>\n              <img\n                src={perk.imageUrl}\n                alt={perk.title}\n                loading=\"lazy\"\n                draggable={false}\n                className=\"h-full w-full object-cover transition-transform duration-300 group-hover:scale-105\"\n              />\n              {perk.voucherId && (\n                <span className=\"absolute right-2 bottom-2 rounded-full bg-slate-950/80 px-2 py-0.5 text-[10px] font-bold text-amber-200 backdrop-blur-sm\">\n                  {perk.voucherId}\n                </span>\n              )}\n            </div>\n            <div className=\"p-3\">\n              <p className=\"truncate text-xs font-extrabold text-slate-900\">\n                {perk.title}\n              </p>\n              <p className=\"mt-1 line-clamp-2 text-[11px] leading-relaxed text-slate-500\">\n                {perk.description}\n              </p>\n            </div>\n          </button>\n        ))}\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/tabs/PartnerPerksCarousel.tsx"
        }
        overwrite: true
      }
    }
