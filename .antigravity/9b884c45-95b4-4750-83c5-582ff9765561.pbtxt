    end_line: 181
    content: "import { BottomNavBar } from \'./components/BottomNavBar\';\nimport { LocationSearchModal } from \'./components/modals/LocationSearchModal\';\nimport { ActivityTab } from \'./components/tabs/ActivityTab\';\nimport { HomeTab } from \'./components/tabs/HomeTab\';\nimport { MapTabView } from \'./components/tabs/MapTabView\';\nimport { SafetyTab } from \'./components/tabs/SafetyTab\';\nimport { MOCK_MECHANIC } from \'./data/mockRescueData\';\nimport { useRescueOrderState } from \'./hooks/useRescueOrderState\';\n\nexport default function App() {\n  const s = useRescueOrderState();\n\n  return (\n    <div className=\"flex min-h-[100dvh] w-full items-center justify-center bg-slate-900\">\n      <div className=\"relative mx-auto flex h-[100dvh] w-full max-w-[430px] flex-col overflow-hidden border-x border-slate-200 bg-[#F8FAFC] shadow-2xl\">\n        <main className=\"relative flex min-h-0 flex-1 flex-col overflow-hidden\">\n          {s.activeTab === \'home\' && (\n            <HomeTab\n              activeLocation={s.geo.activeLocation}\n              userLocation={s.geo.userLocation}\n              stations={s.geo.stations}\n              isLoadingStations={s.geo.isLoadingStations}\n              openRepairShops={s.repairShops.openRepairShops}\n              isLoadingShops={s.repairShops.isLoadingShops}\n              onOpenLocationSearch={() => s.setIsLocationSearchOpen(true)}\n              onCallMechanicNow={() => {\n                s.repairShops.selectShop(null);\n                s.setEnteredFromQuickStations(false);\n                s.setStep(\'issue\');\n                s.setActiveTab(\'map\');\n              }}\n              onQuickIssueSelect={s.handleQuickIssue}\n              onQuickCategorySelect={s.handleQuickCategory}\n              onQuickSosSelect={s.handleQuickSos}\n              onSelectStationCard={s.handleOpenMapWithStation}\n              onOpenRepairShopsMap={s.handleOpenMapWithRepairShop}\n              onTriggerDemoMechanic={s.handleDemoAdvance}\n              onSelectCampaignBanner={s.handleSelectCampaignBanner}\n              onSelectPartnerPerk={s.handleSelectPartnerPerk}\n            />\n          )}\n\n          {s.activeTab === \'map\' && (\n            <div className=\"flex min-h-0 flex-1 flex-col pb-16\">\n              <MapTabView\n                userLocation={s.geo.userLocation}\n                stations={s.effectiveStations}\n                openRepairShops={s.repairShops.openRepairShops}\n                gasStations={s.gasStations.gasStations}\n                policeStations={s.policeStations.policeStations}\n                mapFilter={s.repairShops.mapFilter}\n                selectedStationId={s.selectedStationId}\n                selectedPoliceStationId={s.policeStations.selectedPoliceStationId}\n                inspectedPlace={s.activeInspect.inspectedPlace}\n                inspectRoute={s.activeInspect.inspectRoute}\n                inspectRouteSummary={s.activeInspect.inspectRouteSummary}\n                isLoadingInspectRoute={s.activeInspect.isLoadingInspectRoute}\n                selectedGasStationId={s.gasStations.selectedGasStationId}\n                gasRoute={s.gasStations.gasRoute}\n                policeRoute={s.policeStations.policeRoute}\n                isLoadingGasStations={s.gasStations.isLoadingGasStations}\n                isLoadingGasRoute={s.gasStations.isLoadingGasRoute}\n                isLoadingPoliceStations={s.policeStations.isLoadingPoliceStations}\n                isLoadingPoliceRoute={s.policeStations.isLoadingPoliceRoute}\n                pickupMode={s.pickupMode}\n                pickupCoord={s.pickupTarget.coord}\n                pickupTitle={s.pickupTarget.title}\n                pickupAddress={s.pickupTarget.address}\n                walkingRoute={s.geo.walkingRoute}\n                routeSummary={s.geo.routeSummary}\n                isLoadingRoute={s.geo.isLoadingRoute}\n                isSubmitting={s.isSubmitting}\n                step={s.step}\n                trackingStatus={s.trackingStatus}\n                selectedIssue={s.selectedIssue}\n                customNote={s.customNote}\n                issueSummary={s.issueSummary}\n                pricing={s.pricing}\n                selectedVoucherId={s.selectedVoucherId}\n                mechanicRoute={s.mechanicSim.mechanicRoute}\n                routeStartTimeMs={s.mechanicSim.routeStartTimeMs}\n                initialEtaMinutes={s.mechanicSim.initialEtaMinutes}\n                liveEtaMinutes={s.mechanicSim.liveEtaMinutes}\n                chatMessages={s.mechanicSim.chatMessages}\n                isMechanicTyping={s.mechanicSim.isMechanicTyping}\n                recenterSignal={s.recenterSignal}\n                enteredFromQuickStations={s.enteredFromQuickStations}\n                onSelectStation={s.setSelectedStationId}\n                onInspectPlace={s.activeInspect.inspectAndRoutePlace}\n                onClearInspection={s.activeInspect.clearInspection}\n                onChangeMapFilter={s.handleChangeMapFilter}\n                onSelectGasStation={s.gasStations.setSelectedGasStationId}\n                onDrawGasRoute={s.gasStations.routeToGasStation}\n                onPickGasStationForRescue={s.handleSelectGasStationForRescue}\n                onSelectPoliceStation={s.policeStations.setSelectedPoliceStationId}\n                onDrawPoliceRoute={s.policeStations.routeToPoliceStation}\n                onPickSafeStationForRescue={s.handlePickSafeStationForRescue}\n                onSelectVoucher={s.setSelectedVoucherId}\n                onEtaMinuteChange={s.mechanicSim.setLiveEtaMinutes}\n                onMechanicArrived={s.handleMechanicArrived}\n                onSendChatMessage={s.mechanicSim.sendChatMessage}\n                onBackToHome={() => s.setActiveTab(\'home\')}\n                onDemoAdvance={s.handleDemoAdvance}\n                onRecenter={s.triggerRecenter}\n                onStartOrder={() => {\n                  s.activeInspect.clearInspection();\n                  s.setEnteredFromQuickStations(false);\n                  s.setStep(\'issue\');\n                }}\n                onOpenSafeStations={() =>\n                  s.handleOpenMapWithStation(s.selectedStationId ?? \'\')\n                }\n                onSelectIssue={s.setSelectedIssue}\n                onChangeNote={s.setCustomNote}\n                onChangeMode={s.handleChangePickupMode}\n                onSetStep={s.setStep}\n                onConfirmRescue={s.handleConfirmRescue}\n                onCancelOrder={() => s.handleResetFlow(false)}\n                onCompleteOrder={s.handleCompleteAndLog}\n                pinPicker={{\n                  isActive: s.pinPicker.isPinPickerMode,\n                  isDragging: s.pinPicker.isPinDragging,\n                  coord: s.pinPicker.pinnedCoord,\n                  address: s.pinPicker.pinnedAddress,\n                  isResolving: s.pinPicker.isResolvingPin,\n                  onMoveStart: s.pinPicker.handlePinMoveStart,\n                  onMoveEnd: s.pinPicker.handlePinMoveEnd,\n                  onConfirm: s.handleConfirmMapPinPicker,\n                  onCancel: s.pinPicker.cancelPinPicker,\n                }}\n              />\n            </div>\n          )}\n\n          {s.activeTab === \'activity\' && (\n            <ActivityTab\n              step={s.step}\n              trackingStatus={s.trackingStatus}\n              activeIssueLabel={s.issueSummary}\n              activePickupAddress={s.pickupTarget.address}\n              mechanic={{\n                ...MOCK_MECHANIC,\n                etaMinutes: Math.max(1, s.mechanicSim.liveEtaMinutes),\n              }}\n              history={s.activityHistory}\n              onOpenMapTracking={() => s.setActiveTab(\'map\')}\n              onTriggerDemoAdvance={s.handleDemoAdvance}\n              onStartNewRescue={() => {\n                s.setStep(\'issue\');\n                s.setActiveTab(\'map\');\n              }}\n            />\n          )}\n\n          {s.activeTab === \'safety\' && (\n            <SafetyTab\n              stations={s.geo.stations}\n              onRouteToStation={s.handleOpenMapWithStation}\n            />\n          )}\n        </main>\n\n        <BottomNavBar\n          activeTab={s.activeTab}\n          hasActiveOrder={s.step === \'tracking\'}\n          onSelectTab={s.setActiveTab}\n        />\n\n        <LocationSearchModal\n          isOpen={s.isLocationSearchOpen}\n          activeLocation={s.geo.activeLocation}\n          isLocatingGps={s.geo.isLocatingGps}\n          onSelectSuggestion={s.handleSelectSearchLocation}\n          onUseCurrentGps={s.handleResetToGpsLocation}\n          onStartMapPinPicker={s.handleStartMapPinPicker}\n          onClose={() => s.setIsLocationSearchOpen(false)}\n        />\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 182
    num_bytes: 8624
    line_range_bytes: 8624
  }
}
