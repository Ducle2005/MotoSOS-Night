    content: "import { X } from \'lucide-react\';\nimport type { SafeStation } from \'../../types/rescue\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\n\ninterface StationPreviewCardProps {\n  station: SafeStation;\n  onClose: () => void;\n}\n\nexport function StationPreviewCard({\n  station,\n  onClose,\n}: StationPreviewCardProps) {\n  return (\n    <div className=\"animate-step-enter rounded-2xl border border-slate-800 bg-slate-900/95 p-3.5 shadow-xl backdrop-blur-md\">\n      <div className=\"flex items-start justify-between gap-3\">\n        <div className=\"min-w-0\">\n          <p className=\"text-xs font-medium text-emerald-400\">\n            {station.categoryLabel} \302\267 {station.openHours}\n          </p>\n          <h2 className=\"mt-0.5 truncate text-sm font-bold text-slate-100\">\n            {station.name}\n          </h2>\n          <p className=\"mt-0.5 truncate text-xs text-slate-400\">\n            {station.address}\n          </p>\n          <p className=\"mt-1.5 font-mono text-xs tabular-nums text-slate-200\">\n            {formatWalkingDistance(\n              station.walkingDistanceMeters,\n              station.walkingMinutes,\n            )}{\' \'}\n            \302\267 {station.amenities.join(\' \302\267 \')}\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          onClick={onClose}\n          aria-label=\"\304\220\303\263ng th\303\264ng tin tr\341\272\241m\"\n          className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-slate-400 hover:bg-slate-800 hover:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400\"\n        >\n          <X className=\"h-4 w-4\" aria-hidden=\"true\" />\n        </button>\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 47
    num_bytes: 1673
    line_range_bytes: 1673
  }
}
