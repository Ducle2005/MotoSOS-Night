        instruction: "import { LocateFixed } from \'lucide-react\';\nimport type { ReactNode } from \'react\';\nimport type { RescueStep } from \'../types/rescue\';\n\ninterface BottomSheetShellProps {\n  step: RescueStep;\n  onRecenter: () => void;\n  children: ReactNode;\n}\n\nconst STEP_INDEX: Record<RescueStep, number> = {\n  idle: 0,\n  issue: 1,\n  pickup: 2,\n  tracking: 3,\n};\n\nexport function BottomSheetShell({\n  step,\n  onRecenter,\n  children,\n}: BottomSheetShellProps) {\n  const currentIndex = STEP_INDEX[step];\n\n  return (\n    <aside\n      aria-label=\"B\341\272\243ng \304\221i\341\273\201u khi\341\273\203n c\341\273\251u h\341\273\231 xe m\303\241y\"\n      className=\"pointer-events-auto absolute inset-x-0 bottom-0 z-20 flex max-h-[54dvh] flex-col rounded-t-3xl border-t border-slate-800 bg-slate-900/95 shadow-2xl shadow-black/90 backdrop-blur-md lg:inset-y-0 lg:left-auto lg:right-0 lg:max-h-none lg:w-[440px] lg:rounded-none lg:border-l lg:border-t-0\"\n    >\n      {/* Floating circular \"V\341\273\201 v\341\273\213 tr\303\255 c\341\273\247a t\303\264i\" button right above Bottom Sheet top-right edge */}\n      <button\n        type=\"button\"\n        onClick={onRecenter}\n        aria-label=\"V\341\273\201 v\341\273\213 tr\303\255 c\341\273\247a t\303\264i\"\n        title=\"V\341\273\201 v\341\273\213 tr\303\255 c\341\273\247a t\303\264i\"\n        className=\"absolute -top-14 right-4 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/90 bg-slate-900/95 text-sky-400 shadow-lg shadow-black/60 backdrop-blur-md transition-all hover:border-sky-400 hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 active:scale-95 lg:top-auto lg:bottom-6 lg:-left-16 lg:right-auto\"\n      >\n        <LocateFixed className=\"h-5 w-5\" aria-hidden=\"true\" />\n      </button>\n\n      {/* Mobile drag handle affordance */}\n      <div className=\"flex shrink-0 justify-center pt-2.5 pb-1 lg:hidden\" aria-hidden=\"true\">\n        <div className=\"h-1.5 w-10 rounded-full bg-slate-700\" />\n      </div>\n\n      {/* Step progress indicator during active flow */}\n      {currentIndex > 0 && (\n        <div className=\"shrink-0 px-5 pt-1.5 pb-2 lg:pt-5\">\n          <div className=\"flex items-center justify-between text-xs\">\n            <span className=\"font-mono font-semibold tabular-nums text-slate-200\">\n              B\306\260\341\273\233c {currentIndex} / 3\n            </span>\n            <span className=\"font-medium text-slate-400\">\n              {currentIndex === 1 && \'Ch\341\273\215n s\341\273\261 c\341\273\221\'}\n              {currentIndex === 2 && \'Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235\'}\n              {currentIndex === 3 && \'Theo d\303\265i th\341\273\243\'}\n            </span>\n          </div>\n          <div\n            className=\"mt-2 grid grid-cols-3 gap-1.5\"\n            role=\"progressbar\"\n            aria-valuenow={currentIndex}\n            aria-valuemin={1}\n            aria-valuemax={3}\n            aria-label=\"Ti\341\272\277n tr\303\254nh \304\221\341\272\267t c\341\273\251u h\341\273\231\"\n          >\n            {[1, 2, 3].map((idx) => (\n              <div\n                key={idx}\n                className={`h-1 rounded-full transition-colors duration-200 ${\n                  idx <= currentIndex ? \'bg-amber-500\' : \'bg-slate-800\'\n                }`}\n              />\n            ))}\n          </div>\n        </div>\n      )}\n\n      <div className=\"flex min-h-0 flex-1 flex-col overflow-hidden rounded-t-3xl lg:rounded-none\">\n        {children}\n      </div>\n    </aside>\n  );\n}\n"
