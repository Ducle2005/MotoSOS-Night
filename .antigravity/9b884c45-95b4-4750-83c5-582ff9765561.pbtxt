  view_file {
    absolute_path_uri: "file:///src/components/tabs/VipNightShieldBanner.tsx"
    end_line: 106
    content: "import { ChevronRight, ShieldCheck } from \'lucide-react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport { useEffect, useState } from \'react\';\nimport { SAFETY_BANNER_SLIDES } from \'../../data/mockRescueData\';\n\ninterface VipNightShieldBannerProps {\n  onAction: () => void;\n}\n\nconst SLIDE_INTERVAL_MS = 4500;\n\nexport function VipNightShieldBanner({ onAction }: VipNightShieldBannerProps) {\n  const [slideIdx, setSlideIdx] = useState(0);\n  const currentSlide = SAFETY_BANNER_SLIDES[slideIdx] ?? SAFETY_BANNER_SLIDES[0];\n\n  useEffect(() => {\n    const timer = window.setInterval(() => {\n      setSlideIdx((prev) => (prev + 1) % SAFETY_BANNER_SLIDES.length);\n    }, SLIDE_INTERVAL_MS);\n    return () => window.clearInterval(timer);\n  }, []);\n\n  return (\n    <section aria-label=\"VIP Night Shield \342\200\224 M\341\272\271o an to\303\240n ban \304\221\303\252m\" className=\"mt-5\">\n      <motion.button\n        type=\"button\"\n        whileTap={{ scale: 0.985 }}\n        onClick={onAction}\n        className=\"group relative w-full overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900 p-4 text-left text-white shadow-[0_14px_30px_-10px_rgba(16,185,129,0.35)] ring-1 ring-inset ring-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500\"\n      >\n        {/* Subtle periodic sheen sweep */}\n        <span\n          aria-hidden=\"true\"\n          className=\"animate-vip-sheen pointer-events-none absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-transparent via-white/30 to-transparent\"\n        />\n\n        {/* Ambient glowing shield motif in bottom-right */}\n        <div\n          aria-hidden=\"true\"\n          className=\"pointer-events-none absolute -right-4 -bottom-5 flex h-28 w-28 items-center justify-center rounded-full bg-emerald-400/15 blur-xl\"\n        />\n        <ShieldCheck\n          aria-hidden=\"true\"\n          className=\"pointer-events-none absolute right-2 -bottom-3 h-24 w-24 text-emerald-300/15 transition-transform duration-300 group-hover:scale-105\"\n          strokeWidth={1.4}\n        />\n\n        <div className=\"relative z-10 min-h-[82px] pr-12\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={currentSlide.id}\n              initial={{ opacity: 0, x: 12 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -12 }}\n              transition={{ duration: 0.25, ease: [0.16, 1, 0.3, 1] }}\n            >\n              <p className=\"text-[11px] font-semibold tracking-wide text-emerald-200\">\n                {currentSlide.badge}\n              </p>\n              <h2 className=\"mt-1 text-sm font-bold leading-snug text-white text-balance\">\n                {currentSlide.title}\n              </h2>\n              <span className=\"mt-2.5 inline-flex items-center gap-1 text-xs font-semibold text-emerald-200\">\n                <span>{currentSlide.cta}</span>\n                <ChevronRight\n                  className=\"h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5\"\n                  aria-hidden=\"true\"\n                />\n              </span>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n      </motion.button>\n\n      {/* Compact animated progress indicators */}\n      <div className=\"mt-2.5 flex items-center justify-center gap-1.5\">\n        {SAFETY_BANNER_SLIDES.map((slide, index) => {\n          const active = slideIdx === index;\n          return (\n            <button\n              key={slide.id}\n              type=\"button\"\n              onClick={() => setSlideIdx(index)}\n              aria-label={`Xem th\341\272\273 an to\303\240n ${index + 1}`}\n              aria-pressed={active}\n              className={`relative h-1.5 overflow-hidden rounded-full transition-all duration-300 ${\n                active ? \'w-7 bg-emerald-100\' : \'w-2 bg-slate-200 hover:bg-slate-300\'\n              }`}\n            >\n              {active && (\n                <motion.span\n                  key={`progress-${slideIdx}`}\n                  initial={{ scaleX: 0 }}\n                  animate={{ scaleX: 1 }}\n                  transition={{ duration: SLIDE_INTERVAL_MS / 1000, ease: \'linear\' }}\n                  style={{ transformOrigin: \'left\' }}\n                  className=\"absolute inset-0 rounded-full bg-emerald-500\"\n                />\n              )}\n            </button>\n          );\n        })}\n      </div>\n    </section>\n  );\n}\n"
    num_lines: 107
