    content: "import type { GeoJSONSource, Map as MapLibreMap } from \'maplibre-gl\';\nimport type { GeoCoord, GeoJsonLineString } from \'../../types/rescue\';\nimport { buildAccuracyCirclePolygon } from \'../../utils/gpsWatcher\';\n\nexport const EMPTY_FEATURE_COLLECTION = {\n  type: \'FeatureCollection\' as const,\n  features: [],\n};\n\nexport function ensureRescueRouteLayers(map: MapLibreMap): void {\n  if (!map.getSource(\'gps-accuracy-circle\')) {\n    map.addSource(\'gps-accuracy-circle\', {\n      type: \'geojson\',\n      data: EMPTY_FEATURE_COLLECTION,\n    });\n  }\n  if (!map.getLayer(\'gps-accuracy-fill\')) {\n    map.addLayer({\n      id: \'gps-accuracy-fill\',\n      type: \'fill\',\n      source: \'gps-accuracy-circle\',\n      paint: { \'fill-color\': \'#3b82f6\', \'fill-opacity\': 0.15 },\n    });\n  }\n  if (!map.getLayer(\'gps-accuracy-stroke\')) {\n    map.addLayer({\n      id: \'gps-accuracy-stroke\',\n      type: \'line\',\n      source: \'gps-accuracy-circle\',\n      paint: { \'line-color\': \'#60a5fa\', \'line-opacity\': 0.4, \'line-width\': 1.5 },\n    });\n  }\n\n  if (!map.getSource(\'walking-route\')) {\n    map.addSource(\'walking-route\', {\n      type: \'geojson\',\n      data: EMPTY_FEATURE_COLLECTION,\n    });\n  }\n\n  if (!map.getLayer(\'walking-route-casing\')) {\n    map.addLayer({\n      id: \'walking-route-casing\',\n      type: \'line\',\n      source: \'walking-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#ffffff\',\n        \'line-width\': 7,\n        \'line-opacity\': 0.95,\n      },\n    });\n  }\n\n  if (!map.getLayer(\'walking-route-line\')) {\n    map.addLayer({\n      id: \'walking-route-line\',\n      type: \'line\',\n      source: \'walking-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#10b981\',\n        \'line-width\': 4.5,\n        \'line-dasharray\': [2, 1.3],\n      },\n    });\n  }\n\n  if (!map.getSource(\'mechanic-route\')) {\n    map.addSource(\'mechanic-route\', {\n      type: \'geojson\',\n      data: EMPTY_FEATURE_COLLECTION,\n    });\n  }\n\n  if (!map.getLayer(\'mechanic-route-casing\')) {\n    map.addLayer({\n      id: \'mechanic-route-casing\',\n      type: \'line\',\n      source: \'mechanic-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#ffffff\',\n        \'line-width\': 7,\n        \'line-opacity\': 0.92,\n      },\n    });\n  }\n\n  if (!map.getLayer(\'mechanic-route-line\')) {\n    map.addLayer({\n      id: \'mechanic-route-line\',\n      type: \'line\',\n      source: \'mechanic-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#f59e0b\',\n        \'line-width\': 4,\n        \'line-opacity\': 1,\n      },\n    });\n  }\n\n  if (!map.getSource(\'shop-route\')) {\n    map.addSource(\'shop-route\', {\n      type: \'geojson\',\n      data: EMPTY_FEATURE_COLLECTION,\n    });\n  }\n\n  if (!map.getLayer(\'shop-route-casing\')) {\n    map.addLayer({\n      id: \'shop-route-casing\',\n      type: \'line\',\n      source: \'shop-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#ffffff\',\n        \'line-width\': 7,\n        \'line-opacity\': 0.95,\n      },\n    });\n  }\n\n  if (!map.getLayer(\'shop-route-line\')) {\n    map.addLayer({\n      id: \'shop-route-line\',\n      type: \'line\',\n      source: \'shop-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#2563eb\',\n        \'line-width\': 4.5,\n        \'line-opacity\': 1,\n      },\n    });\n  }\n\n  if (!map.getSource(\'gas-route\')) {\n    map.addSource(\'gas-route\', {\n      type: \'geojson\',\n      data: EMPTY_FEATURE_COLLECTION,\n    });\n  }\n\n  if (!map.getLayer(\'gas-route-casing\')) {\n    map.addLayer({\n      id: \'gas-route-casing\',\n      type: \'line\',\n      source: \'gas-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#ffffff\',\n        \'line-width\': 7,\n        \'line-opacity\': 0.95,\n      },\n    });\n  }\n\n  if (!map.getLayer(\'gas-route-line\')) {\n    map.addLayer({\n      id: \'gas-route-line\',\n      type: \'line\',\n      source: \'gas-route\',\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\n      paint: {\n        \'line-color\': \'#ea580c\',\n        \'line-width\': 4.5,\n        \'line-opacity\': 1,\n      },\n    });\n  }\n}\n\nexport function setRouteSourceGeometry(\n  map: MapLibreMap,\n  sourceId: string,\n  geometry: GeoJsonLineString | null,\n): void {\n  const source = map.getSource(sourceId) as GeoJSONSource | undefined;\n  if (!source) return;\n\n  if (!geometry) {\n    source.setData(EMPTY_FEATURE_COLLECTION);\n    return;\n  }\n\n  source.setData({\n    type: \'Feature\',\n    properties: {},\n    geometry,\n  });\n}\n\nexport function setAccuracyCircleGeoJson(\n  map: MapLibreMap,\n  coord: GeoCoord,\n  accuracyMeters: number | null | undefined,\n): void {\n  const source = map.getSource(\'gps-accuracy-circle\') as GeoJSONSource | undefined;\n  if (!source) return;\n  if (typeof accuracyMeters !== \'number\' || !Number.isFinite(accuracyMeters) || accuracyMeters <= 0) {\n    source.setData(EMPTY_FEATURE_COLLECTION);\n    return;\n  }\n  source.setData(buildAccuracyCirclePolygon(coord, accuracyMeters));\n}\n\nexport function getViewportPadding(\n  container: HTMLDivElement | null,\n  forRoute: boolean,\n) {\n  const height = container?.clientHeight ?? window.innerHeight;\n  const safeBottom = forRoute\n    ? Math.min(Math.round(height * 0.61), Math.max(220, height - 180))\n    : Math.min(240, Math.max(160, Math.round(height * 0.34)));\n  return { top: forRoute ? 108 : 52, bottom: safeBottom, left: 36, right: 36 };\n}\n\nexport function fitMapBoundsSafely(\n  map: MapLibreMap,\n  container: HTMLDivElement | null,\n  bounds: [[number, number], [number, number]],\n  maxZoom: number,\n  duration = 550,\n): void {\n  map.resize();\n  map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\n  map.fitBounds(bounds, {\n    padding: getViewportPadding(container, true),\n    duration,\n    maxZoom,\n  });\n}\n"
