    action_spec {
      create_file {
        instruction: "import { Clock, Home, Map, ShieldCheck } from \'lucide-react\';\nimport type { AppTab } from \'../types/rescue\';\n\ninterface BottomNavBarProps {\n  activeTab: AppTab;\n  hasActiveOrder: boolean;\n  onSelectTab: (tab: AppTab) => void;\n}\n\nconst NAV_ITEMS: Array<{\n  id: AppTab;\n  label: string;\n  icon: typeof Home;\n}> = [\n  { id: \'home\', label: \'Trang ch\341\273\247\', icon: Home },\n  { id: \'map\', label: \'B\341\272\243n \304\221\341\273\223\', icon: Map },\n  { id: \'activity\', label: \'Ho\341\272\241t \304\221\341\273\231ng\', icon: Clock },\n  { id: \'safety\', label: \'An to\303\240n\', icon: ShieldCheck },\n];\n\nexport function BottomNavBar({\n  activeTab,\n  hasActiveOrder,\n  onSelectTab,\n}: BottomNavBarProps) {\n  return (\n    <nav\n      aria-label=\"\304\220i\341\273\201u h\306\260\341\273\233ng ch\303\255nh\"\n      className=\"relative z-30 grid h-16 shrink-0 grid-cols-4 items-center border-t border-slate-100 bg-white px-2\"\n    >\n      {NAV_ITEMS.map((item) => {\n        const Icon = item.icon;\n        const active = activeTab === item.id;\n        return (\n          <button\n            key={item.id}\n            type=\"button\"\n            onClick={() => onSelectTab(item.id)}\n            aria-current={active ? \'page\' : undefined}\n            className={`relative flex min-h-[48px] flex-col items-center justify-center gap-0.5 rounded-xl transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${\n              active\n                ? \'text-emerald-600\'\n                : \'text-slate-400 hover:text-slate-700\'\n            }`}\n          >\n            <span className=\"relative\">\n              <Icon\n                className=\"h-[22px] w-[22px]\"\n                strokeWidth={active ? 2.3 : 1.9}\n                aria-hidden=\"true\"\n              />\n              {item.id === \'activity\' && hasActiveOrder && (\n                <span\n                  aria-label=\"\304\220ang c\303\263 \304\221\306\241n c\341\273\251u h\341\273\231\"\n                  className=\"absolute -top-0.5 -right-1 h-2 w-2 rounded-full bg-emerald-500 ring-2 ring-white\"\n                />\n              )}\n            </span>\n            <span\n              className={`text-[11px] tracking-tight whitespace-nowrap ${\n                active ? \'font-bold text-emerald-600\' : \'font-medium text-slate-500\'\n              }`}\n            >\n              {item.label}\n            </span>\n          </button>\n        );\n      })}\n    </nav>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/BottomNavBar.tsx"
        }
        overwrite: true
      }
    }
