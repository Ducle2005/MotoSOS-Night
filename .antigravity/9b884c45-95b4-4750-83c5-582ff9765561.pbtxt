      arguments_json: "{\"CodeContent\":\"import type { ReactNode } from \'react\';\\nimport type { RescueStep } from \'../types/rescue\';\\n\\ninterface BottomSheetShellProps {\\n  step: RescueStep;\\n  children: ReactNode;\\n}\\n\\nconst STEP_INDEX: Record<RescueStep, number> = {\\n  idle: 0,\\n  issue: 1,\\n  pickup: 2,\\n  tracking: 3,\\n};\\n\\nexport function BottomSheetShell({ step, children }: BottomSheetShellProps) {\\n  const currentIndex = STEP_INDEX[step];\\n\\n  return (\\n    <aside\\n      aria-label=\\\"B\341\272\243ng \304\221i\341\273\201u khi\341\273\203n c\341\273\251u h\341\273\231 xe m\303\241y\\\"\\n      className=\\\"relative z-20 flex max-h-[58dvh] flex-col rounded-t-3xl border-t border-slate-800 bg-slate-900 shadow-2xl shadow-black/80 lg:h-full lg:max-h-none lg:w-[440px] lg:shrink-0 lg:rounded-none lg:border-l lg:border-t-0\\\"\\n    >\\n      {/* Mobile drag handle affordance */}\\n      <div className=\\\"flex justify-center pt-3 pb-1 lg:hidden\\\" aria-hidden=\\\"true\\\">\\n        <div className=\\\"h-1.5 w-10 rounded-full bg-slate-700\\\" />\\n      </div>\\n\\n      {/* Step progress indicator during active flow */}\\n      {currentIndex > 0 && (\\n        <div className=\\\"px-5 pt-2 pb-1 lg:pt-5\\\">\\n          <div className=\\\"flex items-center justify-between text-xs text-slate-400\\\">\\n            <span className=\\\"font-medium text-slate-200\\\">\\n              B\306\260\341\273\233c {currentIndex} / 3\\n            </span>\\n            <span className=\\\"font-mono tabular-nums text-slate-400\\\">\\n              {currentIndex === 1 && \'Ch\341\273\215n s\341\273\261 c\341\273\221\'}\\n              {currentIndex === 2 && \'Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235\'}\\n              {currentIndex === 3 && \'Theo d\303\265i th\341\273\243\'}\\n            </span>\\n          </div>\\n          <div\\n            className=\\\"mt-2 grid grid-cols-3 gap-1.5\\\"\\n            role=\\\"progressbar\\\"\\n            aria-valuenow={currentIndex}\\n            aria-valuemin={1}\\n            aria-valuemax={3}\\n            aria-label=\\\"Ti\341\272\277n tr\303\254nh \304\221\341\272\267t c\341\273\251u h\341\273\231\\\"\\n          >\\n            {[1, 2, 3].map((idx) => (\\n              <div\\n                key={idx}\\n                className={`h-1 rounded-full transition-colors duration-200 ${\\n                  idx <= currentIndex ? \'bg-amber-500\' : \'bg-slate-800\'\\n                }`}\\n              />\\n            ))}\\n          </div>\\n        </div>\\n      )}\\n\\n      <div className=\\\"flex-1 overflow-y-auto px-5 pt-3 pb-6 lg:px-6 lg:pb-8\\\">\\n        {children}\\n      </div>\\n    </aside>\\n  );\\n}\\n\", \"Description\":\"Create responsive BottomSheetShell (mobile bottom sheet + desktop side drawer) with step progress bar\", \"Overwrite\":true, \"TargetFile\":\"/src/components/BottomSheetShell.tsx\", \"toolAction\":\"Creating BottomSheetShell component\", \"toolSummary\":\"Create src/components/BottomSheetShell.tsx\"}"
      original_name: "write_to_file"
    }
