    command_line: "trap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\nmkdir -p .playwright-cli\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 430 900 && \\\nplaywright-cli run-code \'async (page) => {\n  await page.waitForTimeout(1800);\n\n  // 1. Click \"C\303\264ng an\" in Home 8-icon grid\n  await page.getByRole(\"button\", { name: /^C\303\264ng an$/i }).click();\n  await page.locator(\"[data-testid=\\\"police-station-list-sheet\\\"]\").waitFor({ state: \"visible\", timeout: 8000 });\n  await page.waitForTimeout(2200); // wait for Geoapify + OSRM auto-route to station #1\n\n  const policeChipSelected = await page\n    .locator(\"[data-testid=\\\"map-filter-chips\\\"]\")\n    .getByRole(\"tab\", { name: /C\303\264ng an/i })\n    .getAttribute(\"aria-selected\");\n\n  const has113Tel = await page.locator(\"[data-testid=\\\"emergency-113-btn\\\"]\").getAttribute(\"href\");\n  const policeItemsCount = await page.locator(\"[data-testid^=\\\"police-station-item-\\\"]\").count();\n  const policeMarkersCount = await page.locator(\"[data-testid^=\\\"police-station-marker-\\\"]\").count();\n  const hasNearestBadge = await page.locator(\"[data-testid^=\\\"police-station-marker-\\\"]\").filter({ hasText: \"G\341\272\247n nh\341\272\245t\" }).count();\n  const firstPoliceText = await page.locator(\"[data-testid^=\\\"police-station-item-\\\"]\").first().innerText();\n  await page.screenshot({ path: \".playwright-cli/police-sheet.png\" });\n\n  // 2. Click \"\304\220\306\260\341\273\235ng \304\221i\" on station #2 (if >=2) then click a police marker in viewport for FloatingPlaceCard\n  if (policeItemsCount >= 2) {\n    await page.locator(\"[data-testid^=\\\"police-station-item-\\\"]\").nth(1).getByRole(\"button\", { name: /\304\220\306\260\341\273\235ng \304\221i/i }).click();\n    await page.waitForTimeout(1200);\n  }\n  const inViewportPoliceIdx = await page.evaluate(() => {\n    const els = Array.from(document.querySelectorAll(\"[data-testid^=\\\"police-station-marker-\\\"]\"));\n    return els.findIndex((el) => {\n      const r = el.getBoundingClientRect();\n      return r.left >= 10 && r.right <= 420 && r.top >= 110 && r.bottom <= 440;\n    });\n  });\n  await page.locator(\"[data-testid^=\\\"police-station-marker-\\\"]\").nth(Math.max(0, inViewportPoliceIdx)).click({ force: inViewportPoliceIdx < 0 });\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 8000 });\n  await page.waitForTimeout(900);\n  const floatingPoliceText = await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").innerText();\n  await page.screenshot({ path: \".playwright-cli/police-pin-card.png\" });\n\n  // 3. Close floating card and switch to \"T\341\272\245t c\341\272\243\" to confirm all 4 marker types co-exist\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"] button\").first().click();\n  await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").getByRole(\"tab\", { name: /^T\341\272\245t c\341\272\243$/i }).click();\n  await page.waitForTimeout(1800);\n\n  const allModePins = await page.evaluate(() => ({\n    police: document.querySelectorAll(\"[data-testid^=\\\"police-station-marker-\\\"]\").length,\n    repairShops: document.querySelectorAll(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").length,\n    gas: document.querySelectorAll(\"[data-testid^=\\\"gas-station-marker-\\\"]\").length,\n    safeOrStationButtons: document.querySelectorAll(\"button[aria-label*=\\\"ph\303\272t \304\221i b\341\273\231\\\"]\").length,\n  }));\n  await page.screenshot({ path: \".playwright-cli/map-all-4-layers.png\" });\n\n  return JSON.stringify({\n    policeChipSelected,\n    has113Tel,\n    policeItemsCount,\n    policeMarkersCount,\n    hasNearestBadge,\n    firstPoliceText: firstPoliceText.replace(/\\n+/g, \" | \"),\n    floatingPoliceText: floatingPoliceText.replace(/\\n+/g, \" | \"),\n    allModePins,\n  }, null, 2);\n}\' && \\\nplaywright-cli console error"
