      arguments_json: "{\"CodeContent\":\"import { ShieldCheck, Sparkles, RotateCcw } from \'lucide-react\';\\nimport type { RescueStep, TrackingStatus } from \'../types/rescue\';\\n\\ninterface TopOverlayBarProps {\\n  step: RescueStep;\\n  trackingStatus: TrackingStatus;\\n  onDemoAdvance: () => void;\\n}\\n\\nexport function TopOverlayBar({\\n  step,\\n  trackingStatus,\\n  onDemoAdvance,\\n}: TopOverlayBarProps) {\\n  const getDemoLabel = (): string => {\\n    if (step === \'tracking\') {\\n      if (trackingStatus === \'accepted\') return \'Demo: Gi\341\272\243 l\341\272\255p ho\303\240n th\303\240nh\';\\n      if (trackingStatus === \'completed\') return \'Demo: Th\341\273\255 l\341\272\241i lu\341\273\223ng m\341\273\233i\';\\n    }\\n    return \'Demo: Gi\341\272\243 l\341\272\255p th\341\273\243 nh\341\272\255n \304\221\306\241n\';\\n  };\\n\\n  return (\\n    <header className=\\\"pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between gap-3 px-4 pt-3 pb-2\\\">\\n      <div className=\\\"pointer-events-auto flex items-center gap-2.5 rounded-xl bg-slate-900/90 px-3 py-2 backdrop-blur-md border border-slate-800/90 shadow-lg shadow-black/30\\\">\\n        <span className=\\\"flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-500 text-slate-950\\\">\\n          <ShieldCheck className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />\\n        </span>\\n        <div className=\\\"min-w-0\\\">\\n          <p className=\\\"text-sm font-bold tracking-tight text-slate-100 whitespace-nowrap\\\">\\n            MotoSOS Night\\n          </p>\\n        </div>\\n      </div>\\n\\n      <button\\n        type=\\\"button\\\"\\n        onClick={onDemoAdvance}\\n        aria-label={getDemoLabel()}\\n        className=\\\"pointer-events-auto inline-flex min-h-[44px] shrink-0 items-center gap-1.5 rounded-xl border border-amber-500/40 bg-slate-900/95 px-3 py-2 text-xs font-semibold text-amber-300 shadow-lg shadow-black/40 backdrop-blur-md transition-colors hover:border-amber-400 hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 active:scale-[0.98] whitespace-nowrap\\\"\\n      >\\n        {step === \'tracking\' && trackingStatus === \'completed\' ? (\\n          <RotateCcw className=\\\"h-3.5 w-3.5 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n        ) : (\\n          <Sparkles className=\\\"h-3.5 w-3.5 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n        )}\\n        <span>{getDemoLabel()}</span>\\n      </button>\\n    </header>\\n  );\\n}\\n\", \"Description\":\"Create top overlay bar with MotoSOS Night brand mark and Demo simulate mechanic acceptance button in top-right corner\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TopOverlayBar.tsx\", \"toolAction\":\"Creating TopOverlayBar component\", \"toolSummary\":\"Create src/components/TopOverlayBar.tsx\"}"
