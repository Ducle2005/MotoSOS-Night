      original_chunk {
        target_content: "export interface GeoapifyGeocodeFeature {\n  geometry?: {\n    coordinates?: [number, number];\n  };\n  properties?: {\n    place_id?: string;\n    name?: string;\n    street?: string;\n    housenumber?: string;\n    suburb?: string;\n    district?: string;\n    city?: string;\n    address_line1?: string;\n    address_line2?: string;\n    formatted?: string;\n    distance?: number;\n  };\n}\n\nexport function formatSuggestionDistance(distanceMeters: number): string {\n  const safeMeters = Math.max(0, Math.round(distanceMeters));\n  if (safeMeters < 1000) {\n    return `${safeMeters} m`;\n  }\n  return `${(safeMeters / 1000).toFixed(1)} km`;\n}\n\nexport function parseReverseGeocodeAddress(\n  feature: GeoapifyGeocodeFeature | undefined,\n  fallbackCoord: GeoCoord,\n): string {\n  const props = feature?.properties;\n  if (!props) {\n    return `V\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i (${fallbackCoord.lat.toFixed(4)}, ${fallbackCoord.lng.toFixed(4)})`;\n  }\n\n  const line1 =\n    props.address_line1?.trim() ||\n    [props.housenumber, props.street].filter(Boolean).join(\' \').trim() ||\n    props.name?.trim();\n  const district =\n    props.district?.trim() ||\n    props.suburb?.trim() ||\n    props.city?.trim() ||\n    \'\';\n\n  if (line1 && district && !line1.toLowerCase().includes(district.toLowerCase())) {\n    return formatCompactStationAddress(`${line1}, ${district}`);\n  }\n  if (props.formatted) {\n    return formatCompactStationAddress(props.formatted);\n  }\n  if (line1) return line1;\n\n  return `V\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i (${fallbackCoord.lat.toFixed(4)}, ${fallbackCoord.lng.toFixed(4)})`;\n}"
        replacement_content: "export interface GeoapifyGeocodeFeature {\n  geometry?: {\n    coordinates?: [number, number];\n  };\n  properties?: {\n    place_id?: string;\n    name?: string;\n    street?: string;\n    housenumber?: string;\n    quarter?: string;\n    suburb?: string;\n    district?: string;\n    city?: string;\n    address_line1?: string;\n    address_line2?: string;\n    formatted?: string;\n    distance?: number;\n  };\n}\n\nexport function formatSuggestionDistance(distanceMeters: number): string {\n  const safeMeters = Math.max(0, Math.round(distanceMeters));\n  if (safeMeters < 1000) {\n    return `${safeMeters} m`;\n  }\n  return `${(safeMeters / 1000).toFixed(1)} km`;\n}\n\nexport function parseReverseGeocodeAddress(\n  feature: GeoapifyGeocodeFeature | undefined,\n  fallbackCoord: GeoCoord,\n): string {\n  const props = feature?.properties;\n  if (!props) {\n    return `V\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i (${fallbackCoord.lat.toFixed(4)}, ${fallbackCoord.lng.toFixed(4)})`;\n  }\n\n  const streetPart = [props.housenumber, props.street]\n    .filter((part): part is string => Boolean(part && part.trim()))\n    .map((part) => part.trim())\n    .join(\' \');\n\n  const areaPart = (\n    props.suburb ||\n    props.quarter ||\n    props.district ||\n    props.city ||\n    \'\'\n  ).trim();\n\n  if (streetPart && areaPart) {\n    return streetPart.toLowerCase().includes(areaPart.toLowerCase())\n      ? streetPart\n      : `${streetPart}, ${areaPart}`;\n  }\n  if (streetPart) return streetPart;\n  if (areaPart) return areaPart;\n\n  return `V\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i (${fallbackCoord.lat.toFixed(4)}, ${fallbackCoord.lng.toFixed(4)})`;\n}"
        start_line: 8
        end_line: 64
      }
      num_matches: 1
    }
    description: "Ensure reverse geocoding builds clean street + area address without nearby building/agency POI names"
