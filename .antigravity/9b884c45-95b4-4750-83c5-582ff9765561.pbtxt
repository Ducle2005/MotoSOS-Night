  run_command {
    cwd: "/app/applet"
    wait_ms_before_async: 90000
    command_line: "playwright-cli close 2>/dev/null || true; rm -rf .playwright-cli && mkdir -p .playwright-cli && playwright-cli open http://localhost:3000 && playwright-cli resize 430 900 && sleep 1 && playwright-cli run-code \"async page => {\n  await page.waitForSelector(\'[data-testid=\\\"header-bell-btn\\\"]\', { timeout: 10000 });\n  const initialBadge = await page.locator(\'[data-testid=\\\"header-bell-badge\\\"]\').textContent();\n  await page.screenshot({ path: \'.playwright-cli/home-bell.png\' });\n\n  // 1. Open Notification Center & verify filters + mark-all-read\n  await page.click(\'[data-testid=\\\"header-bell-btn\\\"]\');\n  await page.waitForSelector(\'[data-testid=\\\"notification-center-modal\\\"]\', { timeout: 5000 });\n  await page.click(\'[data-testid=\\\"notif-filter-promo\\\"]\');\n  const promoCount = await page.locator(\'[data-testid^=\\\"notif-item-\\\"]\').count();\n  await page.click(\'[data-testid=\\\"notif-filter-all\\\"]\');\n  await page.click(\'[data-testid=\\\"mark-all-read-btn\\\"]\');\n  const badgeAfterReadAll = await page.locator(\'[data-testid=\\\"header-bell-badge\\\"]\').count();\n  await page.click(\'button[aria-label=\\\"\304\220\303\263ng trung t\303\242m th\303\264ng b\303\241o\\\"]\');\n  await page.waitForTimeout(300);\n\n  // 2. Quick SOS trigger -> FloatingPushBanner\n  await page.click(\'button:has-text(\\\"G\341\273\255i SOS\\\")\');\n  await page.waitForSelector(\'[data-testid=\\\"floating-push-banner\\\"]\', { timeout: 5000 });\n  const sosBanner = await page.locator(\'[data-testid=\\\"floating-push-banner\\\"]\').textContent();\n\n  // 3. Submit Rescue Order -> Order Submitted notification\n  await page.click(\'button:has-text(\\\"X\303\241c nh\341\272\255n g\341\273\215i th\341\273\243\\\")\');\n  await page.waitForTimeout(650);\n  const orderBanner = await page.locator(\'[data-testid=\\\"floating-push-banner\\\"]\').textContent();\n\n  // 4. Advance demo -> Mechanic Arrived notification\n  await page.click(\'button:has-text(\\\"Trang ch\341\273\247\\\")\');\n  await page.waitForSelector(\'[data-testid=\\\"header-bell-badge\\\"]\', { timeout: 5000 });\n  const unreadAfterTwoEvents = await page.locator(\'[data-testid=\\\"header-bell-badge\\\"]\').textContent();\n  await page.click(\'button:has-text(\\\"Test th\341\273\243\\\")\');\n  await page.waitForTimeout(350);\n  const arriveBanner = await page.locator(\'[data-testid=\\\"floating-push-banner\\\"]\').textContent();\n  return { initialBadge, promoCount, badgeAfterReadAll, sosBanner, orderBanner, unreadAfterTwoEvents, arriveBanner };\n}\" && playwright-cli console error && playwright-cli close"
    proposed_command_line: "playwright-cli close 2>/dev/null || true; rm -rf .playwright-cli && mkdir -p .playwright-cli && playwright-cli open http://localhost:3000 && playwright-cli resize 430 900 && sleep 1 && playwright-cli run-code \"async page => {\n  await page.waitForSelector(\'[data-testid=\\\"header-bell-btn\\\"]\', { timeout: 10000 });\n  const initialBadge = await page.locator(\'[data-testid=\\\"header-bell-badge\\\"]\').textContent();\n  await page.screenshot({ path: \'.playwright-cli/home-bell.png\' });\n\n  // 1. Open Notification Center & verify filters + mark-all-read\n  await page.click(\'[data-testid=\\\"header-bell-btn\\\"]\');\n  await page.waitForSelector(\'[data-testid=\\\"notification-center-modal\\\"]\', { timeout: 5000 });\n  await page.click(\'[data-testid=\\\"notif-filter-promo\\\"]\');\n  const promoCount = await page.locator(\'[data-testid^=\\\"notif-item-\\\"]\').count();\n  await page.click(\'[data-testid=\\\"notif-filter-all\\\"]\');\n  await page.click(\'[data-testid=\\\"mark-all-read-btn\\\"]\');\n  const badgeAfterReadAll = await page.locator(\'[data-testid=\\\"header-bell-badge\\\"]\').count();\n  await page.click(\'button[aria-label=\\\"\304\220\303\263ng trung t\303\242m th\303\264ng b\303\241o\\\"]\');\n  await page.waitForTimeout(300);\n\n  // 2. Quick SOS trigger -> FloatingPushBanner\n  await page.click(\'button:has-text(\\\"G\341\273\255i SOS\\\")\');\n  await page.waitForSelector(\'[data-testid=\\\"floating-push-banner\\\"]\', { timeout: 5000 });\n  const sosBanner = await page.locator(\'[data-testid=\\\"floating-push-banner\\\"]\').textContent();\n\n  // 3. Submit Rescue Order -> Order Submitted notification\n  await page.click(\'button:has-text(\\\"X\303\241c nh\341\272\255n g\341\273\215i th\341\273\243\\\")\');\n  await page.waitForTimeout(650);\n  const orderBanner = await page.locator(\'[data-testid=\\\"floating-push-banner\\\"]\').textContent();\n\n  // 4. Advance demo -> Mechanic Arrived notification\n  await page.click(\'button:has-text(\\\"Trang ch\341\273\247\\\")\');\n  await page.waitForSelector(\'[data-testid=\\\"header-bell-badge\\\"]\', { timeout: 5000 });\n  const unreadAfterTwoEvents = await page.locator(\'[data-testid=\\\"header-bell-badge\\\"]\').textContent();\n  await page.click(\'button:has-text(\\\"Test th\341\273\243\\\")\');\n  await page.waitForTimeout(350);\n  const arriveBanner = await page.locator(\'[data-testid=\\\"floating-push-banner\\\"]\').textContent();\n  return { initialBadge, promoCount, badgeAfterReadAll, sosBanner, orderBanner, unreadAfterTwoEvents, arriveBanner };\n}\" && playwright-cli console error && playwright-cli close"
