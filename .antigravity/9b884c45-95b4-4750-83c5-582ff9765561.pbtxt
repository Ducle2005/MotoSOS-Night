    content: "import type { GeoCoord } from \'../types/rescue\';\n\nexport interface MockRepairShopSeed {\n  id: string;\n  name: string;\n  address: string;\n  phone: string;\n  openingHoursRaw: string | null;\n  coord: GeoCoord;\n}\n\nexport const MOCK_REPAIR_SHOPS_SEED: MockRepairShopSeed[] = [\n  {\n    id: \'shop-anh-tuan-247\',\n    name: \'Ti\341\273\207m S\341\273\255a Xe Anh Tu\341\272\245n 24/7\',\n    address: \'42 L\303\275 T\341\273\261 Tr\341\273\215ng, Q.1\',\n    phone: \'0903 712 458\',\n    openingHoursRaw: \'24/7\',\n    coord: { lat: 10.7779, lng: 106.7029 },\n  },\n  {\n    id: \'shop-minh-phat-dem\',\n    name: \'C\341\273\251u H\341\273\231 & S\341\273\255a Xe Minh Ph\303\241t\',\n    address: \'118 Pasteur, Q.1\',\n    phone: \'0938 645 219\',\n    openingHoursRaw: \'24/7\',\n    coord: { lat: 10.7791, lng: 106.6982 },\n  },\n  {\n    id: \'shop-hong-phuc\',\n    name: \'S\341\273\255a Xe Tay Ga H\341\273\223ng Ph\303\272c\',\n    address: \'65 Nguy\341\273\205n Du, Q.1\',\n    phone: \'0918 334 890\',\n    openingHoursRaw: null,\n    coord: { lat: 10.7785, lng: 106.6976 },\n  },\n  {\n    id: \'shop-thanh-dat-day\',\n    name: \'Ti\341\273\207m S\341\273\255a Xe Th\303\240nh \304\220\341\272\241t\',\n    address: \'214 Hai B\303\240 Tr\306\260ng, Q.1\',\n    phone: \'0909 551 204\',\n    openingHoursRaw: \'Mo-Su 07:00-21:30\',\n    coord: { lat: 10.7834, lng: 106.6974 },\n  },\n  {\n    id: \'shop-quoc-bao-day\',\n    name: \'Head & S\341\273\255a Xe Qu\341\273\221c B\341\272\243o\',\n    address: \'91 L\303\252 L\341\273\243i, Q.1\',\n    phone: \'0902 889 112\',\n    openingHoursRaw: \'Mo-Sa 07:30-20:00\',\n    coord: { lat: 10.7734, lng: 106.6997 },\n  },\n];\n"
