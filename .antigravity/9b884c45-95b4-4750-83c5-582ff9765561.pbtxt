      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add solid blue shop-route casing and line layers to MapLibre style setup\", \"EndLine\":80, \"Instruction\":\"Add shop-route source and casing/line layers in ensureRescueRouteLayers\", \"ReplacementContent\":\"  if (!map.getLayer(\'mechanic-route-line\')) {\\n    map.addLayer({\\n      id: \'mechanic-route-line\',\\n      type: \'line\',\\n      source: \'mechanic-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#f59e0b\',\\n        \'line-width\': 4,\\n        \'line-opacity\': 1,\\n      },\\n    });\\n  }\\n\\n  if (!map.getSource(\'shop-route\')) {\\n    map.addSource(\'shop-route\', {\\n      type: \'geojson\',\\n      data: EMPTY_FEATURE_COLLECTION,\\n    });\\n  }\\n\\n  if (!map.getLayer(\'shop-route-casing\')) {\\n    map.addLayer({\\n      id: \'shop-route-casing\',\\n      type: \'line\',\\n      source: \'shop-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#ffffff\',\\n        \'line-width\': 7,\\n        \'line-opacity\': 0.95,\\n      },\\n    });\\n  }\\n\\n  if (!map.getLayer(\'shop-route-line\')) {\\n    map.addLayer({\\n      id: \'shop-route-line\',\\n      type: \'line\',\\n      source: \'shop-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#2563eb\',\\n        \'line-width\': 4.5,\\n        \'line-opacity\': 1,\\n      },\\n    });\\n  }\\n}\", \"StartLine\":65, \"TargetContent\":\"  if (!map.getLayer(\'mechanic-route-line\')) {\\n    map.addLayer({\\n      id: \'mechanic-route-line\',\\n      type: \'line\',\\n      source: \'mechanic-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#f59e0b\',\\n        \'line-width\': 4,\\n        \'line-opacity\': 1,\\n      },\\n    });\\n  }\\n}\", \"TargetFile\":\"/src/components/map/mapLayers.ts\", \"toolAction\":\"Adding shop route layer to mapLayers.ts\", \"toolSummary\":\"Add shop route layer\"}"
