ns, \\\"STATIONS_WHEN_SHOP_FILTER:\\\", stationPins);\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/r17-map-shops-only.png\n\nplaywright-cli run-code \"async (page) => {\n  await page.getByRole(\\\"tab\\\", { name: /Tr\341\272\241m An To\303\240n/ }).click();\n  await page.waitForTimeout(400);\n  const shopPins = await page.locator(\\\"[data-testid^=\\\\\\\"repair-shop-marker-\\\\\\\"]\\\").count();\n  const stationPins = await page.locator(\\\"[aria-label*=\\\\\\\"ph\303\272t \304\221i b\341\273\231\\\\\\\"]\\\").count();\n  console.log(\\\"STATION_FILTER_SHOPS:\\\", shopPins, \\\"STATION_FILTER_STATIONS:\\\", stationPins);\n  await page.getByRole(\\\"tab\\\", { name: /Ti\341\273\207m s\341\273\255a xe/ }).click();\n  await page.waitForSelector(\\\"[data-testid^=\\\\\\\"repair-shop-marker-\\\\\\\"]\\\");\n}\"\n\nplaywright-cli run-code \"async (page) => {\n  await page.locator(\\\"[data-testid^=\\\\\\\"repair-shop-marker-\\\\\\\"]\\\").first().click({ force: true });\n  await page.waitForSelector(\\\"[data-testid=\\\\\\\"repair-shop-detail-sheet\\\\\\\"]\\\");\n  const gmapsHref = await page.locator(\\\"[data-testid=\\\\\\\"repair-shop-detail-sheet\\\\\\\"] a[target=\\\\\\\"_blank\\\\\\\"]\\\").getAttribute(\\\"href\\\");\n  const telHref = await page.locator(\\\"[data-testid=\\\\\\\"repair-shop-detail-sheet\\\\\\\"] a[href^=\\\\\\\"tel:\\\\\\\"]\\\").getAttribute(\\\"href\\\");\n  console.log(\\\"GMAPS_HREF:\\\", gmapsHref, \\\"TEL_HREF:\\\", telHref);\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/r17-shop-detail.png\n\nplaywright-cli run-code \"async (page) => {\n  await page.getByRole(\\\"button\\\", { name: \\\"D\341\272\253n \304\221\306\260\341\273\235ng\\\" }).click();\n  await page.waitForSelector(\\\"text=\304\220ang ch\341\273\211 \304\221\306\260\341\273\235ng\\\", { timeout: 10000 });\n  await page.waitForTimeout(1200);\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/r17-shop-route.png\n\nplaywright-cli console error