      create_file {
        instruction: "import type { SafeStation, SafeStationCategory } from \'../../types/rescue\';\n\nfunction getCategorySvgMarkup(category: SafeStationCategory): string {\n  if (category === \'convenience\') {\n    return `<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7\"/><path d=\"M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8\"/><path d=\"M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4\"/><path d=\"M2 7h20\"/><path d=\"M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7\"/></svg>`;\n  }\n  if (category === \'gas_station\') {\n    return `<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"3\" x2=\"15\" y1=\"22\" y2=\"22\"/><line x1=\"4\" x2=\"14\" y1=\"9\" y2=\"9\"/><path d=\"M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18\"/><path d=\"M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2a2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5\"/></svg>`;\n  }\n  return `<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/></svg>`;\n}\n\nexport function createUserMarkerElement(isSearching: boolean): HTMLDivElement {\n  const wrapper = document.createElement(\'div\');\n  wrapper.className = \'relative flex items-center justify-center pointer-events-none\';\n  wrapper.setAttribute(\'aria-label\', \'V\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\');\n\n  const radarRing = document.createElement(\'span\');\n  radarRing.className = isSearching\n    ? \'absolute h-20 w-20 rounded-full border border-amber-400/50 bg-amber-500/15 animate-ping\'\n    : \'absolute h-10 w-10 rounded-full bg-sky-400/30 animate-ping\';\n\n  const halo = document.createElement(\'span\');\n  halo.className = \'absolute h-7 w-7 rounded-full bg-sky-500/25\';\n\n  const dot = document.createElement(\'span\');\n  dot.className =\n    \'relative h-4 w-4 rounded-full border-2 border-white bg-sky-500 shadow-lg shadow-sky-500/60\';\n\n  wrapper.appendChild(radarRing);\n  wrapper.appendChild(halo);\n  wrapper.appendChild(dot);\n  return wrapper;\n}\n\nexport function createStationMarkerElement(\n  station: SafeStation,\n  isHighlighted: boolean,\n  onClick: () => void,\n): HTMLButtonElement {\n  const button = document.createElement(\'button\');\n  button.type = \'button\';\n  button.setAttribute(\n    \'aria-label\',\n    `${station.name}, ${station.categoryLabel}, ${station.walkingDistanceMeters}m \302\267 ${station.walkingMinutes} ph\303\272t \304\221i b\341\273\231`,\n  );\n  button.setAttribute(\'aria-pressed\', String(isHighlighted));\n  button.className =\n    \'group flex min-h-[44px] min-w-[44px] flex-col items-center justify-center focus:outline-none cursor-pointer\';\n  button.addEventListener(\'click\', (event) => {\n    event.stopPropagation();\n    onClick();\n  });\n\n  const badge = document.createElement(\'div\');\n  badge.className = isHighlighted\n    ? \'flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/40 scale-110 transition-transform\'\n    : \'flex h-8 w-8 items-center justify-center rounded-xl border border-emerald-500/60 bg-slate-900/95 text-emerald-400 shadow-md shadow-black/60 transition-transform group-hover:scale-105\';\n  badge.innerHTML = getCategorySvgMarkup(station.category);\n\n  const labelBox = document.createElement(\'div\');\n  labelBox.className =\n    \'mt-1 rounded-md border border-slate-800/90 bg-slate-950/90 px-1.5 py-0.5 text-center shadow backdrop-blur-sm\';\n\n  const title = document.createElement(\'p\');\n  title.className =\n    \'max-w-[128px] truncate text-[10px] font-semibold text-slate-100\';\n  title.textContent = station.name;\n\n  const dist = document.createElement(\'p\');\n  dist.className =\n    \'font-mono text-[9px] tabular-nums text-emerald-400 whitespace-nowrap\';\n  dist.textContent = `${station.walkingDistanceMeters}m \302\267 ${station.walkingMinutes}p`;\n\n  labelBox.appendChild(title);\n  labelBox.appendChild(dist);\n  button.appendChild(badge);\n  button.appendChild(labelBox);\n  return button;\n}\n\nexport function createMechanicMarkerElement(\n  mechanicName: string,\n  etaMinutes: number,\n  isCompleted: boolean,\n): HTMLDivElement {\n  const wrapper = document.createElement(\'div\');\n  wrapper.className = \'flex flex-col items-center pointer-events-none\';\n\n  const iconBox = document.createElement(\'div\');\n  iconBox.className =\n    \'flex h-10 w-10 items-center justify-center rounded-full border-2 border-slate-950 bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/40\';\n  iconBox.innerHTML = `<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>`;\n\n  const label = document.createElement(\'span\');\n  label.className =\n    \'mt-1 rounded-md bg-amber-500 px-2 py-0.5 text-[10px] font-bold text-slate-950 whitespace-nowrap shadow\';\n  const shortName = mechanicName.split(\' \').pop() || mechanicName;\n  label.textContent = isCompleted\n    ? \'Th\341\273\243 \304\221\303\243 \304\221\341\272\277n \304\221i\341\273\203m h\341\272\271n\'\n    : `Th\341\273\243 ${shortName} \302\267 ${etaMinutes}p`;\n\n  wrapper.appendChild(iconBox);\n  wrapper.appendChild(label);\n  return wrapper;\n}\n"
