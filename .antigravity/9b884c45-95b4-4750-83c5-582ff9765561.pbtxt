,\\n  selectedShopId,\\n  selectedGasStationId,\\n  mapFilter,\\n  pickupMode,\\n  pickupCoord,\\n  walkingRoute,\\n  shopRoute,\\n  gasRoute,\\n  mechanicRoute,\\n  routeStartTimeMs,\\n  initialEtaMinutes,\\n  step,\\n  trackingStatus,\\n  mechanic,\\n  recenterSignal,\\n  isPinPickerMode = false,\\n  isPinDragging = false,\\n  onSelectStation,\\n  onInspectStation,\\n  onSelectShop,\\n  onSelectGasStation,\\n  onPinMoveStart,\\n  onPinMoveEnd,\\n  onEtaMinuteChange,\\n  onMechanicArrived,\\n}: RescueMapProps) {\\n  const containerRef = useRef<HTMLDivElement | null>(null);\\n  const mapRef = useRef<MapLibreMap | null>(null);\\n  const userMarkerRef = useRef<Marker | null>(null);\\n  const [mapReady, setMapReady] = useState(false);\\n\\n  const mechanicMarkerRef = useRescueMapMechanicOverlay({\\n    mapRef,\\n    containerRef,\\n    mapReady,\\n    step,\\n    trackingStatus,\\n    mechanicRoute,\\n    routeStartTimeMs,\\n    initialEtaMinutes,\\n    pickupCoord,\\n    mechanicName: mechanic.name,\\n    onEtaMinuteChange,\\n    onMechanicArrived,\\n  });\\n\\n  const { clearAllMarkers } = useMapMarkersSync({\\n    mapRef,\\n    containerRef,\\n    mapReady,\\n    userCoord: userLocation.coord,\\n    stations,\\n    openRepairShops,\\n    gasStations,\\n    selectedStationId,\\n    inspectedStationId,\\n    selectedShopId,\\n    selectedGasStationId,\\n    mapFilter,\\n    shopRoute,\\n    gasRoute,\\n    step,\\n    pickupMode,\\n    onSelectStation,\\n    onInspectStation,\\n    onSelectShop,\\n    onSelectGasStation,\\n  });\", \"TargetFile\":\"/src/components/RescueMap.tsx\", \"toolAction\":\"Trimming RescueMap line count\", \"toolSummary\":\"Keep RescueMap <250 lines\"}"
