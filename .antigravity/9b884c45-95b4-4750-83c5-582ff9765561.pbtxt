      thinking_signature: "\022\320\005\n\315\005\001i\024}\023\244\204\\\354\v\306u|\313\303\r/\255\345qA\271=\303M\204\225\272\372\340V\224\350\002\210\344\313\232\314\227\237\vu-h\30546\207]\'\216\273\332/\006\b\204g\355\217\222\'\326\006\r`\224\263\275#u\226\320\343\237OG\030G\212\300;\217\320\000-J\246L\034\312w\254R\210\241\213\214\354k\336\371X\275-\017\352LS*\222\345\037\307\335\313}\274M\275\035\250e\370\006\212\n\004\242%2US\252\372\361\251\v\211i\302\355\235{\331\276\325uR\270J*\345U\260\363\344\n6\302yr\206$\373\265\006\350\376\377\225\354RD\026\345\263\002?\211\002\217\220l\343f\353\025\241gj|\365\357k\232\251\261$\301\365\256r\322z\214kP\303]\263B~g\231\241Yn\365\304\201\236\177\332\344\230\247g\312\022\250\2002\324\244,\254\355UPv\301\327\v\005\f\\e\200\006\257\331\220\275#\231\000\251\002D\375\2015\a\'\201\367\250\302\370\202\276{,\317\347\307_\233\273R\005\237_m\\\036~\037%\3334\017\255\257ur\263\241\315\336\035A\v\021\255Y\b\217j^\204Oo\271\220\346,\006S\374H\020z)\005=U\005x\v\335\3201\307\363\377\223\215r\233\'1\220\263\016\251Bu\016\235\360\v&\330\315\246OI\374R\340h\317\374\251=\2518;E\202\227\262\376\n\322#\024\336\370\221\026\272\031\265r\215\362B\032\315l\025,i\336\204\371}\227\023Ow\201\331\263I\'yE\233\262\322\250TZr\256K\a\300\341\f7\032\017\365\030\355\n\336\345?AM\276\317hu}\376\352\3458\211\246\177S};\024\020\322\n\035\317\262B\272ME_\262\'w\362\206+\267\324{\203\302\311\335\267\037\257\335\"\260\336T\340\0340\367Q\376Wn\f\3565}\377\221/\r}a\351\255j0\003\016\332\254\315\256\177\211!YC#\255\277\342\321\254\337\307c\026\363\345\265\v%S\247q\234~\270\213^1\262LQ\240\326\203!\326\322\333,\361\301g\306\376\301\243K\233\366\211\232h\245\026j\237\2755\0307<\236|\367\242\027\337\240\v\264w\3630a\200\334\345qvEzE\024\212\333T\277Z\266j\330\207\006\222\324\314\253\356\241\233u\214y\212\215\223\364\021?\314\367\347\352\363\276&\227\237\210\323\263[\356\240\275\240\355\336T\304G\232_\314\342DVj $1(\355\365@\305\t<\267\302\a\246xE?\3612x\274\020\270\302\232\253\225{\256\365\327)\275\232\220\305\032\216\265G\264\203\221\305\271\323\203\230\227\336<*.\362\366^W\216\370\351\026\356K\2202"
