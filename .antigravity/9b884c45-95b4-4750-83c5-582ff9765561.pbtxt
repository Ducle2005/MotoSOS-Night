    end_line: 147
    content: "import {\n  AlertCircle,\n  BatteryCharging,\n  CircleDot,\n  Fuel,\n  Shield,\n  Store,\n  Wrench,\n} from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type { IssueType, SafeStationCategory } from \'../../types/rescue\';\n\ninterface HomeActionGridProps {\n  onQuickIssueSelect: (issue: IssueType) => void;\n  onQuickCategorySelect: (category: SafeStationCategory) => void;\n  onQuickSosSelect: () => void;\n}\n\nconst ISSUE_GRID: Array<{\n  id: IssueType;\n  label: string;\n  icon: typeof CircleDot;\n  tone: string;\n}> = [\n  {\n    id: \'flat_tire\',\n    label: \'L\341\273\247ng l\341\273\221p\',\n    icon: CircleDot,\n    tone: \'bg-gradient-to-b from-emerald-50 to-emerald-100/80 text-emerald-600\',\n  },\n  {\n    id: \'engine_dead\',\n    label: \'Ch\341\272\277t m\303\241y\',\n    icon: Wrench,\n    tone: \'bg-gradient-to-b from-sky-50 to-sky-100/80 text-sky-600\',\n  },\n  {\n    id: \'out_of_fuel\',\n    label: \'H\341\272\277t x\304\203ng\',\n    icon: Fuel,\n    tone: \'bg-gradient-to-b from-amber-50 to-amber-100/80 text-amber-600\',\n  },\n  {\n    id: \'battery_jump\',\n    label: \'K\303\255ch b\303\254nh\',\n    icon: BatteryCharging,\n    tone: \'bg-gradient-to-b from-teal-50 to-teal-100/80 text-teal-600\',\n  },\n];\n\nconst STATION_GRID: Array<{\n  id: string;\n  label: string;\n  icon: typeof Store;\n  tone: string;\n  category?: SafeStationCategory;\n  isSos?: boolean;\n}> = [\n  {\n    id: \'store\',\n    label: \'C\341\273\255a h\303\240ng 24/7\',\n    icon: Store,\n    tone: \'bg-gradient-to-b from-emerald-50 to-emerald-100/80 text-emerald-600\',\n    category: \'convenience\',\n  },\n  {\n    id: \'fuel\',\n    label: \'C\303\242y x\304\203ng\',\n    icon: Fuel,\n    tone: \'bg-gradient-to-b from-amber-50 to-amber-100/80 text-amber-600\',\n    category: \'gas_station\',\n  },\n  {\n    id: \'police\',\n    label: \'C\303\264ng an\',\n    icon: Shield,\n    tone: \'bg-gradient-to-b from-sky-50 to-sky-100/80 text-sky-600\',\n    category: \'police\',\n  },\n  {\n    id: \'sos\',\n    label: \'G\341\273\255i SOS\',\n    icon: AlertCircle,\n    tone: \'bg-gradient-to-b from-rose-50 to-rose-100/80 text-rose-600\',\n    isSos: true,\n  },\n];\n\nexport function HomeActionGrid({\n  onQuickIssueSelect,\n  onQuickCategorySelect,\n  onQuickSosSelect,\n}: HomeActionGridProps) {\n  return (\n    <section aria-label=\"D\341\273\213ch v\341\273\245 c\341\273\251u h\341\273\231 v\303\240 Tr\341\272\241m An To\303\240n\" className=\"mt-5\">\n      <div className=\"grid grid-cols-4 gap-x-2 gap-y-4\">\n        {ISSUE_GRID.map((item) => {\n          const Icon = item.icon;\n          return (\n            <motion.button\n              key={item.id}\n              type=\"button\"\n              whileTap={{ scale: 0.92 }}\n              onClick={() => onQuickIssueSelect(item.id)}\n              className=\"group flex flex-col items-center gap-1.5 rounded-2xl p-1 text-center transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-95\"\n            >\n              <span\n                className={`flex h-12 w-12 items-center justify-center rounded-2xl shadow-sm ring-1 ring-inset ring-black/5 transition-transform group-hover:-translate-y-0.5 ${item.tone}`}\n              >\n                <Icon className=\"h-5 w-5\" aria-hidden=\"true\" />\n              </span>\n              <span className=\"text-[11px] font-semibold leading-tight text-slate-700\">\n                {item.label}\n              </span>\n            </motion.button>\n          );\n        })}\n\n        {STATION_GRID.map((item) => {\n          const Icon = item.icon;\n          return (\n            <motion.button\n              key={item.id}\n              type=\"button\"\n              whileTap={{ scale: 0.92 }}\n              onClick={() =>\n                item.isSos\n                  ? onQuickSosSelect()\n                  : item.category && onQuickCategorySelect(item.category)\n              }\n              className=\"group flex flex-col items-center gap-1.5 rounded-2xl p-1 text-center transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-95\"\n            >\n              <span\n                className={`flex h-12 w-12 items-center justify-center rounded-2xl shadow-sm ring-1 ring-inset ring-black/5 transition-transform group-hover:-translate-y-0.5 ${item.tone}`}\n              >\n                <Icon className=\"h-5 w-5\" aria-hidden=\"true\" />\n              </span>\n              <span className=\"text-[11px] font-semibold leading-tight text-slate-700\">\n                {item.label}\n              </span>\n            </motion.button>\n          );\n        })}\n      </div>\n    </section>\n  );\n}\n"
