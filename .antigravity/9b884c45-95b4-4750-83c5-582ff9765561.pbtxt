)    .getAttribute(\"aria-selected\");  const has113Tel = await page.locator(\"[data-testid=\\\"emergency-113-btn\\\"]\").getAttribute(\"href\");  const policeItemsCount = await page.locator(\"[data-testid^=\\\"police-station-item-\\\"]\").count();  const policeMarkersCount = await page.locator(\"[data-testid^=\\\"police-station-marker-\\\"]\").count();  const hasNearestBadge = await page.locator(\"[data-testid^=\\\"police-station-marker-\\\"]\").filter({ hasText: \"G\341\272\247n nh\341\272\245t\" }).count();  const firstPoliceText = await page.locator(\"[data-testid^=\\\"police-station-item-\\\"]\").first().innerText();  await page.screenshot({ path: \".playwright-cli/police-sheet.png\" });  // 2. Click \"\304\220\306\260\341\273\235ng \304\221i\" on station #2 (if >=2) then click a police marker in viewport for FloatingPlaceCard  if (policeItemsCount >= 2) {    await page.locator(\"[data-testid^=\\\"police-station-item-\\\"]\").nth(1).getByRole(\"button\", { name: /\304\220\306\260\341\273\235ng \304\221i/i }).click();    await page.waitForTimeout(1200);  }  const inViewportPoliceIdx = await page.evaluate(() => {    const els = Array.from(document.querySelectorAll(\"[data-testid^=\\\"police-station-marker-\\\"]\"));    return els.findIndex((el) => {      const r = el.getBoundingClientRect();      return r.left >= 10 && r.right <= 420 && r.top >= 110 && r.bottom <= 440;    });  });  await page.locator(\"[data-testid^=\\\"police-station-marker-\\\"]\").nth(Math.max(0, inViewportPoliceIdx)).click({ force: inViewportPoliceIdx < 0 });  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 8000 });  await page.waitForTimeout(900);  const floatingPoliceText = await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").innerText();  await page.screenshot({ path: \".playwright-cli/police-pin-card.png\" });  // 3. Close floating card and switch to \"T\341\272\245t c\341\272\243\" to confirm all 4 marker types co-exist  await page.locator(\"[data-testid=\\\"floating-place-card\\\"] button\").first().click();  await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").getByRole(\"tab\", { name: /^T\341\272\245t c\341\272\243$/i }).click();  await page.waitForTimeout(1800);  const allModePins = await page.evaluate(() => ({    police: document.querySelectorAll(\"[data-testid^=\\\"police-station-marker-\\\"]\").length,    repairShops: document.querySelectorAll(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").length,    gas: document.querySelectorAll(\"[data-testid^=\\\"gas-station-marker-\\\"]\").length,    safeOrStationButtons: document.querySelectorAll(\"button[aria-label*=\\\"ph\303\272t \304\221i b\341\273\231\\\"]\").length,  }));  await page.screenshot({ path: \".playwright-cli/map-all-4-layers.png\" });  return JSON.stringify({    policeChipSelected,    has113Tel,    policeItemsCount,    policeMarkersCount,    hasNearestBadge,    firstPoliceText: firstPoliceText.replace(/\\n+/g, \" | \"),    floatingPoliceText: floatingPoliceText.replace(/\\n+/g, \" | \"),    allModePins,  }, null, 2);})(page);```### Page- Page URL: http://localhost:3000/- Page Title: MotoSOS \342\200\224 C\341\273\251u h\341\273\231 xe m\303\241y & Tr\341\272\241m An To\303\240n 24/7### ResultTotal messages: 5 (Errors: 0, Warnings: 0)Returning 0 messages for level \"error\"\n\n### Latest snapshot (.playwright-cli/page-2026-11-14T11-13-17-618Z.yml)\n```yaml\n- generic [ref=e4]:\n  - main [ref=e5]:\n    - generic [ref=e7]:\n      - generic [ref=e8]:\n        - generic [ref=e9]:\n          - generic [ref=e10]:\n            - generic [ref=e11]:\n              - heading \"MotoSOS Priority\" [level=1] [ref=e12]\n              - generic [ref=e13]: 24/7 VIP Rescue\n            - button \"Trung t\303\242m Qu\341\272\255n 1, TP. H\341\273\223 Ch\303\255 Minh\" [ref=e17]\n          - button \"Test th\341\273\243\" [ref=e22]\n        - generic [ref=e24]:\n          - button \"B\341\272\241n \304\221ang g\341\272\267p