      arguments_json: "{\"CommandLine\":\"bash -c \'\\nset -e\\ntrap \\\"playwright-cli close >/dev/null 2>&1 || true\\\" EXIT\\nmkdir -p .playwright-cli\\n\\nplaywright-cli open http://localhost:3000 --browser=chromium >/dev/null\\nplaywright-cli resize 390 844 >/dev/null\\nsleep 4\\n\\nplaywright-cli eval \\\"() => {\\n  const aside = document.querySelector(\\\\\\\"aside\\\\\\\");\\n  const rect = aside ? aside.getBoundingClientRect() : null;\\n  const stationBtns = Array.from(document.querySelectorAll(\\\\\\\"[data-testid=rescue-map-canvas] button[aria-pressed]\\\\\\\"));\\n  const stationTexts = stationBtns.map(b => b.textContent.trim());\\n  const topBtn = document.querySelector(\\\\\\\"header button\\\\\\\");\\n  const topRect = topBtn ? topBtn.getBoundingClientRect() : null;\\n  return {\\n    viewportH: window.innerHeight,\\n    sheetH: rect ? Math.round(rect.height) : 0,\\n    sheetPct: rect ? Number(((rect.height / window.innerHeight) * 100).toFixed(1)) : 0,\\n    stationCount: stationBtns.length,\\n    stationTexts,\\n    topBtnH: topRect ? Math.round(topRect.height) : 0,\\n    hasHardcodedAddress: document.body.innerText.includes(\\\\\\\"182 \304\220i\341\273\207n Bi\303\252n Ph\341\273\247\\\\\\\"),\\n    idleText: aside ? aside.innerText.replace(/\\\\\\\\n+/g, \\\\\\\" | \\\\\\\") : \\\\\\\"\\\\\\\"\\n  };\\n}\\\"\\n\\nplaywright-cli screenshot --filename=.playwright-cli/r7-mobile-idle.png >/dev/null\\n\\n# Click first circular station marker on the map\\nplaywright-cli eval \\\"() => {\\n  const btn = document.querySelector(\\\\\\\"[data-testid=rescue-map-canvas] button[aria-pressed]\\\\\\\");\\n  if (btn) btn.click();\\n  return btn ? btn.getAttribute(\\\\\\\"aria-label\\\\\\\") : null;\\n}\\\"\\nsleep 1\\nplaywright-cli screenshot --filename=.playwright-cli/r7-mobile-station-tap.png >/dev/null\\n\\n# Click the quick pill button to jump straight to Step 2 Safe Stations + OSRM route\\nplaywright-cli eval \\\"() => {\\n  const btns = Array.from(document.querySelectorAll(\\\\\\\"aside button\\\\\\\"));\\n  const pill = btns.find(b => b.textContent.includes(\\\\\\\"T\303\254m Tr\341\272\241m An To\303\240n g\341\272\247n \304\221\303\242y\\\\\\\"));\\n  if (pill) pill.click();\\n  return Boolean(pill);\\n}\\\"\\nsleep 3\\nplaywright-cli screenshot --filename=.playwright-cli/r7-mobile-step2.png >/dev/null\\n\\n# Check Step 2 pickup address and click Test tho\\nplaywright-cli eval \\\"() => {\\n  const addr = document.querySelector(\\\\\\\"[data-testid=pickup-address]\\\\\\\")?.textContent;\\n  const demoBtn = Array.from(document.querySelectorAll(\\\\\\\"header button\\\\\\\")).find(b => b.textContent.includes(\\\\\\\"Test th\341\273\243\\\\\\\"));\\n  if (demoBtn) demoBtn.click();\\n  return { pickupAddress: addr, clickedDemo: Boolean(demoBtn) };\\n}\\\"\\nsleep 1\\nplaywright-cli screenshot --filename=.playwright-cli/r7-mobile-tracking.png >/dev/null\\n\\nplaywright-cli console\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying rendered UI in browser\", \"toolSummary\":\"Run browser verification\"}"
