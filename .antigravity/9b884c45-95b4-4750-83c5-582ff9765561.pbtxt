      arguments_json: "{\"CodeContent\":\"export type AppTab = \'home\' | \'map\' | \'activity\' | \'safety\';\\n\\nexport type IssueType =\\n  | \'flat_tire\'\\n  | \'engine_dead\'\\n  | \'out_of_fuel\'\\n  | \'battery_jump\'\\n  | \'other\';\\n\\nexport type SafeStationCategory = \'convenience\' | \'gas_station\' | \'police\';\\n\\nexport type PickupMode = \'current_location\' | \'safe_station\';\\n\\nexport type RescueStep = \'idle\' | \'issue\' | \'pickup\' | \'tracking\';\\n\\nexport type TrackingStatus = \'searching\' | \'accepted\' | \'completed\';\\n\\nexport type VoucherId = \'ANTOAN20\' | \'DEMKHUYA15\' | \'BANMOI25\';\\n\\nexport interface GeoCoord {\\n  lat: number;\\n  lng: number;\\n}\\n\\nexport interface SafeStation {\\n  id: string;\\n  name: string;\\n  category: SafeStationCategory;\\n  categoryLabel: string;\\n  address: string;\\n  walkingDistanceMeters: number;\\n  walkingMinutes: number;\\n  openHours: string;\\n  amenities: string[];\\n  coord: GeoCoord;\\n}\\n\\nexport interface IssueOption {\\n  id: IssueType;\\n  label: string;\\n  subtitle: string;\\n  fixedPrice: number;\\n}\\n\\nexport interface VoucherOption {\\n  id: VoucherId;\\n  code: VoucherId;\\n  title: string;\\n  description: string;\\n  discountAmount: number;\\n  requiresSafeStation: boolean;\\n}\\n\\nexport interface OrderPricing {\\n  basePrice: number;\\n  discountAmount: number;\\n  finalPrice: number;\\n  appliedVoucher: VoucherOption | null;\\n}\\n\\nexport interface ChatMessage {\\n  id: string;\\n  sender: \'user\' | \'mechanic\';\\n  text: string;\\n  timestampLabel: string;\\n}\\n\\nexport interface MechanicInfo {\\n  id: string;\\n  name: string;\\n  phone: string;\\n  licensePlate: string;\\n  vehicleModel: string;\\n  rating: number;\\n  completedRescues: number;\\n  etaMinutes: number;\\n  distanceKm: number;\\n  coord: GeoCoord;\\n}\\n\\nexport interface UserLocation {\\n  address: string;\\n  district: string;\\n  coord: GeoCoord;\\n  source: \'gps\' | \'fallback\';\\n}\\n\\nexport interface GeoJsonLineString {\\n  type: \'LineString\';\\n  coordinates: [number, number][];\\n}\\n\\nexport interface RescueActivityItem {\\n  id: string;\\n  issueLabel: string;\\n  pickupAddress: string;\\n  mechanicName: string;\\n  licensePlate: string;\\n  timestampLabel: string;\\n  priceLabel?: string;\\n  status: \'completed\' | \'cancelled\';\\n}\\n\", \"Description\":\"Add fixed pricing, voucher, order pricing, and mechanic chat types to rescue domain model\", \"Overwrite\":true, \"TargetFile\":\"/src/types/rescue.ts\", \"toolAction\":\"Updating rescue TypeScript interfaces\", \"toolSummary\":\"Update src/types/rescue.ts\"}"
