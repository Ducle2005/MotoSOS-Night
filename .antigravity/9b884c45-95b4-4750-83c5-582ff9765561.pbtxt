      arguments_json: "{\"Description\":\"Add isLocationSearchOpen state and clear stale inspections on location change in useRescueOrderState\", \"Instruction\":\"Add isLocationSearchOpen state, handleSelectSearchLocation, and handleResetToGpsLocation while staying under 250 lines\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":16, \"ReplacementContent\":\"import type {\\n  AppTab,\\n  IssueType,\\n  LocationSuggestion,\\n  PickupMode,\\n  RescueActivityItem,\\n  RescueStep,\\n  SafeStation,\\n  SafeStationCategory,\\n  TrackingStatus,\\n  VoucherId,\\n} from \'../types/rescue\';\", \"StartLine\":10, \"TargetContent\":\"import type {\\n  AppTab,\\n  IssueType,\\n  PickupMode,\\n  RescueActivityItem,\\n  RescueStep,\\n  SafeStation,\\n  SafeStationCategory,\\n  TrackingStatus,\\n  VoucherId,\\n} from \'../types/rescue\';\"}, {\"AllowMultiple\":false, \"EndLine\":55, \"ReplacementContent\":\"  const [isLocationSearchOpen, setIsLocationSearchOpen] = useState(false);\\n  const [activityHistory, setActivityHistory] = useState<RescueActivityItem[]>(\\n    INITIAL_ACTIVITY_HISTORY,\\n  );\\n  const [activeStationForRoute, setActiveStationForRoute] =\\n    useState<SafeStation | null>(null);\", \"StartLine\":49, \"TargetContent\":\"  const [activityHistory, setActivityHistory] = useState<RescueActivityItem[]>(\\n    INITIAL_ACTIVITY_HISTORY,\\n  );\\n  const [activeStationForRoute, setActiveStationForRoute] =\\n    useState<SafeStation | null>(null);\"}, {\"AllowMultiple\":false, \"EndLine\":247, \"ReplacementContent\":\"  const handleSelectSearchLocation = (item: LocationSuggestion) => {\\n    setInspectedStationId(null);\\n    repairShops.selectShop(null);\\n    geo.selectSearchedLocation(item);\\n  };\\n\\n  const handleResetToGpsLocation = async () => {\\n    setInspectedStationId(null);\\n    repairShops.selectShop(null);\\n    await geo.useCurrentGpsLocation();\\n  };\\n\\n  return {\\n    activeTab, setActiveTab, step, setStep,\\n    selectedIssue, setSelectedIssue, customNote, setCustomNote,\\n    pickupMode, handleChangePickupMode, selectedVoucherId, setSelectedVoucherId,\\n    selectedStationId, setSelectedStationId, inspectedStationId, setInspectedStationId,\\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\\n    isLocationSearchOpen, setIsLocationSearchOpen,\\n    recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\\n    activityHistory, geo, repairShops, pickupTarget, issueSummary, pricing, mechanicSim,\\n    handleResetFlow, handleCompleteAndLog, handleConfirmRescue, handleDemoAdvance,\\n    handleMechanicArrived, handleOpenMapWithStation, handleOpenMapWithRepairShop,\\n    handleQuickCategory, handleQuickIssue, handleQuickSos,\\n    handleSelectSearchLocation, handleResetToGpsLocation,\\n  };\\n}\", \"StartLine\":230, \"TargetContent\":\"  return {\\n    activeTab, setActiveTab, step, setStep,\\n    selectedIssue, setSelectedIssue, customNote, setCustomNote,\\n    pickupMode, handleChangePickupMode, selectedVoucherId, setSelectedVoucherId,\\n    selectedStationId, setSelectedStationId, inspectedStationId, setInspectedStationId,\\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\\n    recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\\n    activityHistory, geo, repairShops, pickupTarget, issueSummary, pricing, mechanicSim,\\n    handleResetFlow, handleCompleteAndLog, handleConfirmRescue, handleDemoAdvance,\\n    handleMechanicArrived, handleOpenMapWithStation, handleOpenMapWithRepairShop,\\n    handleQuickCategory, handleQuickIssue, handleQuickSos,\\n  };\\n}\"}], \"TargetFile\":\"/src/hooks/useRescueOrderState.ts\", \"toolAction\":\"Adding location search modal state to useRescueOrderState\", \"toolSummary\":\"Update useRescueOrderState\"}"
