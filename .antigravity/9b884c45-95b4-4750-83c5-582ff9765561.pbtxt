  code_action {
    action_spec {
      create_file {
        instruction: "import { Marker, type Map as MapLibreMap } from \'maplibre-gl\';\nimport { useEffect, useRef, type MutableRefObject } from \'react\';\nimport { fitMapBoundsSafely, setRouteSourceGeometry } from \'../components/map/mapLayers\';\nimport {\n  createGasStationMarkerElement,\n  createPoliceStationMarkerElement,\n  createRepairShopMarkerElement,\n  createStationMarkerElement,\n} from \'../components/map/mapMarkers\';\nimport type {\n  GasStation, GeoCoord, GeoJsonLineString, InspectedPlace,\n  MapLayerFilter, PickupMode, PoliceStation, RepairShop, RescueStep, SafeStation,\n} from \'../types/rescue\';\nimport { computeBoundsBox } from \'../utils/rescueLogic\';\n\ninterface UseMapMarkersSyncParams {\n  mapRef: MutableRefObject<MapLibreMap | null>;\n  containerRef: MutableRefObject<HTMLDivElement | null>;\n  mapReady: boolean;\n  userCoord: GeoCoord;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  policeStations: PoliceStation[];\n  selectedStationId: string | null;\n  selectedPoliceStationId: string | null;\n  inspectedPlace: InspectedPlace | null;\n  inspectRoute: GeoJsonLineString | null;\n  walkingRoute: GeoJsonLineString | null;\n  gasRoute: GeoJsonLineString | null;\n  policeRoute: GeoJsonLineString | null;\n  mapFilter: MapLayerFilter;\n  step: RescueStep;\n  pickupMode: PickupMode;\n  onInspectPlace: (place: InspectedPlace) => void;\n  onSelectStation: (stationId: string) => void;\n  onSelectGasStation: (stationId: string | null) => void;\n  onSelectPoliceStation: (stationId: string | null) => void;\n}\n\nexport function useMapMarkersSync(params: UseMapMarkersSyncParams) {\n  const {\n    mapRef, containerRef, mapReady, userCoord, stations, openRepairShops,\n    gasStations, policeStations, selectedStationId, selectedPoliceStationId,\n    inspectedPlace, inspectRoute, walkingRoute, gasRoute, policeRoute,\n    mapFilter, step, pickupMode, onInspectPlace, onSelectStation,\n    onSelectGasStation, onSelectPoliceStation,\n  } = params;\n  const stationMarkersRef = useRef<Marker[]>([]);\n  const repairShopMarkersRef = useRef<Marker[]>([]);\n  const gasMarkersRef = useRef<Marker[]>([]);\n  const policeMarkersRef = useRef<Marker[]>([]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n    stationMarkersRef.current.forEach((m) => m.remove());\n    if (!(step === \'tracking\' || mapFilter === \'all\' || mapFilter === \'safe_stations\')) {\n      stationMarkersRef.current = [];\n      return;\n    }\n    stationMarkersRef.current = stations.map((station) => {\n      const isHighlighted =\n        (inspectedPlace?.kind === \'safe_station\' && inspectedPlace.station.id === station.id) ||\n        (selectedStationId === station.id && (step === \'pickup\' || step === \'tracking\') && pickupMode === \'safe_station\');\n      const el = createStationMarkerElement(station, isHighlighted, () => {\n        onSelectStation(station.id);\n        onInspectPlace({ kind: \'safe_station\', station });\n      });\n      return new Marker({ element: el, anchor: \'center\' }).setLngLat([station.coord.lng, station.coord.lat]).addTo(map);\n    });\n  }, [mapReady, stations, selectedStationId, inspectedPlace, step, pickupMode, mapFilter]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n    repairShopMarkersRef.current.forEach((m) => m.remove());\n    if (!(step !== \'tracking\' && (mapFilter === \'all\' || mapFilter === \'repair_shops\'))) {\n      repairShopMarkersRef.current = [];\n      return;\n    }\n    repairShopMarkersRef.current = openRepairShops.map((shop) => {\n      const isHighlighted = inspectedPlace?.kind === \'repair_shop\' && inspectedPlace.shop.id === shop.id;\n      const el = createRepairShopMarkerElement(shop, isHighlighted, () => onInspectPlace({ kind: \'repair_shop\', shop }));\n      return new Marker({ element: el, anchor: \'center\' }).setLngLat([shop.coord.lng, shop.coord.lat]).addTo(map);\n    });\n  }, [mapReady, openRepairShops, inspectedPlace, mapFilter, step]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n    gasMarkersRef.current.forEach((m) => m.remove());\n    if (!(step !== \'tracking\' && (mapFilter === \'all\' || mapFilter === \'gas_stations\'))) {\n      gasMarkersRef.current = [];\n      return;\n    }\n    const visibleGas = mapFilter === \'all\' ? gasStations.slice(0, 4) : gasStations;\n    gasMarkersRef.current = visibleGas.map((station) => {\n      const isHighlighted = inspectedPlace?.kind === \'gas_station\' && inspectedPlace.gasStation.id === station.id;\n      const el = createGasStationMarkerElement(station, isHighlighted, () => {\n        onSelectGasStation(station.id);\n        onInspectPlace({ kind: \'gas_station\', gasStation: station });\n      });\n      return new Marker({ element: el, anchor: \'center\' }).setLngLat([station.coord.lng, station.coord.lat]).addTo(map);\n    });\n  }, [mapReady, gasStations, inspectedPlace, mapFilter, step]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n    policeMarkersRef.current.forEach((m) => m.remove());\n    if (!(step !== \'tracking\' && (mapFilter === \'all\' || mapFilter === \'police_stations\'))) {\n      policeMarkersRef.current = [];\n      return;\n    }\n    const visiblePolice = mapFilter === \'all\' ? policeStations.slice(0, 4) : policeStations;\n    policeMarkersRef.current = visiblePolice.map((station) => {\n      const isHighlighted =\n        (inspectedPlace?.kind === \'police_station\' && inspectedPlace.policeStation.id === station.id) ||\n        (mapFilter === \'police_stations\' && selectedPoliceStationId === station.id);\n      const el = createPoliceStationMarkerElement(station, isHighlighted, () => {\n        onSelectPoliceStation(station.id);\n        onInspectPlace({ kind: \'police_station\', policeStation: station });\n      });\n      return new Marker({ element: el, anchor: \'center\' }).setLngLat([station.coord.lng, station.coord.lat]).addTo(map);\n    });\n  }, [mapReady, policeStations, selectedPoliceStationId, inspectedPlace, mapFilter, step]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n    const inspectKind = inspectedPlace?.kind ?? null;\n    const activeWalk = step === \'tracking\' ? walkingRoute : inspectKind === \'safe_station\' ? (inspectRoute ?? walkingRoute) : walkingRoute;\n    const activeShop = step !== \'tracking\' && inspectKind === \'repair_shop\' ? inspectRoute : null;\n    const activeGas = step !== \'tracking\' && inspectKind === \'gas_station\' ? (inspectRoute ?? gasRoute) : step === \'idle\' && mapFilter === \'gas_stations\' ? gasRoute : null;\n    const activePolice = step !== \'tracking\' && inspectKind === \'police_station\' ? (inspectRoute ?? policeRoute) : step === \'idle\' && mapFilter === \'police_stations\' ? policeRoute : null;\n\n    setRouteSourceGeometry(map, \'walking-route\', activeWalk);\n    setRouteSourceGeometry(map, \'shop-route\', activeShop);\n    setRouteSourceGeometry(map, \'gas-route\', activeGas);\n    setRouteSourceGeometry(map, \'police-route\', activePolice);\n\n    if (step === \'tracking\') return;\n    const routeToFit =\n      (inspectKind === \'repair_shop\' ? activeShop :\n        inspectKind === \'gas_station\' ? activeGas :\n        inspectKind === \'police_station\' ? activePolice :\n        inspectKind === \'safe_station\' ? activeWalk :\n        activePolice ?? activeGas ?? activeWalk) ?? null;\n    if (!routeToFit) return;\n    const bounds = computeBoundsBox(routeToFit.coordinates);\n    if (bounds) fitMapBoundsSafely(map, containerRef.current, bounds, 16.2, 600);\n  }, [inspectedPlace, inspectRoute, walkingRoute, gasRoute, policeRoute, mapFilter, step, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady || step === \'tracking\' || inspectRoute || gasRoute || policeRoute) return;\n\n    const addBounds = (pts: [number, number][], maxZoom = 15.0) => {\n      if (pts.length > 1) {\n        const bounds = computeBoundsBox(pts);\n        if (bounds) fitMapBoundsSafely(map, containerRef.current, bounds, maxZoom, 550);\n      }\n    };\n\n    if (mapFilter === \'all\') {\n      addBounds([\n        [userCoord.lng, userCoord.lat],\n        ...stations.slice(0, 2).map((s): [number, number] => [s.coord.lng, s.coord.lat]),\n        ...openRepairShops.slice(0, 2).map((s): [number, number] => [s.coord.lng, s.coord.lat]),\n        ...gasStations.slice(0, 2).map((g): [number, number] => [g.coord.lng, g.coord.lat]),\n        ...policeStations.slice(0, 2).map((p): [number, number] => [p.coord.lng, p.coord.lat]),\n      ]);\n      return;\n    }\n    if (mapFilter === \'repair_shops\') addBounds([[userCoord.lng, userCoord.lat], ...openRepairShops.slice(0, 5).map((s): [number, number] => [s.coord.lng, s.coord.lat])]);\n    if (mapFilter === \'gas_stations\') addBounds([[userCoord.lng, userCoord.lat], ...gasStations.slice(0, 5).map((g): [number, number] => [g.coord.lng, g.coord.lat])], 15.2);\n    if (mapFilter === \'police_stations\') addBounds([[userCoord.lng, userCoord.lat], ...policeStations.slice(0, 5).map((p): [number, number] => [p.coord.lng, p.coord.lat])], 15.2);\n  }, [mapFilter, step, mapReady, stations, openRepairShops, gasStations, policeStations, inspectRoute, gasRoute, policeRoute, userCoord.lat, userCoord.lng]);\n\n  return {\n    clearAllMarkers: () => {\n      stationMarkersRef.current.forEach((m) => m.remove()); stationMarkersRef.current = [];\n      repairShopMarkersRef.current.forEach((m) => m.remove()); repairShopMarkersRef.current = [];\n      gasMarkersRef.current.forEach((m) => m.remove()); gasMarkersRef.current = [];\n      policeMarkersRef.current.forEach((m) => m.remove()); policeMarkersRef.current = [];\n    },\n  };\n}\n"
        path {
          absolute_uri: "file:///src/hooks/useMapMarkersSync.ts"
        }
        overwrite: true
      }
    }
