  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  ArrowLeft,\n  ArrowRight,\n  CircleDot,\n  Fuel,\n  HelpCircle,\n  Wrench,\n} from \'lucide-react\';\nimport type { IssueOption, IssueType } from \'../../types/rescue\';\n\ninterface IssueSelectionStepProps {\n  options: IssueOption[];\n  selectedIssue: IssueType | null;\n  customNote: string;\n  onSelectIssue: (issue: IssueType) => void;\n  onChangeNote: (note: string) => void;\n  onBack: () => void;\n  onContinue: () => void;\n}\n\nfunction getIssueIcon(id: IssueType) {\n  if (id === \'flat_tire\') return CircleDot;\n  if (id === \'engine_dead\') return Wrench;\n  if (id === \'out_of_fuel\') return Fuel;\n  return HelpCircle;\n}\n\nexport function IssueSelectionStep({\n  options,\n  selectedIssue,\n  customNote,\n  onSelectIssue,\n  onChangeNote,\n  onBack,\n  onContinue,\n}: IssueSelectionStepProps) {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div>\n        <h1 className=\"text-lg font-bold tracking-tight text-slate-50\">\n          Xe b\341\272\241n \304\221ang g\341\272\267p s\341\273\261 c\341\273\221 g\303\254?\n        </h1>\n        <p className=\"mt-1 text-sm text-slate-400\">\n          Ch\341\273\215n nhanh t\303\254nh tr\341\272\241ng xe \304\221\341\273\203 \304\221i\341\273\201u ph\341\273\221i th\341\273\243 mang \304\221\303\272ng \304\221\341\273\223 ngh\341\273\201.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-2.5\" role=\"radiogroup\" aria-label=\"Lo\341\272\241i s\341\273\261 c\341\273\221 xe m\303\241y\">\n        {options.map((option) => {\n          const Icon = getIssueIcon(option.id);\n          const active = selectedIssue === option.id;\n\n          return (\n            <button\n              key={option.id}\n              type=\"button\"\n              role=\"radio\"\n              aria-checked={active}\n              onClick={() => onSelectIssue(option.id)}\n              className={`flex min-h-[96px] flex-col justify-between rounded-2xl border p-3.5 text-left transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 active:scale-[0.98] ${\n                active\n                  ? \'border-amber-400 bg-amber-500/15 text-slate-50\'\n                  : \'border-slate-800 bg-slate-950/60 text-slate-200 hover:border-slate-700 hover:bg-slate-800/60\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between gap-2\">\n                <span\n                  className={`flex h-9 w-9 items-center justify-center rounded-xl ${\n                    active\n                      ? \'bg-amber-500 text-slate-950\'\n                      : \'bg-slate-800 text-slate-300\'\n                  }`}\n                >\n                  <Icon className=\"h-4 w-4\" aria-hidden=\"true\" />\n                </span>\n              </div>\n\n              <div className=\"mt-2.5\">\n                <p className=\"text-sm font-bold text-slate-100\">{option.label}</p>\n                <p className=\"mt-0.5 line-clamp-2 text-xs text-slate-400\">\n                  {option.subtitle}\n                </p>\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {selectedIssue && (\n        <div className=\"rounded-2xl border border-slate-800 bg-slate-950/50 p-3\">\n          <label\n            htmlFor=\"issue-note-input\"\n            className=\"block text-xs font-medium text-slate-300\"\n          >\n            {selectedIssue === \'other\'\n              ? \'M\303\264 t\341\272\243 ng\341\272\257n s\341\273\261 c\341\273\221 (t\303\271y ch\341\273\215n)\'\n              : \'Ghi ch\303\272 th\303\252m cho th\341\273\243 (t\303\271y ch\341\273\215n)\'}\n          </label>\n          <input\n            id=\"issue-note-input\"\n            type=\"text\"\n            value={customNote}\n            onChange={(e) => onChangeNote(e.target.value)}\n            placeholder={\n              selectedIssue === \'other\'\n                ? \'V\303\255 d\341\273\245: \304\220\341\273\251t s\303\252n, k\341\272\271t kh\303\263a c\341\273\225...\'\n                : \'V\303\255 d\341\273\245: Xe tay ga Vision m\303\240u \304\221en...\'\n            }\n            className=\"mt-1.5 min-h-[44px] w-full rounded-xl border border-slate-800 bg-slate-900 px-3 text-sm text-slate-100 placeholder:text-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500\"\n          />\n        </div>\n      )}\n\n      <div className=\"flex items-center gap-2.5 pt-1\">\n        <button\n          type=\"button\"\n          onClick={onBack}\n          className=\"inline-flex min-h-[48px] items-center justify-center gap-1.5 rounded-xl border border-slate-800 bg-slate-950 px-4 text-sm font-semibold text-slate-300 transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400\"\n        >\n          <ArrowLeft className=\"h-4 w-4\" aria-hidden=\"true\" />\n          <span>Quay l\341\272\241i</span>\n        </button>\n\n        <button\n          type=\"button\"\n          disabled={!selectedIssue}\n          onClick={onContinue}\n          className=\"inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-xl bg-amber-500 px-5 text-sm font-bold text-slate-950 transition-all hover:bg-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 disabled:cursor-not-allowed disabled:bg-slate-800 disabled:text-slate-500 active:scale-[0.98]\"\n        >\n          <span>Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 th\341\273\243</span>\n          <ArrowRight className=\"h-4 w-4\" aria-hidden=\"true\" />\n        </button>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/IssueSelectionStep.tsx"
        }
        overwrite: true
      }
    }
