    command_line: "trap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\nmkdir -p .playwright-cli\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 430 900 && \\\nplaywright-cli run-code \'async (page) => {\n  await page.waitForTimeout(2200);\n\n  // Test A: Home tab nearby repair shops with phone + 1-tap call + Directions\n  const firstShop = page.locator(\"[data-testid^=\\\"home-repair-shop-\\\"]\").first();\n  await firstShop.scrollIntoViewIfNeeded();\n  await page.waitForTimeout(300);\n  const homeTelCount = await page.locator(\"[data-testid^=\\\"home-repair-shop-\\\"] a[href^=\\\"tel:\\\"]\").count();\n  const firstShopText = await firstShop.innerText();\n\n  // Click \"\304\220\306\260\341\273\235ng \304\221i\" on the first Home repair shop -> opens Map tab, draws route, opens FloatingPlaceCard\n  await firstShop.getByRole(\"button\", { name: /\304\220\306\260\341\273\235ng \304\221i/i }).click();\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 10000 });\n  await page.waitForTimeout(1400);\n  const cardTextFromHome = await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").innerText();\n\n  // Test B: Close FloatingPlaceCard -> click \"T\341\272\245t c\341\272\243\" tab -> verify all 3 marker layers in viewport -> click repair shop pin\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"] button\").first().click();\n  await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").getByRole(\"tab\", { name: /^T\341\272\245t c\341\272\243$/i }).click();\n  await page.waitForTimeout(2500);\n\n  const safePins = await page.locator(\"[data-testid^=\\\"station-marker-\\\"]\").count();\n  const shopPins = await page.locator(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").count();\n  const gasPins = await page.locator(\"[data-testid^=\\\"gas-station-marker-\\\"]\").count();\n\n  const inViewportShopIndex = await page.evaluate(() => {\n    const els = Array.from(document.querySelectorAll(\"[data-testid^=\\\"repair-shop-marker-\\\"]\"));\n    return els.findIndex((el) => {\n      const r = el.getBoundingClientRect();\n      return r.left >= 10 && r.right <= 420 && r.top >= 110 && r.bottom <= 560;\n    });\n  });\n\n  if (inViewportShopIndex >= 0) {\n    await page.locator(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").nth(inViewportShopIndex).click();\n  } else {\n    await page.locator(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").first().click({ force: true });\n  }\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 10000 });\n  await page.waitForTimeout(1400);\n  await page.screenshot({ path: \".playwright-cli/verify-map-all.png\" });\n\n  // Close floating card before Step 1/2 flow\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"] button\").first().click();\n  await page.waitForTimeout(300);\n\n  // Test C: Idle -> Step 1 -> Step 2 (check filter chips, Step 2 list vs invoice non-overlap, call & route, collapse sheet)\n  await page.getByRole(\"button\", { name: /G\341\273\214I S\341\273\254A XE KH\341\272\250N C\341\272\244P/i }).click();\n  await page.waitForTimeout(400);\n  const chipsOnStep1 = await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").isVisible();\n\n  await page.getByText(\"L\341\273\247ng l\341\273\221p\", { exact: false }).first().click();\n  await page.waitForTimeout(200);\n  await page.getByRole(\"button\", { name: /Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 th\341\273\243/i }).click();\n  await page.locator(\"[data-testid=\\\"step2-place-list\\\"]\").waitFor({ state: \"visible\", timeout: 8000 });\n  await page.waitForTimeout(500);\n\n  const chipsOnStep2 = await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").isVisible();\n  const layoutMetrics = await page.evaluate(() => {\n    const list = document.querySelector(\"[data-testid=\\\"step2-place-list\\\"]\")?.getBoundingClientRect();\n    const btn = document.querySelector(\"[data-testid=\\\"confirm-order-btn\\\"]\")?.getBoundingClientRect();\n    const listTelCount = document.querySelectorAll(\"[data-testid=\\\"step2-place-list\\\"] a[href^=\\\"tel:\\\"]\").length;\n    return {\n      listTop: list ? Math.round(list.top) : null,\n      listBottom: list ? Math.round(list.bottom) : null,\n      listHeight: list ? Math.round(list.height) : null,\n      btnTop: btn ? Math.round(btn.top) : null,\n      gapPx: list && btn ? Math.round(btn.top - list.bottom) : null,\n      listTelCount\n    };\n  });\n  await page.screenshot({ path: \".playwright-cli/verify-step2-list.png\" });\n\n  // Click \"\304\220\306\260\341\273\235ng \304\221i\" on a Step 2 list item, then collapse Bottom Sheet to confirm map + route + floating card visible\n  await page.locator(\"[data-testid=\\\"step2-place-list\\\"]\").getByRole(\"button\", { name: /\304\220\306\260\341\273\235ng \304\221i/i }).first().click();\n  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 10000 });\n  await page.waitForTimeout(1200);\n  await page.locator(\"[data-testid=\\\"toggle-sheet-btn\\\"]\").click();\n  await page.waitForTimeout(450);\n  const collapsedCardVisible = await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").isVisible();\n  await page.screenshot({ path: \".playwright-cli/verify-step2-collapsed.png\" });\n\n  return JSON.stringify({\n    homeTelCount,\n    firstShopText: firstShopText.replace(/\\n+/g, \" | \"),\n    cardTextFromHome: cardTextFromHome.replace(/\\n+/g, \" | \"),\n    pinsInAllMode: { safePins, shopPins, gasPins, inViewportShopIndex },\n    chipsOnStep1,\n    chipsOnStep2,\n    layoutMetrics,\n    collapsedCardVisible\n  }, null, 2);\n}\' && \\\nplaywright-cli console error"
