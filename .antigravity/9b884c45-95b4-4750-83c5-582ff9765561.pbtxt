      thinking_signature: "\022\331\f\n\326\f\001i\024}\023\363\253c\'\366\005h\270*\317\304\351\256O\315\035\377\360\323\247\2722\2007\243\366\343\212\035W\242\021\323\246[\224\244\344\371!\000\t\023\271\r\'=\374\361+\334\226-Y~\311T,\277\241\b0/\342\352$\032K\277\267+\347C=wo\313\257\210k1p\203T\231U_\343rS\204\355\027$\307\220~R\220\\\211\006\375\f\353\177\022\242\030\242\323F?\337\374\307\326 \035\276?X\000\3066\006l\252)a\021\253\320@T\216\264\3243\240\221\362\244\031\230\367\324\212u\243Y0\243\v\266\244<\032\235VI\363\2375\a\260\257\\n\036\034\3050\\\344\324\243\373\234q\260\025\036\335<*\324HG\231\314KkJ\214\037:\353Lz\326\035X!F3\031\017\257\376\231\326\342&\226\3338\343a\\oq\\\2037z\260\346|S\316C\362\314\211\035Y\244\374r\036RP\270\226\205\t\302O\344IRj\002\251\204q=)km!1\272^\252o\330\304\360>\200\215\320\2577\270\021L\335\313\021%z\254\366\340\267\a\257\3329\377\202\026\021\311\252;,\265\201\366\001\177\n+b\373\274\376\270\371\264\311!i\345\227\311\277\213#\357\246\204$\036\214\264`KI\227|\337\307P|\231A\a\371\334\240\334\205\302\201np\b\331\322\215\r\250H\333\341\256\020\304\333\347.\342A\344`\333\206{\346\245\374)\325\255\2709\005\265-\247\177Yn\321.~\350G\312\326dn\270\316\255u!\036\2200=\'\023\254I\004\3459\332ow?\307\326\201.\204\203>1\315\243&\351\237\r\352sl<#\n\315\337\210\272\334\264D\251\361T\373\203E`\217\340\342\231\210\371If\026\365\344Aw\365\303\244\310R\n\361\344\276\343\363\313g \351\275Ye\242\216\305\336\231k\315f\177%\246q\261L?\023\231q\362\335\224\321#<\025\330\026\331\332vd\234\335--\227\"\222\235f\214\345@\032\252wV$T\270\324\2402\3736Xs\215A\246\212{\206X\033~\256\200*\204\210\243\317\227\225 \200\306\027\253kw\177\333<\363\376O\347Me\352oK\352}Y\bkxk8\352\307\365:\253\310\250\352\376\210\244g\224\360j\311=7\215gvM\332[m\277\226\313u\320\243m\362\"N\314\332\206\333\327\177l\242\257\234k\354\223S\222\336\340\244\376\234g,\005\b2Ix\226\222\340D\t\350\242\3144\341g\304\302U\336\177,\'\214\342\021\240d\303\243\221\320D\r,\0000\241\362\331\245V\026\314!\373\026\021mj\216\324\n\252x\006{\232U\333_T\367.\352\335\004y\217\2223\363\316d\271\261\373\310\020|\2748\253@?@\266\211\360\377\317_\217\316\246x{\354\371n{\v\241\"+\325<0\031\333v}\026\231\270N\030\355+\b\024\316\002\003}\324\235\267\256\266K\241\221\033=\313\206\021\211\370/cV\227\305\254\224S\253\324\214h>=Dt\032\203\254\373Dn\r\b\365\266\314k\256\300\203\355\027~\273\234Q\346d\217\263*\302\234\342\3403\223L\232\276\212\321<\313\365\\\225\305\352X\246\274B\214\0061\214\fK\241\365\333\204\327\345\030T\327\323\234\323u\212\253\006Qb\256\202\264E\f\354\r\037\203es\nM\033\225WO\2461\200~\351\247\330\212^A\355V.\214\247\213{W^\234\177<\263\273)\314\366\203e\270\360\242/\320\035\243(\033\376\353\334\024+\26537\246\322\236Re\027u\244c\230\325Za\331u\201\326dQ\tF\006\rJ\324r\026\237\be\305\336_\255\272 \214\377|\v\032rC\315\276b\243\217\234\263T\354\321\264\243M\030\264\036\331.\002\352a\276xj\234cD\332\313M4S\036\024\267H\217\037X\364\255\024\230M\233K\366\320\354\006\363a2\272\036S\335\006\035KC\006\260\f\311\241\204`O\3039\031\f\357\377\220\315\224j\361\215)am>\334\246\303| \026q\242kw\025\273\360>\212\266\264(X\241\b\271\v\320\375\001\\\216\001\345I\276_\215\372\341\223\335\375\323p\216\345r\327\276{M\355\344\217&4\000u\362n0\275\347@R)\275\334\037\252\276\226\327\327c\347\2623\243\314\337\022\222\3710uA\036>\275A\277\201\311\335\377Z\335\271|\327\266i\274\177R^\337\276\365\236\350\373B@>`\375\346\300\325\3212\370\253\036L\260:\222\277\201\346\203\252\033\216\264\361\302}\372\350F\245Y\233rj\202\360\312\036\325\222Y4+pN\022\314H\353\272\303\377\351\253)\377\245_\302\020\253\264\243SB\266\233\342WV\212\201\200A\264\t\037\026\265\205\240^\200\204\033W\023gQ\345\230\021Y\332\333lm\300f~\355\270\256\312\316\030\t\366\327u\354\317\3170Q\fM\306\274\031\210\365\305\330e\t|\330\342dQJ\327\256\002\026\375\216\306\300q\f)\237\270v&o\366\316\364\025\r^\327pFI\232!\234X\223\264\377.\034\030I\006\271\246\232N\030?U\235\0048\f\017\025\307\262\334\225-\177p\027\