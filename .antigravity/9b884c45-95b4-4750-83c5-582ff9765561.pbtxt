  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  ExternalLink,\n  Loader2,\n  MapPin,\n  Navigation,\n  Phone,\n  Wrench,\n  X,\n} from \'lucide-react\';\nimport { useEffect, useState } from \'react\';\nimport type { RepairShop } from \'../../types/rescue\';\nimport {\n  buildGoogleMapsSearchUrl,\n  formatShopDistanceLabel,\n} from \'../../utils/repairShopApi\';\n\ninterface RepairShopDetailSheetProps {\n  shop: RepairShop;\n  hasActiveRoute: boolean;\n  routeSummary: { distanceMeters: number; durationMinutes: number } | null;\n  isLoadingRoute: boolean;\n  onNavigate: () => void;\n  onClose: () => void;\n}\n\nexport function RepairShopDetailSheet({\n  shop,\n  hasActiveRoute,\n  routeSummary,\n  isLoadingRoute,\n  onNavigate,\n  onClose,\n}: RepairShopDetailSheetProps) {\n  const [callNotice, setCallNotice] = useState(false);\n\n  useEffect(() => {\n    setCallNotice(false);\n  }, [shop.id]);\n\n  const distanceText = routeSummary\n    ? formatShopDistanceLabel(routeSummary.distanceMeters, routeSummary.durationMinutes)\n    : formatShopDistanceLabel(shop.distanceMeters, shop.rideMinutes);\n\n  return (\n    <div\n      data-testid=\"repair-shop-detail-sheet\"\n      className=\"flex flex-col gap-3 px-5 pt-1 pb-5\"\n    >\n      <div className=\"flex items-start justify-between gap-2\">\n        <div className=\"flex min-w-0 items-start gap-3\">\n          <span className=\"mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 ring-1 ring-inset ring-blue-200/70\">\n            <Wrench className=\"h-5 w-5\" aria-hidden=\"true\" />\n          </span>\n\n          <div className=\"min-w-0\">\n            <h2 className=\"truncate text-base font-extrabold tracking-tight text-slate-900\">\n              {shop.name}\n            </h2>\n            <div className=\"mt-1 flex flex-wrap items-center gap-1.5\">\n              <span className=\"inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200 whitespace-nowrap\">\n                <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-500\" />\n                {shop.openStatusLabel}\n              </span>\n              <span className=\"font-sans text-xs font-semibold tabular-nums text-slate-600 whitespace-nowrap\">\n                {distanceText}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={onClose}\n          aria-label=\"\304\220\303\263ng th\303\264ng tin ti\341\273\207m s\341\273\255a xe\"\n          className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-700\"\n        >\n          <X className=\"h-4 w-4\" aria-hidden=\"true\" />\n        </button>\n      </div>\n\n      <div className=\"flex items-center justify-between gap-2 rounded-2xl border border-slate-100 bg-slate-50/80 px-3.5 py-2.5 text-xs text-slate-600\">\n        <div className=\"flex min-w-0 items-center gap-2\">\n          <MapPin className=\"h-3.5 w-3.5 shrink-0 text-blue-600\" aria-hidden=\"true\" />\n          <span className=\"truncate\">{shop.address}</span>\n        </div>\n        {hasActiveRoute && (\n          <span className=\"shrink-0 rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-bold text-blue-700 whitespace-nowrap\">\n            \304\220ang ch\341\273\211 \304\221\306\260\341\273\235ng\n          </span>\n        )}\n      </div>\n\n      {callNotice && (\n        <p className=\"rounded-xl bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700\">\n          \304\220ang k\341\272\277t n\341\273\221i cu\341\273\231c g\341\273\215i t\341\273\233i {shop.phone}...\n        </p>\n      )}\n\n      <div className=\"grid grid-cols-3 gap-2\">\n        <button\n          type=\"button\"\n          onClick={onNavigate}\n          disabled={isLoadingRoute}\n          className=\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl bg-blue-600 px-3 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-600/25 transition-all hover:bg-blue-700 active:scale-[0.98] disabled:opacity-70\"\n        >\n          {isLoadingRoute ? (\n            <Loader2 className=\"h-4 w-4 animate-spin\" aria-hidden=\"true\" />\n          ) : (\n            <Navigation className=\"h-4 w-4\" aria-hidden=\"true\" />\n          )}\n          <span>D\341\272\253n \304\221\306\260\341\273\235ng</span>\n        </button>\n\n        <a\n          href={`tel:${shop.phone.replace(/\\s+/g, \'\')}`}\n          onClick={() => setCallNotice(true)}\n          className=\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-bold text-emerald-700 transition-colors hover:bg-emerald-100 active:scale-[0.98]\"\n        >\n          <Phone className=\"h-4 w-4\" aria-hidden=\"true\" />\n          <span>G\341\273\215i ti\341\273\207m</span>\n        </a>\n\n        <a\n          href={buildGoogleMapsSearchUrl(shop)}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          className=\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-bold text-slate-700 transition-colors hover:bg-slate-50 active:scale-[0.98]\"\n        >\n          <ExternalLink className=\"h-4 w-4 text-slate-500\" aria-hidden=\"true\" />\n          <span>Google Maps</span>\n        </a>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/RepairShopDetailSheet.tsx"
        }
        overwrite: true
      }
    }
