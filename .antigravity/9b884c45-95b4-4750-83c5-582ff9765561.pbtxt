      thinking_signature: "\022\236\006\n\233\006\001i\024}\023\275\006_\2226J@\3630\"\311[\242Y\307\243o\365\223b\253w\264A\003\202?5\300\207x\320\324G@!=\023\271;ez\004\361B\177\177kw_GN\352\342\222h\3415N\346\375.\333\363\fv\233\337f\225\255\264h\003.\206bH\'Fe\361\302\250\373\310<\361{\261\f\324\002\314\027\347\263\310\212\317\234\223b\232\365\364-A4\000\226\004\315\325H\247f\363\247\205\316Z9\016\353\a\373\261\260\310\306\b\365\230\312\330\245\231\335\317\350J\211\227\245U\027N\310\2566\031+bb\020\364G\\?\as\244\211\305\313/\207QT\307]\364\372\243\344<&K\fb\213\027^\2537P\244\017\201{\345\024\n\rd\261\330\222\022\226\177\363\020\272s\276r\331\001|\021m~\f\351\250\036\200P-\352\034\t\206\347Vu\2128\277\001\240\263b\3537\256m/\314\036\374t{\026\311\333\300{\261a\371\352\020\250@4Z\001\330\aKQ\026\247t\034}\033\324\274\264f\300\354\031\345\"T\3205c\341f\364\314\216=\243\3252\333\215Q\330>\v)9\377_<\3269\\\2160\252a\261|\214\\H\034\345\203N\301\003\343\343_\301\\\316\374\314\034=h\357x\217\224\344\371\251\310\334U\340\256\027i\367^\032tmt\224\313\263\277%\030\247\025M~M\321\341\365\3402\003Ua\314\277\0373\332\324\233B<R\351\207\021Y\361K\017b\217\0232k\350\242\350\a\321[\353\320hx\001B\350\037(\341\323\025y\333_\223\261EEM\3579\202\221\033\320\270\356R\nI\363\237\331\201r\264\371\247\323Q$\373=\235\333(GN;\r\227\033S\257\234^s\253\374S4J!r\021\033\341\3544\027\035\254\016m\030w\247\027\277\372\314\031m[l=\263\202tZ\004\207\2321\202\355\251\263=\226 \243\002\200&X\344\320)\250\366\b\274\177\203\303K\372\304\316\214\264\023\265\030\200\315\204\236\213\213h\347I\3666\216\256&\rlg\330X[\2529m\361\376\314*\270\304\326\372]\b\311\213\243a-\247\376\000\242\306\237&\204\262w-\242\250f\3057\334Q\225\254+x\206\352\337\242\334\330IH\205o\365p\335-\357\260W>]\372\306K\275\260\3339s\274\213$\003/\232~\244]\f\344a\230=;\222\270`\0015a\322)\'^p\306G\255\036\034O\253\235S\215\212\004b\t\025\0328\3212f\020\031\000\222\361^\307\270\003\316=\344\201\262\002}\222\f\322^\373\372Ac\367\