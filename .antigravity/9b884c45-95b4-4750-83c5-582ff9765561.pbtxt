  view_file {
    absolute_path_uri: "file:///src/hooks/useRescueGeo.ts"
    end_line: 134
    content: "import { useEffect, useState } from \'react\';\nimport {\n  FALLBACK_USER_LOCATION,\n  MOCK_SAFE_STATIONS,\n} from \'../data/mockRescueData\';\nimport type {\n  GeoJsonLineString,\n  PickupMode,\n  RescueStep,\n  SafeStation,\n  UserLocation,\n} from \'../types/rescue\';\nimport { fetchNearbySafeStations, fetchWalkingRoute } from \'../utils/mapApi\';\nimport { getNearestSafeStation } from \'../utils/rescueLogic\';\n\nexport function useRescueGeo(\n  step: RescueStep,\n  pickupMode: PickupMode,\n  selectedStation: SafeStation | null,\n  onStationsReady: (stations: SafeStation[]) => void,\n) {\n  const [userLocation, setUserLocation] = useState<UserLocation>(\n    FALLBACK_USER_LOCATION,\n  );\n  const [stations, setStations] = useState<SafeStation[]>(MOCK_SAFE_STATIONS);\n  const [isLoadingStations, setIsLoadingStations] = useState(false);\n  const [walkingRoute, setWalkingRoute] = useState<GeoJsonLineString | null>(\n    null,\n  );\n  const [routeSummary, setRouteSummary] = useState<{\n    distanceMeters: number;\n    durationMinutes: number;\n  } | null>(null);\n  const [isLoadingRoute, setIsLoadingRoute] = useState(false);\n\n  // 1. Request real browser GPS with fallback to HCMC center\n  useEffect(() => {\n    if (typeof navigator === \'undefined\' || !navigator.geolocation) return;\n\n    navigator.geolocation.getCurrentPosition(\n      (pos) => {\n        const lat = pos.coords.latitude;\n        const lng = pos.coords.longitude;\n        setUserLocation({\n          address: `V\341\273\213 tr\303\255 GPS (${lat.toFixed(4)}, ${lng.toFixed(4)})`,\n          district: \'\304\220\341\273\213nh v\341\273\213 tr\341\273\261c ti\341\272\277p\',\n          coord: { lat, lng },\n          source: \'gps\',\n        });\n      },\n      () => {\n        setUserLocation(FALLBACK_USER_LOCATION);\n      },\n      { enableHighAccuracy: true, timeout: 6000, maximumAge: 60000 },\n    );\n  }, []);\n\n  // 2. Scan nearby 24/7 Safe Stations via Geoapify Places API (with mock fallback)\n  useEffect(() => {\n    const controller = new AbortController();\n    setIsLoadingStations(true);\n\n    fetchNearbySafeStations(userLocation.coord, controller.signal)\n      .then(({ stations: nextStations }) => {\n        if (controller.signal.aborted) return;\n        setStations(nextStations);\n        onStationsReady(nextStations);\n      })\n      .finally(() => {\n        if (!controller.signal.aborted) {\n          setIsLoadingStations(false);\n        }\n      });\n\n    return () => controller.abort();\n  }, [userLocation.coord.lat, userLocation.coord.lng]);\n\n  // 3. Fetch real walking route via OSRM when Safe Station pickup is active\n  useEffect(() => {\n    const shouldRoute =\n      (step === \'pickup\' || step === \'tracking\') &&\n      pickupMode === \'safe_station\' &&\n      selectedStation !== null;\n\n    if (!shouldRoute || !selectedStation) {\n      setWalkingRoute(null);\n      setRouteSummary(null);\n      setIsLoadingRoute(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    setIsLoadingRoute(true);\n\n    fetchWalkingRoute(userLocation.coord, selectedStation.coord, controller.signal)\n      .then((res) => {\n        if (controller.signal.aborted) return;\n        setWalkingRoute(res.geometry);\n        setRouteSummary({\n          distanceMeters: res.distanceMeters,\n          durationMinutes: res.durationMinutes,\n        });\n      })\n      .finally(() => {\n        if (!controller.signal.aborted) {\n          setIsLoadingRoute(false);\n        }\n      });\n\n    return () => controller.abort();\n  }, [\n    step,\n    pickupMode,\n    userLocation.coord.lat,\n    userLocation.coord.lng,\n    selectedStation?.id,\n  ]);\n\n  const nearestStation = getNearestSafeStation(stations);\n\n  return {\n    userLocation,\n    stations,\n    nearestStation,\n    isLoadingStations,\n    walkingRoute,\n    routeSummary,\n    isLoadingRoute,\n    clearRoute: () => {\n      setWalkingRoute(null);\n      setRouteSummary(null);\n    },\n  };\n}\n"
    num_lines: 135
    num_bytes: 3827
    line_range_bytes: 3827
  }
}
