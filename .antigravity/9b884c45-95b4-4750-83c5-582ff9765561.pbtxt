          target_content: "export type MapLayerFilter =\n  | \'all\'\n  | \'repair_shops\'\n  | \'gas_stations\'\n  | \'safe_stations\';\n\nexport interface GeoCoord {\n  lat: number;\n  lng: number;\n}\n\nexport interface SafeStation {\n  id: string;\n  name: string;\n  category: SafeStationCategory;\n  categoryLabel: string;\n  address: string;\n  walkingDistanceMeters: number;\n  walkingMinutes: number;\n  openHours: string;\n  amenities: string[];\n  coord: GeoCoord;\n}\n\nexport interface RepairShop {\n  id: string;\n  name: string;\n  address: string;\n  phone: string;\n  distanceMeters: number;\n  rideMinutes: number;\n  openingHoursRaw: string | null;\n  isOpen: boolean;\n  openStatusLabel: string;\n  hasExplicitHours: boolean;\n  coord: GeoCoord;\n}\n\nexport interface GasStation {\n  id: string;\n  name: string;\n  address: string;\n  walkingDistanceMeters: number;\n  walkingMinutes: number;\n  openStatusLabel: string;\n  isNearest: boolean;\n  coord: GeoCoord;\n}\n\nexport interface IssueOption {\n  id: IssueType;\n  label: string;\n  subtitle: string;\n  fixedPrice: number;\n}\n\nexport interface VoucherOption {\n  id: VoucherId;\n  code: VoucherId;\n  title: string;\n  description: string;\n  discountAmount: number;\n  requiresSafeStation: boolean;\n}\n\nexport interface OrderPricing {\n  basePrice: number;\n  discountAmount: number;\n  finalPrice: number;\n  appliedVoucher: VoucherOption | null;\n}\n\nexport interface ChatMessage {\n  id: string;\n  sender: \'user\' | \'mechanic\';\n  text: string;\n  timestampLabel: string;\n}\n\nexport interface MechanicInfo {\n  id: string;\n  name: string;\n  phone: string;\n  licensePlate: string;\n  vehicleModel: string;\n  rating: number;\n  completedRescues: number;\n  etaMinutes: number;\n  distanceKm: number;\n  coord: GeoCoord;\n}\n\nexport interface ActiveLocation {\n  lat: number;\n  lng: number;\n  address: string;\n  isCurrentGPS: boolean;\n  accuracyMeters?: number | null;\n}\n\nexport interface LocationSuggestion {\n  id: string;\n  addressLine1: string;\n  addressLine2: string;\n  fullAddress: string;\n  lat: number;\n  lng: number;\n  distanceMeters: number;\n}\n\nexport interface UserLocation {\n  address: string;\n  district: string;\n  coord: GeoCoord;\n  source: \'gps\' | \'fallback\';\n  accuracyMeters?: number | null;\n}\n\nexport interface GeoJsonLineString {\n  type: \'LineString\';\n  coordinates: [number, number][];\n}\n\nexport interface RescueActivityItem {\n  id: string;\n  issueLabel: string;\n  pickupAddress: string;\n  mechanicName: string;\n  licensePlate: string;\n  timestampLabel: string;\n  priceLabel?: string;\n  status: \'completed\' | \'cancelled\';\n}\n\nexport type InspectedPlace =\n  | { kind: \'safe_station\'; station: SafeStation }\n  | { kind: \'repair_shop\'; shop: RepairShop }\n  | { kind: \'gas_station\'; gasStation: GasStation };"
          replacement_content: "export type MapLayerFilter =\n  | \'all\'\n  | \'repair_shops\'\n  | \'gas_stations\'\n  | \'police_stations\'\n  | \'safe_stations\';\n\nexport interface GeoCoord {\n  lat: number;\n  lng: number;\n}\n\nexport interface SafeStation {\n  id: string;\n  name: string;\n  category: SafeStationCategory;\n  categoryLabel: string;\n  address: string;\n  walkingDistanceMeters: number;\n  walkingMinutes: number;\n  openHours: string;\n  amenities: string[];\n  coord: GeoCoord;\n}\n\nexport interface RepairShop {\n  id: string;\n  name: string;\n  address: string;\n  phone: string;\n  distanceMeters: number;\n  rideMinutes: number;\n  openingHoursRaw: string | null;\n  isOpen: boolean;\n  openStatusLabel: string;\n  hasExplicitHours: boolean;\n  coord: GeoCoord;\n}\n\nexport interface GasStation {\n  id: string;\n  name: string;\n  address: string;\n  walkingDistanceMeters: number;\n  walkingMinutes: number;\n  openStatusLabel: string;\n  isNearest: boolean;\n  coord: GeoCoord;\n}\n\nexport interface PoliceStation {\n  id: string;\n  name: string;\n  address: string;\n  phone: string | null;\n  distanceMeters: number;\n  durationMinutes: number;\n  isNearest: boolean;\n  coord: GeoCoord;\n}\n\nexport interface IssueOption {\n  id: IssueType;\n  label: string;\n  subtitle: string;\n  fixedPrice: number;\n}\n\nexport interface VoucherOption {\n  id: VoucherId;\n  code: VoucherId;\n  title: string;\n  description: string;\n  discountAmount: number;\n  requiresSafeStation: boolean;\n}\n\nexport interface OrderPricing {\n  basePrice: number;\n  discountAmount: number;\n  finalPrice: number;\n  appliedVoucher: VoucherOption | null;\n}\n\nexport interface ChatMessage {\n  id: string;\n  sender: \'user\' | \'mechanic\';\n  text: string;\n  timestampLabel: string;\n}\n\nexport interface MechanicInfo {\n  id: string;\n  name: string;\n  phone: string;\n  licensePlate: string;\n  vehicleModel: string;\n  rating: number;\n  completedRescues: number;\n  etaMinutes: number;\n  distanceKm: number;\n  coord: GeoCoord;\n}\n\nexport interface ActiveLocation {\n  lat: number;\n  lng: number;\n  address: string;\n  isCurrentGPS: boolean;\n  accuracyMeters?: number | null;\n}\n\nexport interface LocationSuggestion {\n  id: string;\n  addressLine1: string;\n  addressLine2: string;\n  fullAddress: string;\n  lat: number;\n  lng: number;\n  distanceMeters: number;\n}\n\nexport interface UserLocation {\n  address: string;\n  district: string;\n  coord: GeoCoord;\n  source: \'gps\' | \'fallback\';\n  accuracyMeters?: number | null;\n}\n\nexport interface GeoJsonLineString {\n  type: \'LineString\';\n  coordinates: [number, number][];\n}\n\nexport interface RescueActivityItem {\n  id: string;\n  issueLabel: string;\n  pickupAddress: string;\n  mechanicName: string;\n  licensePlate: string;\n  timestampLabel: string;\n  priceLabel?: string;\n  status: \'completed\' | \'cancelled\';\n}\n\nexport type InspectedPlace =\n  | { kind: \'safe_station\'; station: SafeStation }\n  | { kind: \'repair_shop\'; shop: RepairShop }\n  | { kind: \'gas_station\'; gasStation: GasStation }\n  | { kind: \'police_station\'; policeStation: PoliceStation };"
