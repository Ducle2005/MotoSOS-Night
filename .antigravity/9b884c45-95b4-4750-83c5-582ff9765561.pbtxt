      arguments_json: "{\"Description\":\"Wire quick Safe Stations shortcut pill and smart back navigation in App.tsx\", \"Instruction\":\"Track enteredFromQuickStations state, wire onOpenSafeStations on IdleHomeStep, and update Step 2 back navigation\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":47, \"ReplacementContent\":\"  const [isSubmitting, setIsSubmitting] = useState(false);\\n  const [enteredFromQuickStations, setEnteredFromQuickStations] = useState(false);\\n  const [recenterSignal, setRecenterSignal] = useState(0);\", \"StartLine\":43, \"TargetContent\":\"  const [isSubmitting, setIsSubmitting] = useState(false);\\n  const [recenterSignal, setRecenterSignal] = useState(0);\"}, {\"AllowMultiple\":false, \"EndLine\":76, \"ReplacementContent\":\"  const {\\n    userLocation,\\n    stations,\\n    walkingRoute,\\n    routeSummary,\\n    isLoadingRoute,\\n    clearRoute,\\n  } = useRescueGeo(step, pickupMode, activeStationForRoute, handleStationsReady);\", \"StartLine\":67, \"TargetContent\":\"  const {\\n    userLocation,\\n    stations,\\n    isLoadingStations,\\n    walkingRoute,\\n    routeSummary,\\n    isLoadingRoute,\\n    clearRoute,\\n  } = useRescueGeo(step, pickupMode, activeStationForRoute, handleStationsReady);\"}, {\"AllowMultiple\":false, \"EndLine\":129, \"ReplacementContent\":\"    setTrackingStatus(\'searching\');\\n    setEnteredFromQuickStations(false);\\n    setInspectedStationId(null);\\n    clearRoute();\\n  };\", \"StartLine\":124, \"TargetContent\":\"    setTrackingStatus(\'searching\');\\n    setInspectedStationId(null);\\n    clearRoute();\\n  };\"}, {\"AllowMultiple\":false, \"EndLine\":226, \"ReplacementContent\":\"          {step === \'idle\' && (\\n            <IdleHomeStep\\n              userLocation={userLocation}\\n              onStartOrder={() => {\\n                setEnteredFromQuickStations(false);\\n                setInspectedStationId(null);\\n                setStep(\'issue\');\\n              }}\\n