  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  Clock,\n  MapPin,\n  MessageCircle,\n  Phone,\n  ShieldCheck,\n  Star,\n  Wrench,\n} from \'lucide-react\';\nimport { useState } from \'react\';\nimport type { MechanicInfo, OrderPricing } from \'../../types/rescue\';\nimport { formatVnd } from \'../../utils/pricingAndSimLogic\';\n\ninterface AcceptedMechanicCardProps {\n  issueSummary: string;\n  pickupTitle: string;\n  pickupAddress: string;\n  mechanic: MechanicInfo;\n  liveEtaMinutes: number;\n  hasArrived: boolean;\n  pricing: OrderPricing;\n  onOpenChat: () => void;\n}\n\nexport function AcceptedMechanicCard({\n  issueSummary,\n  pickupTitle,\n  pickupAddress,\n  mechanic,\n  liveEtaMinutes,\n  hasArrived,\n  pricing,\n  onOpenChat,\n}: AcceptedMechanicCardProps) {\n  const [callNotice, setCallNotice] = useState(false);\n  const hasDiscount =\n    pricing.appliedVoucher !== null && pricing.discountAmount > 0;\n\n  return (\n    <div className=\"flex min-h-0 flex-1 flex-col\" data-testid=\"tracking-accepted\">\n      <div className=\"flex-1 overflow-y-auto px-5 pt-1 pb-2.5 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n        <div className=\"flex items-start justify-between gap-3\">\n          <div>\n            <p className=\"text-xs font-bold text-emerald-600\">\n              {hasArrived\n                ? \'Th\341\273\243 \304\221ang t\341\273\233i ngay \304\221i\341\273\203m h\341\272\271n!\'\n                : \'Th\341\273\243 \304\221\303\243 nh\341\272\255n \304\221\306\241n \302\267 \304\220ang di chuy\341\273\203n t\341\273\233i b\341\272\241n\'}\n            </p>\n            <h1\n              data-testid=\"live-eta-heading\"\n              className=\"mt-0.5 text-base font-extrabold tracking-tight text-slate-900\"\n            >\n              {hasArrived\n                ? \'Th\341\273\243 \304\221\303\243 \304\221\341\272\277n g\341\272\247n \304\221i\341\273\203m \304\221\303\263n\'\n                : `D\341\273\261 ki\341\272\277n t\341\273\233i sau ${liveEtaMinutes} ph\303\272t`}\n            </h1>\n          </div>\n\n          <div className=\"flex shrink-0 items-center gap-1 rounded-xl border border-amber-200 bg-amber-50 px-2.5 py-1 text-amber-700\">\n            <Clock className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n            <span className=\"font-sans text-xs font-bold tabular-nums\">\n              {hasArrived ? \'\304\220\303\243 t\341\273\233i\' : `${liveEtaMinutes}p`}\n            </span>\n          </div>\n        </div>\n\n        {/* Mechanic card */}\n        <div className=\"mt-2.5 rounded-2xl border border-slate-200 bg-slate-50/80 p-3\">\n          <div className=\"flex items-center justify-between gap-3\">\n            <div className=\"flex min-w-0 items-center gap-3\">\n              <div className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-emerald-500 text-white shadow-sm\">\n                <Wrench className=\"h-5 w-5\" aria-hidden=\"true\" />\n              </div>\n              <div className=\"min-w-0\">\n                <h2 className=\"truncate text-sm font-bold text-slate-900\">\n                  {mechanic.name}\n                </h2>\n                <p className=\"mt-0.5 flex items-center gap-1.5 text-xs text-slate-500\">\n                  <Star className=\"h-3.5 w-3.5 fill-amber-400 text-amber-400\" aria-hidden=\"true\" />\n                  <span className=\"font-sans font-semibold tabular-nums text-slate-800\">\n                    {mechanic.rating}\n                  </span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-sans tabular-nums\">\n                    {mechanic.completedRescues} ca c\341\273\251u h\341\273\231\n                  </span>\n                </p>\n              </div>\n            </div>\n\n            <div className=\"shrink-0 text-right\">\n              <p className=\"text-[11px] text-slate-500\">Bi\341\273\203n s\341\273\221 xe</p>\n              <p className=\"mt-0.5 font-sans text-xs font-bold tabular-nums text-emerald-700 whitespace-nowrap\">\n                {mechanic.licensePlate}\n              </p>\n            </div>\n          </div>\n\n          {/* Locked service & price row */}\n          <div className=\"mt-2.5 flex items-center justify-between gap-2 border-t border-slate-200/80 pt-2 text-xs\">\n            <span className=\"truncate font-medium text-slate-600\">\n              G\303\263i: <strong className=\"text-slate-900\">{issueSummary}</strong>\n            </span>\n            <span className=\"flex shrink-0 items-center gap-1.5 font-sans tabular-nums\">\n              {hasDiscount && (\n                <span className=\"text-[11px] text-slate-400 line-through\">\n                  {formatVnd(pricing.basePrice)}\n                </span>\n              )}\n              <span className=\"font-extrabold text-emerald-700\">\n                {formatVnd(pricing.finalPrice)}\n              </span>\n            </span>\n          </div>\n\n          <p className=\"mt-1.5 flex items-center gap-1.5 text-xs text-slate-500\">\n            <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n            <span className=\"truncate\">\n              \304\220i\341\273\203m h\341\272\271n: {pickupTitle} ({pickupAddress})\n            </span>\n          </p>\n        </div>\n\n        {callNotice && (\n          <div\n            role=\"status\"\n            data-testid=\"call-connecting-status\"\n            className=\"mt-2 flex items-center justify-between gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800\"\n          >\n            <span>\304\220ang k\341\272\277t n\341\273\221i cu\341\273\231c g\341\273\215i t\341\273\233i {mechanic.phone}...</span>\n            <button\n              type=\"button\"\n              onClick={() => setCallNotice(false)}\n              className=\"text-[11px] font-bold text-emerald-700 underline\"\n            >\n              \341\272\250n\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* 2 Large Action Buttons: G\341\273\215i \304\221i\341\273\207n + Nh\341\272\257n tin */}\n      <div className=\"shrink-0 border-t border-slate-100 bg-white px-5 py-3\">\n        <div className=\"grid grid-cols-2 gap-2.5\">\n          <a\n            href=\"tel:0909888999\"\n            onClick={() => setCallNotice(true)}\n            data-testid=\"call-mechanic-btn\"\n            className=\"inline-flex min-h-[46px] items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 text-sm font-bold text-white shadow-md shadow-emerald-500/20 transition-colors hover:bg-emerald-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-[0.98]\"\n          >\n            <Phone className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>G\341\273\215i \304\221i\341\273\207n</span>\n          </a>\n\n          <button\n            type=\"button\"\n            onClick={onOpenChat}\n            data-testid=\"chat-mechanic-btn\"\n            className=\"inline-flex min-h-[46px] items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 text-sm font-bold text-emerald-700 transition-colors hover:bg-emerald-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-[0.98]\"\n          >\n            <MessageCircle className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>Nh\341\272\257n tin</span>\n          </button>\n        </div>\n\n        <p className=\"mt-2 flex items-center justify-center gap-1.5 text-[11px] text-slate-500\">\n          <ShieldCheck className=\"h-3.5 w-3.5 text-emerald-600\" aria-hidden=\"true\" />\n          <span>Gi\303\241 \304\221\303\243 ch\341\273\221t {formatVnd(pricing.finalPrice)} \302\267 Kh\303\264ng ph\341\273\245 thu \341\272\251n</span>\n        </p>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/AcceptedMechanicCard.tsx"
        }
        overwrite: true
      }
    }
