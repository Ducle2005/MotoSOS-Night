    replacement_infos {
      original_chunk {
        target_content: "import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\nimport type { CampaignBannerItem, PartnerPerkItem } from \'../data/homePromotions\';\nimport { FALLBACK_USER_LOCATION, INITIAL_ACTIVITY_HISTORY, ISSUE_OPTIONS, MOCK_MECHANIC, MOCK_SAFE_STATIONS, VOUCHER_OPTIONS } from \'../data/mockRescueData\';\nimport type { AppTab, GasStation, IssueType, LocationSuggestion, MapLayerFilter, PickupMode, RescueActivityItem, RescueStep, SafeStation, SafeStationCategory, TrackingStatus, VoucherId } from \'../types/rescue\';\nimport { gasStationToSafeStation } from \'../utils/gasStationApi\';\nimport { calculateRescuePricing, formatVnd } from \'../utils/pricingAndSimLogic\';\nimport { buildMechanicApproachCoord, findStationByCategory, getIssueLabel, getNearestSafeStation, getNextDemoTrackingStatus, resolvePickupTarget } from \'../utils/rescueLogic\';\nimport { useGasStationState } from \'./useGasStationState\';\nimport { useMapPinPicker } from \'./useMapPinPicker\';\nimport { useMechanicSimulation } from \'./useMechanicSimulation\';\nimport { useRepairShopState } from \'./useRepairShopState\';\nimport { useRescueGeo } from \'./useRescueGeo\';\n\nexport function useRescueOrderState() {\n  const [activeTab, setActiveTab] = useState<AppTab>(\'home\');\n  const [step, setStep] = useState<RescueStep>(\'idle\');\n  const [selectedIssue, setSelectedIssue] = useState<IssueType | null>(null);\n  const [customNote, setCustomNote] = useState(\'\');\n  const [pickupMode, setPickupMode] = useState<PickupMode>(\'current_location\');\n  const [selectedVoucherId, setSelectedVoucherId] = useState<VoucherId | null>(null);\n  const [selectedStationId, setSelectedStationId] = useState<string | null>(MOCK_SAFE_STATIONS[0]?.id ?? null);\n  const [inspectedStationId, setInspectedStationId] = useState<string | null>(null);\n  const [trackingStatus, setTrackingStatus] = useState<TrackingStatus>(\'searching\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [enteredFromQuickStations, setEnteredFromQuickStations] = useState(false);\n  const [recenterSignal, setRecenterSignal] = useState(0);\n  const [isLocationSearchOpen, setIsLocationSearchOpen] = useState(false);\n  const [activityHistory, setActivityHistory] = useState<RescueActivityItem[]>(INITIAL_ACTIVITY_HISTORY);\n  const [activeStationForRoute, setActiveStationForRoute] = useState<SafeStation | null>(null);\n  const [chosenGasSafeStation, setChosenGasSafeStation] = useState<SafeStation | null>(null);\n  const submitTimerRef = useRef<number | null>(null);\n\n  useEffect(() => () => { if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current); }, []);\n\n  const handleStationsReady = useCallback((nextStations: SafeStation[]) => {\n    const nearest = getNearestSafeStation(nextStations);\n    setSelectedStationId((prev) =>\n      nextStations.some((s) => s.id === prev) ? prev : (nearest?.id ?? null),\n    );\n  }, []);\n\n  const geo = useRescueGeo(step, pickupMode, activeStationForRoute, handleStationsReady);\n  const repairShops = useRepairShopState(geo.userLocation.coord);\n  const gasStations = useGasStationState(geo.userLocation.coord);\n  const pinPicker = useMapPinPicker();\n\n  const effectiveStations = useMemo(\n    () =>\n      chosenGasSafeStation &&\n      !geo.stations.some((s) => s.id === chosenGasSafeStation.id)\n        ? [chosenGasSafeStation, ...geo.stations]\n        : geo.stations,\n    [geo.stations, chosenGasSafeStation],\n  );\n\n  const pickupTarget = useMemo(\n    () => resolvePickupTarget(pickupMode, geo.userLocation || FALLBACK_USER_LOCATION, effectiveStations, selectedStationId),\n    [pickupMode, geo.userLocation, effectiveStations, selectedStationId],\n  );\n\n  useEffect(() => {\n    setActiveStationForRoute(pickupTarget.station);\n  }, [pickupTarget.station]);\n\n  // Clear Safe-Station-only voucher if user switches back to current_location\n  const handleChangePickupMode = useCallback((mode: PickupMode) => {\n    setPickupMode(mode);\n    if (mode !== \'safe_station\') {\n      setSelectedVoucherId((prev) => (prev === \'ANTOAN20\' ? null : prev));\n    }\n  }, []);\n\n  const issueSummary = useMemo(() => getIssueLabel(selectedIssue, ISSUE_OPTIONS, customNote), [selectedIssue, customNote]);\n  const pricing = useMemo(\n    () => calculateRescuePricing(selectedIssue, ISSUE_OPTIONS, pickupMode, selectedVoucherId, VOUCHER_OPTIONS),\n    [selectedIssue, pickupMode, selectedVoucherId],\n  );\n  const mechanicStartCoord = useMemo(() => buildMechanicApproachCoord(pickupTarget.coord), [pickupTarget.coord.lat, pickupTarget.coord.lng]);\n\n  const mechanicSim = useMechanicSimulation({\n    step, trackingStatus, mechanicStartCoord,\n    pickupCoord: pickupTarget.coord, pickupTitle: pickupTarget.title, mechanicName: MOCK_MECHANIC.name,\n  });\n\n  const clearOverlays = (clearGasStationChoice = false) => {\n    setInspectedStationId(null);\n    if (clearGasStationChoice) setChosenGasSafeStation(null);\n    repairShops.selectShop(null);\n    gasStations.clearGasRoute();\n  };\n\n  const handleResetFlow = (returnToHome = false) => {\n    if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current);\n    setIsSubmitting(false); setStep(\'idle\'); setSelectedIssue(null); setCustomNote(\'\');\n    setPickupMode(\'current_location\'); setSelectedVoucherId(null);\n    setTrackingStatus(\'searching\'); setEnteredFromQuickStations(false);\n    pinPicker.cancelPinPicker(); clearOverlays(true); geo.clearRoute();\n    if (returnToHome) setActiveTab(\'home\');\n  };\n\n  const handleCompleteAndLog = () => {\n    setActivityHistory((prev) => [{\n      id: `act-${Date.now()}`, issueLabel: issueSummary, pickupAddress: pickupTarget.address,\n      mechanicName: MOCK_MECHANIC.name, licensePlate: MOCK_MECHANIC.licensePlate,\n      timestampLabel: \'V\341\273\253a xong\', priceLabel: formatVnd(pricing.finalPrice), status: \'completed\',\n    }, ...prev]);\n    handleResetFlow(true);\n  };\n\n  const handleConfirmRescue = () => {\n    setIsSubmitting(true);\n    submitTimerRef.current = window.setTimeout(() => {\n      setIsSubmitting(false); setTrackingStatus(\'searching\'); setStep(\'tracking\');\n    }, 400);\n  };\n\n  const handleDemoAdvance = () => {\n    repairShops.selectShop(null);\n    setActiveTab(\'map\');\n    if (step !== \'tracking\') {\n      if (!selectedIssue) setSelectedIssue(\'flat_tire\');\n      setTrackingStatus(\'accepted\'); setStep(\'tracking\');\n      return;\n    }\n    if (trackingStatus === \'completed\') return handleCompleteAndLog();\n    setTrackingStatus((prev) => getNextDemoTrackingStatus(prev));\n  };\n\n  const handleOpenMapWithStation = (stationId: string) => {\n    if (stationId) setSelectedStationId(stationId);\n    clearOverlays(false); setEnteredFromQuickStations(true);\n    setPickupMode(\'safe_station\'); setStep(\'pickup\'); setActiveTab(\'map\');\n  };\n\n  const handleOpenMapWithRepairShop = (shopId?: string) => {\n    setInspectedStationId(null); setStep(\'idle\');\n    repairShops.setMapFilter(\'repair_shops\'); repairShops.selectShop(shopId ?? null);\n    setActiveTab(\'map\');\n  };\n\n  const handleOpenMapWithGasStations = () => {\n    clearOverlays(false); repairShops.setMapFilter(\'gas_stations\');\n    setStep(\'idle\'); setActiveTab(\'map\');\n  };\n\n  const handleChangeMapFilter = (nextFilter: MapLayerFilter) => {\n    if (nextFilter !== \'gas_stations\') gasStations.clearGasRoute();\n    repairShops.setMapFilter(nextFilter);\n  };\n\n  const handleSelectGasStationForRescue = (station: GasStation) => {\n    const safe = gasStationToSafeStation(station);\n    setChosenGasSafeStation(safe); setSelectedStationId(safe.id);\n    setPickupMode(\'safe_station\'); setSelectedVoucherId(\'ANTOAN20\');\n    clearOverlays(false); setEnteredFromQuickStations(true); setStep(\'pickup\');\n  };\n\n  const handleQuickCategory = (category: SafeStationCategory) =>\n    category === \'gas_station\'\n      ? handleOpenMapWithGasStations()\n      : handleOpenMapWithStation(findStationByCategory(geo.stations, category)?.id ?? \'\');\n\n  const handleQuickIssue = (issue: IssueType) => {\n    clearOverlays(false); setSelectedIssue(issue);\n    setEnteredFromQuickStations(false); setStep(\'issue\'); setActiveTab(\'map\');\n  };\n\n  const handleQuickSos = () => {\n    clearOverlays(false); setSelectedIssue(\'other\'); setCustomNote(\'SOS kh\341\272\251n c\341\272\245p ban \304\221\303\252m\');\n    handleChangePickupMode(\'current_location\'); setEnteredFromQuickStations(false);\n    setStep(\'pickup\'); setActiveTab(\'map\');\n  };\n\n  const handleMechanicArrived = useCallback(() => {\n    setTrackingStatus((prev) => (prev === \'accepted\' ? \'arrived\' : prev));\n  }, []);\n\n  const handleStartMapPinPicker = () => {\n    clearOverlays(true); setStep(\'idle\');\n    pinPicker.startPinPicker(geo.userLocation.coord, geo.userLocation.address);\n    setIsLocationSearchOpen(false); setActiveTab(\'map\');\n  };\n\n  const handleConfirmMapPinPicker = () => {\n    const { coord, address } = pinPicker.finishPinPicker();\n    clearOverlays(true); geo.confirmPinnedLocation(coord, address);\n  };\n\n  const handleSelectSearchLocation = (item: LocationSuggestion) => {\n    pinPicker.cancelPinPicker(); clearOverlays(true); geo.selectSearchedLocation(item);\n  };\n\n  const handleResetToGpsLocation = async () => {\n    pinPicker.cancelPinPicker(); clearOverlays(true); await geo.useCurrentGpsLocation();\n  };\n\n  const applyPromotion = (\n    voucherId: VoucherId | null,\n    targetPickupMode?: PickupMode,\n    targetIssue?: IssueType,\n    targetStep: RescueStep = \'issue\',\n  ) => {\n    clearOverlays(false);\n    setSelectedIssue(targetIssue ?? null);\n    setPickupMode(targetPickupMode ?? \'current_location\');\n    setSelectedVoucherId(voucherId);\n    setEnteredFromQuickStations(false);\n    setStep(targetStep);\n    setActiveTab(\'map\');\n  };\n\n  const handleSelectCampaignBanner = (b: CampaignBannerItem) =>\n    applyPromotion(b.voucherId, b.targetPickupMode, b.targetIssue, b.targetStep);\n\n  const handleSelectPartnerPerk = (p: PartnerPerkItem) =>\n    applyPromotion(p.voucherId, p.targetPickupMode, undefined, \'issue\');\n\n  return {\n    activeTab, setActiveTab, step, setStep, selectedIssue, setSelectedIssue,\n    customNote, setCustomNote, pickupMode, handleChangePickupMode,\n    selectedVoucherId, setSelectedVoucherId, selectedStationId, setSelectedStationId,\n    inspectedStationId, setInspectedStationId, trackingStatus, isSubmitting,\n    enteredFromQuickStations, setEnteredFromQuickStations, isLocationSearchOpen,\n    setIsLocationSearchOpen, recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\n    activityHistory, geo, repairShops, gasStations, pinPicker, effectiveStations,\n    pickupTarget, issueSummary, pricing, mechanicSim, handleResetFlow, handleCompleteAndLog,\n    handleConfirmRescue, handleDemoAdvance, handleMechanicArrived, handleOpenMapWithStation,\n    handleOpenMapWithRepairShop, handleChangeMapFilter, handleSelectGasStationForRescue,\n    handleQuickCategory, handleQuickIssue, handleQuickSos, handleStartMapPinPicker,\n    handleConfirmMapPinPicker, handleSelectSearchLocation, handleResetToGpsLocation,\n    handleSelectCampaignBanner, handleSelectPartnerPerk,\n  };\n}"
        replacement_content: "import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\nimport type { CampaignBannerItem, PartnerPerkItem } from \'../data/homePromotions\';\nimport { FALLBACK_USER_LOCATION, INITIAL_ACTIVITY_HISTORY, ISSUE_OPTIONS, MOCK_MECHANIC, MOCK_SAFE_STATIONS, VOUCHER_OPTIONS } from \'../data/mockRescueData\';\nimport type { AppTab, GasStation, IssueType, LocationSuggestion, MapLayerFilter, PickupMode, RescueActivityItem, RescueStep, SafeStation, SafeStationCategory, TrackingStatus, VoucherId } from \'../types/rescue\';\nimport { gasStationToSafeStation } from \'../utils/gasStationApi\';\nimport { calculateRescuePricing, formatVnd } from \'../utils/pricingAndSimLogic\';\nimport { buildMechanicApproachCoord, findStationByCategory, getIssueLabel, getNearestSafeStation, getNextDemoTrackingStatus, resolvePickupTarget } from \'../utils/rescueLogic\';\nimport { useActivePlaceInspect } from \'./useActivePlaceInspect\';\nimport { useGasStationState } from \'./useGasStationState\';\nimport { useMapPinPicker } from \'./useMapPinPicker\';\nimport { useMechanicSimulation } from \'./useMechanicSimulation\';\nimport { useRepairShopState } from \'./useRepairShopState\';\nimport { useRescueGeo } from \'./useRescueGeo\';\n\nexport function useRescueOrderState() {\n  const [activeTab, setActiveTab] = useState<AppTab>(\'home\');\n  const [step, setStep] = useState<RescueStep>(\'idle\');\n  const [selectedIssue, setSelectedIssue] = useState<IssueType | null>(null);\n  const [customNote, setCustomNote] = useState(\'\');\n  const [pickupMode, setPickupMode] = useState<PickupMode>(\'current_location\');\n  const [selectedVoucherId, setSelectedVoucherId] = useState<VoucherId | null>(null);\n  const [selectedStationId, setSelectedStationId] = useState<string | null>(MOCK_SAFE_STATIONS[0]?.id ?? null);\n  const [trackingStatus, setTrackingStatus] = useState<TrackingStatus>(\'searching\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [enteredFromQuickStations, setEnteredFromQuickStations] = useState(false);\n  const [recenterSignal, setRecenterSignal] = useState(0);\n  const [isLocationSearchOpen, setIsLocationSearchOpen] = useState(false);\n  const [activityHistory, setActivityHistory] = useState<RescueActivityItem[]>(INITIAL_ACTIVITY_HISTORY);\n  const [activeStationForRoute, setActiveStationForRoute] = useState<SafeStation | null>(null);\n  const [chosenGasSafeStation, setChosenGasSafeStation] = useState<SafeStation | null>(null);\n  const submitTimerRef = useRef<number | null>(null);\n\n  useEffect(() => () => { if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current); }, []);\n\n  const handleStationsReady = useCallback((nextStations: SafeStation[]) => {\n    const nearest = getNearestSafeStation(nextStations);\n    setSelectedStationId((prev) =>\n      nextStations.some((s) => s.id === prev) ? prev : (nearest?.id ?? null),\n    );\n  }, []);\n\n  const geo = useRescueGeo(step, pickupMode, activeStationForRoute, handleStationsReady);\n  const repairShops = useRepairShopState(geo.userLocation.coord);\n  const gasStations = useGasStationState(geo.userLocation.coord);\n  const activeInspect = useActivePlaceInspect(geo.userLocation.coord);\n  const pinPicker = useMapPinPicker();\n\n  const effectiveStations = useMemo(\n    () =>\n      chosenGasSafeStation &&\n      !geo.stations.some((s) => s.id === chosenGasSafeStation.id)\n        ? [chosenGasSafeStation, ...geo.stations]\n        : geo.stations,\n    [geo.stations, chosenGasSafeStation],\n  );\n\n  const pickupTarget = useMemo(\n    () => resolvePickupTarget(pickupMode, geo.userLocation || FALLBACK_USER_LOCATION, effectiveStations, selectedStationId),\n    [pickupMode, geo.userLocation, effectiveStations, selectedStationId],\n  );\n\n  useEffect(() => {\n    setActiveStationForRoute(pickupTarget.station);\n  }, [pickupTarget.station]);\n\n  const handleChangePickupMode = useCallback((mode: PickupMode) => {\n    setPickupMode(mode);\n    if (mode !== \'safe_station\') {\n      setSelectedVoucherId((prev) => (prev === \'ANTOAN20\' ? null : prev));\n    }\n  }, []);\n\n  const issueSummary = useMemo(() => getIssueLabel(selectedIssue, ISSUE_OPTIONS, customNote), [selectedIssue, customNote]);\n  const pricing = useMemo(\n    () => calculateRescuePricing(selectedIssue, ISSUE_OPTIONS, pickupMode, selectedVoucherId, VOUCHER_OPTIONS),\n    [selectedIssue, pickupMode, selectedVoucherId],\n  );\n  const mechanicStartCoord = useMemo(() => buildMechanicApproachCoord(pickupTarget.coord), [pickupTarget.coord.lat, pickupTarget.coord.lng]);\n\n  const mechanicSim = useMechanicSimulation({\n    step, trackingStatus, mechanicStartCoord,\n    pickupCoord: pickupTarget.coord, pickupTitle: pickupTarget.title, mechanicName: MOCK_MECHANIC.name,\n  });\n\n  const clearOverlays = (clearGasChoice = false) => {\n    activeInspect.clearInspection();\n    if (clearGasChoice) setChosenGasSafeStation(null);\n    repairShops.selectShop(null);\n    gasStations.clearGasRoute();\n  };\n\n  const handleResetFlow = (returnToHome = false) => {\n    if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current);\n    setIsSubmitting(false); setStep(\'idle\'); setSelectedIssue(null); setCustomNote(\'\');\n    setPickupMode(\'current_location\'); setSelectedVoucherId(null);\n    setTrackingStatus(\'searching\'); setEnteredFromQuickStations(false);\n    pinPicker.cancelPinPicker(); clearOverlays(true); geo.clearRoute();\n    if (returnToHome) setActiveTab(\'home\');\n  };\n\n  const handleCompleteAndLog = () => {\n    setActivityHistory((prev) => [{\n      id: `act-${Date.now()}`, issueLabel: issueSummary, pickupAddress: pickupTarget.address,\n      mechanicName: MOCK_MECHANIC.name, licensePlate: MOCK_MECHANIC.licensePlate,\n      timestampLabel: \'V\341\273\253a xong\', priceLabel: formatVnd(pricing.finalPrice), status: \'completed\',\n    }, ...prev]);\n    handleResetFlow(true);\n  };\n\n  const handleConfirmRescue = () => {\n    setIsSubmitting(true);\n    submitTimerRef.current = window.setTimeout(() => {\n      activeInspect.clearInspection();\n      setIsSubmitting(false); setTrackingStatus(\'searching\'); setStep(\'tracking\');\n    }, 400);\n  };\n\n  const handleDemoAdvance = () => {\n    activeInspect.clearInspection();\n    setActiveTab(\'map\');\n    if (step !== \'tracking\') {\n      if (!selectedIssue) setSelectedIssue(\'flat_tire\');\n      setTrackingStatus(\'accepted\'); setStep(\'tracking\');\n      return;\n    }\n    if (trackingStatus === \'completed\') return handleCompleteAndLog();\n    setTrackingStatus((prev) => getNextDemoTrackingStatus(prev));\n  };\n\n  const handleOpenMapWithStation = (stationId: string) => {\n    clearOverlays(false);\n    const station = effectiveStations.find((s) => s.id === stationId);\n    if (station) {\n      setSelectedStationId(station.id);\n      activeInspect.inspectAndRoutePlace({ kind: \'safe_station\', station });\n    } else if (stationId) {\n      setSelectedStationId(stationId);\n    }\n    setEnteredFromQuickStations(true);\n    setPickupMode(\'safe_station\'); setStep(\'pickup\'); setActiveTab(\'map\');\n  };\n\n  const handleOpenMapWithRepairShop = (shopId?: string) => {\n    clearOverlays(false); setStep(\'idle\');\n    repairShops.setMapFilter(\'repair_shops\');\n    if (shopId) {\n      const shop = repairShops.openRepairShops.find((s) => s.id === shopId);\n      if (shop) activeInspect.inspectAndRoutePlace({ kind: \'repair_shop\', shop });\n    }\n    setActiveTab(\'map\');\n  };\n\n  const handleOpenMapWithGasStations = () => {\n    clearOverlays(false); repairShops.setMapFilter(\'gas_stations\');\n    setStep(\'idle\'); setActiveTab(\'map\');\n  };\n\n  const handleChangeMapFilter = (nextFilter: MapLayerFilter) => {\n    if (nextFilter !== \'gas_stations\') gasStations.clearGasRoute();\n    activeInspect.clearInspection();\n    repairShops.setMapFilter(nextFilter);\n  };\n\n  const handlePickSafeStationForRescue = (station: SafeStation) => {\n    setSelectedStationId(station.id);\n    setPickupMode(\'safe_station\');\n    setEnteredFromQuickStations(true);\n    if (step === \'idle\') setStep(\'pickup\');\n  };\n\n  const handleSelectGasStationForRescue = (station: GasStation) => {\n    const safe = gasStationToSafeStation(station);\n    setChosenGasSafeStation(safe); setSelectedStationId(safe.id);\n    setPickupMode(\'safe_station\'); setSelectedVoucherId(\'ANTOAN20\');\n    setEnteredFromQuickStations(true);\n    if (step === \'idle\') setStep(\'pickup\');\n  };\n\n  const handleQuickCategory = (category: SafeStationCategory) =>\n    category === \'gas_station\'\n      ? handleOpenMapWithGasStations()\n      : handleOpenMapWithStation(findStationByCategory(geo.stations, category)?.id ?? \'\');\n\n  const handleQuickIssue = (issue: IssueType) => {\n    clearOverlays(false); setSelectedIssue(issue);\n    setEnteredFromQuickStations(false); setStep(\'issue\'); setActiveTab(\'map\');\n  };\n\n  const handleQuickSos = () => {\n    clearOverlays(false); setSelectedIssue(\'other\'); setCustomNote(\'SOS kh\341\272\251n c\341\272\245p ban \304\221\303\252m\');\n    handleChangePickupMode(\'current_location\'); setEnteredFromQuickStations(false);\n    setStep(\'pickup\'); setActiveTab(\'map\');\n  };\n\n  const handleMechanicArrived = useCallback(() => {\n    setTrackingStatus((prev) => (prev === \'accepted\' ? \'arrived\' : prev));\n  }, []);\n\n  const handleStartMapPinPicker = () => {\n    clearOverlays(true); setStep(\'idle\');\n    pinPicker.startPinPicker(geo.userLocation.coord, geo.userLocation.address);\n    setIsLocationSearchOpen(false); setActiveTab(\'map\');\n  };\n\n  const handleConfirmMapPinPicker = () => {\n    const { coord, address } = pinPicker.finishPinPicker();\n    clearOverlays(true); geo.confirmPinnedLocation(coord, address);\n  };\n\n  const handleSelectSearchLocation = (item: LocationSuggestion) => {\n    pinPicker.cancelPinPicker(); clearOverlays(true); geo.selectSearchedLocation(item);\n  };\n\n  const handleResetToGpsLocation = async () => {\n    pinPicker.cancelPinPicker(); clearOverlays(true); await geo.useCurrentGpsLocation();\n  };\n\n  const applyPromotion = (voucherId: VoucherId | null, targetMode?: PickupMode, targetIssue?: IssueType, targetStep: RescueStep = \'issue\') => {\n    clearOverlays(false); setSelectedIssue(targetIssue ?? null);\n    setPickupMode(targetMode ?? \'current_location\'); setSelectedVoucherId(voucherId);\n    setEnteredFromQuickStations(false); setStep(targetStep); setActiveTab(\'map\');\n  };\n\n  const handleSelectCampaignBanner = (b: CampaignBannerItem) =>\n    applyPromotion(b.voucherId, b.targetPickupMode, b.targetIssue, b.targetStep);\n\n  const handleSelectPartnerPerk = (p: PartnerPerkItem) =>\n    applyPromotion(p.voucherId, p.targetPickupMode, undefined, \'issue\');\n\n  return {\n    activeTab, setActiveTab, step, setStep, selectedIssue, setSelectedIssue,\n    customNote, setCustomNote, pickupMode, handleChangePickupMode,\n    selectedVoucherId, setSelectedVoucherId, selectedStationId, setSelectedStationId,\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\n    isLocationSearchOpen, setIsLocationSearchOpen, recenterSignal,\n    triggerRecenter: () => setRecenterSignal((c) => c + 1),\n    activityHistory, geo, repairShops, gasStations, activeInspect, pinPicker,\n    effectiveStations, pickupTarget, issueSummary, pricing, mechanicSim,\n    handleResetFlow, handleCompleteAndLog, handleConfirmRescue, handleDemoAdvance,\n    handleMechanicArrived, handleOpenMapWithStation, handleOpenMapWithRepairShop,\n    handleChangeMapFilter, handleSelectGasStationForRescue, handlePickSafeStationForRescue,\n    handleQuickCategory, handleQuickIssue, handleQuickSos, handleStartMapPinPicker,\n    handleConfirmMapPinPicker, handleSelectSearchLocation, handleResetToGpsLocation,\n    handleSelectCampaignBanner, handleSelectPartnerPerk,\n  };\n}"
