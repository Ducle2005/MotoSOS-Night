 />\n      </g>\n\n      <circle\n        cx=\"46\"\n        cy=\"58\"\n        r=\"4.2\"\n        fill=\"#0f172a\"\n        stroke=\"#475569\"\n        strokeWidth=\"0.8\"\n      />\n\n      {showWalkingRoute && selectedStationPoint && walkMid && (\n        <path\n          d={`M ${userPoint.x} ${userPoint.y} Q ${walkMid.x} ${walkMid.y} ${selectedStationPoint.x} ${selectedStationPoint.y}`}\n          fill=\"none\"\n          stroke=\"#34d399\"\n          strokeWidth=\"1.15\"\n          strokeDasharray=\"2 1.5\"\n          strokeLinecap=\"round\"\n        />\n      )}\n\n      {showMechanicRoute && (\n        <path\n          d={`M ${mechanicStartPoint.x} ${mechanicStartPoint.y} Q ${mechMid.x} ${mechMid.y} ${pickupPoint.x} ${pickupPoint.y}`}\n          fill=\"none\"\n          stroke=\"#f59e0b\"\n          strokeWidth=\"1.25\"\n          strokeLinecap=\"round\"\n        />\n      )}\n\n      <rect width=\"100\" height=\"100\" fill=\"url(#nightVignette)\" />\n    </svg>\n  );\n}\n"
