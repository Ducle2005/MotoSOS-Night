  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  Clock,\n  ExternalLink,\n  Fuel,\n  Loader2,\n  MapPin,\n  Navigation,\n  Phone,\n  Shield,\n  ShieldCheck,\n  Wrench,\n  X,\n} from \'lucide-react\';\nimport type { RouteSummaryInfo } from \'../../hooks/useActivePlaceInspect\';\nimport type {\n  GasStation,\n  InspectedPlace,\n  SafeStation,\n} from \'../../types/rescue\';\nimport { buildGoogleMapsDirectionsUrl } from \'../../utils/gasStationApi\';\nimport { buildPoliceGoogleMapsUrl } from \'../../utils/policeStationApi\';\nimport {\n  buildGoogleMapsSearchUrl,\n  formatShortCallLabel,\n} from \'../../utils/repairShopApi\';\n\ninterface FloatingPlaceCardProps {\n  place: InspectedPlace;\n  routeSummary: RouteSummaryInfo | null;\n  isLoadingRoute: boolean;\n  onRoutePlace: (place: InspectedPlace) => void;\n  onPickSafeStation: (station: SafeStation) => void;\n  onPickGasStation: (station: GasStation) => void;\n  onClose: () => void;\n}\n\nfunction formatDistanceValue(meters: number): string {\n  const safe = Math.max(0, Math.round(meters));\n  return safe < 1000 ? `${safe}m` : `${(safe / 1000).toFixed(1)} km`;\n}\n\nfunction getPlaceMeta(\n  place: InspectedPlace,\n  routeSummary: RouteSummaryInfo | null,\n) {\n  if (place.kind === \'safe_station\') {\n    return {\n      badge: place.station.categoryLabel,\n      badgeCls: \'bg-emerald-50 text-emerald-700 border-emerald-200/80\',\n      iconBg: \'bg-emerald-500 text-white\',\n      Icon: ShieldCheck,\n      name: place.station.name,\n      address: place.station.address,\n      meters: routeSummary?.distanceMeters ?? place.station.walkingDistanceMeters,\n      minutes: routeSummary?.durationMinutes ?? place.station.walkingMinutes,\n      timeUnit: \'ph\303\272t \304\221i b\341\273\231\',\n      phone: null as string | null,\n      mapsUrl: buildGoogleMapsDirectionsUrl(place.station.coord.lat, place.station.coord.lng),\n    };\n  }\n  if (place.kind === \'repair_shop\') {\n    return {\n      badge: \'Ti\341\273\207m s\341\273\255a xe \302\267 \304\220ang m\341\273\237\',\n      badgeCls: \'bg-blue-50 text-blue-700 border-blue-200/80\',\n      iconBg: \'bg-blue-600 text-white\',\n      Icon: Wrench,\n      name: place.shop.name,\n      address: place.shop.address,\n      meters: routeSummary?.distanceMeters ?? place.shop.distanceMeters,\n      minutes: routeSummary?.durationMinutes ?? place.shop.rideMinutes,\n      timeUnit: \'ph\303\272t ch\341\272\241y xe\',\n      phone: place.shop.phone,\n      mapsUrl: buildGoogleMapsSearchUrl(place.shop),\n    };\n  }\n  if (place.kind === \'police_station\') {\n    return {\n      badge: place.policeStation.isNearest ? \'C\303\264ng an \302\267 G\341\272\247n nh\341\272\245t\' : \'C\303\264ng an khu v\341\273\261c\',\n      badgeCls: \'bg-indigo-50 text-indigo-800 border-indigo-200/80\',\n      iconBg: \'bg-indigo-700 text-white\',\n      Icon: Shield,\n      name: place.policeStation.name,\n      address: place.policeStation.address,\n      meters: routeSummary?.distanceMeters ?? place.policeStation.distanceMeters,\n      minutes: routeSummary?.durationMinutes ?? place.policeStation.durationMinutes,\n      timeUnit: \'ph\303\272t di chuy\341\273\203n\',\n      phone: place.policeStation.phone,\n      mapsUrl: buildPoliceGoogleMapsUrl(place.policeStation),\n    };\n  }\n  return {\n    badge: place.gasStation.isNearest ? \'C\303\242y x\304\203ng g\341\272\247n nh\341\272\245t\' : \'C\303\242y x\304\203ng\',\n    badgeCls: \'bg-amber-50 text-amber-800 border-amber-200/80\',\n    iconBg: \'bg-amber-500 text-white\',\n    Icon: Fuel,\n    name: place.gasStation.name,\n    address: place.gasStation.address,\n    meters: routeSummary?.distanceMeters ?? place.gasStation.walkingDistanceMeters,\n    minutes: routeSummary?.durationMinutes ?? place.gasStation.walkingMinutes,\n    timeUnit: \'ph\303\272t d\341\272\257t b\341\273\231\',\n    phone: null as string | null,\n    mapsUrl: buildGoogleMapsDirectionsUrl(place.gasStation.coord.lat, place.gasStation.coord.lng),\n  };\n}\n\nexport function FloatingPlaceCard({\n  place,\n  routeSummary,\n  isLoadingRoute,\n  onRoutePlace,\n  onPickSafeStation,\n  onPickGasStation,\n  onClose,\n}: FloatingPlaceCardProps) {\n  const meta = getPlaceMeta(place, routeSummary);\n  const Icon = meta.Icon;\n\n  return (\n    <div\n      data-testid=\"floating-place-card\"\n      className=\"pointer-events-auto animate-step-enter rounded-2xl border border-slate-200/90 bg-white/95 p-3 shadow-[0_12px_32px_rgba(15,23,42,0.16)] backdrop-blur-md\"\n    >\n      <div className=\"flex items-start justify-between gap-2\">\n        <div className=\"flex min-w-0 items-start gap-2.5\">\n          <span\n            className={`mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl shadow-xs ${meta.iconBg}`}\n          >\n            <Icon className=\"h-4 w-4\" aria-hidden=\"true\" />\n          </span>\n\n          <div className=\"min-w-0\">\n            <div className=\"flex flex-wrap items-center gap-1.5\">\n              <span\n                className={`inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold whitespace-nowrap ${meta.badgeCls}`}\n              >\n                {meta.badge}\n              </span>\n              <span className=\"inline-flex items-center gap-1 font-sans text-[11px] font-bold tabular-nums text-slate-700 whitespace-nowrap\">\n                <Clock className=\"h-3 w-3 text-slate-400\" aria-hidden=\"true\" />\n                {formatDistanceValue(meta.meters)} \302\267 {meta.minutes} {meta.timeUnit}\n              </span>\n            </div>\n\n            <h3 className=\"mt-1 truncate text-sm font-extrabold text-slate-900\">\n              {meta.name}\n            </h3>\n            <p className=\"mt-0.5 flex items-center gap-1 truncate text-[11px] text-slate-500\">\n              <MapPin className=\"h-3 w-3 shrink-0 text-slate-400\" aria-hidden=\"true\" />\n              <span className=\"truncate\">{meta.address}</span>\n            </p>\n            {meta.phone && (\n              <p className=\"mt-0.5 flex items-center gap-1 font-sans text-[11.5px] font-bold tabular-nums text-blue-700\">\n                <Phone className=\"h-3 w-3 shrink-0\" aria-hidden=\"true\" />\n                <span>{meta.phone}</span>\n              </p>\n            )}\n          </div>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={onClose}\n          aria-label=\"\304\220\303\263ng th\341\272\273 \304\221\341\273\213a \304\221i\341\273\203m\"\n          className=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-700\"\n        >\n          <X className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n        </button>\n      </div>\n\n      <div className=\"mt-2.5 flex items-center gap-1.5\">\n        {meta.phone ? (\n          <a\n            href={`tel:${meta.phone.replace(/\\s+/g, \'\')}`}\n            className=\"inline-flex min-h-[34px] flex-1 items-center justify-center gap-1 rounded-xl bg-emerald-500 px-2.5 text-[11px] font-bold text-white shadow-xs transition-colors hover:bg-emerald-600 whitespace-nowrap\"\n          >\n            <Phone className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n            <span>{formatShortCallLabel(meta.phone)}</span>\n          </a>\n        ) : place.kind === \'police_station\' ? (\n          <a\n            href={meta.mapsUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex min-h-[34px] flex-1 items-center justify-center gap-1 rounded-xl border border-indigo-200 bg-indigo-50 px-2.5 text-[11px] font-bold text-indigo-700 transition-colors hover:bg-indigo-100 whitespace-nowrap\"\n          >\n            <Phone className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n            <span>G\341\273\215i \304\221i\341\273\207n</span>\n          </a>\n        ) : null}\n\n        <button\n          type=\"button\"\n          onClick={() => onRoutePlace(place)}\n          disabled={isLoadingRoute}\n          className=\"inline-flex min-h-[34px] flex-1 items-center justify-center gap-1 rounded-xl bg-slate-900 px-2.5 text-[11px] font-bold text-white shadow-xs transition-colors hover:bg-slate-800 disabled:opacity-70 whitespace-nowrap\"\n        >\n          {isLoadingRoute ? (\n            <Loader2 className=\"h-3.5 w-3.5 shrink-0 animate-spin\" aria-hidden=\"true\" />\n          ) : (\n            <Navigation className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n          )}\n          <span>\304\220\306\260\341\273\235ng \304\221i</span>\n        </button>\n\n        {place.kind === \'safe_station\' && (\n          <button\n            type=\"button\"\n            onClick={() => onPickSafeStation(place.station)}\n            className=\"inline-flex min-h-[34px] flex-1 items-center justify-center gap-1 rounded-xl bg-emerald-500 px-2.5 text-[11px] font-bold text-white shadow-xs transition-colors hover:bg-emerald-600 whitespace-nowrap\"\n          >\n            <ShieldCheck className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n            <span>\304\220\303\263n t\341\272\241i \304\221\303\242y</span>\n          </button>\n        )}\n\n        {place.kind === \'gas_station\' && (\n          <button\n            type=\"button\"\n            onClick={() => onPickGasStation(place.gasStation)}\n            className=\"inline-flex min-h-[34px] flex-1 items-center justify-center gap-1 rounded-xl bg-emerald-500 px-2.5 text-[11px] font-bold text-white shadow-xs transition-colors hover:bg-emerald-600 whitespace-nowrap\"\n          >\n            <ShieldCheck className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n            <span>\304\220\303\263n t\341\272\241i \304\221\303\242y</span>\n          </button>\n        )}\n\n        <a\n          href={meta.mapsUrl}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          aria-label=\"M\341\273\237 Google Maps\"\n          className=\"inline-flex min-h-[34px] items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white px-2.5 text-[11px] font-bold text-slate-700 transition-colors hover:bg-slate-50 whitespace-nowrap\"\n        >\n          <ExternalLink className=\"h-3.5 w-3.5 shrink-0 text-slate-500\" aria-hidden=\"true\" />\n          <span>Maps</span>\n        </a>\n      </div>\n    </div>\n  );\n}\n"
