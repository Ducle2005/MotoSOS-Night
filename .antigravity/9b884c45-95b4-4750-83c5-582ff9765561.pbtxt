    end_line: 215
    content: "import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\nimport {\n  FALLBACK_USER_LOCATION,\n  INITIAL_ACTIVITY_HISTORY,\n  ISSUE_OPTIONS,\n  MOCK_MECHANIC,\n  MOCK_SAFE_STATIONS,\n} from \'../data/mockRescueData\';\nimport type {\n  AppTab,\n  IssueType,\n  PickupMode,\n  RescueActivityItem,\n  RescueStep,\n  SafeStation,\n  SafeStationCategory,\n  TrackingStatus,\n} from \'../types/rescue\';\nimport {\n  buildMechanicApproachCoord,\n  findStationByCategory,\n  getIssueLabel,\n  getNearestSafeStation,\n  getNextDemoTrackingStatus,\n  resolvePickupTarget,\n} from \'../utils/rescueLogic\';\nimport { useRescueGeo } from \'./useRescueGeo\';\n\nexport function useRescueOrderState() {\n  const [activeTab, setActiveTab] = useState<AppTab>(\'home\');\n  const [step, setStep] = useState<RescueStep>(\'idle\');\n  const [selectedIssue, setSelectedIssue] = useState<IssueType | null>(null);\n  const [customNote, setCustomNote] = useState(\'\');\n  const [pickupMode, setPickupMode] = useState<PickupMode>(\'current_location\');\n  const [selectedStationId, setSelectedStationId] = useState<string | null>(\n    MOCK_SAFE_STATIONS[0]?.id ?? null,\n  );\n  const [inspectedStationId, setInspectedStationId] = useState<string | null>(null);\n  const [trackingStatus, setTrackingStatus] = useState<TrackingStatus>(\'searching\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [enteredFromQuickStations, setEnteredFromQuickStations] = useState(false);\n  const [recenterSignal, setRecenterSignal] = useState(0);\n  const [activityHistory, setActivityHistory] = useState<RescueActivityItem[]>(\n    INITIAL_ACTIVITY_HISTORY,\n  );\n  const [activeStationForRoute, setActiveStationForRoute] =\n    useState<SafeStation | null>(null);\n\n  const submitTimerRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    return () => {\n      if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current);\n    };\n  }, []);\n\n  const handleStationsReady = useCallback((nextStations: SafeStation[]) => {\n    const nearest = getNearestSafeStation(nextStations);\n    setSelectedStationId((prev) =>\n      nextStations.some((s) => s.id === prev) ? prev : (nearest?.id ?? null),\n    );\n  }, []);\n\n  const geo = useRescueGeo(\n    step,\n    pickupMode,\n    activeStationForRoute,\n    handleStationsReady,\n  );\n\n  const pickupTarget = useMemo(\n    () =>\n      resolvePickupTarget(\n        pickupMode,\n        geo.userLocation || FALLBACK_USER_LOCATION,\n        geo.stations,\n        selectedStationId,\n      ),\n    [pickupMode, geo.userLocation, geo.stations, selectedStationId],\n  );\n\n  useEffect(() => {\n    setActiveStationForRoute(pickupTarget.station);\n  }, [pickupTarget.station]);\n\n  const issueSummary = useMemo(\n    () => getIssueLabel(selectedIssue, ISSUE_OPTIONS, customNote),\n    [selectedIssue, customNote],\n  );\n\n  const mechanicCoord = useMemo(\n    () => buildMechanicApproachCoord(pickupTarget.coord),\n    [pickupTarget.coord.lat, pickupTarget.coord.lng],\n  );\n\n  const handleResetFlow = (returnToHome = false) => {\n    if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current);\n    setIsSubmitting(false);\n    setStep(\'idle\');\n    setSelectedIssue(null);\n    setCustomNote(\'\');\n    setPickupMode(\'current_location\');\n    setTrackingStatus(\'searching\');\n    setEnteredFromQuickStations(false);\n    setInspectedStationId(null);\n    geo.clearRoute();\n    if (returnToHome) setActiveTab(\'home\');\n  };\n\n  const handleCompleteAndLog = () => {\n    setActivityHistory((prev) => [\n      {\n        id: `act-${Date.now()}`,\n        issueLabel: issueSummary,\n        pickupAddress: pickupTarget.address,\n        mechanicName: MOCK_MECHANIC.name,\n        licensePlate: MOCK_MECHANIC.licensePlate,\n        timestampLabel: \'V\341\273\253a xong\',\n        status: \'completed\',\n      },\n      ...prev,\n    ]);\n    handleResetFlow(true);\n  };\n\n  const handleConfirmRescue = () => {\n    setIsSubmitting(true);\n    submitTimerRef.current = window.setTimeout(() => {\n      setIsSubmitting(false);\n      setTrackingStatus(\'searching\');\n      setStep(\'tracking\');\n    }, 400);\n  };\n\n  const handleDemoAdvance = () => {\n    setActiveTab(\'map\');\n    if (step !== \'tracking\') {\n      if (!selectedIssue) setSelectedIssue(\'flat_tire\');\n      setTrackingStatus(\'accepted\');\n      setStep(\'tracking\');\n      return;\n    }\n    if (trackingStatus === \'completed\') {\n      handleCompleteAndLog();\n      return;\n    }\n    setTrackingStatus((prev) => getNextDemoTrackingStatus(prev));\n  };\n\n  const handleOpenMapWithStation = (stationId: string) => {\n    if (stationId) setSelectedStationId(stationId);\n    setEnteredFromQuickStations(true);\n    setInspectedStationId(null);\n    setPickupMode(\'safe_station\');\n    setStep(\'pickup\');\n    setActiveTab(\'map\');\n  };\n\n  const handleQuickCategory = (category: SafeStationCategory) => {\n    const match = findStationByCategory(geo.stations, category);\n    handleOpenMapWithStation(match?.id ?? \'\');\n  };\n\n  const handleQuickIssue = (issue: IssueType) => {\n    setSelectedIssue(issue);\n    setEnteredFromQuickStations(false);\n    setStep(\'issue\');\n    setActiveTab(\'map\');\n  };\n\n  const handleQuickSos = () => {\n    setSelectedIssue(\'other\');\n    setCustomNote(\'SOS kh\341\272\251n c\341\272\245p ban \304\221\303\252m\');\n    setPickupMode(\'current_location\');\n    setEnteredFromQuickStations(false);\n    setStep(\'pickup\');\n    setActiveTab(\'map\');\n  };\n\n  return {\n    activeTab,\n    setActiveTab,\n    step,\n    setStep,\n    selectedIssue,\n    setSelectedIssue,\n    customNote,\n    setCustomNote,\n    pickupMode,\n    setPickupMode,\n    selectedStationId,\n    setSelectedStationId,\n    inspectedStationId,\n    setInspectedStationId,\n    trackingStatus,\n    isSubmitting,\n    enteredFromQuickStations,\n    setEnteredFromQuickStations,\n    recenterSignal,\n    triggerRecenter: () => setRecenterSignal((c) => c + 1),\n    activityHistory,\n    geo,\n    pickupTarget,\n    issueSummary,\n    mechanicCoord,\n    handleResetFlow,\n    handleCompleteAndLog,\n    handleConfirmRescue,\n    handleDemoAdvance,\n    handleOpenMapWithStation,\n    handleQuickCategory,\n    handleQuickIssue,\n    handleQuickSos,\n  };\n}\n"
    num_lines: 216
    num_bytes: 6081
    line_range_bytes: 6081
  }
}
