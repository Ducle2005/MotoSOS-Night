        replacement_chunks {
          target_content: "import { MapPin, Search, ShieldCheck } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type {\n  ActiveLocation,\n  IssueType,\n  RepairShop,\n  SafeStation,\n  SafeStationCategory,\n  UserLocation,\n} from \'../../types/rescue\';\nimport { HomeActionGrid } from \'./HomeActionGrid\';\nimport { NearbyRepairShopsSection } from \'./NearbyRepairShopsSection\';\nimport { NearbyStationsCarousel } from \'./NearbyStationsCarousel\';\nimport { VipNightShieldBanner } from \'./VipNightShieldBanner\';\n\ninterface HomeTabProps {\n  activeLocation: ActiveLocation;\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  isLoadingStations: boolean;\n  openRepairShops: RepairShop[];\n  isLoadingShops: boolean;\n  onOpenLocationSearch: () => void;\n  onCallMechanicNow: () => void;\n  onQuickIssueSelect: (issue: IssueType) => void;\n  onQuickCategorySelect: (category: SafeStationCategory) => void;\n  onQuickSosSelect: () => void;\n  onSelectStationCard: (stationId: string) => void;\n  onOpenRepairShopsMap: (shopId?: string) => void;\n  onTriggerDemoMechanic: () => void;\n}\n\nconst containerVariants = {\n  hidden: {},\n  show: {\n    transition: { staggerChildren: 0.06 },\n  },\n};\n\nconst itemVariants = {\n  hidden: { opacity: 0, y: 14 },\n  show: {\n    opacity: 1,\n    y: 0,\n    transition: { duration: 0.34, ease: [0.16, 1, 0.3, 1] as const },\n  },\n};\n\nexport function HomeTab({\n  activeLocation,\n  userLocation,\n  stations,\n  isLoadingStations,\n  openRepairShops,\n  isLoadingShops,\n  onOpenLocationSearch,\n  onCallMechanicNow,\n  onQuickIssueSelect,\n  onQuickCategorySelect,\n  onQuickSosSelect,\n  onSelectStationCard,\n  onOpenRepairShopsMap,\n  onTriggerDemoMechanic,\n}: HomeTabProps) {\n  const heroAddressLabel = activeLocation.isCurrentGPS\n    ? \'B\341\272\241n \304\221ang g\341\272\267p s\341\273\261 c\341\273\221 \341\273\237 \304\221\303\242u?\'\n    : activeLocation.address;\n\n  return (\n    <div className=\"relative flex-1 overflow-y-auto bg-[#F8FAFC] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n      {/* Ambient top radial emerald glow */}\n      <div\n        aria-hidden=\"true\"\n        className=\"pointer-events-none absolute inset-x-0 top-0 h-56 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-500/15 via-slate-50/50 to-transparent\"\n      />\n\n      <motion.div\n        variants={containerVariants}\n        initial=\"hidden\"\n        animate=\"show\"\n        className=\"relative z-10 px-5 pt-4 pb-28\"\n      >\n        {/* Header */}\n        <motion.header\n          variants={itemVariants}\n          className=\"flex items-center justify-between gap-2\"\n        >\n          <button\n            type=\"button\"\n            onClick={onOpenLocationSearch}\n            className=\"min-w-0 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-lg\"\n          >\n            <h1 className=\"text-lg font-extrabold tracking-tight text-slate-900\">\n              Xin ch\303\240o, T\303\240i x\341\272\277\n            </h1>\n            <p className=\"mt-0.5 flex items-center gap-1 text-xs text-slate-500\">\n              <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-500\" aria-hidden=\"true\" />\n              <span className=\"truncate\">{userLocation.address}</span>\n            </p>\n          </button>\n\n          <div className=\"flex shrink-0 items-center gap-1.5\">\n            <span className=\"inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-500/20 whitespace-nowrap\">\n              <ShieldCheck className=\"h-3.5 w-3.5 text-emerald-600\" aria-hidden=\"true\" />\n              <span>An to\303\240n 24/7</span>\n            </span>\n            <motion.button\n              type=\"button\"\n              whileTap={{ scale: 0.94 }}\n              onClick={onTriggerDemoMechanic}\n              className=\"inline-flex min-h-[30px] items-center rounded-full border border-slate-200/80 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 shadow-xs transition-colors hover:border-emerald-300 hover:text-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap\"\n            >\n              Test th\341\273\243\n            </motion.button>\n          </div>\n        </motion.header>\n\n        {/* Luxury Floating Hero Search & Quick Call Bar */}\n        <motion.div variants={itemVariants} className=\"mt-4\">\n          <div className=\"flex min-h-[58px] w-full items-center justify-between gap-2 rounded-full border border-emerald-500/30 bg-white pr-2 pl-3.5 py-1.5 shadow-[0_12px_32px_-8px_rgba(16,185,129,0.28)] ring-1 ring-inset ring-white transition-shadow hover:shadow-[0_16px_36px_-8px_rgba(16,185,129,0.36)]\">\n            <button\n              type=\"button\"\n              data-testid=\"open-location-search-btn\"\n              onClick={onOpenLocationSearch}\n              className=\"flex min-w-0 flex-1 items-center gap-2.5 py-2 text-left focus-visible:outline-none\"\n            >\n              <span className=\"relative flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600\">\n                <Search className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n              </span>\n              <span\n                className={`truncate text-sm font-semibold ${\n                  activeLocation.isCurrentGPS ? \'text-slate-600\' : \'text-slate-900\'\n                }`}\n              >\n                {heroAddressLabel}\n              </span>\n            </button>\n\n            <motion.button\n              type=\"button\"\n              whileTap={{ scale: 0.96 }}\n              onClick={onCallMechanicNow}\n              className=\"relative shrink-0 overflow-hidden rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-2.5 text-xs font-bold text-white shadow-md shadow-emerald-500/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap\"\n            >\n              <span\n                aria-hidden=\"true\"\n                className=\"animate-shimmer-sweep pointer-events-none absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-transparent via-white/40 to-transparent\"\n              />\n              <span className=\"relative z-10\">G\341\273\215i th\341\273\243 ngay</span>\n            </motion.button>\n          </div>\n        </motion.div>\n\n        <motion.div variants={itemVariants}>\n          <HomeActionGrid\n            onQuickIssueSelect={onQuickIssueSelect}\n            onQuickCategorySelect={onQuickCategorySelect}\n            onQuickSosSelect={onQuickSosSelect}\n          />\n        </motion.div>\n\n        <motion.div variants={itemVariants}>\n          <VipNightShieldBanner\n            onAction={() => onSelectStationCard(stations[0]?.id ?? \'\')}\n          />\n        </motion.div>\n\n        <motion.div variants={itemVariants}>\n          <NearbyStationsCarousel\n            stations={stations}\n            isLoadingStations={isLoadingStations}\n            onSelectStationCard={onSelectStationCard}\n            onViewMap={() => onQuickCategorySelect(\'convenience\')}\n          />\n        </motion.div>\n\n        <motion.div variants={itemVariants}>\n          <NearbyRepairShopsSection\n            shops={openRepairShops}\n            isLoading={isLoadingShops}\n            onSelectShop={(shopId) => onOpenRepairShopsMap(shopId)}\n            onViewAllOnMap={() => onOpenRepairShopsMap()}\n          />\n        </motion.div>\n      </motion.div>\n    </div>\n  );\n}"
          replacement_content: "import { Crown, MapPin, Search } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type { CampaignBannerItem, PartnerPerkItem } from \'../../data/homePromotions\';\nimport type {\n  ActiveLocation,\n  IssueType,\n  RepairShop,\n  SafeStation,\n  SafeStationCategory,\n  UserLocation,\n} from \'../../types/rescue\';\nimport { CampaignBannerCarousel } from \'./CampaignBannerCarousel\';\nimport { HomeActionGrid } from \'./HomeActionGrid\';\nimport { NearbyRepairShopsSection } from \'./NearbyRepairShopsSection\';\nimport { NearbyStationsCarousel } from \'./NearbyStationsCarousel\';\nimport { PartnerPerksCarousel } from \'./PartnerPerksCarousel\';\n\ninterface HomeTabProps {\n  activeLocation: ActiveLocation;\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  isLoadingStations: boolean;\n  openRepairShops: RepairShop[];\n  isLoadingShops: boolean;\n  onOpenLocationSearch: () => void;\n  onCallMechanicNow: () => void;\n  onQuickIssueSelect: (issue: IssueType) => void;\n  onQuickCategorySelect: (category: SafeStationCategory) => void;\n  onQuickSosSelect: () => void;\n  onSelectStationCard: (stationId: string) => void;\n  onOpenRepairShopsMap: (shopId?: string) => void;\n  onTriggerDemoMechanic: () => void;\n  onSelectCampaignBanner: (banner: CampaignBannerItem) => void;\n  onSelectPartnerPerk: (perk: PartnerPerkItem) => void;\n}\n\nconst containerVariants = {\n  hidden: {},\n  show: {\n    transition: { staggerChildren: 0.05 },\n  },\n};\n\nconst itemVariants = {\n  hidden: { opacity: 0, y: 12 },\n  show: {\n    opacity: 1,\n    y: 0,\n    transition: { duration: 0.32, ease: [0.16, 1, 0.3, 1] as const },\n  },\n};\n\nexport function HomeTab({\n  activeLocation,\n  userLocation,\n  stations,\n  isLoadingStations,\n  openRepairShops,\n  isLoadingShops,\n  onOpenLocationSearch,\n  onCallMechanicNow,\n  onQuickIssueSelect,\n  onQuickCategorySelect,\n  onQuickSosSelect,\n  onSelectStationCard,\n  onOpenRepairShopsMap,\n  onTriggerDemoMechanic,\n  onSelectCampaignBanner,\n  onSelectPartnerPerk,\n}: HomeTabProps) {\n  const heroAddressLabel = activeLocation.isCurrentGPS\n    ? \'B\341\272\241n \304\221ang g\341\272\267p s\341\273\261 c\341\273\221 \341\273\237 \304\221\303\242u?\'\n    : activeLocation.address;\n\n  return (\n    <div className=\"relative flex-1 overflow-y-auto bg-[#F8FAFC] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n      <motion.div\n        variants={containerVariants}\n        initial=\"hidden\"\n        animate=\"show\"\n        className=\"pb-28\"\n      >\n        {/* Obsidian Dark Priority Header */}\n        <header className=\"relative overflow-hidden rounded-b-[32px] bg-[#090D16] px-5 pt-5 pb-12 text-white\">\n          <div\n            aria-hidden=\"true\"\n            className=\"pointer-events-none absolute -top-12 -right-8 h-48 w-48 rounded-full bg-emerald-500/20 blur-3xl\"\n          />\n          <div\n            aria-hidden=\"true\"\n            className=\"pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-amber-400/10 blur-3xl\"\n          />\n\n          <motion.div\n            variants={itemVariants}\n            className=\"relative z-10 flex items-start justify-between gap-2\"\n          >\n            <div className=\"min-w-0 flex-1\">\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h1 className=\"text-[19px] font-extrabold tracking-tight text-white\">\n                  MotoSOS Priority\n                </h1>\n                <span className=\"inline-flex items-center gap-1 rounded-full border border-amber-300/40 bg-amber-400/15 px-2 py-0.5 text-[10px] font-bold tracking-wide text-amber-200 whitespace-nowrap\">\n                  <Crown className=\"h-3 w-3 text-amber-300\" aria-hidden=\"true\" />\n                  <span>24/7 VIP Rescue</span>\n                </span>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={onOpenLocationSearch}\n                className=\"mt-1.5 flex max-w-full items-center gap-1 rounded-lg text-left text-xs text-slate-300 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400\"\n              >\n                <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-400\" aria-hidden=\"true\" />\n                <span className=\"truncate\">{userLocation.address}</span>\n              </button>\n            </div>\n\n            <motion.button\n              type=\"button\"\n              whileTap={{ scale: 0.94 }}\n              onClick={onTriggerDemoMechanic}\n              className=\"inline-flex min-h-[30px] shrink-0 items-center rounded-full border border-white/15 bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 whitespace-nowrap\"\n            >\n              Test th\341\273\243\n            </motion.button>\n          </motion.div>\n\n          {/* Dark Frosted Glass Search & Instant Rescue Bar */}\n          <motion.div variants={itemVariants} className=\"relative z-10 mt-4\">\n            <div className=\"flex w-full items-center justify-between gap-2 rounded-2xl border border-white/15 bg-white/10 p-1.5 backdrop-blur-xl\">\n              <button\n                type=\"button\"\n                data-testid=\"open-location-search-btn\"\n                onClick={onOpenLocationSearch}\n                className=\"flex min-w-0 flex-1 items-center gap-2.5 px-2 py-2 text-left focus-visible:outline-none\"\n              >\n                <span className=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-white/10 text-emerald-300\">\n                  <Search className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                </span>\n                <span\n                  className={`truncate text-sm font-medium ${\n                    activeLocation.isCurrentGPS ? \'text-slate-200\' : \'font-semibold text-white\'\n                  }`}\n                >\n                  {heroAddressLabel}\n                </span>\n              </button>\n\n              <motion.button\n                type=\"button\"\n                whileTap={{ scale: 0.96 }}\n                onClick={onCallMechanicNow}\n                className=\"shrink-0 rounded-xl bg-emerald-500 px-3.5 py-2.5 text-xs font-bold text-slate-950 shadow-lg shadow-emerald-500/25 transition-colors hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 whitespace-nowrap\"\n              >\n                G\341\273\215i th\341\273\243 ngay\n              </motion.button>\n            </div>\n          </motion.div>\n        </header>\n\n        {/* Elevated Floating 8-Icon Service Grid */}\n        <motion.div variants={itemVariants}>\n          <HomeActionGrid\n            onQuickIssueSelect={onQuickIssueSelect}\n            onQuickCategorySelect={onQuickCategorySelect}\n            onQuickSosSelect={onQuickSosSelect}\n          />\n        </motion.div>\n\n        <div className=\"px-5\">\n          <motion.div variants={itemVariants}>\n            <CampaignBannerCarousel onSelectBanner={onSelectCampaignBanner} />\n          </motion.div>\n\n          <motion.div variants={itemVariants}>\n            <NearbyStationsCarousel\n              stations={stations}\n              isLoadingStations={isLoadingStations}\n              onSelectStationCard={onSelectStationCard}\n              onViewMap={() => onQuickCategorySelect(\'convenience\')}\n            />\n          </motion.div>\n\n          <motion.div variants={itemVariants}>\n            <PartnerPerksCarousel onSelectPerk={onSelectPartnerPerk} />\n          </motion.div>\n\n          <motion.div variants={itemVariants}>\n            <NearbyRepairShopsSection\n              shops={openRepairShops}\n              isLoading={isLoadingShops}\n              onSelectShop={(shopId) => onOpenRepairShopsMap(shopId)}\n              onViewAllOnMap={() => onOpenRepairShopsMap()}\n            />\n          </motion.div>\n        </div>\n      </motion.div>\n    </div>\n  );\n}"
