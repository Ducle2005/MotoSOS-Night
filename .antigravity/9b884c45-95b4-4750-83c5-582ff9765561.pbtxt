      full: "### Browser `default` opened with pid 14363.### Ran Playwright code```jsawait page.goto(\'http://localhost:3000\');```### Page- Page URL: http://localhost:3000/- Page Title: MotoSOS \342\200\224 C\341\273\251u h\341\273\231 xe m\303\241y & Tr\341\272\241m An To\303\240n 24/7### Snapshot- [Snapshot](.playwright-cli/page-2026-11-14T11-03-33-803Z.yml)### Events- New console entries: .playwright-cli/console-2026-11-14T11-03-32-872Z.log#L1### Ran Playwright code```jsawait page.setViewportSize({ width: 430, height: 900 });```### Result\"{\\n  \\\"homeTelCount\\\": 3,\\n  \\\"firstShopText\\\": \\\"H\341\272\273m 18A Nguy\341\273\205n Th\341\273\213 Minh Khai | \304\220ang m\341\273\237 \342\200\242 1.1 km \342\200\242 TP.HCM | 0978 312 690 | G\341\273\215i 0978... | \304\220\306\260\341\273\235ng \304\221i\\\",\\n  \\\"cardTextFromHome\\\": \\\"Ti\341\273\207m s\341\273\255a xe \302\267 \304\220ang m\341\273\237 | 1.9 km \302\267 3 ph\303\272t ch\341\272\241y xe | H\341\272\273m 18A Nguy\341\273\205n Th\341\273\213 Minh Khai | TP.HCM | 0978 312 690 | G\341\273\215i 0978... | \304\220\306\260\341\273\235ng \304\221i | Maps\\\",\\n  \\\"pinsInAllMode\\\": {\\n    \\\"safePins\\\": 0,\\n    \\\"shopPins\\\": 8,\\n    \\\"gasPins\\\": 4,\\n    \\\"inViewportShopIndex\\\": 1\\n  },\\n  \\\"chipsOnStep1\\\": true,\\n  \\\"chipsOnStep2\\\": true,\\n  \\\"layoutMetrics\\\": {\\n    \\\"listTop\\\": 388,\\n    \\\"listBottom\\\": 598,\\n    \\\"listHeight\\\": 210,\\n    \\\"btnTop\\\": 780,\\n    \\\"gapPx\\\": 182,\\n    \\\"listTelCount\\\": 8\\n  },\\n  \\\"collapsedCardVisible\\\": true\\n}\"### Ran Playwright code```jsawait (async (page) => {  await page.waitForTimeout(2200);  // Test A: Home tab nearby repair shops with phone + 1-tap call + Directions  const firstShop = page.locator(\"[data-testid^=\\\"home-repair-shop-\\\"]\").first();  await firstShop.scrollIntoViewIfNeeded();  await page.waitForTimeout(300);  const homeTelCount = await page.locator(\"[data-testid^=\\\"home-repair-shop-\\\"] a[href^=\\\"tel:\\\"]\").count();  const firstShopText = await firstShop.innerText();  // Click \"\304\220\306\260\341\273\235ng \304\221i\" on the first Home repair shop -> opens Map tab, draws route, opens FloatingPlaceCard  await firstShop.getByRole(\"button\", { name: /\304\220\306\260\341\273\235ng \304\221i/i }).click();  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 10000 });  await page.waitForTimeout(1400);  const cardTextFromHome = await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").innerText();  // Test B: Close FloatingPlaceCard -> click \"T\341\272\245t c\341\272\243\" tab -> verify all 3 marker layers in viewport -> click repair shop pin  await page.locator(\"[data-testid=\\\"floating-place-card\\\"] button\").first().click();  await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").getByRole(\"tab\", { name: /^T\341\272\245t c\341\272\243$/i }).click();  await page.waitForTimeout(2500);  const safePins = await page.locator(\"[data-testid^=\\\"station-marker-\\\"]\").count();  const shopPins = await page.locator(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").count();  const gasPins = await page.locator(\"[data-testid^=\\\"gas-station-marker-\\\"]\").count();  const inViewportShopIndex = await page.evaluate(() => {    const els = Array.from(document.querySelectorAll(\"[data-testid^=\\\"repair-shop-marker-\\\"]\"));    return els.findIndex((el) => {      const r = el.getBoundingClientRect();      return r.left >= 10 && r.right <= 420 && r.top >= 110 && r.bottom <= 560;    });  });  if (inViewportShopIndex >= 0) {    await page.locator(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").nth(inViewportShopIndex).click();  } else {    await page.locator(\"[data-testid^=\\\"repair-shop-marker-\\\"]\").first().click({ force: true });  }  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 10000 });  await page.waitForTimeout(1400);  await page.screenshot({ path: \".playwright-cli/verify-map-all.png\" });  // Close floating card before Step 1/2 flow  await page.locator(\"[data-testid=\\\"floating-place-card\\\"] button\").first().click();  await page.waitForTimeout(300);  // Test C: Idle -> Step 1 -> Step 2 (check filter chips, Step 2 list vs invoice non-overlap, call & route, collapse sheet)  await page.getByRole(\"button\", { name: /G\341\273\214I S\341\273\254A XE KH\341\272\250N C\341\272\244P/i }).click();  await page.waitForTimeout(400);  const chipsOnStep1 = await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").isVisible();  await page.getByText(\"L\341\273\247ng l\341\273\221p\", { exact: false }).first().click();  await page.waitForTimeout(200);  await page.getByRole(\"button\", { name: /Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 th\341\273\243/i }).click();  await page.locator(\"[data-testid=\\\"step2-place-list\\\"]\").waitFor({ state: \"visible\", timeout: 8000 });  await page.waitForTimeout(500);  const chipsOnStep2 = await page.locator(\"[data-testid=\\\"map-filter-chips\\\"]\").isVisible();  const layoutMetrics = await page.evaluate(() => {    const list = document.querySelector(\"[data-testid=\\\"step2-place-list\\\"]\")?.getBoundingClientRect();    const btn = document.querySelector(\"[data-testid=\\\"confirm-order-btn\\\"]\")?.getBoundingClientRect();    const listTelCount = document.querySelectorAll(\"[data-testid=\\\"step2-place-list\\\"] a[href^=\\\"tel:\\\"]\").length;    return {      listTop: list ? Math.round(list.top) : null,      listBottom: list ? Math.round(list.bottom) : null,      listHeight: list ? Math.round(list.height) : null,      btnTop: btn ? Math.round(btn.top) : null,      gapPx: list && btn ? Math.round(btn.top - list.bottom) : null,      listTelCount    };  });  await page.screenshot({ path: \".playwright-cli/verify-step2-list.png\" });  // Click \"\304\220\306\260\341\273\235ng \304\221i\" on a Step 2 list item, then collapse Bottom Sheet to confirm map + route + floating card visible  await page.locator(\"[data-testid=\\\"step2-place-list\\\"]\").getByRole(\"button\", { name: /\304\220\306\260\341\273\235ng \304\221i/i }).first().click();  await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").waitFor({ state: \"visible\", timeout: 10000 });  await page.waitForTimeout(1200);  await page.locator(\"[data-testid=\\\"toggle-sheet-btn\\\"]\").click();  await page.waitForTimeout(450);  const collapsedCardVisible = await page.locator(\"[data-testid=\\\"floating-place-card\\\"]\").isVisible();  await page.screenshot({ path: \".playwright-cli/verify-step2-collapsed.png\" });  return JSON.stringify({    homeTelCount,    firstShopText: firstShopText.replace(/\\n+/g, \" | \"),    cardTextFromHome: cardTextFromHome.replace(/\\n+/g, \" | \"),    pinsInAllMode: { safePins, shopPins, gasPins, inViewportShopIndex },    chipsOnStep1,    chipsOnStep2,    layoutMetrics,    collapsedCardVisible  }, null, 2);})(page);```### Page- Page URL: http://localhost:3000/- Page Title: MotoSOS \342\200\224 C\341\273\251u h\341\273\231 xe m\303\241y & Tr\341\272\241m An To\303\240n 24/7### ResultTotal messages: 5 (Errors: 0, Warnings: 0)Returning 0 messages for level \"error\"\n\n### Latest snapshot (.playwright-cli/page-2026-11-14T11-03-33-803Z.yml)\n```yaml\n- generic [ref=e4]:\n  - main [ref=e5]:\n    - generic [ref=e7]:\n      - generic [ref=e8]:\n        - generic [ref=e9]:\n          - generic [ref=e10]:\n            - generic [ref=e11]:\n              - heading \"MotoSOS Priority\" [level=1] [ref=e12]\n              - generic [ref=e13]: 24/7 VIP Rescue\n            - button \"Trung t\303\242m Qu\341\272\255n 1, TP. H\341\273\223 Ch\303\255 Minh\" [ref=e17]\n          - button \"Test th\341\273\243\" [ref=e22]\n        - generic [ref=e24]:\n          - button \"B\341\272\241n \304\221ang g\341\272\267p s\341\273\261 c\341\273\221 \341\273\237 \304\221\303\242u?\" [ref=e25]\n