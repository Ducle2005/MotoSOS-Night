        instruction: "import { AlertTriangle, ChevronRight, Fuel, MapPin, Shield, Store } from \'lucide-react\';\nimport type { SafeStation, SafeStationCategory, UserLocation } from \'../../types/rescue\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\n\ninterface IdleHomeStepProps {\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  selectedStationId: string | null;\n  onInspectStation: (stationId: string) => void;\n  onStartOrder: () => void;\n}\n\nfunction StationCategoryIcon({ category }: { category: SafeStationCategory }) {\n  if (category === \'convenience\') {\n    return <Store className=\"h-4 w-4 text-emerald-400\" aria-hidden=\"true\" />;\n  }\n  if (category === \'gas_station\') {\n    return <Fuel className=\"h-4 w-4 text-emerald-400\" aria-hidden=\"true\" />;\n  }\n  return <Shield className=\"h-4 w-4 text-emerald-400\" aria-hidden=\"true\" />;\n}\n\nexport function IdleHomeStep({\n  userLocation,\n  stations,\n  selectedStationId,\n  onInspectStation,\n  onStartOrder,\n}: IdleHomeStepProps) {\n  return (\n    <div className=\"flex min-h-0 flex-1 flex-col\">\n      <div className=\"flex-1 overflow-y-auto px-5 pt-2 pb-5 lg:px-6 lg:pt-6\">\n        <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n          <MapPin className=\"h-3.5 w-3.5 shrink-0 text-sky-400\" aria-hidden=\"true\" />\n          <span className=\"truncate\">{userLocation.address}</span>\n        </div>\n        <h1 className=\"mt-1.5 text-xl font-bold tracking-tight text-slate-50 text-balance\">\n          C\341\273\251u h\341\273\231 xe m\303\241y ban \304\221\303\252m\n        </h1>\n        <p className=\"mt-1 text-sm text-slate-400\">\n          C\303\263 {stations.length} Tr\341\272\241m An To\303\240n m\341\273\237 24/7 trong b\303\241n k\303\255nh \304\221i b\341\273\231 quanh b\341\272\241n.\n        </p>\n\n        {/* Primary Emergency CTA */}\n        <button\n          type=\"button\"\n          onClick={onStartOrder}\n          className=\"mt-4 flex min-h-[54px] w-full items-center justify-center gap-2.5 rounded-2xl bg-amber-500 px-5 py-3.5 text-base font-extrabold tracking-tight text-slate-950 shadow-lg shadow-amber-500/20 transition-all duration-150 hover:bg-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 active:scale-[0.98]\"\n        >\n          <AlertTriangle className=\"h-5 w-5 shrink-0\" aria-hidden=\"true\" />\n          <span>G\341\273\214I S\341\273\254A XE KH\341\272\250N C\341\272\244P</span>\n        </button>\n\n        {/* Nearby Safe Stations quick list */}\n        <div className=\"mt-4\">\n          <div className=\"mb-2 flex items-center justify-between\">\n            <h2 className=\"text-xs font-semibold text-slate-300\">\n              Tr\341\272\241m An To\303\240n m\341\273\237 24/7 g\341\272\247n b\341\272\241n\n            </h2>\n            <span className=\"text-xs text-slate-400\">Ch\341\272\241m \304\221\341\273\203 xem</span>\n          </div>\n\n          <ul className=\"divide-y divide-slate-800/80 rounded-2xl border border-slate-800 bg-slate-950/50\">\n            {stations.map((station) => {\n              const isSelected = selectedStationId === station.id;\n              return (\n                <li key={station.id}>\n                  <button\n                    type=\"button\"\n                    onClick={() => onInspectStation(station.id)}\n                    className={`flex min-h-[56px] w-full items-center gap-3 px-3.5 py-2.5 text-left transition-colors hover:bg-slate-800/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-400 ${\n                      isSelected ? \'bg-emerald-950/35\' : \'\'\n                    }`}\n                  >\n                    <span className=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-800/90\">\n                      <StationCategoryIcon category={station.category} />\n                    </span>\n                    <div className=\"min-w-0 flex-1\">\n                      <p className=\"truncate text-sm font-semibold text-slate-100\">\n                        {station.name}\n                      </p>\n                      <p className=\"mt-0.5 truncate text-xs text-slate-400\">\n                        {station.categoryLabel}\n                        <span aria-hidden=\"true\"> \302\267 </span>\n                        <span className=\"font-mono tabular-nums text-emerald-400\">\n                          {formatWalkingDistance(\n                            station.walkingDistanceMeters,\n                            station.walkingMinutes,\n                          )}\n                        </span>\n                      </p>\n                    </div>\n                    <ChevronRight className=\"h-4 w-4 shrink-0 text-slate-500\" aria-hidden=\"true\" />\n                  </button>\n                </li>\n              );\n            })}\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/IdleHomeStep.tsx"
        }
        overwrite: true
      }
    }
