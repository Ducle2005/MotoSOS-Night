      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Position simulated mechanic start coordinate ~1.3km away from the pickup point\", \"EndLine\":136, \"Instruction\":\"Update buildMechanicApproachCoord to place mechanic ~1.3km away from pickupCoord\", \"ReplacementContent\":\"export function buildMechanicApproachCoord(pickupCoord: GeoCoord): GeoCoord {\\n  return {\\n    lat: pickupCoord.lat - 0.0082,\\n    lng: pickupCoord.lng + 0.0085,\\n  };\\n}\", \"StartLine\":128, \"TargetContent\":\"export function buildMechanicApproachCoord(pickupCoord: GeoCoord): GeoCoord {\\n  return {\\n    lat: pickupCoord.lat - 0.0065,\\n    lng: pickupCoord.lng + 0.0058,\\n  };\\n}\", \"TargetFile\":\"/src/utils/rescueLogic.ts\", \"toolAction\":\"Updating mechanic starting offset to ~1.3km\", \"toolSummary\":\"Update mechanic start distance in rescueLogic.ts\"}"
