      thinking_signature: "\022\255\t\n\252\t\001i\024}\023]U\333\201c(\333\3611J\323@\306\373\000xl\336\'\276\332\200\341u\177\271\031\360\243\352VF\031tf\226\252I\356x \200\302]y\027\264p}\030\001\271\333\tY\376\245\303\217(\333\204\036\352H6\314\344e\262\203O\257\264\356C\363L7\035\254`s~f\374\362\370;:R\b\260\025\272=s\'\244a\005N9\225V\0257f\b\332\221\255\272\337&d\307{\220\231\250.<\002tF\267\002\366/\3502\262\3062l\204x\210\305:Ac=0\213,\357\352\344\243\300]\347Qw\260\253\330\334\240\345\311t7fk\0311*\005+\336\3328Do\301D\210\326\035CO\264o\374\342<\370k\026\202\335\277\220H\203\365q\336\201\216\253\203\346)\032-\252H\231\027E\244\216\325\373\034s`\313\n\f\347\302\370\206}\221:\233\234\324\236\261F\271\362\002\367\332\257\344\247\225/6\353*\356\244\305^(\334Y\202\261\033;\244P\343c\324\025Y\335\v\306\372\367n\373\r\370\324?\272.\326\312\242\2658R\252\264WV\204\005\'\212<\243s\327%C=u\016m\277-M\204\302X\324\315\256e\256\v\016t\206\270\352\3336\365\334O\201\035>\"\246.\271\035\336\3342\235\324q\267\305\025\250O\270\214o\231p\261T\333\310iU\205A?B\331=\254(\375\210\367/\"w\336XB\270}\332\030\031\236\2304\271\325\222$\0169(\246*\004\"\3350j\377}7\204\227\2452\345\332z\263St\255P\020\033\360\334\2155\271oA\371\226\r\352x\346\201\261\310\001\213Q\312YtjZG\a\322\250\357\267\233\303\n\202\336\265\226\215r\002\031\327\306\025\036Qf\357\2520\266\302\334\265\307\216o\276\251\224jx\2737u\206l\375-rD\0353\310;\206i\227\365f\253=e3\r5\266\346\361\263\216;9\033WKT\247\204}S\354\346\334\017\214\342\332D\264\'\311\326\310\251Yr\312\364\242\322o\177-\205\271\177\320\f\231W\036\022\224\272\300:\254Y\232|\257l\351\335\344\225\234\fv\3551\216\240\257\277HR)\244\314\277\237\034\244\302 \232\2460\202\3722\024\372\b\303\241i\026\266\365\370\252\320-X\206\275\365\324%\275\227\331\251O\001\037[-|\027\342#4I\365\377l=\263hQ\327=\237I\225C\252\316\265\244U\352_\202\374y\205\250q\261**\000HB6S\254\311\215\233\346\343\221R\272/\274\004\237\262t\225\332\024\343\017-E\017!\264O9/\274KK\242