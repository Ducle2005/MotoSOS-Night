  code_action {
    action_spec {
      create_file {
        instruction: "import { Bell, BellRing, CheckCheck, X } from \'lucide-react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport { useMemo, useState } from \'react\';\nimport type {\n  AppNotification,\n  BrowserPushPermission,\n  NotificationFilterTab,\n} from \'../../types/notification\';\nimport { filterNotifications } from \'../../utils/notificationLogic\';\nimport { NotificationItemRow } from \'./NotificationItemRow\';\n\ninterface NotificationCenterModalProps {\n  isOpen: boolean;\n  notifications: AppNotification[];\n  unreadCount: number;\n  permission: BrowserPushPermission;\n  isDevicePushEnabled: boolean;\n  onToggleDevicePush: () => void;\n  onMarkAllRead: () => void;\n  onSelectNotification: (item: AppNotification) => void;\n  onClose: () => void;\n}\n\nconst FILTER_TABS: { id: NotificationFilterTab; label: string }[] = [\n  { id: \'all\', label: \'T\341\272\245t c\341\272\243\' },\n  { id: \'rescue\', label: \'C\341\273\251u h\341\273\231\' },\n  { id: \'promo\', label: \'\306\257u \304\221\303\243i\' },\n  { id: \'safety\', label: \'An to\303\240n\' },\n];\n\nexport function NotificationCenterModal({\n  isOpen,\n  notifications,\n  unreadCount,\n  permission,\n  isDevicePushEnabled,\n  onToggleDevicePush,\n  onMarkAllRead,\n  onSelectNotification,\n  onClose,\n}: NotificationCenterModalProps) {\n  const [activeFilter, setActiveFilter] = useState<NotificationFilterTab>(\'all\');\n\n  const visibleItems = useMemo(\n    () => filterNotifications(notifications, activeFilter),\n    [notifications, activeFilter],\n  );\n\n  return (\n    <AnimatePresence>\n      {isOpen && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className=\"absolute inset-0 z-[90] flex flex-col justify-end bg-slate-950/55 backdrop-blur-[2px]\"\n          onClick={onClose}\n        >\n          <motion.section\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-label=\"Trung t\303\242m th\303\264ng b\303\241o\"\n            data-testid=\"notification-center-modal\"\n            initial={{ y: \'100%\' }}\n            animate={{ y: 0 }}\n            exit={{ y: \'100%\' }}\n            transition={{ type: \'spring\', stiffness: 360, damping: 34 }}\n            onClick={(e) => e.stopPropagation()}\n            className=\"flex max-h-[86dvh] w-full flex-col overflow-hidden rounded-t-[28px] bg-[#F8FAFC] shadow-2xl\"\n          >\n            {/* Modal Header */}\n            <div className=\"flex items-center justify-between border-b border-slate-200/80 bg-white px-5 py-4\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-slate-900 text-white\">\n                  <Bell className=\"h-4 w-4\" aria-hidden=\"true\" />\n                </div>\n                <div>\n                  <h2 className=\"text-base font-extrabold text-slate-900\">\n                    Trung t\303\242m th\303\264ng b\303\241o\n                  </h2>\n                  <p className=\"text-xs text-slate-500\">\n                    {unreadCount > 0 ? `${unreadCount} th\303\264ng b\303\241o ch\306\260a \304\221\341\273\215c` : \'\304\220\303\243 \304\221\341\273\215c t\341\272\245t c\341\272\243\'}\n                  </p>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                aria-label=\"\304\220\303\263ng trung t\303\242m th\303\264ng b\303\241o\"\n                onClick={onClose}\n                className=\"flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-slate-200\"\n              >\n                <X className=\"h-4 w-4\" aria-hidden=\"true\" />\n              </button>\n            </div>\n\n            {/* Quick Device Push Toggle Bar */}\n            <div className=\"border-b border-slate-200/70 bg-white px-5 py-3\">\n              <div className=\"flex items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-slate-50 px-3.5 py-2.5\">\n                <div className=\"flex min-w-0 items-center gap-2.5\">\n                  <BellRing className=\"h-4 w-4 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n                  <div className=\"min-w-0\">\n                    <p className=\"truncate text-xs font-bold text-slate-900\">\n                      Nh\341\272\255n th\303\264ng b\303\241o \304\221\341\272\251y tr\303\252n thi\341\272\277t b\341\273\213\n                    </p>\n                    {permission === \'denied\' && (\n                      <p className=\"text-[11px] text-rose-600\">\n                        Tr\303\254nh duy\341\273\207t \304\221ang ch\341\272\267n \342\200\224 h\303\243y c\341\272\245p quy\341\273\201n trong c\303\240i \304\221\341\272\267t web.\n                      </p>\n                    )}\n                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  data-testid=\"toggle-device-push-btn\"\n                  onClick={onToggleDevicePush}\n                  disabled={permission === \'unsupported\'}\n                  className={`shrink-0 rounded-full px-3 py-1 text-xs font-bold transition-colors ${\n                    isDevicePushEnabled\n                      ? \'bg-emerald-600 text-white hover:bg-emerald-700\'\n                      : \'bg-slate-900 text-white hover:bg-slate-800 disabled:opacity-40\'\n                  }`}\n                >\n                  {permission === \'unsupported\'\n                    ? \'Kh\303\264ng h\341\273\227 tr\341\273\243\'\n                    : isDevicePushEnabled\n                      ? \'\304\220\303\243 b\341\272\255t\'\n                      : \'B\341\272\255t ngay\'}\n                </button>\n              </div>\n\n              {/* Filter Chips & Mark All Read */}\n              <div className=\"mt-3 flex items-center justify-between gap-2\">\n                <div className=\"flex items-center gap-1.5 overflow-x-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n                  {FILTER_TABS.map((tab) => {\n                    const active = activeFilter === tab.id;\n                    return (\n                      <button\n                        key={tab.id}\n                        type=\"button\"\n                        data-testid={`notif-filter-${tab.id}`}\n                        onClick={() => setActiveFilter(tab.id)}\n                        className={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold transition-colors whitespace-nowrap ${\n                          active\n                            ? \'bg-slate-900 text-white\'\n                            : \'bg-slate-100 text-slate-600 hover:bg-slate-200\'\n                        }`}\n                      >\n                        {tab.label}\n                      </button>\n                    );\n                  })}\n                </div>\n                <button\n                  type=\"button\"\n                  data-testid=\"mark-all-read-btn\"\n                  onClick={onMarkAllRead}\n                  disabled={unreadCount === 0}\n                  className=\"inline-flex shrink-0 items-center gap-1 rounded-lg px-2 py-1 text-[11px] font-bold text-emerald-700 transition-colors hover:bg-emerald-50 disabled:opacity-40 whitespace-nowrap\"\n                >\n                  <CheckCheck className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                  <span>\304\220\303\241nh d\341\272\245u \304\221\303\243 \304\221\341\273\215c t\341\272\245t c\341\272\243</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Notification List */}\n            <div className=\"flex-1 space-y-2.5 overflow-y-auto px-5 py-4\">\n              {visibleItems.length === 0 ? (\n                <div className=\"rounded-2xl border border-dashed border-slate-200 bg-white py-10 text-center\">\n                  <p className=\"text-sm font-semibold text-slate-500\">\n                    Ch\306\260a c\303\263 th\303\264ng b\303\241o n\303\240o trong m\341\273\245c n\303\240y\n                  </p>\n                </div>\n              ) : (\n                visibleItems.map((item) => (\n                  <NotificationItemRow\n                    key={item.id}\n                    item={item}\n                    onSelect={onSelectNotification}\n                  />\n                ))\n              )}\n            </div>\n          </motion.section>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n"
