    content: "import type {\n  GeoCoord,\n  IssueOption,\n  IssueType,\n  PickupMode,\n  SafeStation,\n  TrackingStatus,\n  UserLocation,\n} from \'../types/rescue\';\n\nexport function resolvePickupTarget(\n  mode: PickupMode,\n  userLocation: UserLocation,\n  stations: SafeStation[],\n  selectedStationId: string | null,\n): {\n  title: string;\n  address: string;\n  coord: GeoCoord;\n  station: SafeStation | null;\n} {\n  if (mode === \'safe_station\') {\n    const matched =\n      stations.find((station) => station.id === selectedStationId) ??\n      getNearestSafeStation(stations);\n\n    if (matched) {\n      return {\n        title: matched.name,\n        address: matched.address,\n        coord: matched.coord,\n        station: matched,\n      };\n    }\n  }\n\n  return {\n    title: \'V\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\',\n    address: userLocation.address,\n    coord: userLocation.coord,\n    station: null,\n  };\n}\n\nexport function getNearestSafeStation(stations: SafeStation[]): SafeStation | null {\n  if (stations.length === 0) return null;\n  return [...stations].sort(\n    (a, b) => a.walkingDistanceMeters - b.walkingDistanceMeters,\n  )[0];\n}\n\nexport function findStationByCategory(\n  stations: SafeStation[],\n  category: SafeStation[\'category\'],\n): SafeStation | null {\n  const matching = stations.filter((station) => station.category === category);\n  if (matching.length > 0) {\n    return getNearestSafeStation(matching);\n  }\n  return getNearestSafeStation(stations);\n}\n\nexport function computeHaversineMeters(a: GeoCoord, b: GeoCoord): number {\n  const toRad = (deg: number) => (deg * Math.PI) / 180;\n  const earthRadiusMeters = 6371000;\n  const dLat = toRad(b.lat - a.lat);\n  const dLng = toRad(b.lng - a.lng);\n  const lat1 = toRad(a.lat);\n  const lat2 = toRad(b.lat);\n\n  const h =\n    Math.sin(dLat / 2) ** 2 +\n    Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;\n  const c = 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));\n  return Math.round(earthRadiusMeters * c);\n}\n\nexport function estimateWalkingMinutes(meters: number): number {\n  return Math.max(1, Math.round(Math.max(0, meters) / 75));\n}\n\nexport function formatWalkingDistance(meters: number, minutes: number): string {\n  const safeMeters = Math.max(0, Math.round(meters));\n  const safeMinutes = Math.max(1, Math.round(minutes));\n  return `${safeMeters}m \302\267 ${safeMinutes} ph\303\272t \304\221i b\341\273\231`;\n}\n\nexport function getNextDemoTrackingStatus(current: TrackingStatus): TrackingStatus {\n  if (current === \'searching\') return \'accepted\';\n  if (current === \'accepted\') return \'completed\';\n  return \'completed\';\n}\n\nexport function getIssueLabel(\n  issueId: IssueType | null,\n  options: IssueOption[],\n  customNote?: string,\n): string {\n  const found = options.find((opt) => opt.id === issueId);\n  if (!found) return \'C\341\273\251u h\341\273\231 xe m\303\241y kh\341\272\251n c\341\272\245p\';\n  if (issueId === \'other\' && customNote && customNote.trim().length > 0) {\n    return `${found.label} (${customNote.trim()})`;\n  }\n  return found.label;\n}\n\nexport function computeBoundsBox(\n  coords: [number, number][],\n): [[number, number], [number, number]] | null {\n  if (coords.length === 0) return null;\n  let minLng = coords[0][0];\n  let minLat = coords[0][1];\n  let maxLng = coords[0][0];\n  let maxLat = coords[0][1];\n\n  for (const [lng, lat] of coords) {\n    if (lng < minLng) minLng = lng;\n    if (lat < minLat) minLat = lat;\n    if (lng > maxLng) maxLng = lng;\n    if (lat > maxLat) maxLat = lat;\n  }\n\n  return [\n    [minLng, minLat],\n    [maxLng, maxLat],\n  ];\n}\n\nexport function buildMechanicApproachCoord(pickupCoord: GeoCoord): GeoCoord {\n  return {\n    lat: pickupCoord.lat - 0.0065,\n    lng: pickupCoord.lng + 0.0058,\n  };\n}\n\nexport function getStationSafetyBadgeText(\n  category: SafeStation[\'category\'],\n): string {\n  if (category === \'convenience\') return \'M\341\273\237 24/7 \342\200\242 \304\220\303\250n s\303\241ng & Camera\';\n  if (category === \'gas_station\') return \'Tr\341\273\261c 24/7 \342\200\242 C\303\263 nh\303\242n vi\303\252n\';\n  return \'Tr\341\273\261c ban 24/7 \342\200\242 An ninh cao\';\n}\n\nexport function formatCompactStationAddress(rawAddress: string): string {\n  const cleaned = rawAddress.trim();\n  if (!cleaned) return \'G\341\272\247n v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i\';\n\n  const redundantTail =\n    /^(vietnam|vi\341\273\207t nam|ho chi minh city|th\303\240nh ph\341\273\221 h\341\273\223 ch\303\255 minh|tp\\.?\\s*h\341\273\223 ch\303\255 minh|tp\\.?\\s*hcm|\\d{5,6})$/i;\n\n  const parts = cleaned\n    .split(\',\')\n    .map((part) => part.trim())\n    .filter((part) => part.length > 0 && !redundantTail.test(part));\n\n  if (parts.length === 0) return \'Trung t\303\242m TP.HCM\';\n\n  const normalizeStreet = (street: string): string => {\n    if (/\\s+street$/i.test(street) && !/^(\304\221\\.|\304\221\306\260\341\273\235ng)/i.test(street)) {\n      return `\304\220. ${street.replace(/\\s+street$/i, \'\').trim()}`;\n    }\n    return street.replace(/^\304\220\306\260\341\273\235ng\\s+/i, \'\304\220. \');\n  };\n\n  const normalizeDistrict = (segment: string): string => {\n    if (/^(saigon|s\303\240i g\303\262n|b\341\272\277n ngh\303\251|b\341\272\277n th\303\240nh|p\\.\\s*b\341\272\277n ngh\303\251|p\\.\\s*b\341\272\277n th\303\240nh)$/i.test(segment)) {\n      return \'Q.1\';\n    }\n    return segment\n      .replace(/^District\\s+(\\d+)/i, \'Q.$1\')\n      .replace(/^Qu\341\272\255n\\s+(\\d+)/i, \'Q.$1\')\n      .replace(/^Ph\306\260\341\273\235ng\\s+/i, \'P. \');\n  };\n\n  const first = normalizeStreet(parts[0]);\n  if (parts.length === 1) return first;\n\n  const last = normalizeDistrict(parts[parts.length - 1]);\n  if (last.toLowerCase() === first.toLowerCase()) return first;\n  return `${first}, ${last}`;\n}\n\nexport function computeActiveCarouselIndex(\n  scrollLeft: number,\n  maxScrollLeft: number,\n  itemCount: number,\n  cardStepPx = 274,\n): number {\n  if (itemCount <= 1) return 0;\n  if (maxScrollLeft > 0 && scrollLeft >= maxScrollLeft - 4) {\n    return itemCount - 1;\n  }\n  const index = Math.round(Math.max(0, scrollLeft) / cardStepPx);\n  return Math.min(itemCount - 1, Math.max(0, index));\n}\n\n\n"
    num_lines: 198
    num_bytes: 5667
    line_range_bytes: 5667
  }
}
