  code_action {
    action_spec {
      create_file {
        instruction: "import type {\n  GeoCoord,\n  IssueOption,\n  IssueType,\n  OrderPricing,\n  PickupMode,\n  VoucherId,\n  VoucherOption,\n} from \'../types/rescue\';\nimport { computeHaversineMeters } from \'./rescueLogic\';\n\nexport function formatVnd(amount: number): string {\n  const safe = Math.max(0, Math.round(amount));\n  const formatted = safe.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \'.\');\n  return `${formatted}\304\221`;\n}\n\nexport function isVoucherEligible(\n  voucher: VoucherOption,\n  pickupMode: PickupMode,\n): boolean {\n  if (!voucher.requiresSafeStation) return true;\n  return pickupMode === \'safe_station\';\n}\n\nexport function calculateRescuePricing(\n  issueId: IssueType | null,\n  options: IssueOption[],\n  pickupMode: PickupMode,\n  voucherId: VoucherId | null,\n  vouchers: VoucherOption[],\n): OrderPricing {\n  const matchedIssue =\n    options.find((opt) => opt.id === issueId) ?? options[0] ?? null;\n  const basePrice = matchedIssue?.fixedPrice ?? 85000;\n\n  const candidateVoucher = voucherId\n    ? vouchers.find((v) => v.id === voucherId) ?? null\n    : null;\n  const appliedVoucher =\n    candidateVoucher && isVoucherEligible(candidateVoucher, pickupMode)\n      ? candidateVoucher\n      : null;\n\n  const discountAmount = appliedVoucher\n    ? Math.min(basePrice, appliedVoucher.discountAmount)\n    : 0;\n  const finalPrice = Math.max(0, basePrice - discountAmount);\n\n  return {\n    basePrice,\n    discountAmount,\n    finalPrice,\n    appliedVoucher,\n  };\n}\n\nexport function resampleRouteWaypoints(\n  coordinates: [number, number][],\n  targetSteps = 16,\n): GeoCoord[] {\n  if (coordinates.length === 0) return [];\n  if (coordinates.length === 1) {\n    return [{ lng: coordinates[0][0], lat: coordinates[0][1] }];\n  }\n\n  const cumulativeDistances: number[] = [0];\n  let totalMeters = 0;\n\n  for (let i = 1; i < coordinates.length; i += 1) {\n    const prev: GeoCoord = { lng: coordinates[i - 1][0], lat: coordinates[i - 1][1] };\n    const curr: GeoCoord = { lng: coordinates[i][0], lat: coordinates[i][1] };\n    totalMeters += computeHaversineMeters(prev, curr);\n    cumulativeDistances.push(totalMeters);\n  }\n\n  if (totalMeters <= 0) {\n    return coordinates.map(([lng, lat]) => ({ lng, lat }));\n  }\n\n  const steps = Math.max(2, targetSteps);\n  const waypoints: GeoCoord[] = [];\n  let segIdx = 0;\n\n  for (let step = 0; step <= steps; step += 1) {\n    const targetDist = (totalMeters * step) / steps;\n    while (\n      segIdx < cumulativeDistances.length - 2 &&\n      cumulativeDistances[segIdx + 1] < targetDist\n    ) {\n      segIdx += 1;\n    }\n\n    const startDist = cumulativeDistances[segIdx];\n    const endDist = cumulativeDistances[segIdx + 1];\n    const segLen = Math.max(0.0001, endDist - startDist);\n    const ratio = Math.min(1, Math.max(0, (targetDist - startDist) / segLen));\n\n    const [lng1, lat1] = coordinates[segIdx];\n    const [lng2, lat2] = coordinates[segIdx + 1];\n\n    waypoints.push({\n      lng: lng1 + (lng2 - lng1) * ratio,\n      lat: lat1 + (lat2 - lat1) * ratio,\n    });\n  }\n\n  return waypoints;\n}\n\nexport function computeStepEtaMinutes(\n  stepIndex: number,\n  totalSteps: number,\n  initialEtaMinutes: number,\n): number {\n  if (totalSteps <= 1) return 1;\n  if (stepIndex >= totalSteps - 1) return 0;\n  const progress = Math.min(1, Math.max(0, stepIndex / (totalSteps - 1)));\n  return Math.max(1, Math.ceil(initialEtaMinutes * (1 - progress)));\n}\n\nexport function buildMechanicAutoReply(\n  userMessage: string,\n  pickupTitle: string,\n  etaMinutes: number,\n): string {\n  const lower = userMessage.toLowerCase();\n  const etaText = etaMinutes <= 1 ? \'ch\306\260a t\341\273\233i 1 ph\303\272t\' : `kho\341\272\243ng ${etaMinutes} ph\303\272t`;\n\n  if (lower.includes(\'tr\341\272\241m an to\303\240n\') || lower.includes(\'s\303\241ng \304\221\303\250n\')) {\n    return `Ok b\341\272\241n nh\303\251, m\303\254nh th\341\272\245y \304\221i\341\273\203m h\341\272\271n ${pickupTitle} r\341\273\223i. B\341\272\241n c\341\273\251 \304\221\341\273\251ng ch\341\273\227 s\303\241ng \304\221\303\250n ch\341\273\235 kho\341\272\243ng ${etaText} m\303\254nh t\341\273\233i ngay!`;\n  }\n  if (lower.includes(\'tr\306\260\341\273\233c c\341\273\255a\')) {\n    return `R\303\265 r\341\273\223i b\341\272\241n \306\241i, th\341\272\245y xe d\341\273\261ng tr\306\260\341\273\233c c\341\273\255a m\303\254nh t\341\272\245p v\303\240o li\341\273\201n. M\303\254nh c\303\262n c\303\241ch ${etaText} n\341\273\257a nh\303\251.`;\n  }\n  if (lower.includes(\'g\341\272\247n ch\306\260a\') || lower.includes(\'\304\221\303\242u r\341\273\223i\')) {\n    return `M\303\254nh \304\221ang ch\341\272\241y th\341\272\263ng t\341\273\233i ${pickupTitle}, c\303\262n t\341\272\247m ${etaText} l\303\240 t\341\273\233i n\306\241i nha b\341\272\241n!`;\n  }\n  return `M\303\254nh \304\221\303\243 nh\341\272\255n tin nh\341\272\257n r\341\273\223i nh\303\251. B\341\272\241n y\303\252n t\303\242m \304\221\341\273\251ng \341\273\237 ${pickupTitle}, m\303\254nh \304\221ang t\341\273\233i sau ${etaText}.`;\n}\n"
        path {
