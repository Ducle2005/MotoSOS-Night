    tool_calls {
      id: "call_3791308379187028208"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { MessageCircle, ShieldAlert, Tag, Wrench } from \'lucide-react\';\\nimport type { AppNotification, NotificationType } from \'../../types/notification\';\\nimport { formatNotificationTime } from \'../../utils/notificationLogic\';\\n\\ninterface NotificationItemRowProps {\\n  item: AppNotification;\\n  onSelect: (item: AppNotification) => void;\\n}\\n\\nfunction getItemBadge(type: NotificationType) {\\n  switch (type) {\\n    case \'promo\':\\n      return { bg: \'bg-amber-100 text-amber-700\', Icon: Tag };\\n    case \'safety\':\\n      return { bg: \'bg-rose-100 text-rose-700\', Icon: ShieldAlert };\\n    case \'chat\':\\n      return { bg: \'bg-sky-100 text-sky-700\', Icon: MessageCircle };\\n    default:\\n      return { bg: \'bg-emerald-100 text-emerald-700\', Icon: Wrench };\\n  }\\n}\\n\\nexport function NotificationItemRow({ item, onSelect }: NotificationItemRowProps) {\\n  const { bg, Icon } = getItemBadge(item.type);\\n\\n  return (\\n    <button\\n      type=\\\"button\\\"\\n      data-testid={`notif-item-${item.id}`}\\n      onClick={() => onSelect(item)}\\n      className={`flex w-full items-start gap-3 rounded-2xl border p-3.5 text-left transition-all ${\\n        item.isRead\\n          ? \'border-slate-200/80 bg-white hover:border-slate-300\'\\n          : \'border-emerald-200/90 bg-emerald-50/75 shadow-sm hover:bg-emerald-50\'\\n      }`}\\n    >\\n      <div\\n        className={`mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${bg}`}\\n      >\\n        <Icon className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />\\n      </div>\\n      <div className=\\\"min-w-0 flex-1\\\">\\n        <div className=\\\"flex items-start justify-between gap-2\\\">\\n          <p\\n            className={`text-xs leading-snug ${\\n              item.isRead ? \'font-semibold text-slate-800\' : \'font-bold text-slate-950\'\\n            }`}\\n          >\\n            {item.title}\\n          </p>\\n          {!item.isRead && (\\n            <span\\n              aria-label=\\\"Ch\306\260a \304\221\341\273\215c\\\"\\n              className=\\\"mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-500\\\"\\n            />\\n          )}\\n        </div>\\n        <p className=\\\"mt-1 text-xs leading-relaxed text-slate-600\\\">{item.message}</p>\\n        <p className=\\\"mt-1.5 text-[11px] font-medium text-slate-400\\\">\\n          {formatNotificationTime(item.timestamp)}\\n        </p>\\n      </div>\\n    </button>\\n  );\\n}\\n\", \"Description\":\"Extract NotificationItemRow component to keep NotificationCenterModal well below 250 lines\", \"Overwrite\":true, \"TargetFile\":\"/src/components/notifications/NotificationItemRow.tsx\", \"toolAction\":\"Creating NotificationItemRow component\", \"toolSummary\":\"Create NotificationItemRow component\"}"
      original_name: "write_to_file"
    }
