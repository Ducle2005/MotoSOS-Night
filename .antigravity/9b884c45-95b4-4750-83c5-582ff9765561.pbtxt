        instruction: "import {\n  CheckCircle2,\n  Clock,\n  Loader2,\n  MapPin,\n  Phone,\n  ShieldCheck,\n  Star,\n  Wrench,\n} from \'lucide-react\';\nimport { useState } from \'react\';\nimport type { MechanicInfo, TrackingStatus } from \'../../types/rescue\';\n\ninterface TrackingStepProps {\n  status: TrackingStatus;\n  issueSummary: string;\n  pickupTitle: string;\n  pickupAddress: string;\n  mechanic: MechanicInfo;\n  onDemoAdvance: () => void;\n  onCancelOrder: () => void;\n  onCompleteReset: () => void;\n}\n\nexport function TrackingStep({\n  status,\n  issueSummary,\n  pickupTitle,\n  pickupAddress,\n  mechanic,\n  onDemoAdvance,\n  onCancelOrder,\n  onCompleteReset,\n}: TrackingStepProps) {\n  const [callFeedback, setCallFeedback] = useState(false);\n\n  if (status === \'searching\') {\n    return (\n      <div className=\"flex min-h-0 flex-1 flex-col\" data-testid=\"tracking-searching\">\n        <div className=\"flex-1 overflow-y-auto px-5 pt-1 pb-4 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n          <div className=\"flex items-center justify-between gap-2\">\n            <div className=\"flex items-center gap-3 min-w-0\">\n              <div className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600\">\n                <Loader2 className=\"h-5 w-5 animate-spin\" aria-hidden=\"true\" />\n              </div>\n              <div className=\"min-w-0\">\n                <h1 className=\"text-base font-extrabold tracking-tight text-slate-900\">\n                  \304\220ang t\303\254m th\341\273\243 g\341\272\247n b\341\272\241n...\n                </h1>\n                <p className=\"truncate text-xs text-slate-500\">\n                  K\341\272\277t n\341\273\221i \304\221\341\273\231i c\341\273\251u h\341\273\231 trong b\303\241n k\303\255nh 3km\n                </p>\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={onDemoAdvance}\n              className=\"shrink-0 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[11px] font-bold text-emerald-700 hover:bg-emerald-100 whitespace-nowrap\"\n            >\n              Gi\341\272\243 l\341\272\255p th\341\273\243 nh\341\272\255n \304\221\306\241n\n            </button>\n          </div>\n\n          <div\n            className=\"mt-3 rounded-2xl border border-slate-100 bg-slate-50 p-3.5\"\n            aria-hidden=\"true\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"h-10 w-10 rounded-full bg-slate-200 animate-pulse\" />\n              <div className=\"flex-1 space-y-2\">\n                <div className=\"h-3 w-2/3 rounded bg-slate-200 animate-pulse\" />\n                <div className=\"h-2.5 w-1/2 rounded bg-slate-200/70 animate-pulse\" />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-2.5 space-y-2 rounded-2xl border border-slate-100 bg-white p-3 text-xs\">\n            <div className=\"flex items-center justify-between gap-3\">\n              <span className=\"shrink-0 text-slate-500\">S\341\273\261 c\341\273\221</span>\n              <span className=\"font-bold text-slate-900\">{issueSummary}</span>\n            </div>\n            <div className=\"flex items-start justify-between gap-3 border-t border-slate-100 pt-2\">\n              <span className=\"shrink-0 text-slate-500\">\304\220i\341\273\203m \304\221\303\263n</span>\n              <span className=\"text-right font-medium text-slate-700\">\n                {pickupTitle} \302\267 {pickupAddress}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"shrink-0 border-t border-slate-100 bg-white px-5 py-3\">\n          <button\n            type=\"button\"\n            onClick={onCancelOrder}\n            className=\"min-h-[46px] w-full rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-600 transition-colors hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400\"\n          >\n            H\341\273\247y y\303\252u c\341\272\247u c\341\273\251u h\341\273\231\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  if (status === \'accepted\') {\n    return (\n      <div className=\"flex min-h-0 flex-1 flex-col\" data-testid=\"tracking-accepted\">\n        <div className=\"flex-1 overflow-y-auto px-5 pt-1 pb-3 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n          <div className=\"flex items-start justify-between gap-3\">\n            <div>\n              <p className=\"text-xs font-bold text-emerald-600\">\n                Th\341\273\243 \304\221\303\243 nh\341\272\255n \304\221\306\241n \302\267 \304\220ang di chuy\341\273\203n t\341\273\233i b\341\272\241n\n              </p>\n              <h1 className=\"mt-0.5 text-base font-extrabold tracking-tight text-slate-900\">\n                D\341\273\261 ki\341\272\277n t\341\273\233i sau {mechanic.etaMinutes} ph\303\272t\n              </h1>\n            </div>\n            <div className=\"flex shrink-0 items-center gap-1 rounded-xl border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-emerald-700\">\n              <Clock className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n              <span className=\"font-mono text-xs font-bold tabular-nums\">\n                {mechanic.etaMinutes}p\n              </span>\n            </div>\n          </div>\n\n          <div className=\"mt-3 rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5\">\n            <div className=\"flex items-center justify-between gap-3\">\n              <div className=\"flex min-w-0 items-center gap-3\">\n                <div className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-emerald-500 text-white shadow-sm\">\n                  <Wrench className=\"h-5 w-5\" aria-hidden=\"true\" />\n                </div>\n                <div className=\"min-w-0\">\n                  <h2 className=\"truncate text-sm font-bold text-slate-900\">\n                    {mechanic.name}\n                  </h2>\n                  <p className=\"mt-0.5 flex items-center gap-1.5 text-xs text-slate-500\">\n                    <Star className=\"h-3.5 w-3.5 fill-amber-400 text-amber-400\" aria-hidden=\"true\" />\n                    <span className=\"font-mono font-semibold tabular-nums text-slate-800\">\n                      {mechanic.rating}\n                    </span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span className=\"font-mono tabular-nums\">\n                      {mechanic.completedRescues} ca c\341\273\251u h\341\273\231\n                    </span>\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"shrink-0 text-right\">\n                <p className=\"text-[11px] text-slate-500\">Bi\341\273\203n s\341\273\221 xe</p>\n                <p className=\"mt-0.5 font-mono text-xs font-bold tabular-nums text-emerald-700 whitespace-nowrap\">\n                  {mechanic.licensePlate}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"mt-2.5 border-t border-slate-200/80 pt-2.5 text-xs text-slate-600\">\n              <p className=\"truncate font-medium\">{mechanic.vehicleModel}</p>\n              <p className=\"mt-1 flex items-center gap-1.5 text-slate-500\">\n                <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n                <span className=\"truncate\">\n                  \304\220i\341\273\203m h\341\272\271n: {pickupTitle} ({pickupAddress})\n                </span>\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"shrink-0 border-t border-slate-100 bg-white px-5 py-3\">\n          <button\n            type=\"button\"\n            onClick={() => setCallFeedback(true)}\n            className=\"inline-flex min-h-[46px] w-full items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 text-sm font-bold text-white shadow-md shadow-emerald-500/20 transition-colors hover:bg-emerald-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-[0.98]\"\n          >\n            <Phone className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>\n              {callFeedback\n                ? `\304\220ang g\341\273\215i ${mechanic.phone}...`\n                : `G\341\273\215i th\341\273\243 (${mechanic.phone})`}\n            </span>\n          </button>\n\n          <p className=\"mt-2 flex items-center justify-center gap-1.5 text-[11px] text-slate-500\">\n            <ShieldCheck className=\"h-3.5 w-3.5 text-emerald-600\" aria-hidden=\"true\" />\n            <span>S\341\273\261 c\341\273\221: {issueSummary} \302\267 B\303\241o gi\303\241 minh b\341\272\241ch tr\306\260\341\273\233c khi s\341\273\255a</span>\n          </p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex min-h-0 flex-1 flex-col\" data-testid=\"tracking-completed\">\n      <div className=\"flex-1 overflow-y-auto px-5 pt-1 pb-4 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600\">\n            <CheckCircle2 className=\"h-6 w-6\" aria-hidden=\"true\" />\n          </div>\n          <div>\n            <p className=\"text-xs font-bold text-emerald-600\">C\341\273\251u h\341\273\231 ho\303\240n t\341\272\245t</p>\n            <h1 className=\"text-base font-extrabold tracking-tight text-slate-900\">\n              Xe b\341\272\241n \304\221\303\243 an to\303\240n l\304\203n b\303\241nh!\n            </h1>\n          </div>\n        </div>\n\n        <div className=\"mt-3.5 space-y-2 rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5 text-xs\">\n          <div className=\"flex items-center justify-between gap-3\">\n            <span className=\"shrink-0 text-slate-500\">Th\341\273\243 ph\341\273\245 tr\303\241ch</span>\n            <span className=\"text-right font-bold text-slate-900\">\n              {mechanic.name}{\' \'}\n              <span className=\"font-mono whitespace-nowrap text-emerald-700\">\n                \302\267 {mechanic.licensePlate}\n              </span>\n            </span>\n          </div>\n          <div className=\"flex items-center justify-between gap-3 border-t border-slate-200/70 pt-2\">\n            <span className=\"shrink-0 text-slate-500\">S\341\273\261 c\341\273\221 \304\221\303\243 x\341\273\255 l\303\275</span>\n            <span className=\"font-bold text-slate-900\">{issueSummary}</span>\n          </div>\n          <div className=\"flex items-start justify-between gap-3 border-t border-slate-200/70 pt-2\">\n            <span className=\"shrink-0 text-slate-500\">\304\220i\341\273\203m \304\221\303\263n</span>\n            <span className=\"text-right text-slate-700\">{pickupAddress}</span>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"shrink-0 border-t border-slate-100 bg-white px-5 py-3\">\n        <button\n          type=\"button\"\n          onClick={onCompleteReset}\n          className=\"min-h-[46px] w-full rounded-xl bg-emerald-500 px-5 text-sm font-extrabold text-white shadow-md shadow-emerald-500/20 transition-colors hover:bg-emerald-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-[0.98]\"\n        >\n          L\306\260u l\341\273\213ch s\341\273\255 & V\341\273\201 Trang ch\341\273\247\n        </button>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/TrackingStep.tsx"
        }
        overwrite: true
      }
    }
