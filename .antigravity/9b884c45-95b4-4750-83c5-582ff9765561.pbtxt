      thinking_signature: "\022\355\a\n\352\a\001i\024}\023\340?\262\307\271\217b\224\031\367\026\370\017Xq\262xi\214\2655\f\2616\313\260\0214\202\336\222F.\267\\<\364\375\315\024\036\324\3469\307\017]\017\312\331\313g\027\032\331\277H\345c\005\347n\025\214\222\314\367\005\270\234\217\002v\224\302\202\023\355\264bt\270\2422\316\212\272\257\244\'\334\243\021V\237\257\212\306[(0\356%D\312\307k\250\270\276k\213!-\347N\377\217\201\376\'6\370w\376s\037\227\206h\377\311\273}\\I\261c\313\271)\263\001\235?g\260k\274\023\263~\212.\232\006\005\0004\216\214\271oMm\000\363Z\367\0276w.\022a\001\224hP\316v.!\323\301\224\355\372\v\271\a\265\306T\3405\364\256\351\255X\327,G!\266\367\332\024v\2373\217OM\345\360\274T\355\272\'\344d#\006\f`v\320\201\360\262\261\201i2\202\372\333i \345\a\0160\376R\004c\203\270\322\355\206!\016\203\227\301\302\240\r\b\347\231\032\315\227],\267\330l\327\300&5\221\211G\243\222\363\326\020\211\203\211\355\330\025N\367\347\276\337\230\022n\324t\234x\236\320\327W\032\274WW\344\246\2639a\213}\322\223\330X\336\326\243\261m\267\214\3548\236 N\2660\326T\211\006\357\021U\323\027\303\235\235\350\360R:.\234\002%mo3\362]_@\275\2168\032\333\232Q!\365\023ow$E\025:\036\304\347\202\225\315\223\351\177O\330\251\"\252y\221Hjm\224I5\263\222\361\215\270g\237\312q-\360\373\037\355\220\333\307\031`\345\312Xy\236f\203k\301;1p\177,\020r\006\324\251\240\nw\"i\b\302KB\353;\372M\267|\v\035\177\253$\344G\366\021E%\004y\370\276\247\004\207=\v~\253\256\245Wi>\376\215\271X\274\177\362G\355\304\251\330\002V\370\250\241\323A)\000=\374\307~\353\033\317\034\365\234\034]\346r\206\305 \264e\242\377\315L\225\317\370E\375\300\242\334\233\273\270>\220\320\364\345\277\274&\347\256\253\250\2217\260\261\227\217\324\'\367:}:\273\336\225j\v\n\b\275n\037\260\305\375\312\301\321(\2601\032\365\263\vX\317\037\344\371\346\017\311C\206\035\t\'R05\363\244!&\317\306\336\212ZI\201\201\257ez\302\247k3\026\272\305\300\356\311\324s\232t\365\316\273\025\260\360\345\fJ~\363\363\207\212\201*gqy\032\352\3710\220\0