  view_file {
    absolute_path_uri: "file:///src/components/steps/Step2PlaceListPicker.tsx"
    end_line: 234
    content: "import { Check, Fuel, Loader2, Navigation, Phone, ShieldCheck, Wrench } from \'lucide-react\';\nimport type {\n  GasStation,\n  InspectedPlace,\n  MapLayerFilter,\n  RepairShop,\n  SafeStation,\n} from \'../../types/rescue\';\nimport {\n  formatShortCallLabel,\n  formatShopDistanceLabel,\n} from \'../../utils/repairShopApi\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\n\ninterface Step2PlaceListPickerProps {\n  mapFilter: MapLayerFilter;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  selectedStationId: string | null;\n  inspectedPlace: InspectedPlace | null;\n  isLoadingRoute: boolean;\n  onSelectSafeStation: (station: SafeStation) => void;\n  onSelectGasStation: (station: GasStation) => void;\n  onRouteShop: (shop: RepairShop) => void;\n}\n\ntype Step2RowItem =\n  | { kind: \'safe_station\'; distance: number; station: SafeStation }\n  | { kind: \'repair_shop\'; distance: number; shop: RepairShop }\n  | { kind: \'gas_station\'; distance: number; gasStation: GasStation };\n\nexport function Step2PlaceListPicker({\n  mapFilter,\n  stations,\n  openRepairShops,\n  gasStations,\n  selectedStationId,\n  inspectedPlace,\n  isLoadingRoute,\n  onSelectSafeStation,\n  onSelectGasStation,\n  onRouteShop,\n}: Step2PlaceListPickerProps) {\n  const rows: Step2RowItem[] = [];\n\n  if (mapFilter === \'all\' || mapFilter === \'safe_stations\') {\n    for (const station of stations) {\n      rows.push({ kind: \'safe_station\', distance: station.walkingDistanceMeters, station });\n    }\n  }\n  if (mapFilter === \'all\' || mapFilter === \'repair_shops\') {\n    for (const shop of openRepairShops) {\n      rows.push({ kind: \'repair_shop\', distance: shop.distanceMeters, shop });\n    }\n  }\n  if (mapFilter === \'all\' || mapFilter === \'gas_stations\') {\n    for (const gas of gasStations.slice(0, 4)) {\n      rows.push({ kind: \'gas_station\', distance: gas.walkingDistanceMeters, gasStation: gas });\n    }\n  }\n\n  rows.sort((a, b) => a.distance - b.distance);\n\n  return (\n    <div className=\"mt-2 rounded-2xl border border-slate-200 bg-slate-50/75 p-2\">\n      <div className=\"flex items-center justify-between px-1.5 pb-1\">\n        <p className=\"text-[11px] font-bold text-slate-700\">\n          \304\220\341\273\213a \304\221i\341\273\203m g\341\272\247n b\341\272\241n (ch\341\273\215n \304\221\341\273\203 v\341\272\275 \304\221\306\260\341\273\235ng & li\303\252n h\341\273\207):\n        </p>\n        {isLoadingRoute && (\n          <Loader2\n            className=\"h-3.5 w-3.5 animate-spin text-emerald-600\"\n            aria-label=\"\304\220ang t\303\254m tuy\341\272\277n \304\221\306\260\341\273\235ng\"\n          />\n        )}\n      </div>\n\n      <div\n        data-testid=\"step2-place-list\"\n        className=\"max-h-[210px] space-y-2 overflow-y-auto pr-1 [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-slate-300\"\n      >\n        {rows.map((row) => {\n          if (row.kind === \'safe_station\') {\n            const s = row.station;\n            const active =\n              selectedStationId === s.id ||\n              (inspectedPlace?.kind === \'safe_station\' &&\n                inspectedPlace.station.id === s.id);\n            return (\n              <div\n                key={`ss-${s.id}`}\n                className={`flex items-center justify-between gap-2 rounded-xl border px-2.5 py-2 transition-colors ${\n                  active\n                    ? \'border-emerald-500 bg-white shadow-xs\'\n                    : \'border-slate-200/70 bg-white hover:border-emerald-300\'\n                }`}\n              >\n                <button\n                  type=\"button\"\n                  onClick={() => onSelectSafeStation(s)}\n                  className=\"flex min-w-0 flex-1 items-center gap-2 text-left\"\n                >\n                  <span className=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600\">\n                    <ShieldCheck className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                  </span>\n                  <div className=\"min-w-0\">\n                    <p className=\"truncate text-xs font-bold text-slate-900\">{s.name}</p>\n                    <p className=\"truncate font-sans text-[11px] tabular-nums text-emerald-700\">\n                      Tr\341\272\241m 24/7 \302\267 {formatWalkingDistance(s.walkingDistanceMeters, s.walkingMinutes)}\n                    </p>\n                  </div>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => onSelectSafeStation(s)}\n                  className={`inline-flex h-7 shrink-0 items-center gap-1 rounded-lg px-2 text-[11px] font-bold whitespace-nowrap ${\n                    active\n                      ? \'bg-emerald-500 text-white\'\n                      : \'bg-emerald-50 text-emerald-700 hover:bg-emerald-100\'\n                  }`}\n                >\n                  {active ? <Check className=\"h-3 w-3\" aria-hidden=\"true\" /> : <Navigation className=\"h-3 w-3\" aria-hidden=\"true\" />}\n                  <span>{active ? \'\304\220ang ch\341\273\215n\' : \'\304\220\306\260\341\273\235ng \304\221i\'}</span>\n                </button>\n              </div>\n            );\n          }\n\n          if (row.kind === \'repair_shop\') {\n            const shop = row.shop;\n            const active =\n              inspectedPlace?.kind === \'repair_shop\' &&\n              inspectedPlace.shop.id === shop.id;\n            return (\n              <div\n                key={`rs-${shop.id}`}\n                data-testid={`step2-shop-${shop.id}`}\n                className={`rounded-xl border px-2.5 py-2 transition-colors ${\n                  active\n                    ? \'border-blue-500 bg-white shadow-xs\'\n                    : \'border-slate-200/70 bg-white hover:border-blue-300\'\n                }`}\n              >\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div className=\"flex min-w-0 items-start gap-2\">\n                    <span className=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600\">\n                      <Wrench className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"truncate text-xs font-bold text-slate-900\">{shop.name}</p>\n                      <p className=\"truncate font-sans text-[11px] tabular-nums text-slate-500\">\n                        <span className=\"font-semibold text-emerald-600\">\342\227\217 \304\220ang m\341\273\237</span> \302\267{\' \'}\n                        {formatShopDistanceLabel(shop.distanceMeters, shop.rideMinutes)}\n                      </p>\n                      <p className=\"mt-0.5 font-sans text-[11px] font-bold tabular-nums text-blue-700\">\n                        S\304\220T: {shop.phone}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"mt-1.5 flex items-center gap-1.5\">\n                  <a\n                    href={`tel:${shop.phone.replace(/\\s+/g, \'\')}`}\n                    className=\"inline-flex h-7 flex-1 items-center justify-center gap-1 rounded-lg bg-emerald-50 px-2 text-[11px] font-bold text-emerald-700 ring-1 ring-inset ring-emerald-200 hover:bg-emerald-100 whitespace-nowrap\"\n                  >\n                    <Phone className=\"h-3 w-3 shrink-0\" aria-hidden=\"true\" />\n                    <span>{formatShortCallLabel(shop.phone)}</span>\n                  </a>\n                  <button\n                    type=\"button\"\n                    onClick={() => onRouteShop(shop)}\n                    className={`inline-flex h-7 flex-1 items-center justify-center gap-1 rounded-lg px-2 text-[11px] font-bold whitespace-nowrap ${\n                      active\n                        ? \'bg-blue-600 text-white\'\n                        : \'bg-slate-900 text-white hover:bg-slate-800\'\n                    }`}\n                  >\n                    <Navigation className=\"h-3 w-3 shrink-0\" aria-hidden=\"true\" />\n                    <span>\304\220\306\260\341\273\235ng \304\221i</span>\n                  </button>\n                </div>\n              </div>\n            );\n          }\n\n          const g = row.gasStation;\n          const active =\n            inspectedPlace?.kind === \'gas_station\' &&\n            inspectedPlace.gasStation.id === g.id;\n          return (\n            <div\n              key={`gs-${g.id}`}\n              className={`flex items-center justify-between gap-2 rounded-xl border px-2.5 py-2 transition-colors ${\n                active\n                  ? \'border-amber-500 bg-white shadow-xs\'\n                  : \'border-slate-200/70 bg-white hover:border-amber-300\'\n              }`}\n            >\n              <button\n                type=\"button\"\n                onClick={() => onSelectGasStation(g)}\n                className=\"flex min-w-0 flex-1 items-center gap-2 text-left\"\n              >\n                <span className=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600\">\n                  <Fuel className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                </span>\n                <div className=\"min-w-0\">\n                  <p className=\"truncate text-xs font-bold text-slate-900\">{g.name}</p>\n                  <p className=\"truncate font-sans text-[11px] tabular-nums text-amber-700\">\n                    C\303\242y x\304\203ng \302\267 {formatWalkingDistance(g.walkingDistanceMeters, g.walkingMinutes)}\n                  </p>\n                </div>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onSelectGasStation(g)}\n                className={`inline-flex h-7 shrink-0 items-center gap-1 rounded-lg px-2 text-[11px] font-bold whitespace-nowrap ${\n                  active\n                    ? \'bg-amber-500 text-white\'\n                    : \'bg-amber-50 text-amber-800 hover:bg-amber-100\'\n                }`}\n              >\n                <Navigation className=\"h-3 w-3\" aria-hidden=\"true\" />\n                <span>\304\220\306\260\341\273\235ng \304\221i</span>\n              </button>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 235
    num_bytes: 9927
    line_range_bytes: 9927
  }
}
