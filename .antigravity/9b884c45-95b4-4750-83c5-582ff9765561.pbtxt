  view_file {
    absolute_path_uri: "file:///src/hooks/useActivePlaceInspect.ts"
    end_line: 74
    content: "import { useCallback, useEffect, useRef, useState } from \'react\';\nimport type { GeoCoord, GeoJsonLineString, InspectedPlace } from \'../types/rescue\';\nimport { fetchMechanicDrivingRoute, fetchWalkingRoute } from \'../utils/osrmApi\';\n\nexport interface RouteSummaryInfo {\n  distanceMeters: number;\n  durationMinutes: number;\n}\n\nexport function useActivePlaceInspect(userCoord: GeoCoord) {\n  const [inspectedPlace, setInspectedPlace] = useState<InspectedPlace | null>(null);\n  const [inspectRoute, setInspectRoute] = useState<GeoJsonLineString | null>(null);\n  const [inspectRouteSummary, setInspectRouteSummary] =\n    useState<RouteSummaryInfo | null>(null);\n  const [isLoadingInspectRoute, setIsLoadingInspectRoute] = useState(false);\n  const abortRef = useRef<AbortController | null>(null);\n\n  useEffect(() => () => abortRef.current?.abort(), []);\n\n  const clearInspection = useCallback(() => {\n    abortRef.current?.abort();\n    setInspectedPlace(null);\n    setInspectRoute(null);\n    setInspectRouteSummary(null);\n    setIsLoadingInspectRoute(false);\n  }, []);\n\n  const inspectAndRoutePlace = useCallback(\n    async (place: InspectedPlace) => {\n      abortRef.current?.abort();\n      const controller = new AbortController();\n      abortRef.current = controller;\n\n      setInspectedPlace(place);\n      setIsLoadingInspectRoute(true);\n\n      const destination =\n        place.kind === \'safe_station\'\n          ? place.station.coord\n          : place.kind === \'repair_shop\'\n            ? place.shop.coord\n            : place.gasStation.coord;\n\n      try {\n        const result =\n          place.kind === \'repair_shop\'\n            ? await fetchMechanicDrivingRoute(userCoord, destination, controller.signal)\n            : await fetchWalkingRoute(userCoord, destination, controller.signal);\n\n        if (!controller.signal.aborted) {\n          setInspectRoute(result.geometry);\n          setInspectRouteSummary({\n            distanceMeters: result.distanceMeters,\n            durationMinutes: result.durationMinutes,\n          });\n        }\n      } finally {\n        if (!controller.signal.aborted) {\n          setIsLoadingInspectRoute(false);\n        }\n      }\n    },\n    [userCoord.lat, userCoord.lng],\n  );\n\n  return {\n    inspectedPlace,\n    inspectRoute,\n    inspectRouteSummary,\n    isLoadingInspectRoute,\n    inspectAndRoutePlace,\n    clearInspection,\n  };\n}\n"
    num_lines: 75
    num_bytes: 2362
    line_range_bytes: 2362
  }
}
