          target_content: "export function MapTabView(props: MapTabViewProps) {\n  const [isVoucherDrawerOpen, setIsVoucherDrawerOpen] = useState(false);\n  const [isChatDrawerOpen, setIsChatDrawerOpen] = useState(false);\n\n  const {\n    userLocation,\n    stations,\n    openRepairShops,\n    mapFilter,\n    selectedStationId,\n    inspectedStationId,\n    selectedShopId,\n    selectedShop,\n    shopRoute,\n    shopRouteSummary,\n    isLoadingShopRoute,\n    pickupMode,\n    pickupCoord,\n    pickupTitle,\n    pickupAddress,\n    walkingRoute,\n    routeSummary,\n    isLoadingRoute,\n    isSubmitting,\n    step,\n    trackingStatus,\n    selectedIssue,\n    customNote,\n    issueSummary,\n    pricing,\n    selectedVoucherId,\n    mechanicRoute,\n    routeStartTimeMs,\n    initialEtaMinutes,\n    liveEtaMinutes,\n    chatMessages,\n    isMechanicTyping,\n    recenterSignal,\n    enteredFromQuickStations,\n  } = props;\n\n  useEffect(() => {\n    if (step !== \'pickup\') setIsVoucherDrawerOpen(false);\n    if (\n      step !== \'tracking\' ||\n      (trackingStatus !== \'accepted\' && trackingStatus !== \'arrived\')\n    ) {\n      setIsChatDrawerOpen(false);\n    }\n  }, [step, trackingStatus]);\n\n  return (\n    <div className=\"relative flex min-h-0 flex-1 flex-col\">\n      <RescueMap\n        userLocation={userLocation}\n        stations={stations}\n        openRepairShops={openRepairShops}\n        selectedStationId={selectedStationId}\n        inspectedStationId={inspectedStationId}\n        selectedShopId={selectedShopId}\n        mapFilter={mapFilter}\n        pickupMode={pickupMode}\n        pickupCoord={pickupCoord}\n        walkingRoute={walkingRoute}\n        shopRoute={shopRoute}\n        mechanicRoute={mechanicRoute}\n        routeStartTimeMs={routeStartTimeMs}\n        initialEtaMinutes={initialEtaMinutes}\n        step={step}\n        trackingStatus={trackingStatus}\n        mechanic={MOCK_MECHANIC}\n        recenterSignal={recenterSignal}\n        onSelectStation={(id) => {\n          props.onSelectStation(id);\n          if (step === \'pickup\') props.onChangeMode(\'safe_station\');\n        }}\n        onInspectStation={props.onInspectStation}\n        onSelectShop={props.onSelectShop}\n        onEtaMinuteChange={props.onEtaMinuteChange}\n        onMechanicArrived={props.onMechanicArrived}\n      />\n\n      <TopOverlayBar\n        step={step}\n        trackingStatus={trackingStatus}\n        onBackToHome={props.onBackToHome}\n        onDemoAdvance={props.onDemoAdvance}\n      />\n\n      {step === \'idle\' && (\n        <MapFilterChips\n          activeFilter={mapFilter}\n          openShopCount={openRepairShops.length}\n          stationCount={stations.length}\n          onSelectFilter={props.onChangeMapFilter}\n        />\n      )}\n\n      <BottomSheetShell\n        step={step}\n        isShopDetailOpen={step === \'idle\' && selectedShop !== null}\n        onRecenter={props.onRecenter}\n      >\n        <MapBottomSheetContent\n          step={step}\n          trackingStatus={trackingStatus}\n          userLocation={userLocation}\n          stations={stations}\n          selectedStationId={selectedStationId}\n          pickupMode={pickupMode}\n          pickupTitle={pickupTitle}\n          pickupAddress={pickupAddress}\n          routeSummary={routeSummary}\n          isLoadingRoute={isLoadingRoute}\n          isSubmitting={isSubmitting}\n          selectedIssue={selectedIssue}\n          customNote={customNote}\n          issueSummary={issueSummary}\n          pricing={pricing}\n          liveEtaMinutes={liveEtaMinutes}\n          enteredFromQuickStations={enteredFromQuickStations}\n          selectedShop={selectedShop}\n          hasShopRoute={shopRoute !== null}\n          shopRouteSummary={shopRouteSummary}\n          isLoadingShopRoute={isLoadingShopRoute}\n          onNavigateToShop={() => {\n            if (selectedShop) props.onNavigateToShop(selectedShop);\n          }}\n          onCloseShopDetail={() => props.onSelectShop(null)}\n          onStartOrder={props.onStartOrder}\n          onOpenSafeStations={props.onOpenSafeStations}\n          onSelectIssue={props.onSelectIssue}\n          onChangeNote={props.onChangeNote}\n          onChangeMode={props.onChangeMode}\n          onSelectStation={props.onSelectStation}\n          onOpenVouchers={() => setIsVoucherDrawerOpen(true)}\n          onSetStep={props.onSetStep}\n          onConfirmRescue={props.onConfirmRescue}\n          onOpenChat={() => setIsChatDrawerOpen(true)}\n          onDemoAdvance={props.onDemoAdvance}\n          onCancelOrder={props.onCancelOrder}\n          onCompleteOrder={props.onCompleteOrder}\n        />\n      </BottomSheetShell>\n\n      <VoucherDrawerModal\n        isOpen={isVoucherDrawerOpen}\n        vouchers={VOUCHER_OPTIONS}\n        selectedVoucherId={selectedVoucherId}\n        pickupMode={pickupMode}\n        onApplyVoucher={props.onSelectVoucher}\n        onClose={() => setIsVoucherDrawerOpen(false)}\n      />\n\n      <MechanicChatDrawer\n        isOpen={isChatDrawerOpen}\n        mechanic={MOCK_MECHANIC}\n        messages={chatMessages}\n        quickSuggestions={QUICK_CHAT_SUGGESTIONS}\n        isMechanicTyping={isMechanicTyping}\n        onSendMessage={props.onSendChatMessage}\n        onClose={() => setIsChatDrawerOpen(false)}\n      />\n    </div>\n  );\n}"
          replacement_content: "export function MapTabView(props: MapTabViewProps) {\n  const [isVoucherDrawerOpen, setIsVoucherDrawerOpen] = useState(false);\n  const [isChatDrawerOpen, setIsChatDrawerOpen] = useState(false);\n\n  const { step, trackingStatus } = props;\n\n  useEffect(() => {\n    if (step !== \'pickup\') setIsVoucherDrawerOpen(false);\n    if (\n      step !== \'tracking\' ||\n      (trackingStatus !== \'accepted\' && trackingStatus !== \'arrived\')\n    ) {\n      setIsChatDrawerOpen(false);\n    }\n  }, [step, trackingStatus]);\n\n  return (\n    <div className=\"relative flex min-h-0 flex-1 flex-col\">\n      <RescueMap\n        userLocation={props.userLocation}\n        stations={props.stations}\n        openRepairShops={props.openRepairShops}\n        selectedStationId={props.selectedStationId}\n        inspectedStationId={props.inspectedStationId}\n        selectedShopId={props.selectedShopId}\n        mapFilter={props.mapFilter}\n        pickupMode={props.pickupMode}\n        pickupCoord={props.pickupCoord}\n        walkingRoute={props.walkingRoute}\n        shopRoute={props.shopRoute}\n        mechanicRoute={props.mechanicRoute}\n        routeStartTimeMs={props.routeStartTimeMs}\n        initialEtaMinutes={props.initialEtaMinutes}\n        step={step}\n        trackingStatus={trackingStatus}\n        mechanic={MOCK_MECHANIC}\n        recenterSignal={props.recenterSignal}\n        onSelectStation={(id) => {\n          props.onSelectStation(id);\n          if (step === \'pickup\') props.onChangeMode(\'safe_station\');\n        }}\n        onInspectStation={props.onInspectStation}\n        onSelectShop={props.onSelectShop}\n        onEtaMinuteChange={props.onEtaMinuteChange}\n        onMechanicArrived={props.onMechanicArrived}\n      />\n\n      <TopOverlayBar\n        step={step}\n        trackingStatus={trackingStatus}\n        onBackToHome={props.onBackToHome}\n        onDemoAdvance={props.onDemoAdvance}\n      />\n\n      {step === \'idle\' && (\n        <MapFilterChips\n          activeFilter={props.mapFilter}\n          openShopCount={props.openRepairShops.length}\n          stationCount={props.stations.length}\n          onSelectFilter={props.onChangeMapFilter}\n        />\n      )}\n\n      <BottomSheetShell\n        step={step}\n        isShopDetailOpen={step === \'idle\' && props.selectedShop !== null}\n        onRecenter={props.onRecenter}\n      >\n        <MapBottomSheetContent\n          step={step}\n          trackingStatus={trackingStatus}\n          userLocation={props.userLocation}\n          stations={props.stations}\n          selectedStationId={props.selectedStationId}\n          pickupMode={props.pickupMode}\n          pickupTitle={props.pickupTitle}\n          pickupAddress={props.pickupAddress}\n          routeSummary={props.routeSummary}\n          isLoadingRoute={props.isLoadingRoute}\n          isSubmitting={props.isSubmitting}\n          selectedIssue={props.selectedIssue}\n          customNote={props.customNote}\n          issueSummary={props.issueSummary}\n          pricing={props.pricing}\n          liveEtaMinutes={props.liveEtaMinutes}\n          enteredFromQuickStations={props.enteredFromQuickStations}\n          selectedShop={props.selectedShop}\n          hasShopRoute={props.shopRoute !== null}\n          shopRouteSummary={props.shopRouteSummary}\n          isLoadingShopRoute={props.isLoadingShopRoute}\n          onNavigateToShop={() => {\n            if (props.selectedShop) props.onNavigateToShop(props.selectedShop);\n          }}\n          onCloseShopDetail={() => props.onSelectShop(null)}\n          onStartOrder={props.onStartOrder}\n          onOpenSafeStations={props.onOpenSafeStations}\n          onSelectIssue={props.onSelectIssue}\n          onChangeNote={props.onChangeNote}\n          onChangeMode={props.onChangeMode}\n          onSelectStation={props.onSelectStation}\n          onOpenVouchers={() => setIsVoucherDrawerOpen(true)}\n          onSetStep={props.onSetStep}\n          onConfirmRescue={props.onConfirmRescue}\n          onOpenChat={() => setIsChatDrawerOpen(true)}\n          onDemoAdvance={props.onDemoAdvance}\n          onCancelOrder={props.onCancelOrder}\n          onCompleteOrder={props.onCompleteOrder}\n        />\n      </BottomSheetShell>\n\n      <VoucherDrawerModal\n        isOpen={isVoucherDrawerOpen}\n        vouchers={VOUCHER_OPTIONS}\n        selectedVoucherId={props.selectedVoucherId}\n        pickupMode={props.pickupMode}\n        onApplyVoucher={props.onSelectVoucher}\n        onClose={() => setIsVoucherDrawerOpen(false)}\n      />\n\n      <MechanicChatDrawer\n        isOpen={isChatDrawerOpen}\n        mechanic={MOCK_MECHANIC}\n        messages={props.chatMessages}\n        quickSuggestions={QUICK_CHAT_SUGGESTIONS}\n        isMechanicTyping={props.isMechanicTyping}\n        onSendMessage={props.onSendChatMessage}\n        onClose={() => setIsChatDrawerOpen(false)}\n      />\n    </div>\n  );\n}"
