      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Pass rAF timing and arrival callbacks into useRescueMapMechanicOverlay in RescueMap\", \"EndLine\":92, \"Instruction\":\"Replace mechanicCoord/mechanicEtaMinutes props with routeStartTimeMs, initialEtaMinutes, onEtaMinuteChange, onMechanicArrived in RescueMap.tsx\", \"ReplacementContent\":\"interface RescueMapProps {\\n  userLocation: UserLocation;\\n  stations: SafeStation[];\\n  selectedStationId: string | null;\\n  inspectedStationId: string | null;\\n  pickupMode: PickupMode;\\n  pickupCoord: GeoCoord;\\n  walkingRoute: GeoJsonLineString | null;\\n  mechanicRoute: GeoJsonLineString | null;\\n  routeStartTimeMs: number | null;\\n  initialEtaMinutes: number;\\n  step: RescueStep;\\n  trackingStatus: TrackingStatus;\\n  mechanic: MechanicInfo;\\n  recenterSignal: number;\\n  onSelectStation: (stationId: string) => void;\\n  onInspectStation: (stationId: string | null) => void;\\n  onEtaMinuteChange: (etaMinutes: number) => void;\\n  onMechanicArrived: () => void;\\n}\\n\\nexport function RescueMap({\\n  userLocation,\\n  stations,\\n  selectedStationId,\\n  inspectedStationId,\\n  pickupMode,\\n  pickupCoord,\\n  walkingRoute,\\n  mechanicRoute,\\n  routeStartTimeMs,\\n  initialEtaMinutes,\\n  step,\\n  trackingStatus,\\n  mechanic,\\n  recenterSignal,\\n  onSelectStation,\\n  onInspectStation,\\n  onEtaMinuteChange,\\n  onMechanicArrived,\\n}: RescueMapProps) {\\n  const containerRef = useRef<HTMLDivElement | null>(null);\\n  const mapRef = useRef<MapLibreMap | null>(null);\\n  const userMarkerRef = useRef<Marker | null>(null);\\n  const stationMarkersRef = useRef<Marker[]>([]);\\n  const [mapReady, setMapReady] = useState(false);\\n\\n  const mechanicMarkerRef = useRescueMapMechanicOverlay({\\n    mapRef,\\n    containerRef,\\n    mapReady,\\n    step,\\n    trackingStatus,\\n    mechanicRoute,\\n    routeStartTimeMs,\\n    initialEtaMinutes,\\n    pickupCoord,\\n    mechanicName: mechanic.name,\\n    onEtaMinuteChange,\\n    onMechanicArrived,\\n  });\", \"StartLine\":32, \"TargetContent\":\"interface RescueMapProps {\\n  userLocation: UserLocation;\\n  stations: SafeStation[];\\n  selectedStationId: string | null;\\n  inspectedStationId: string | null;\\n  pickupMode: PickupMode;\\n  pickupCoord: GeoCoord;\\n  walkingRoute: GeoJsonLineString | null;\\n  mechanicRoute: GeoJsonLineString | null;\\n  step: RescueStep;\\n  trackingStatus: TrackingStatus;\\n  mechanic: MechanicInfo;\\n  mechanicCoord: GeoCoord;\\n  mechanicEtaMinutes: number;\\n  recenterSignal: number;\\n  onSelectStation: (stationId: string) => void;\\n  onInspectStation: (stationId: string | null) => void;\\n}\\n\\nexport function RescueMap({\\n  userLocation,\\n  stations,\\n  selectedStationId,\\n  inspectedStationId,\\n  pickupMode,\\n  pickupCoord,\\n  walkingRoute,\\n  mechanicRoute,\\n  step,\\n  trackingStatus,\\n  mechanic,\\n  mechanicCoord,\\n  mechanicEtaMinutes,\\n  recenterSignal,\\n  onSelectStation,\\n  onInspectStation,\\n}: RescueMapProps) {\\n  const containerRef = useRef<HTMLDivElement | null>(null);\\n  const mapRef = useRef<MapLibreMap | null>(null);\\n  const userMarkerRef = useRef<Marker | null>(null);\\n  const stationMarkersRef = useRef<Marker[]>([]);\\n  const [mapReady, setMapReady] = useState(false);\\n\\n  const mechanicMarkerRef = useRescueMapMechanicOverlay({\\n    mapRef,\\n    containerRef,\\n    mapReady,\\n    step,\\n    trackingStatus,\\n    mechanicRoute,\\n    mechanicCoord,\\n    pickupCoord,\\n    mechanicName: mechanic.name,\\n    mechanicEtaMinutes,\\n  });\", \"TargetFile\":\"/src/components/RescueMap.tsx\", \"toolAction\":\"Updating RescueMap props for 60fps route overlay\", \"toolSummary\":\"Update RescueMap.tsx\"}"
      original_name: "replace_file_content"
