      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update reverse geocoding unit tests for street+area priority and ignoring agency POI names\", \"EndLine\":23, \"Instruction\":\"Update parseReverseGeocodeAddress tests in geocodeApi.test.ts\", \"ReplacementContent\":\"test(\'parseReverseGeocodeAddress ignores nearby building POI name and prioritizes street + area cleanly\', () => {\\n  const address = parseReverseGeocodeAddress(\\n    {\\n      properties: {\\n        name: \'S\341\273\237 N\303\264ng nghi\341\273\207p v\303\240 M\303\264i tr\306\260\341\273\235ng Th\303\240nh ph\341\273\221 H\341\273\223 Ch\303\255 Minh\',\\n        address_line1: \'S\341\273\237 N\303\264ng nghi\341\273\207p v\303\240 M\303\264i tr\306\260\341\273\235ng Th\303\240nh ph\341\273\221 H\341\273\223 Ch\303\255 Minh\',\\n        housenumber: \'182\',\\n        street: \'\304\220i\341\273\207n Bi\303\252n Ph\341\273\247\',\\n        district: \'Qu\341\272\255n B\303\254nh Th\341\272\241nh\',\\n      },\\n    },\\n    { lat: 10.7769, lng: 106.7009 },\\n  );\\n  assert.equal(address, \'182 \304\220i\341\273\207n Bi\303\252n Ph\341\273\247, Qu\341\272\255n B\303\254nh Th\341\272\241nh\');\\n\\n  const suburbPreferred = parseReverseGeocodeAddress(\\n    {\\n      properties: {\\n        street: \'L\303\252 Th\303\241nh T\303\264n\',\\n        suburb: \'Ph\306\260\341\273\235ng B\341\272\277n Ngh\303\251\',\\n        district: \'Qu\341\272\255n 1\',\\n      },\\n    },\\n    { lat: 10.7769, lng: 106.7009 },\\n  );\\n  assert.equal(suburbPreferred, \'L\303\252 Th\303\241nh T\303\264n, Ph\306\260\341\273\235ng B\341\272\277n Ngh\303\251\');\\n});\", \"StartLine\":11, \"TargetContent\":\"test(\'parseReverseGeocodeAddress formats compact street and district cleanly\', () => {\\n  const address = parseReverseGeocodeAddress(\\n    {\\n      properties: {\\n        address_line1: \'86 L\303\252 Th\303\241nh T\303\264n\',\\n        district: \'Qu\341\272\255n 1\',\\n      },\\n    },\\n    { lat: 10.7769, lng: 106.7009 },\\n  );\\n  assert.equal(address, \'86 L\303\252 Th\303\241nh T\303\264n, Q.1\');\\n});\", \"TargetFile\":\"/src/utils/geocodeApi.test.ts\", \"toolAction\":\"Updating geocodeApi unit tests\", \"toolSummary\":\"Update geocodeApi tests\"}"
      original_name: "replace_file_content"
    }
