  code_action {
    action_spec {
      create_file {
        instruction: "import { Map as MapLibreMap, Marker } from \'maplibre-gl\';\nimport { useEffect, useRef } from \'react\';\nimport type {\n  GeoCoord,\n  GeoJsonLineString,\n  RescueStep,\n  TrackingStatus,\n} from \'../types/rescue\';\nimport { computeBoundsBox } from \'../utils/rescueLogic\';\nimport { fitMapBoundsSafely, setRouteSourceGeometry } from \'../components/map/mapLayers\';\nimport {\n  createMechanicMarkerElement,\n  updateMechanicMarkerElement,\n} from \'../components/map/mapMarkers\';\n\ninterface UseRescueMapMechanicOverlayArgs {\n  mapRef: React.MutableRefObject<MapLibreMap | null>;\n  containerRef: React.MutableRefObject<HTMLDivElement | null>;\n  mapReady: boolean;\n  step: RescueStep;\n  trackingStatus: TrackingStatus;\n  mechanicRoute: GeoJsonLineString | null;\n  mechanicCoord: GeoCoord;\n  pickupCoord: GeoCoord;\n  mechanicName: string;\n  mechanicEtaMinutes: number;\n}\n\nexport function useRescueMapMechanicOverlay({\n  mapRef,\n  containerRef,\n  mapReady,\n  step,\n  trackingStatus,\n  mechanicRoute,\n  mechanicCoord,\n  pickupCoord,\n  mechanicName,\n  mechanicEtaMinutes,\n}: UseRescueMapMechanicOverlayArgs) {\n  const mechanicMarkerRef = useRef<Marker | null>(null);\n  const fittedRouteRef = useRef<GeoJsonLineString | null>(null);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    const showRoute =\n      step === \'tracking\' &&\n      (trackingStatus === \'accepted\' || trackingStatus === \'completed\');\n\n    if (!showRoute) {\n      setRouteSourceGeometry(map, \'mechanic-route\', null);\n      fittedRouteRef.current = null;\n      return;\n    }\n\n    const activeRoute: GeoJsonLineString = mechanicRoute ?? {\n      type: \'LineString\',\n      coordinates: [\n        [mechanicCoord.lng, mechanicCoord.lat],\n        [pickupCoord.lng, pickupCoord.lat],\n      ],\n    };\n    setRouteSourceGeometry(map, \'mechanic-route\', activeRoute);\n\n    if (mechanicRoute && fittedRouteRef.current !== mechanicRoute) {\n      fittedRouteRef.current = mechanicRoute;\n      const bounds = computeBoundsBox(mechanicRoute.coordinates);\n      if (bounds) {\n        fitMapBoundsSafely(map, containerRef.current, bounds, 15.8, 550);\n      }\n    }\n  }, [step, trackingStatus, mechanicRoute, pickupCoord, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    const showMechanic =\n      step === \'tracking\' &&\n      (trackingStatus === \'accepted\' || trackingStatus === \'completed\');\n\n    if (!showMechanic) {\n      mechanicMarkerRef.current?.remove();\n      mechanicMarkerRef.current = null;\n      return;\n    }\n\n    const isCompleted = trackingStatus === \'completed\';\n    const currentPos = isCompleted ? pickupCoord : mechanicCoord;\n\n    if (!mechanicMarkerRef.current) {\n      const el = createMechanicMarkerElement(\n        mechanicName,\n        mechanicEtaMinutes,\n        isCompleted,\n      );\n      mechanicMarkerRef.current = new Marker({ element: el, anchor: \'bottom\' })\n        .setLngLat([currentPos.lng, currentPos.lat])\n        .addTo(map);\n      return;\n    }\n\n    mechanicMarkerRef.current.setLngLat([currentPos.lng, currentPos.lat]);\n    updateMechanicMarkerElement(\n      mechanicMarkerRef.current.getElement(),\n      mechanicName,\n      mechanicEtaMinutes,\n      isCompleted,\n    );\n  }, [step, trackingStatus, mechanicCoord, mechanicEtaMinutes, pickupCoord, mechanicName, mapReady]);\n\n  return mechanicMarkerRef;\n}\n"
        path {
          absolute_uri: "file:///src/hooks/useRescueMapMechanicOverlay.ts"
        }
        overwrite: true
      }
    }
