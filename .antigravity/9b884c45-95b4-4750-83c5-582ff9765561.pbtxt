  code_action {
    action_spec {
      create_file {
        instruction: "import { ChevronRight, Ticket } from \'lucide-react\';\nimport type { OrderPricing } from \'../../types/rescue\';\nimport { formatVnd } from \'../../utils/pricingAndSimLogic\';\n\ninterface OrderInvoiceBarProps {\n  pricing: OrderPricing;\n  availableVoucherCount: number;\n  onOpenVouchers: () => void;\n}\n\nexport function OrderInvoiceBar({\n  pricing,\n  availableVoucherCount,\n  onOpenVouchers,\n}: OrderInvoiceBarProps) {\n  const hasDiscount =\n    pricing.appliedVoucher !== null && pricing.discountAmount > 0;\n\n  return (\n    <div className=\"mb-2.5 space-y-2\">\n      {/* Transparent invoice breakdown */}\n      <div\n        className=\"rounded-xl border border-slate-200/80 bg-slate-50/80 px-3 py-2 text-xs\"\n        aria-label=\"Chi ti\341\272\277t h\303\263a \304\221\306\241n c\341\273\251u h\341\273\231\"\n      >\n        <div className=\"flex items-center justify-between gap-2 text-slate-600\">\n          <span>Gi\303\241 d\341\273\213ch v\341\273\245 g\341\273\221c</span>\n          <span\n            className={`font-sans tabular-nums ${\n              hasDiscount ? \'text-slate-400 line-through\' : \'font-semibold text-slate-800\'\n            }`}\n          >\n            {formatVnd(pricing.basePrice)}\n          </span>\n        </div>\n\n        <div className=\"mt-1 flex items-center justify-between gap-2 text-slate-600\">\n          <span>Gi\341\272\243m gi\303\241 khuy\341\272\277n m\303\243i</span>\n          <span\n            className={`font-sans font-semibold tabular-nums ${\n              hasDiscount ? \'text-emerald-600\' : \'text-slate-400\'\n            }`}\n          >\n            {hasDiscount ? `-${formatVnd(pricing.discountAmount)}` : \'0\304\221\'}\n          </span>\n        </div>\n\n        <div className=\"mt-1.5 flex items-center justify-between gap-2 border-t border-slate-200/80 pt-1.5\">\n          <span className=\"font-bold text-slate-900\">T\341\273\225ng thanh to\303\241n</span>\n          <span\n            data-testid=\"invoice-final-price\"\n            className=\"font-sans text-sm font-extrabold tabular-nums text-emerald-700\"\n          >\n            {formatVnd(pricing.finalPrice)}\n          </span>\n        </div>\n      </div>\n\n      {/* Voucher selector trigger bar */}\n      <button\n        type=\"button\"\n        onClick={onOpenVouchers}\n        data-testid=\"voucher-picker-trigger\"\n        className={`flex min-h-[42px] w-full items-center justify-between gap-2 rounded-xl border px-3 py-2 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${\n          hasDiscount\n            ? \'border-emerald-500 bg-emerald-50/70\'\n            : \'border-slate-200 bg-white hover:border-emerald-300 hover:bg-slate-50\'\n        }`}\n      >\n        <span className=\"flex min-w-0 items-center gap-2\">\n          <Ticket\n            className={`h-4 w-4 shrink-0 ${\n              hasDiscount ? \'text-emerald-600\' : \'text-amber-500\'\n            }`}\n            aria-hidden=\"true\"\n          />\n          <span className=\"text-xs font-bold text-slate-900\">\306\257u \304\221\303\243i</span>\n        </span>\n\n        <span className=\"flex min-w-0 items-center gap-1\">\n          <span\n            className={`truncate font-sans text-xs font-semibold tabular-nums ${\n              hasDiscount ? \'text-emerald-700\' : \'text-slate-500\'\n            }`}\n          >\n            {hasDiscount && pricing.appliedVoucher\n              ? `${pricing.appliedVoucher.code} (-${formatVnd(pricing.discountAmount)})`\n              : `Ch\341\273\215n m\303\243 gi\341\272\243m gi\303\241 (${availableVoucherCount} s\341\272\265n c\303\263)`}\n          </span>\n          <ChevronRight className=\"h-4 w-4 shrink-0 text-slate-400\" aria-hidden=\"true\" />\n        </span>\n      </button>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/OrderInvoiceBar.tsx"
        }
        overwrite: true
      }
    }
