pBottomSheetContentProps) {\\n  const { step, trackingStatus, mapFilter, selectedShop, pinPicker } = props;\\n\\n  if (pinPicker?.isActive) {\\n    return (\\n      <PinPickerSheet\\n        coord={pinPicker.coord}\\n        address={pinPicker.address}\\n        isResolving={pinPicker.isResolving}\\n        onConfirm={pinPicker.onConfirm}\\n        onCancel={pinPicker.onCancel}\\n      />\\n    );\\n  }\\n\\n  if (step === \'idle\' && selectedShop) {\\n    return (\\n      <RepairShopDetailSheet\\n        shop={selectedShop}\\n        hasActiveRoute={props.hasShopRoute}\\n        routeSummary={props.shopRouteSummary}\\n        isLoadingRoute={props.isLoadingShopRoute}\\n        onNavigate={props.onNavigateToShop}\\n        onClose={props.onCloseShopDetail}\\n      />\\n    );\\n  }\", \"StartLine\":68, \"TargetContent\":\"  onCancelOrder: () => void;\\n  onCompleteOrder: () => void;\\n}\\n\\nexport function MapBottomSheetContent(props: MapBottomSheetContentProps) {\\n  const { step, trackingStatus, mapFilter, selectedShop } = props;\\n\\n  if (step === \'idle\' && selectedShop) {\\n    return (\\n      <RepairShopDetailSheet\\n        shop={selectedShop}\\n        hasActiveRoute={props.hasShopRoute}\\n        routeSummary={props.shopRouteSummary}\\n        isLoadingRoute={props.isLoadingShopRoute}\\n        onNavigate={props.onNavigateToShop}\\n        onClose={props.onCloseShopDetail}\\n      />\\n    );\\n  }\"}], \"TargetFile\":\"/src/components/tabs/MapBottomSheetContent.tsx\", \"toolAction\":\"Adding PinPickerSheet to MapBottomSheetContent\", \"toolSummary\":\"Wire PinPickerSheet into sheet\"}"
