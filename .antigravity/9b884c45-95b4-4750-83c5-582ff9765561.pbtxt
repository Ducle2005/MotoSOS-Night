      thinking_signature: "\022\341\b\n\336\b\001i\024}\023&\213\001\037\r\223\317\221+\332\r\366L\326\310W\n\210\v\273~\226G\215\331\235\260\021B\264\037d\"\3036M\256w\377\371#\264\0254\354\250B\261\222./\031\273U\003d@\242x\276\225fs\332\023\223\r\006\214\220\325dAn\214\351\n\202\356`\212\2579\034\220s\377W\372S\357\306X)\255!\205cz\350\021\306\020\331?\245\331o\000\\?\342\373\333\177b|\255R\333\220\005\003\267\344\314\214\251\223C\2164\216\031\334\240\002?\305\373Z\251\250\001\227\366r\304L\361 \375h.\027\316S\021\347kn\313\314\vo^\341~\f\266\376<\350\372\303\'n \331Xg\352\311\213>*Y\221\2460E\200\364\026E\n\242\302\216\353N\365\202\023M\004::\331\223\023\260%\235_H\f\"\371*\366\017\323\327\306\005\337\315\\c4{\016\303\322\365@\350\277\020:RQ\302_\001\216\264UC\310\024\226{3\030\331A\024\366\334\235\317\305\016\020\031\004\024z\236;\026\364% G\275\255\334+\034{\244\306\256\267\217\244\267\3513po\316-<\363-\373\262\036\201\335\2600\373\301\016J\373*\001\330\274<\fh\234Et`\331\227hMIL\026^KT\246\303i\v\343\266qS5y\256\242\312\264\n\215W&\237\300\2426\220\351\202u\303\243r\323x\202\2362\372\252\263\254N\230C\250\342\277i\337s\241\315\314\347\204yG\353,\305?N\250C\212i\345\033\315\032\316\344v\222\252\2057\331[\"\251g\251\rJHT\270E-\a=\020\313\226\250\351\"{\r\366\245\350\337U\242\305\276\350\351\024J\345\r\033#\343\230\313htj\220p_\a\326W\243\201y\256,s\316@*I\345\370\310\251\b\241\364\\\327\366v\004\200\\\271<`\0013K\221\214P\274H\310!\204g\217\350\023\301s{\364\255$$*7\274\333w\3174\002\243\031\204\224\337\364\235\366J!\204\232\375\261\336\345A\361\027\224\v\367\312\300\334\361\342\357\331V\377Z=A\277\210$\373l\024\203m\370\337\265\222\rP^\'\374&\031~@Uev$\210\307\233\272\324e\361\373\342i:\b\365s\031)\032\224\001\r\375x b\002xQ*0\352Y\324+0\266Z@\243[\310\364\374\v\366\252\253\345\024\312\3547\356e?\363\373q\201\347oM^\203\275d\211#\36127\305\227\302@\252\374\2047\226H\347\316%\362 \203YP\301\271\220@\263d\211\023\022\246I\3666\275R\002\004\214\027F\262\305\223\3