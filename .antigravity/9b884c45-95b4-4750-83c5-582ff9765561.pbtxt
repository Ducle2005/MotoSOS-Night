    end_line: 136
    content: "import { ChevronDown, ChevronUp, LocateFixed } from \'lucide-react\';\nimport { useEffect, useState, type ReactNode } from \'react\';\nimport type { RescueStep } from \'../types/rescue\';\n\ninterface BottomSheetShellProps {\n  step: RescueStep;\n  isShopDetailOpen?: boolean;\n  isGasListOpen?: boolean;\n  floatingTopSlot?: ReactNode;\n  onRecenter: () => void;\n  children: ReactNode;\n}\n\nconst STEP_INDEX: Record<RescueStep, number> = {\n  idle: 0,\n  issue: 1,\n  pickup: 2,\n  tracking: 3,\n};\n\nexport function BottomSheetShell({\n  step,\n  isShopDetailOpen = false,\n  isGasListOpen = false,\n  floatingTopSlot,\n  onRecenter,\n  children,\n}: BottomSheetShellProps) {\n  const [isCollapsed, setIsCollapsed] = useState(false);\n\n  useEffect(() => {\n    setIsCollapsed(false);\n  }, [step]);\n\n  const currentIndex = STEP_INDEX[step];\n  const expandedHeightClass =\n    step === \'idle\'\n      ? isGasListOpen\n        ? \'max-h-[48%]\'\n        : isShopDetailOpen\n          ? \'max-h-[44%]\'\n          : \'max-h-[34%]\'\n      : step === \'issue\'\n        ? \'max-h-[62%]\'\n        : step === \'pickup\'\n          ? \'max-h-[76%]\'\n          : \'max-h-[64%]\';\n\n  const heightClass = isCollapsed ? \'max-h-[72px]\' : expandedHeightClass;\n\n  return (\n    <aside\n      aria-label=\"B\341\272\243ng \304\221i\341\273\201u khi\341\273\203n c\341\273\251u h\341\273\231 xe m\303\241y\"\n      className={`pointer-events-auto absolute inset-x-0 bottom-0 z-20 flex ${heightClass} flex-col rounded-t-3xl border-t border-slate-100 bg-white shadow-[0_-8px_30px_rgba(0,0,0,0.08)] transition-[max-height] duration-200`}\n    >\n      {/* Floating container right above Bottom Sheet: Recenter button + FloatingPlaceCard */}\n      <div className=\"pointer-events-none absolute inset-x-0 bottom-full z-30 mb-2.5 flex flex-col gap-2 px-4\">\n        <button\n          type=\"button\"\n          onClick={onRecenter}\n          aria-label=\"V\341\273\201 v\341\273\213 tr\303\255 c\341\273\247a t\303\264i\"\n          title=\"V\341\273\201 v\341\273\213 tr\303\255 c\341\273\247a t\303\264i\"\n          className=\"pointer-events-auto flex h-11 w-11 self-end items-center justify-center rounded-full border border-slate-200 bg-white text-emerald-600 shadow-lg shadow-slate-900/10 transition-all hover:border-emerald-400 hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 active:scale-95\"\n        >\n          <LocateFixed className=\"h-5 w-5\" aria-hidden=\"true\" />\n        </button>\n\n        {floatingTopSlot}\n      </div>\n\n      {/* Drag handle & Collapse/Expand button */}\n      <div className=\"flex shrink-0 items-center justify-between px-4 pt-2 pb-1\">\n        <span className=\"w-16\" aria-hidden=\"true\" />\n        <div className=\"h-1 w-9 rounded-full bg-slate-200\" aria-hidden=\"true\" />\n        <button\n          type=\"button\"\n          data-testid=\"toggle-sheet-btn\"\n          aria-expanded={!isCollapsed}\n          onClick={() => setIsCollapsed((prev) => !prev)}\n          className=\"inline-flex h-6 items-center gap-1 rounded-full bg-slate-100 px-2.5 text-[11px] font-semibold text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap\"\n        >\n          {isCollapsed ? (\n            <>\n              <ChevronUp className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n              <span>M\341\273\237 r\341\273\231ng</span>\n            </>\n          ) : (\n            <>\n              <ChevronDown className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n              <span>Thu g\341\273\215n</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Step progress indicator during active flow */}\n      {currentIndex > 0 && (\n        <div className=\"shrink-0 px-5 pt-0.5 pb-1.5\">\n          <div className=\"flex items-center justify-between text-xs\">\n            <span className=\"font-sans font-semibold tabular-nums text-slate-900\">\n              B\306\260\341\273\233c {currentIndex} / 3\n            </span>\n            <span className=\"font-semibold text-emerald-600\">\n              {currentIndex === 1 && \'Ch\341\273\215n s\341\273\261 c\341\273\221\'}\n              {currentIndex === 2 && \'Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235\'}\n              {currentIndex === 3 && \'Theo d\303\265i th\341\273\243\'}\n            </span>\n          </div>\n          <div\n            className=\"mt-1 grid grid-cols-3 gap-1.5\"\n            role=\"progressbar\"\n            aria-valuenow={currentIndex}\n            aria-valuemin={1}\n            aria-valuemax={3}\n            aria-label=\"Ti\341\272\277n tr\303\254nh \304\221\341\272\267t c\341\273\251u h\341\273\231\"\n          >\n            {[1, 2, 3].map((idx) => (\n              <div\n                key={idx}\n                className={`h-1 rounded-full transition-colors duration-200 ${\n                  idx <= currentIndex ? \'bg-emerald-500\' : \'bg-slate-100\'\n                }`}\n              />\n            ))}\n          </div>\n        </div>\n      )}\n\n      {!isCollapsed && (\n        <div className=\"flex min-h-0 flex-1 flex-col overflow-hidden rounded-t-3xl\">\n          {children}\n        </div>\n      )}\n    </aside>\n  );\n}\n"
