    tool_calls {
      id: "call_3734984697589855798"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Auto-fit map bounds to nearby open repair shops when repair_shops filter is active\", \"EndLine\":224, \"Instruction\":\"Add useEffect fitting map bounds to userLocation + nearest 5 openRepairShops when mapFilter is repair_shops and no route is active\", \"ReplacementContent\":\"  useEffect(() => {\\n    const map = mapRef.current;\\n    if (!map || !mapReady) return;\\n\\n    const activeGeometry = step === \'idle\' ? shopRoute : null;\\n    setRouteSourceGeometry(map, \'shop-route\', activeGeometry);\\n    if (!activeGeometry) return;\\n\\n    const bounds = computeBoundsBox(activeGeometry.coordinates);\\n    if (bounds) {\\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.2, 600);\\n    }\\n  }, [shopRoute, step, mapReady]);\\n\\n  useEffect(() => {\\n    const map = mapRef.current;\\n    if (\\n      !map ||\\n      !mapReady ||\\n      step !== \'idle\' ||\\n      mapFilter !== \'repair_shops\' ||\\n      shopRoute !== null ||\\n      openRepairShops.length === 0\\n    ) {\\n      return;\\n    }\\n\\n    const points: [number, number][] = [\\n      [userLocation.coord.lng, userLocation.coord.lat],\\n      ...openRepairShops\\n        .slice(0, 5)\\n        .map((shop): [number, number] => [shop.coord.lng, shop.coord.lat]),\\n    ];\\n    const bounds = computeBoundsBox(points);\\n    if (bounds) {\\n      fitMapBoundsSafely(map, containerRef.current, bounds, 15.0, 550);\\n    }\\n  }, [mapFilter, step, mapReady, openRepairShops, shopRoute, userLocation.coord.lat, userLocation.coord.lng]);\\n\\n  return (\", \"StartLine\":208, \"TargetContent\":\"  useEffect(() => {\\n    const map = mapRef.current;\\n    if (!map || !mapReady) return;\\n\\n    const activeGeometry = step === \'idle\' ? shopRoute : null;\\n    setRouteSourceGeometry(map, \'shop-route\', activeGeometry);\\n    if (!activeGeometry) return;\\n\\n    const bounds = computeBoundsBox(activeGeometry.coordinates);\\n    if (bounds) {\\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.2, 600);\\n    }\\n  }, [shopRoute, step, mapReady]);\\n\\n  return (\", \"TargetFile\":\"/src/components/RescueMap.tsx\", \"toolAction\":\"Auto-fitting map bounds for open repair shops filter\", \"toolSummary\":\"Auto-fit open repair shop bounds\"}"
      original_name: "replace_file_content"
    }
