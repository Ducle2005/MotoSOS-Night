    tool_calls {
      id: "call_5219126390726968044"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"\'use client\';\\n\\nimport { Map as MapLibreMap, Marker, setWorkerUrl } from \'maplibre-gl\';\\nimport \'maplibre-gl/dist/maplibre-gl.css\';\\nimport maplibreWorkerUrl from \'maplibre-gl/dist/maplibre-gl-worker.mjs?url\';\\nimport { useEffect, useRef, useState } from \'react\';\\nimport { useMapMarkersSync } from \'../hooks/useMapMarkersSync\';\\nimport { useRescueMapMechanicOverlay } from \'../hooks/useRescueMapMechanicOverlay\';\\nimport type {\\n  GeoCoord,\\n  GeoJsonLineString,\\n  MapLayerFilter,\\n  MechanicInfo,\\n  PickupMode,\\n  RepairShop,\\n  RescueStep,\\n  SafeStation,\\n  TrackingStatus,\\n  UserLocation,\\n} from \'../types/rescue\';\\nimport { computeBoundsBox } from \'../utils/rescueLogic\';\\nimport {\\n  ensureRescueRouteLayers,\\n  fitMapBoundsSafely,\\n  getViewportPadding,\\n  setRouteSourceGeometry,\\n} from \'./map/mapLayers\';\\nimport { createUserMarkerElement } from \'./map/mapMarkers\';\\nimport { StationPreviewCard } from \'./map/StationPreviewCard\';\\n\\nsetWorkerUrl(maplibreWorkerUrl);\\n\\nconst CARTO_POSITRON_STYLE_URL =\\n  \'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json\';\\n\\ninterface RescueMapProps {\\n  userLocation: UserLocation;\\n  stations: SafeStation[];\\n  openRepairShops: RepairShop[];\\n  selectedStationId: string | null;\\n  inspectedStationId: string | null;\\n  selectedShopId: string | null;\\n  mapFilter: MapLayerFilter;\\n  pickupMode: PickupMode;\\n  pickupCoord: GeoCoord;\\n  walkingRoute: GeoJsonLineString | null;\\n  shopRoute: GeoJsonLineString | null;\\n  mechanicRoute: GeoJsonLineString | null;\\n  routeStartTimeMs: number | null;\\n  initialEtaMinutes: number;\\n  step: RescueStep;\\n  trackingStatus: TrackingStatus;\\n  mechanic: MechanicInfo;\\n  recenterSignal: number;\\n  onSelectStation: (stationId: string) => void;\\n  onInspectStation: (stationId: string | null) => void;\\n  onSelectShop: (shopId: string | null) => void;\\n  onEtaMinuteChange: (etaMinutes: number) => void;\\n  onMechanicArrived: () => void;\\n}\\n\\nexport function RescueMap({\\n  userLocation,\\n  stations,\\n  openRepairShops,\\n  selectedStationId,\\n  inspectedStationId,\\n  selectedShopId,\\n  mapFilter,\\n  pickupMode,\\n  pickupCoord,\\n  walkingRoute,\\n  shopRoute,\\n  mechanicRoute,\\n  routeStartTimeMs,\\n  initialEtaMinutes,\\n  step,\\n  trackingStatus,\\n  mechanic,\\n  recenterSignal,\\n  onSelectStation,\\n  onInspectStation,\\n  onSelectShop,\\n  onEtaMinuteChange,\\n  onMechanicArrived,\\n}: RescueMapProps) {\\n  const containerRef = useRef<HTMLDivElement | null>(null);\\n  const mapRef = useRef<MapLibreMap | null>(null);\\n  const userMarkerRef = useRef<Marker | null>(null);\\n  const [mapReady, setMapReady] = useState(false);\\n\\n  const mechanicMarkerRef = useRescueMapMechanicOverlay({\\n    mapRef,\\n    containerRef,\\n    mapReady,\\n    step,\\n    trackingStatus,\\n    mechanicRoute,\\n    routeStartTimeMs,\\n    initialEtaMinutes,\\n    pickupCoord,\\n    mechanicName: mechanic.name,\\n    onEtaMinuteChange,\\n    onMechanicArrived,\\n  });\\n\\n  const { clearAllMarkers } = useMapMarkersSync({\\n    mapRef,\\n    stations,\\n    openRepairShops,\\n    selectedStationId,\\n    inspectedStationId,\\n    selectedShopId,\\n    mapFilter,\\n    step,\\n    pickupMode,\\n    onSelectStation,\\n    onInspectStation,\\n    onSelectShop,\\n  });\\n\\n  const inspectedStation =\\n    stations.find((s) => s.id === inspectedStationId) ?? null;\\n\\n  useEffect(() => {\\n    const el = containerRef.current;\\n    if (!el || mapRef.current) return;\\n\\n    const map = new MapLibreMap({\\n      container: el,\\n      style: CARTO_POSITRON_STYLE_URL,\\n      center: [userLocation.coord.lng, userLocation.coord.lat],\\n      zoom: 15.2,\\n      attributionControl: false,\\n      pitchWithRotate: false,\\n      dragRotate: false,\\n    });\\n\\n    map.on(\'load\', () => {\\n      ensureRescueRouteLayers(map);\\n      map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\\n      map.easeTo({\\n        center: [userLocation.coord.lng, userLocation.coord.lat],\\n        padding: getViewportPadding(el, false),\\n        duration: 0,\\n      });\\n      setMapReady(true);\\n    });\\n\\n    const observer = new ResizeObserver(() => map.resize());\\n    observer.observe(el);\\n    mapRef.current = map;\\n\\n    return () => {\\n      observer.disconnect();\\n      clearAllMarkers();\\n      userMarkerRef.current?.remove();\\n      mechanicMarkerRef.current?.remove();\\n      map.remove();\\n      mapRef.current = null;\\n      setMapReady(false);\\n    };\\n  }, []);\\n\\n  useEffect(() => {\\n    const map = mapRef.current;\\n    if (!map) return;\\n\\n    userMarkerRef.current?.remove();\\n    const isSearching = step === \'tracking\' && trackingStatus === \'searching\';\\n    const el = createUserMarkerElement(isSearching);\\n    userMarkerRef.current = new Marker({ element: el })\\n      .setLngLat([userLocation.coord.lng, userLocation.coord.lat])\\n      .addTo(map);\\n  }, [userLocation.coord.lat, userLocation.coord.lng, step, trackingStatus]);\\n\\n  useEffect(() => {\\n    const map = mapRef.current;\\n    if (!map || !mapReady) return;\\n    map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\\n    map.flyTo({\\n      center: [userLocation.coord.lng, userLocation.coord.lat],\\n      zoom: 15.2,\\n      padding: getViewportPadding(containerRef.current, false),\\n      duration: 600,\\n    });\\n  }, [userLocation.coord.lat, userLocation.coord.lng, recenterSignal, mapReady]);\\n\\n  useEffect(() => {\\n    const map = mapRef.current;\\n    if (!map || !mapReady) return;\\n\\n    setRouteSourceGeometry(map, \'walking-route\', walkingRoute);\\n    if (!walkingRoute || step === \'tracking\') return;\\n\\n    const bounds = computeBoundsBox(walkingRoute.coordinates);\\n    if (bounds) {\\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.5, 600);\\n    }\\n  }, [walkingRoute, step, mapReady]);\\n\\n  useEffect(() => {\\n    const map = mapRef.current;\\n    if (!map || !mapReady) return;\\n\\n    const activeGeometry = step === \'idle\' ? shopRoute : null;\\n    setRouteSourceGeometry(map, \'shop-route\', activeGeometry);\\n    if (!activeGeometry) return;\\n\\n    const bounds = computeBoundsBox(activeGeometry.coordinates);\\n    if (bounds) {\\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.2, 600);\\n    }\\n  }, [shopRoute, step, mapReady]);\\n\\n  return (\\n    <section\\n      aria-label=\\\"B\341\272\243n \304\221\341\273\223 th\341\273\261c t\341\272\277 khu v\341\273\261c, Tr\341\272\241m An To\303\240n v\303\240 Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237\\\"\\n      data-testid=\\\"rescue-map-canvas\\\"\\n      className=\\\"relative h-full w-full bg-slate-100\\\"\\n    >\\n      <div ref={containerRef} className=\\\"h-full w-full\\\" />\\n\\n      {inspectedStation && step === \'idle\' && !selectedShopId && (\\n        <div className=\\\"pointer-events-none absolute inset-x-0 top-28 z-20 px-4\\\">\\n          <div className=\\\"pointer-events-auto relative mx-auto max-w-md lg:mx-0\\\">\\n            <StationPreviewCard\\n              station={inspectedStation}\\n              onClose={() => onInspectStation(null)}\\n            />\\n          </div>\\n        </div>\\n      )}\\n    </section>\\n  );\\n}\\n\", \"Description\":\"Integrate repair shop markers, layer filters, and blue OSRM shop route into RescueMap while staying under 250 lines\", \"Overwrite\":true, \"TargetFile\":\"/src/components/RescueMap.tsx\", \"toolAction\":\"Updating RescueMap with repair shop layers\", \"toolSummary\":\"Update RescueMap\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5219126390726968913"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useState } from \'react\';\\nimport {\\n  MOCK_MECHANIC,\\n  QUICK_CHAT_SUGGESTIONS,\\n  VOUCHER_OPTIONS,\\n} from \'../../data/mockRescueData\';\\nimport type {\\n  ChatMessage,\\n  GeoCoord,\\n  GeoJsonLineString,\\n  IssueType,\\n  MapLayerFilter,\\n  OrderPricing,\\n  PickupMode,\\n  RepairShop,\\n  RescueStep,\\n  SafeStation,\\n  TrackingStatus,\\n  UserLocation,\\n  VoucherId,\\n} from \'../../types/rescue\';\\nimport { BottomSheetShell } from \'../BottomSheetShell\';\\nimport { RescueMap } from \'../RescueMap\';\\nimport { TopOverlayBar } from \'../TopOverlayBar\';\\nimport { MapFilterChips } from \'../map/MapFilterChips\';\\nimport { MechanicChatDrawer } from \'../steps/MechanicChatDrawer\';\\nimport { VoucherDrawerModal } from \'../steps/VoucherDrawerModal\';\\nimport { MapBottomSheetContent } from \'./MapBottomSheetContent\';\\n\\ninterface MapTabViewProps {\\n  userLocation: UserLocation;\\n  stations: SafeStation[];\\n  openRepairShops: RepairShop[];\\n  mapFilter: MapLayerFilter;\\n  selectedStationId: string | null;\\n  inspectedStationId: string | null;\\n  selectedShopId: string | null;\\n  selectedShop: RepairShop | null;\\n  shopRoute: GeoJsonLineString | null;\\n  shopRouteSummary: { distanceMeters: number; durationMinutes: number } | null;\\n  isLoadingShopRoute: boolean;\\n  pickupMode: PickupMode;\\n  pickupCoord: GeoCoord;\\n  pickupTitle: string;\\n  pickupAddress: string;\\n  walkingRoute: GeoJsonLineString | null;\\n  routeSummary: { distanceMeters: number; durationMinutes: number } | null;\\n  isLoadingRoute: boolean;\\n  isSubmitting: boolean;\\n  step: RescueStep;\\n  trackingStatus: TrackingStatus;\\n  selectedIssue: IssueType | null;\\n  customNote: string;\\n  issueSummary: string;\\n  pricing: OrderPricing;\\n  selectedVoucherId: VoucherId | null;\\n  mechanicRoute: GeoJsonLineString | null;\\n  routeStartTimeMs: number | null;\\n  initialEtaMinutes: number;\\n  liveEtaMinutes: number;\\n  chatMessages: ChatMessage[];\\n  isMechanicTyping: boolean;\\n  recenterSignal: number;\\n  enteredFromQuickStations: boolean;\\n  onSelectStation: (id: string) => void;\\n  onInspectStation: (id: string | null) => void;\\n  onChangeMapFilter: (filter: MapLayerFilter) => void;\\n  onSelectShop: (shopId: string | null) => void;\\n  onNavigateToShop: (shop: RepairShop) => void;\\n  onSelectVoucher: (id: VoucherId | null) => void;\\n  onEtaMinuteChange: (etaMinutes: number) => void;\\n  onMechanicArrived: () => void;\\n  onSendChatMessage: (text: string) => void;\\n  onBackToHome: () => void;\\n  onDemoAdvance: () => void;\\n  onRecenter: () => void;\\n  onStartOrder: () => void;\\n  onOpenSafeStations: () => void;\\n  onSelectIssue: (issue: IssueType) => void;\\n  onChangeNote: (note: string) => void;\\n  onChangeMode: (mode: PickupMode) => void;\\n  onSetStep: (step: RescueStep) => void;\\n  onConfirmRescue: () => void;\\n  onCancelOrder: () => void;\\n  onCompleteOrder: () => void;\\n}\\n\\nexport function MapTabView(props: MapTabViewProps) {\\n  const [isVoucherDrawerOpen, setIsVoucherDrawerOpen] = useState(false);\\n  const [isChatDrawerOpen, setIsChatDrawerOpen] = useState(false);\\n\\n  const {\\n    userLocation,\\n    stations,\\n    openRepairShops,\\n    mapFilter,\\n    selectedStationId,\\n    inspectedStationId,\\n    selectedShopId,\\n    selectedShop,\\n    shopRoute,\\n    shopRouteSummary,\\n    isLoadingShopRoute,\\n    pickupMode,\\n    pickupCoord,\\n    pickupTitle,\\n    pickupAddress,\\n    walkingRoute,\\n    routeSummary,\\n    isLoadingRoute,\\n    isSubmitting,\\n    step,\\n    trackingStatus,\\n    selectedIssue,\\n    customNote,\\n    issueSummary,\\n    pricing,\\n    selectedVoucherId,\\n    mechanicRoute,\\n    routeStartTimeMs,\\n    initialEtaMinutes,\\n    liveEtaMinutes,\\n    chatMessages,\\n    isMechanicTyping,\\n    recenterSignal,\\n    enteredFromQuickStations,\\n  } = props;\\n\\n  useEffect(() => {\\n    if (step !== \'pickup\') setIsVoucherDrawerOpen(false);\\n    if (\\n      step !== \'tracking\' ||\\n      (trackingStatus !== \'accepted\' && trackingStatus !== \'arrived\')\\n    ) {\\n      setIsChatDrawerOpen(false);\\n    }\\n  }, [step, trackingStatus]);\\n\\n  return (\\n    <div className=\\\"relative flex min-h-0 flex-1 flex-col\\\">\\n      <RescueMap\\n        userLocation={userLocation}\\n        stations={stations}\\n        openRepairShops={openRepairShops}\\n        selectedStationId={selectedStationId}\\n        inspectedStationId={inspectedStationId}\\n        selectedShopId={selectedShopId}\\n        mapFilter={mapFilter}\\n        pickupMode={pickupMode}\\n        pickupCoord={pickupCoord}\\n        walkingRoute={walkingRoute}\\n        shopRoute={shopRoute}\\n        mechanicRoute={mechanicRoute}\\n        routeStartTimeMs={routeStartTimeMs}\\n        initialEtaMinutes={initialEtaMinutes}\\n        step={step}\\n        trackingStatus={trackingStatus}\\n        mechanic={MOCK_MECHANIC}\\n        recenterSignal={recenterSignal}\\n        onSelectStation={(id) => {\\n          props.onSelectStation(id);\\n          if (step === \'pickup\') props.onChangeMode(\'safe_station\');\\n        }}\\n        onInspectStation={props.onInspectStation}\\n        onSelectShop={props.onSelectShop}\\n        onEtaMinuteChange={props.onEtaMinuteChange}\\n        onMechanicArrived={props.onMechanicArrived}\\n      />\\n\\n      <TopOverlayBar\\n        step={step}\\n        trackingStatus={trackingStatus}\\n        onBackToHome={props.onBackToHome}\\n        onDemoAdvance={props.onDemoAdvance}\\n      />\\n\\n      {step === \'idle\' && (\\n        <MapFilterChips\\n          activeFilter={mapFilter}\\n          openShopCount={openRepairShops.length}\\n          stationCount={stations.length}\\n          onSelectFilter={props.onChangeMapFilter}\\n        />\\n      )}\\n\\n      <BottomSheetShell\\n        step={step}\\n        isShopDetailOpen={step === \'idle\' && selectedShop !== null}\\n        onRecenter={props.onRecenter}\\n      >\\n        <MapBottomSheetContent\\n          step={step}\\n          trackingStatus={trackingStatus}\\n          userLocation={userLocation}\\n          stations={stations}\\n          selectedStationId={selectedStationId}\\n          pickupMode={pickupMode}\\n          pickupTitle={pickupTitle}\\n          pickupAddress={pickupAddress}\\n          routeSummary={routeSummary}\\n          isLoadingRoute={isLoadingRoute}\\n          isSubmitting={isSubmitting}\\n          selectedIssue={selectedIssue}\\n          customNote={customNote}\\n          issueSummary={issueSummary}\\n          pricing={pricing}\\n          liveEtaMinutes={liveEtaMinutes}\\n          enteredFromQuickStations={enteredFromQuickStations}\\n          selectedShop={selectedShop}\\n          hasShopRoute={shopRoute !== null}\\n          shopRouteSummary={shopRouteSummary}\\n          isLoadingShopRoute={isLoadingShopRoute}\\n          onNavigateToShop={() => {\\n            if (selectedShop) props.onNavigateToShop(selectedShop);\\n          }}\\n          onCloseShopDetail={() => props.onSelectShop(null)}\\n          onStartOrder={props.onStartOrder}\\n          onOpenSafeStations={props.onOpenSafeStations}\\n          onSelectIssue={props.onSelectIssue}\\n          onChangeNote={props.onChangeNote}\\n          onChangeMode={props.onChangeMode}\\n          onSelectStation={props.onSelectStation}\\n          onOpenVouchers={() => setIsVoucherDrawerOpen(true)}\\n          onSetStep={props.onSetStep}\\n          onConfirmRescue={props.onConfirmRescue}\\n          onOpenChat={() => setIsChatDrawerOpen(true)}\\n          onDemoAdvance={props.onDemoAdvance}\\n          onCancelOrder={props.onCancelOrder}\\n          onCompleteOrder={props.onCompleteOrder}\\n        />\\n      </BottomSheetShell>\\n\\n      <VoucherDrawerModal\\n        isOpen={isVoucherDrawerOpen}\\n        vouchers={VOUCHER_OPTIONS}\\n        selectedVoucherId={selectedVoucherId}\\n        pickupMode={pickupMode}\\n        onApplyVoucher={props.onSelectVoucher}\\n        onClose={() => setIsVoucherDrawerOpen(false)}\\n      />\\n\\n      <MechanicChatDrawer\\n        isOpen={isChatDrawerOpen}\\n        mechanic={MOCK_MECHANIC}\\n        messages={chatMessages}\\n        quickSuggestions={QUICK_CHAT_SUGGESTIONS}\\n        isMechanicTyping={isMechanicTyping}\\n        onSendMessage={props.onSendChatMessage}\\n        onClose={() => setIsChatDrawerOpen(false)}\\n      />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Wire MapFilterChips and RepairShopDetailSheet into MapTabView cleanly under 250 lines\", \"Overwrite\":true, \"TargetFile\":\"/src/components/tabs/MapTabView.tsx\", \"toolAction\":\"Updating MapTabView with filter chips and repair shop sheet\", \"toolSummary\":\"Update MapTabView\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5219126390726969782"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add NearbyRepairShopsSection to HomeTab with quick navigation to open repair shops on Map tab\", \"EndLine\":151, \"Instruction\":\"Import NearbyRepairShopsSection and RepairShop type, accept openRepairShops/isLoadingShops/onOpenRepairShopsMap props, and render NearbyRepairShopsSection\", \"ReplacementContent\":\"import type {\\n  IssueType,\\n  RepairShop,\\n  SafeStation,\\n  SafeStationCategory,\\n  UserLocation,\\n} from \'../../types/rescue\';\\nimport { HomeActionGrid } from \'./HomeActionGrid\';\\nimport { NearbyRepairShopsSection } from \'./NearbyRepairShopsSection\';\\nimport { NearbyStationsCarousel } from \'./NearbyStationsCarousel\';\\nimport { VipNightShieldBanner } from \'./VipNightShieldBanner\';\\n\\ninterface HomeTabProps {\\n  userLocation: UserLocation;\\n  stations: SafeStation[];\\n  isLoadingStations: boolean;\\n  openRepairShops: RepairShop[];\\n  isLoadingShops: boolean;\\n  onCallMechanicNow: () => void;\\n  onQuickIssueSelect: (issue: IssueType) => void;\\n  onQuickCategorySelect: (category: SafeStationCategory) => void;\\n  onQuickSosSelect: () => void;\\n  onSelectStationCard: (stationId: string) => void;\\n  onOpenRepairShopsMap: (shopId?: string) => void;\\n  onTriggerDemoMechanic: () => void;\\n}\\n\\nconst containerVariants = {\\n  hidden: {},\\n  show: {\\n    transition: { staggerChildren: 0.06 },\\n  },\\n};\\n\\nconst itemVariants = {\\n  hidden: { opacity: 0, y: 14 },\\n  show: {\\n    opacity: 1,\\n    y: 0,\\n    transition: { duration: 0.34, ease: [0.16, 1, 0.3, 1] as const },\\n  },\\n};\\n\\nexport function HomeTab({\\n  userLocation,\\n  stations,\\n  isLoadingStations,\\n  openRepairShops,\\n  isLoadingShops,\\n  onCallMechanicNow,\\n  onQuickIssueSelect,\\n  onQuickCategorySelect,\\n  onQuickSosSelect,\\n  onSelectStationCard,\\n  onOpenRepairShopsMap,\\n  onTriggerDemoMechanic,\\n}: HomeTabProps) {\\n  return (\\n    <div className=\\\"relative flex-1 overflow-y-auto bg-[#F8FAFC] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\\\">\\n      {/* Ambient top radial emerald glow */}\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className=\\\"pointer-events-none absolute inset-x-0 top-0 h-56 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-500/15 via-slate-50/50 to-transparent\\\"\\n      />\\n\\n      <motion.div\\n        variants={containerVariants}\\n        initial=\\\"hidden\\\"\\n        animate=\\\"show\\\"\\n        className=\\\"relative z-10 px-5 pt-4 pb-28\\\"\\n      >\\n        {/* Header */}\\n        <motion.header\\n          variants={itemVariants}\\n          className=\\\"flex items-center justify-between gap-2\\\"\\n        >\\n          <div className=\\\"min-w-0\\\">\\n            <h1 className=\\\"text-lg font-extrabold tracking-tight text-slate-900\\\">\\n              Xin ch\303\240o, T\303\240i x\341\272\277\\n            </h1>\\n            <p className=\\\"mt-0.5 flex items-center gap-1 text-xs text-slate-500\\\">\\n              <MapPin className=\\\"h-3.5 w-3.5 shrink-0 text-emerald-500\\\" aria-hidden=\\\"true\\\" />\\n              <span className=\\\"truncate\\\">{userLocation.address}</span>\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex shrink-0 items-center gap-1.5\\\">\\n            <span className=\\\"inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-500/20 whitespace-nowrap\\\">\\n              <ShieldCheck className=\\\"h-3.5 w-3.5 text-emerald-600\\\" aria-hidden=\\\"true\\\" />\\n              <span>An to\303\240n 24/7</span>\\n            </span>\\n            <motion.button\\n              type=\\\"button\\\"\\n              whileTap={{ scale: 0.94 }}\\n              onClick={onTriggerDemoMechanic}\\n              className=\\\"inline-flex min-h-[30px] items-center rounded-full border border-slate-200/80 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 shadow-xs transition-colors hover:border-emerald-300 hover:text-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap\\\"\\n            >\\n              Test th\341\273\243\\n            </motion.button>\\n          </div>\\n        </motion.header>\\n\\n        {/* Luxury Floating Hero Action Bar */}\\n        <motion.div variants={itemVariants} className=\\\"mt-4\\\">\\n          <motion.button\\n            type=\\\"button\\\"\\n            whileTap={{ scale: 0.985 }}\\n            onClick={onCallMechanicNow}\\n            className=\\\"flex min-h-[58px] w-full items-center justify-between gap-3 rounded-full border border-emerald-500/30 bg-white px-4 py-2 text-left shadow-[0_12px_32px_-8px_rgba(16,185,129,0.28)] ring-1 ring-inset ring-white transition-shadow hover:shadow-[0_16px_36px_-8px_rgba(16,185,129,0.36)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500\\\"\\n          >\\n            <span className=\\\"flex min-w-0 items-center gap-2.5\\\">\\n              <span className=\\\"relative flex h-3 w-3 shrink-0 items-center justify-center\\\">\\n                <span className=\\\"absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75\\\" />\\n                <span className=\\\"relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500\\\" />\\n              </span>\\n              <span className=\\\"truncate text-sm font-semibold text-slate-600\\\">\\n                B\341\272\241n \304\221ang g\341\272\267p s\341\273\261 c\341\273\221 \341\273\237 \304\221\303\242u?\\n              </span>\\n            </span>\\n\\n            <span className=\\\"relative shrink-0 overflow-hidden rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-2 text-xs font-bold text-white shadow-md shadow-emerald-500/25 whitespace-nowrap\\\">\\n              <span\\n                aria-hidden=\\\"true\\\"\\n                className=\\\"animate-shimmer-sweep pointer-events-none absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-transparent via-white/40 to-transparent\\\"\\n              />\\n              <span className=\\\"relative z-10\\\">G\341\273\215i th\341\273\243 ngay</span>\\n            </span>\\n          </motion.button>\\n        </motion.div>\\n\\n        <motion.div variants={itemVariants}>\\n          <HomeActionGrid\\n            onQuickIssueSelect={onQuickIssueSelect}\\n            onQuickCategorySelect={onQuickCategorySelect}\\n            onQuickSosSelect={onQuickSosSelect}\\n          />\\n        </motion.div>\\n\\n        <motion.div variants={itemVariants}>\\n          <VipNightShieldBanner\\n            onAction={() => onSelectStationCard(stations[0]?.id ?? \'\')}\\n          />\\n        </motion.div>\\n\\n        <motion.div variants={itemVariants}>\\n          <NearbyStationsCarousel\\n            stations={stations}\\n            isLoadingStations={isLoadingStations}\\n            onSelectStationCard={onSelectStationCard}\\n            onViewMap={() => onQuickCategorySelect(\'convenience\')}\\n          />\\n        </motion.div>\\n\\n        <motion.div variants={itemVariants}>\\n          <NearbyRepairShopsSection\\n            shops={openRepairShops}\\n            isLoading={isLoadingShops}\\n            onSelectShop={(shopId) => onOpenRepairShopsMap(shopId)}\\n            onViewAllOnMap={() => onOpenRepairShopsMap()}\\n          />\\n        </motion.div>\\n      </motion.div>\\n    </div>\\n  );\\n}\", \"StartLine\":3, \"TargetContent\":\"import type {\\n  IssueType,\\n  SafeStation,\\n  SafeStationCategory,\\n  UserLocation,\\n} from \'../../types/rescue\';\\nimport { HomeActionGrid } from \'./HomeActionGrid\';\\nimport { NearbyStationsCarousel } from \'./NearbyStationsCarousel\';\\nimport { VipNightShieldBanner } from \'./VipNightShieldBanner\';\\n\\ninterface HomeTabProps {\\n  userLocation: UserLocation;\\n  stations: SafeStation[];\\n  isLoadingStations: boolean;\\n  onCallMechanicNow: () => void;\\n  onQuickIssueSelect: (issue: IssueType) => void;\\n  onQuickCategorySelect: (category: SafeStationCategory) => void;\\n  onQuickSosSelect: () => void;\\n  onSelectStationCard: (stationId: string) => void;\\n  onTriggerDemoMechanic: () => void;\\n}\\n\\nconst containerVariants = {\\n  hidden: {},\\n  show: {\\n    transition: { staggerChildren: 0.06 },\\n  },\\n};\\n\\nconst itemVariants = {\\n  hidden: { opacity: 0, y: 14 },\\n  show: {\\n    opacity: 1,\\n    y: 0,\\n    transition: { duration: 0.34, ease: [0.16, 1, 0.3, 1] as const },\\n  },\\n};\\n\\nexport function HomeTab({\\n  userLocation,\\n  stations,\\n  isLoadingStations,\\n  onCallMechanicNow,\\n  onQuickIssueSelect,\\n  onQuickCategorySelect,\\n  onQuickSosSelect,\\n  onSelectStationCard,\\n  onTriggerDemoMechanic,\\n}: HomeTabProps) {\\n  return (\\n    <div className=\\\"relative flex-1 overflow-y-auto bg-[#F8FAFC] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\\\">\\n      {/* Ambient top radial emerald glow */}\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className=\\\"pointer-events-none absolute inset-x-0 top-0 h-56 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-500/15 via-slate-50/50 to-transparent\\\"\\n      />\\n\\n      <motion.div\\n        variants={containerVariants}\\n        initial=\\\"hidden\\\"\\n        animate=\\\"show\\\"\\n        className=\\\"relative z-10 px-5 pt-4 pb-28\\\"\\n      >\\n        {/* Header */}\\n        <motion.header\\n          variants={itemVariants}\\n          className=\\\"flex items-center justify-between gap-2\\\"\\n        >\\n          <div className=\\\"min-w-0\\\">\\n            <h1 className=\\\"text-lg font-extrabold tracking-tight text-slate-900\\\">\\n              Xin ch\303\240o, T\303\240i x\341\272\277\\n            </h1>\\n            <p className=\\\"mt-0.5 flex items-center gap-1 text-xs text-slate-500\\\">\\n              <MapPin className=\\\"h-3.5 w-3.5 shrink-0 text-emerald-500\\\" aria-hidden=\\\"true\\\" />\\n              <span className=\\\"truncate\\\">{userLocation.address}</span>\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex shrink-0 items-center gap-1.5\\\">\\n            <span className=\\\"inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-500/20 whitespace-nowrap\\\">\\n              <ShieldCheck className=\\\"h-3.5 w-3.5 text-emerald-600\\\" aria-hidden=\\\"true\\\" />\\n              <span>An to\303\240n 24/7</span>\\n            </span>\\n            <motion.button\\n              type=\\\"button\\\"\\n              whileTap={{ scale: 0.94 }}\\n              onClick={onTriggerDemoMechanic}\\n              className=\\\"inline-flex min-h-[30px] items-center rounded-full border border-slate-200/80 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 shadow-xs transition-colors hover:border-emerald-300 hover:text-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap\\\"\\n            >\\n              Test th\341\273\243\\n            </motion.button>\\n          </div>\\n        </motion.header>\\n\\n        {/* Luxury Floating Hero Action Bar */}\\n        <motion.div variants={itemVariants} className=\\\"mt-4\\\">\\n          <motion.button\\n            type=\\\"button\\\"\\n            whileTap={{ scale: 0.985 }}\\n            onClick={onCallMechanicNow}\\n            className=\\\"flex min-h-[58px] w-full items-center justify-between gap-3 rounded-full border border-emerald-500/30 bg-white px-4 py-2 text-left shadow-[0_12px_32px_-8px_rgba(16,185,129,0.28)] ring-1 ring-inset ring-white transition-shadow hover:shadow-[0_16px_36px_-8px_rgba(16,185,129,0.36)] focus-visible:outline-none focus-visible:ring-2