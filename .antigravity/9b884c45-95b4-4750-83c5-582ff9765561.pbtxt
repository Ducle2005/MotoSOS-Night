3 shrink-0\" aria-hidden=\"true\" />\n        )}\n        <span>{getDemoLabel()}</span>\n      </button>\n    </header>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/TopOverlayBar.tsx"
        }
        overwrite: true
      }
    }
