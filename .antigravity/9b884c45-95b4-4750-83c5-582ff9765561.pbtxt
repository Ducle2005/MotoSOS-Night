    content: "import {\n  ArrowLeft,\n  Check,\n  Loader2,\n  MapPin,\n  Navigation,\n  ShieldCheck,\n} from \'lucide-react\';\nimport type { PickupMode, SafeStation, UserLocation } from \'../../types/rescue\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\n\ninterface PickupSelectionStepProps {\n  pickupMode: PickupMode;\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  selectedStationId: string | null;\n  resolvedAddress: string;\n  routeSummary: { distanceMeters: number; durationMinutes: number } | null;\n  isLoadingRoute: boolean;\n  isSubmitting: boolean;\n  onChangeMode: (mode: PickupMode) => void;\n  onSelectStation: (stationId: string) => void;\n  onBack: () => void;\n  onConfirm: () => void;\n}\n\nexport function PickupSelectionStep({\n  pickupMode,\n  userLocation,\n  stations,\n  selectedStationId,\n  resolvedAddress,\n  routeSummary,\n  isLoadingRoute,\n  isSubmitting,\n  onChangeMode,\n  onSelectStation,\n  onBack,\n  onConfirm,\n}: PickupSelectionStepProps) {\n  return (\n    <div className=\"flex min-h-0 flex-1 flex-col\">\n      <div className=\"flex-1 overflow-y-auto px-5 pt-2 pb-3 lg:px-6\">\n        <h1 className=\"text-lg font-bold tracking-tight text-slate-50\">\n          B\341\272\241n mu\341\273\221n ch\341\273\235 th\341\273\243 \341\273\237 \304\221\303\242u?\n        </h1>\n        <p className=\"mt-1 text-xs text-slate-400 sm:text-sm\">\n          Ban \304\221\303\252m n\303\252n di chuy\341\273\203n t\341\273\233i n\306\241i s\303\241ng \304\221\303\250n n\341\272\277u xe c\303\262n d\341\272\257t b\341\273\231 \304\221\306\260\341\273\243c.\n        </p>\n\n        {/* Two explicit pickup options */}\n        <div\n          className=\"mt-3 grid grid-cols-1 gap-2\"\n          role=\"radiogroup\"\n          aria-label=\"Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 th\341\273\243\"\n        >\n          <button\n            type=\"button\"\n            role=\"radio\"\n            aria-checked={pickupMode === \'current_location\'}\n            onClick={() => onChangeMode(\'current_location\')}\n            className={`flex min-h-[54px] items-center gap-3 rounded-2xl border px-3.5 py-2.5 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ${\n              pickupMode === \'current_location\'\n                ? \'border-amber-400 bg-amber-500/12\'\n                : \'border-slate-800 bg-slate-950/60 hover:border-slate-700\'\n            }`}\n          >\n            <span\n              className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-xl ${\n                pickupMode === \'current_location\'\n                  ? \'bg-amber-500 text-slate-950\'\n                  : \'bg-slate-800 text-sky-400\'\n              }`}\n            >\n              <Navigation className=\"h-4 w-4\" aria-hidden=\"true\" />\n            </span>\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"text-sm font-bold text-slate-100\">\n                Ch\341\273\235 t\341\272\241i v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i\n              </p>\n              <p className=\"truncate text-xs text-slate-400\">\n                {userLocation.address}\n              </p>\n            </div>\n          </button>\n\n          <button\n            type=\"button\"\n            role=\"radio\"\n            aria-checked={pickupMode === \'safe_station\'}\n            onClick={() => onChangeMode(\'safe_station\')}\n            className={`flex min-h-[54px] items-center gap-3 rounded-2xl border px-3.5 py-2.5 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 ${\n              pickupMode === \'safe_station\'\n                ? \'border-emerald-400 bg-emerald-500/12\'\n                : \'border-slate-800 bg-slate-950/60 hover:border-slate-700\'\n            }`}\n          >\n            <span\n              className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-xl ${\n                pickupMode === \'safe_station\'\n                  ? \'bg-emerald-500 text-slate-950\'\n                  : \'bg-slate-800 text-emerald-400\'\n              }`}\n            >\n              <ShieldCheck className=\"h-4 w-4\" aria-hidden=\"true\" />\n            </span>\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"text-sm font-bold text-slate-100\">\n                Di chuy\341\273\203n t\341\273\233i Tr\341\272\241m An To\303\240n g\341\272\247n nh\341\272\245t\n              </p>\n              <p className=\"truncate text-xs text-slate-400\">\n                Ch\341\273\215n 1 trong {stations.length} tr\341\272\241m tr\303\252n b\341\272\243n \304\221\341\273\223 ho\341\272\267c b\303\252n d\306\260\341\273\233i\n              </p>\n            </div>\n          </button>\n        </div>\n\n        {/* Safe Stations list when safe_station mode is selected */}\n        {pickupMode === \'safe_station\' && (\n          <div className=\"mt-2.5 rounded-2xl border border-slate-800 bg-slate-950/70 p-2\">\n            <div className=\"flex items-center justify-between px-2 py-0.5\">\n              <p className=\"text-xs font-semibold text-emerald-400\">\n                Ch\341\273\215n Tr\341\272\241m An To\303\240n \304\221\341\273\203 v\341\272\275 \304\221\306\260\341\273\235ng \304\221i b\341\273\231:\n              </p>\n              {isLoadingRoute && (\n                <Loader2\n                  className=\"h-3.5 w-3.5 animate-spin text-emerald-400\"\n                  aria-label=\"\304\220ang t\303\254m tuy\341\272\277n \304\221i b\341\273\231\"\n                />\n              )}\n            </div>\n            <div className=\"mt-1 flex flex-col gap-1\">\n              {stations.map((station) => {\n                const selected = selectedStationId === station.id;\n                return (\n                  <button\n                    key={station.id}\n                    type=\"button\"\n                    onClick={() => onSelectStation(station.id)}\n                    aria-pressed={selected}\n                    className={`flex min-h-[48px] items-center justify-between gap-2.5 rounded-xl px-3 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 ${\n                      selected\n                        ? \'bg-emerald-500/15 text-slate-50 ring-1 ring-emerald-500/50\'\n                        : \'text-slate-300 hover:bg-slate-800/70\'\n                    }`}\n                  >\n                    <div className=\"min-w-0 flex-1\">\n                      <p className=\"truncate text-sm font-semibold\">\n                        {station.name}\n                      </p>\n                      <p className=\"truncate text-xs text-slate-400\">\n                        {station.categoryLabel}\n                        <span aria-hidden=\"true\"> \302\267 </span>\n                        <span className=\"font-mono tabular-nums text-emerald-400\">\n                          {formatWalkingDistance(\n                            station.walkingDistanceMeters,\n                            station.walkingMinutes,\n                          )}\n                        </span>\n                      </p>\n                    </div>\n                    {selected && (\n                      <Check\n                        className=\"h-4 w-4 shrink-0 text-emerald-400\"\n                        aria-hidden=\"true\"\n                      />\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Pinned Resolved Pickup Address + Action Bar */}\n      <div className=\"shrink-0 border-t border-slate-800/80 bg-slate-900 px-5 py-3 lg:px-6 lg:py-4\">\n        <div className=\"mb-2.5 flex items-center gap-2 rounded-xl border border-slate-800 bg-slate-950/80 px-3 py-2\">\n          <MapPin className=\"h-4 w-4 shrink-0 text-amber-400\" aria-hidden=\"true\" />\n          <div className=\"min-w-0 flex-1\">\n            <div className=\"flex items-center justify-between gap-2\">\n              <p className=\"text-[11px] text-slate-400\">\304\220i\341\273\203m \304\221\303\263n c\341\273\247a th\341\273\243</p>\n              {pickupMode === \'safe_station\' && routeSummary && (\n                <p className=\"font-mono text-[11px] tabular-nums text-emerald-400\">\n                  {formatWalkingDistance(\n                    routeSummary.distanceMeters,\n                    routeSummary.durationMinutes,\n                  )}\n                </p>\n              )}\n            </div>\n            <p\n              className=\"truncate text-xs font-semibold text-slate-100 sm:text-sm\"\n              data-testid=\"pickup-address\"\n            >\n              {resolvedAddress}\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2.5\">\n          <button\n            type=\"button\"\n            disabled={isSubmitting}\n            onClick={onBack}\n            className=\"inline-flex min-h-[48px] items-center justify-center gap-1.5 rounded-xl border border-slate-800 bg-slate-950 px-4 text-sm font-semibold text-slate-300 transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 disabled:opacity-50\"\n          >\n            <ArrowLeft className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>Quay l\341\272\241i</span>\n          </button>\n\n          <button\n            type=\"button\"\n            disabled={isSubmitting}\n            onClick={onConfirm}\n            className=\"inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-xl bg-amber-500 px-5 text-sm font-extrabold text-slate-950 transition-all hover:bg-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 disabled:cursor-wait disabled:opacity-80 active:scale-[0.98]\"\n          >\n            {isSubmitting ? (\n              <>\n                <Loader2 className=\"h-4 w-4 animate-spin\" aria-hidden=\"true\" />\n                <span>\304\220ang g\341\273\255i y\303\252u c\341\272\247u...</span>\n              </>\n            ) : (\n              <span>X\303\241c nh\341\272\255n g\341\273\215i c\341\273\251u h\341\273\231</span>\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 232
    num_bytes: 9473
    line_range_bytes: 9473
  }
}
