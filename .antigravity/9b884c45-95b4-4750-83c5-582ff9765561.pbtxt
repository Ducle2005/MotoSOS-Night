    end_line: 243
    content: "import { Loader2, LocateFixed, MapPin, Search, X } from \'lucide-react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport { useEffect, useRef, useState } from \'react\';\nimport type { ActiveLocation, LocationSuggestion } from \'../../types/rescue\';\nimport {\n  fetchAddressAutocomplete,\n  formatSuggestionDistance,\n} from \'../../utils/geocodeApi\';\n\ninterface LocationSearchModalProps {\n  isOpen: boolean;\n  activeLocation: ActiveLocation;\n  isLocatingGps: boolean;\n  onSelectSuggestion: (suggestion: LocationSuggestion) => void;\n  onUseCurrentGps: () => Promise<void>;\n  onClose: () => void;\n}\n\nexport function LocationSearchModal({\n  isOpen,\n  activeLocation,\n  isLocatingGps,\n  onSelectSuggestion,\n  onUseCurrentGps,\n  onClose,\n}: LocationSearchModalProps) {\n  const inputRef = useRef<HTMLInputElement | null>(null);\n  const [query, setQuery] = useState(\'\');\n  const [suggestions, setSuggestions] = useState<LocationSuggestion[]>([]);\n  const [isSearching, setIsSearching] = useState(false);\n\n  useEffect(() => {\n    if (!isOpen) {\n      setQuery(\'\');\n      setSuggestions([]);\n      setIsSearching(false);\n      return;\n    }\n\n    const focusTimer = window.setTimeout(() => {\n      inputRef.current?.focus();\n    }, 90);\n    return () => window.clearTimeout(focusTimer);\n  }, [isOpen]);\n\n  useEffect(() => {\n    if (!isOpen) return;\n    const trimmed = query.trim();\n    if (trimmed.length < 2) {\n      setSuggestions([]);\n      setIsSearching(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    setIsSearching(true);\n    const debounceTimer = window.setTimeout(() => {\n      fetchAddressAutocomplete(\n        trimmed,\n        { lat: activeLocation.lat, lng: activeLocation.lng },\n        controller.signal,\n      )\n        .then((items) => {\n          if (!controller.signal.aborted) {\n            setSuggestions(items);\n          }\n        })\n        .finally(() => {\n          if (!controller.signal.aborted) {\n            setIsSearching(false);\n          }\n        });\n    }, 300);\n\n    return () => {\n      window.clearTimeout(debounceTimer);\n      controller.abort();\n    };\n  }, [isOpen, query, activeLocation.lat, activeLocation.lng]);\n\n  const handleUseGpsClick = async () => {\n    await onUseCurrentGps();\n    onClose();\n  };\n\n  return (\n    <AnimatePresence>\n      {isOpen && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"T\303\254m ki\341\272\277m \304\221\341\273\213a \304\221i\341\273\203m g\341\272\267p s\341\273\261 c\341\273\221\"\n          className=\"absolute inset-0 z-50 flex flex-col justify-end\"\n        >\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            onClick={onClose}\n            className=\"absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]\"\n          />\n\n          <motion.div\n            initial={{ y: \'100%\' }}\n            animate={{ y: 0 }}\n            exit={{ y: \'100%\' }}\n            transition={{ type: \'spring\', stiffness: 360, damping: 34 }}\n            className=\"relative z-10 flex h-[88dvh] flex-col rounded-t-3xl bg-white shadow-2xl\"\n          >\n            <div className=\"flex shrink-0 justify-center pt-2.5 pb-1\" aria-hidden=\"true\">\n              <div className=\"h-1 w-10 rounded-full bg-slate-200\" />\n            </div>\n\n            <div className=\"flex shrink-0 items-center justify-between px-5 pt-1 pb-3\">\n              <div>\n                <h2 className=\"text-base font-extrabold tracking-tight text-slate-900\">\n                  Ch\341\273\215n v\341\273\213 tr\303\255 s\341\273\261 c\341\273\221\n                </h2>\n                <p className=\"text-xs text-slate-500\">\n                  T\303\254m t\303\252n \304\221\306\260\341\273\235ng, giao l\341\273\231 ho\341\272\267c s\341\273\255 d\341\273\245ng GPS th\341\273\261c t\341\272\277\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={onClose}\n                aria-label=\"\304\220\303\263ng t\303\254m ki\341\272\277m \304\221\341\273\213a \304\221i\341\273\203m\"\n                className=\"flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-slate-200\"\n              >\n                <X className=\"h-4 w-4\" aria-hidden=\"true\" />\n              </button>\n            </div>\n\n            {/* Google Maps-style search input */}\n            <div className=\"shrink-0 px-5 pb-3\">\n              <div className=\"flex h-12 items-center gap-2.5 rounded-2xl border border-slate-200 bg-slate-50/90 px-3.5 transition-colors focus-within:border-emerald-500 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-500/20\">\n                <Search className=\"h-4 w-4 shrink-0 text-slate-400\" aria-hidden=\"true\" />\n                <input\n                  ref={inputRef}\n                  type=\"text\"\n                  value={query}\n                  onChange={(e) => setQuery(e.target.value)}\n                  placeholder=\"Nh\341\272\255p t\303\252n \304\221\306\260\341\273\235ng, \304\221\341\273\213a \304\221i\341\273\203m, qu\341\272\255n...\"\n                  aria-label=\"Nh\341\272\255p \304\221\341\273\213a ch\341\273\211 c\341\272\247n t\303\254m\"\n                  className=\"min-w-0 flex-1 bg-transparent text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:outline-none\"\n                />\n                {isSearching && (\n                  <Loader2 className=\"h-4 w-4 shrink-0 animate-spin text-emerald-500\" aria-hidden=\"true\" />\n                )}\n                {query.length > 0 && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setQuery(\'\');\n                      setSuggestions([]);\n                      inputRef.current?.focus();\n                    }}\n                    aria-label=\"X\303\263a t\341\273\253 kh\303\263a\"\n                    className=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-200/80 text-slate-600 hover:bg-slate-300\"\n                  >\n                    <X className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Prominent current GPS quick row */}\n            <div className=\"shrink-0 border-y border-slate-100 px-5 py-2.5\">\n              <button\n                type=\"button\"\n                onClick={handleUseGpsClick}\n                disabled={isLocatingGps}\n                className=\"flex w-full items-center gap-3 rounded-2xl bg-emerald-50/70 px-3.5 py-2.5 text-left transition-colors hover:bg-emerald-50 active:scale-[0.99] disabled:opacity-70\"\n              >\n                <span className=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white shadow-sm shadow-emerald-500/30\">\n                  {isLocatingGps ? (\n                    <Loader2 className=\"h-4 w-4 animate-spin\" aria-hidden=\"true\" />\n                  ) : (\n                    <LocateFixed className=\"h-4 w-4\" aria-hidden=\"true\" />\n                  )}\n                </span>\n                <div className=\"min-w-0 flex-1\">\n                  <p className=\"text-sm font-bold text-emerald-800\">\n                    S\341\273\255 d\341\273\245ng v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\n                  </p>\n                  <p className=\"truncate text-xs text-emerald-700/80\">\n                    {isLocatingGps\n                      ? \'\304\220ang l\341\272\245y t\341\273\215a \304\221\341\273\231 GPS th\341\273\261c t\341\272\277...\'\n                      : activeLocation.isCurrentGPS\n                        ? activeLocation.address\n                        : \'\304\220\341\273\213nh v\341\273\213 l\341\272\241i qua GPS c\341\273\247a thi\341\272\277t b\341\273\213\'}\n                  </p>\n                </div>\n              </button>\n            </div>\n\n            {/* Autocomplete suggestions list */}\n            <div className=\"flex-1 overflow-y-auto px-5 py-3 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n              {query.trim().length < 2 ? (\n                <div className=\"rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-5 text-center text-xs text-slate-500\">\n                  Nh\341\272\255p \303\255t nh\341\272\245t 2 k\303\275 t\341\273\261 (v\303\255 d\341\273\245: <span className=\"font-semibold text-slate-700\">Ch\341\273\243 B\341\272\277n Th\303\240nh</span>, <span className=\"font-semibold text-slate-700\">Nguy\341\273\205n Hu\341\273\207</span>) \304\221\341\273\203 xem g\341\273\243i \303\275 \304\221\341\273\213a \304\221i\341\273\203m.\n                </div>\n              ) : isSearching && suggestions.length === 0 ? (\n                <div className=\"flex items-center justify-center gap-2 py-8 text-xs font-medium text-slate-500\">\n                  <Loader2 className=\"h-4 w-4 animate-spin text-emerald-500\" aria-hidden=\"true\" />\n                  <span>\304\220ang t\303\254m \304\221\341\273\213a \304\221i\341\273\203m t\341\272\241i Vi\341\273\207t Nam...</span>\n                </div>\n              ) : suggestions.length === 0 ? (\n                <div className=\"rounded-2xl border border-slate-100 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500\">\n                  Kh\303\264ng t\303\254m th\341\272\245y \304\221\341\273\213a ch\341\273\211 ph\303\271 h\341\273\243p v\341\273\233i &ldquo;{query.trim()}&rdquo;. H\303\243y th\341\273\255 t\303\252n \304\221\306\260\341\273\235ng ho\341\272\267c \304\221\341\273\213a danh kh\303\241c.\n                </div>\n              ) : (\n                <ul className=\"divide-y divide-slate-100\" role=\"listbox\" aria-label=\"G\341\273\243i \303\275 \304\221\341\273\213a \304\221i\341\273\203m\">\n                  {suggestions.map((item) => (\n                    <li key={item.id}>\n                      <button\n                        type=\"button\"\n                        onClick={() => { onSelectSuggestion(item); onClose(); }}\n                        className=\"flex w-full items-center justify-between gap-3 py-3 text-left transition-colors hover:bg-slate-50 active:bg-slate-100\"\n                      >\n                        <div className=\"flex min-w-0 items-center gap-3\">\n                          <span className=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600\">\n                            <MapPin className=\"h-4 w-4 text-emerald-600\" aria-hidden=\"true\" />\n                          </span>\n                          <div className=\"min-w-0\">\n                            <p className=\"truncate text-sm font-bold text-slate-900\">{item.addressLine1}</p>\n                            <p className=\"mt-0.5 truncate text-xs text-slate-500\">{item.addressLine2}</p>\n                          </div>\n                        </div>\n                        <span className=\"shrink-0 font-sans text-xs font-semibold tabular-nums text-slate-500 whitespace-nowrap\">\n                          {formatSuggestionDistance(item.distanceMeters)}\n                        </span>\n                      </button>\n                    </li>\n                  ))}\n                </ul>\n              )}\n            </div>\n          </motion.div>\n        </div>\n      )}\n    </AnimatePresence>\n  );\n}\n"
    num_lines: 244
