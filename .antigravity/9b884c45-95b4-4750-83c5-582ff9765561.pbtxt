      arguments_json: "{\"Description\":\"Wire pinPicker props through MapTabView into RescueMap and MapBottomSheetContent\", \"Instruction\":\"Add grouped pinPicker prop to MapTabView and connect to RescueMap, MapFilterChips, and MapBottomSheetContent\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":81, \"ReplacementContent\":\"  onCancelOrder: () => void;\\n  onCompleteOrder: () => void;\\n  pinPicker: {\\n    isActive: boolean;\\n    isDragging: boolean;\\n    coord: GeoCoord;\\n    address: string;\\n    isResolving: boolean;\\n    onMoveStart: () => void;\\n    onMoveEnd: (coord: GeoCoord) => void;\\n    onConfirm: () => void;\\n    onCancel: () => void;\\n  };\\n}\", \"StartLine\":74, \"TargetContent\":\"  onCancelOrder: () => void;\\n  onCompleteOrder: () => void;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":158, \"ReplacementContent\":\"        mechanic={MOCK_MECHANIC}\\n        recenterSignal={props.recenterSignal}\\n        isPinPickerMode={props.pinPicker.isActive}\\n        isPinDragging={props.pinPicker.isDragging}\\n        onSelectStation={(id) => {\\n          props.onSelectStation(id);\\n          if (step === \'pickup\') props.onChangeMode(\'safe_station\');\\n        }}\\n        onInspectStation={props.onInspectStation}\\n        onSelectShop={props.onSelectShop}\\n        onSelectGasStation={props.onSelectGasStation}\\n        onPinMoveStart={props.pinPicker.onMoveStart}\\n        onPinMoveEnd={props.pinPicker.onMoveEnd}\\n        onEtaMinuteChange={props.onEtaMinuteChange}\\n        onMechanicArrived={props.onMechanicArrived}\\n      />\\n\\n      <TopOverlayBar\\n        step={step}\\n        trackingStatus={trackingStatus}\\n        onBackToHome={props.onBackToHome}\\n        onDemoAdvance={props.onDemoAdvance}\\n      />\\n\\n      {step === \'idle\' && !props.pinPicker.isActive && (\\n        <MapFilterChips\\n          activeFilter={props.mapFilter}\\n          openShopCount={props.openRepairShops.length}\\n          gasStationCount={props.gasStations.length}\\n          stationCount={props.stations.length}\\n          onSelectFilter={props.onChangeMapFilter}\\n        />\\n      )}\\n\\n      <BottomSheetShell\\n        step={step}\\n        isShopDetailOpen={step === \'idle\' && props.selectedShop !== null}\\n        isGasListOpen={\\n          step === \'idle\' &&\\n          props.mapFilter === \'gas_stations\' &&\\n          props.selectedShop === null &&\\n          !props.pinPicker.isActive\\n        }\\n        onRecenter={props.onRecenter}\\n      >\\n        <MapBottomSheetContent\\n          step={step}\\n          trackingStatus={trackingStatus}\\n          mapFilter={props.mapFilter}\", \"StartLine\":115, \"TargetContent\":\"        mechanic={MOCK_MECHANIC}\\n        recenterSignal={props.recenterSignal}\\n        onSelectStation={(id) => {\\n          props.onSelectStation(id);\\n          if (step === \'pickup\') props.onChangeMode(\'safe_station\');\\n        }}\\n        onInspectStation={props.onInspectStation}\\n        onSelectShop={props.onSelectShop}\\n        onSelectGasStation={props.onSelectGasStation}\\n        onEtaMinuteChange={props.onEtaMinuteChange}\\n        onMechanicArrived={props.onMechanicArrived}\\n      />\\n\\n      <TopOverlayBar\\n        step={step}\\n        trackingStatus={trackingStatus}\\n        onBackToHome={props.onBackToHome}\\n        onDemoAdvance={props.onDemoAdvance}\\n      />\\n\\n      {step === \'idle\' && (\\n        <MapFilterChips\\n          activeFilter={props.mapFilter}\\n          openShopCount={props.openRepairShops.length}\\n          gasStationCount={props.gasStations.length}\\n          stationCount={props.stations.length}\\n          onSelectFilter={props.onChangeMapFilter}\\n        />\\n      )}\\n\\n      <BottomSheetShell\\n        step={step}\\n        isShopDetailOpen={step === \'idle\' && props.selectedShop !== null}\\n        isGasListOpen={\\n          step === \'idle\' &&\\n          props.mapFilter === \'gas_stations\' &&\\n          props.selectedShop === null\\n        }\\n        onRecenter={props.onRecenter}\\n      >\\n        <MapBottomSheetContent\\n          step={step}\\n          trackingStatus={trackingStatus}\\n          mapFilter={props.mapFilter}\"}, {\"AllowMultiple\":false, \"EndLine\":208, \"ReplacementContent\":\"          onCancelOrder={props.onCancelOrder}\\n          onCompleteOrder={props.onCompleteOrder}\\n          pinPicker={props.pinPicker}\\n        />\", \"StartLine\":196, \"TargetContent\":\"          onCancelOrder={props.onCancelOrder}\\n          onCompleteOrder={props.onCompleteOrder}\\n        />\"}], \"TargetFile\":\"/src/components/tabs/MapTabView.tsx\", \"toolAction\":\"Wiring pinPicker props in MapTabView\", \"toolSummary\":\"Wire pinPicker in MapTabView\"}"
