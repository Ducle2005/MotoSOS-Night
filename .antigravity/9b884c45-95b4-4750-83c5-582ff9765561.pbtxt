      thinking_signature: "\022\257\t\n\254\t\001i\024}\023h^\027#\252\336=\2500\365\006\034\241q\035\301\031\331\030\352\006\345/\t,3\343CW\324S\344\245\025\362t\271Q\333A\275U\006z,\244w\272\002\233\360\a\256\336\320V\310\261W\0027\232a\\F\340\222*o\273pw\263\227=\321\020kL\272\246\0279\302\033\303/\217\320\344i\200\267g\v\030\271\267Ar\256\202x\247\207\247)W\353I36\003E\031\261$\023\216\234\016YAAWma\200\274\302Q\327G]E\306\202\230@h\233\a\371#\361\316\vA\205H\320\222\377\262\005\002\341\343Wmx\274<\227\220\260=\326\036_\036\213\035p\263{\257\231\274T\024\022\262\356IJ\204\307w\022\241\373f\377t\004\305;\375\3076W\214\250\371)\256\372\024\371*&\342e\233%\375\240\375\252\230\"\361|g\265B\352\212\246{_EP\367\342\313V\375\376\022\026ht\217\215\261\310\254\322,\334\0308\233\222\363\300[\360\352b\247\244|\234\346\310h\177<\336\217\222\335\242 \247\035\276\256\326DH3*\303\000Ine\303/\306\346\352c\321\322\306:\307\031rI\271t\037bR\366|\361p\020\263\271NG\365\031\n9kO;\\\375\372\350P $fo\3416S\356\376\207\202_\035Web\371\276\275\246\303,\306\345`\'\031\026\025MFFC\263\\m\231\305\ti\225L2?K\372N;^\200\3145\a\314\231;\2303R\227\2070\236\373\264\251Ml\342\b\263\232/\363\306\276\023\221E\232h\210\030\304o\\\213(eg\001\236\207\035K\256J\265\0201\363\024\275^!kR\021\346\000\231Z\323\275W\200\360:\270\236\255\366mF\351KPXQ\036(\310x?\340-\001\352\331\370\f\2168\352\av\005`\027<yP)\272\\\372\"L\n\364ro\2316-\260\365\267>@\205\262{\305\265!\244\251A\t\375\177\033\305\2034\315\314Uc\024lx\325\253\247\340\\.\345\231\370\215\365@jPt\2468\250\310\226h}\256\210{\270\264\342\372\254\036R&/6&\260\272\346\034\r7+T-\310\006w\316cf\324=\255\216\2016E\034\364\220Ck\213\b\222Gb\242\315q\240\265\324\361\204\020\216\203\f\242\357\207\216\215\230\262\200oy\303x\350\2424W13\t\263\\I\341\3179\332\351n\332M\246\201\233\255 g`\326J\242\030\207=\244\260*\202\264d\033kOZu\344\221v\006\243E\244\340,\331f\262<\3320\312\216\336\272\373\374\265**\031d\263\254\301\362.p?p.4\347\335\206\303{\363\301T@\005\