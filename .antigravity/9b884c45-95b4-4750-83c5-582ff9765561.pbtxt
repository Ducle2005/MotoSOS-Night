          target_content: "import { ArrowRight, Loader2, MapPin, Wrench } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type { RepairShop } from \'../../types/rescue\';\nimport { formatShopDistanceLabel } from \'../../utils/repairShopApi\';\n\ninterface NearbyRepairShopsSectionProps {\n  shops: RepairShop[];\n  isLoading: boolean;\n  onSelectShop: (shopId: string) => void;\n  onViewAllOnMap: () => void;\n}\n\nexport function NearbyRepairShopsSection({\n  shops,\n  isLoading,\n  onSelectShop,\n  onViewAllOnMap,\n}: NearbyRepairShopsSectionProps) {\n  const visibleShops = shops.slice(0, 3);\n\n  return (\n    <section aria-label=\"Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237 g\341\272\247n b\341\272\241n\" className=\"mt-5\">\n      <div className=\"flex items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"h-2 w-2 rounded-full bg-emerald-500\" aria-hidden=\"true\" />\n          <h2 className=\"text-sm font-bold tracking-tight text-slate-900\">\n            Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237 g\341\272\247n b\341\272\241n\n          </h2>\n        </div>\n\n        {isLoading ? (\n          <span className=\"inline-flex items-center gap-1 text-xs font-medium text-blue-600\">\n            <Loader2 className=\"h-3 w-3 animate-spin\" aria-hidden=\"true\" />\n            <span>\304\220ang l\341\273\215c</span>\n          </span>\n        ) : (\n          <button\n            type=\"button\"\n            onClick={onViewAllOnMap}\n            className=\"text-xs font-semibold text-blue-600 transition-colors hover:text-blue-700\"\n          >\n            Xem b\341\272\243n \304\221\341\273\223 \342\206\222\n          </button>\n        )}\n      </div>\n\n      {visibleShops.length === 0 ? (\n        <div className=\"mt-3 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 text-xs text-slate-500 shadow-xs\">\n          Hi\341\273\207n ch\306\260a ghi nh\341\272\255n ti\341\273\207m m\341\273\237 c\341\273\255a trong b\303\241n k\303\255nh 2.5km. B\341\272\241n c\303\263 th\341\273\203 g\341\273\215i th\341\273\243 l\306\260u \304\221\341\273\231ng 24/7 ph\303\255a tr\303\252n.\n        </div>\n      ) : (\n        <div className=\"mt-3 space-y-2.5\">\n          {visibleShops.map((shop) => (\n            <motion.button\n              key={shop.id}\n              type=\"button\"\n              whileTap={{ scale: 0.985 }}\n              onClick={() => onSelectShop(shop.id)}\n              className=\"group flex w-full items-center justify-between gap-3 rounded-2xl border border-slate-100/90 bg-white p-3.5 text-left shadow-[0_6px_20px_rgba(15,23,42,0.05)] transition-all hover:border-blue-200 hover:shadow-[0_10px_24px_rgba(37,99,235,0.1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500\"\n            >\n              <div className=\"flex min-w-0 items-center gap-3\">\n                <span className=\"relative flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 ring-1 ring-inset ring-blue-200/60\">\n                  <Wrench className=\"h-[18px] w-[18px]\" aria-hidden=\"true\" />\n                  <span className=\"absolute -top-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-400 ring-2 ring-white\" />\n                </span>\n\n                <div className=\"min-w-0\">\n                  <p className=\"truncate text-sm font-bold text-slate-900\">\n                    {shop.name}\n                  </p>\n                  <div className=\"mt-1 flex flex-wrap items-center gap-1.5 text-[11px]\">\n                    <span className=\"inline-flex items-center gap-1 rounded-md bg-emerald-50 px-1.5 py-0.5 font-semibold text-emerald-700 whitespace-nowrap\">\n                      {shop.openStatusLabel}\n                    </span>\n                    <span className=\"font-sans font-semibold tabular-nums text-slate-600 whitespace-nowrap\">\n                      {formatShopDistanceLabel(shop.distanceMeters, shop.rideMinutes)}\n                    </span>\n                  </div>\n                  <p className=\"mt-1 flex items-center gap-1 truncate text-[11px] text-slate-400\">\n                    <MapPin className=\"h-3 w-3 shrink-0 text-slate-400\" aria-hidden=\"true\" />\n                    <span className=\"truncate\">{shop.address}</span>\n                  </p>\n                </div>\n              </div>\n\n              <span className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors group-hover:bg-blue-600 group-hover:text-white\">\n                <ArrowRight className=\"h-4 w-4\" aria-hidden=\"true\" />\n              </span>\n            </motion.button>\n          ))}\n        </div>\n      )}\n    </section>\n  );\n}"
          replacement_content: "import { ArrowRight, Loader2, Wrench } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type { RepairShop } from \'../../types/rescue\';\nimport { formatShopCompactMeta } from \'../../utils/repairShopApi\';\n\ninterface NearbyRepairShopsSectionProps {\n  shops: RepairShop[];\n  isLoading: boolean;\n  onSelectShop: (shopId: string) => void;\n  onViewAllOnMap: () => void;\n}\n\nexport function NearbyRepairShopsSection({\n  shops,\n  isLoading,\n  onSelectShop,\n  onViewAllOnMap,\n}: NearbyRepairShopsSectionProps) {\n  const visibleShops = shops.slice(0, 3);\n\n  return (\n    <section aria-label=\"Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237 g\341\272\247n b\341\272\241n\" className=\"mt-5\">\n      <div className=\"flex items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"h-2 w-2 rounded-full bg-emerald-500\" aria-hidden=\"true\" />\n          <h2 className=\"text-sm font-bold tracking-tight text-slate-900\">\n            Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237 g\341\272\247n b\341\272\241n\n          </h2>\n        </div>\n\n        {isLoading ? (\n          <span className=\"inline-flex items-center gap-1 text-xs font-medium text-slate-500\">\n            <Loader2 className=\"h-3 w-3 animate-spin\" aria-hidden=\"true\" />\n            <span>\304\220ang l\341\273\215c</span>\n          </span>\n        ) : (\n          <button\n            type=\"button\"\n            onClick={onViewAllOnMap}\n            className=\"text-xs font-semibold text-emerald-700 transition-colors hover:text-emerald-800\"\n          >\n            Xem b\341\272\243n \304\221\341\273\223 \342\206\222\n          </button>\n        )}\n      </div>\n\n      {visibleShops.length === 0 ? (\n        <div className=\"mt-3 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 text-xs text-slate-500 shadow-xs\">\n          Hi\341\273\207n ch\306\260a ghi nh\341\272\255n ti\341\273\207m m\341\273\237 c\341\273\255a trong b\303\241n k\303\255nh 2.5km. B\341\272\241n c\303\263 th\341\273\203 g\341\273\215i th\341\273\243 l\306\260u \304\221\341\273\231ng 24/7 ph\303\255a tr\303\252n.\n        </div>\n      ) : (\n        <div className=\"mt-3 space-y-2.5\">\n          {visibleShops.map((shop) => (\n            <motion.button\n              key={shop.id}\n              type=\"button\"\n              whileTap={{ scale: 0.985 }}\n              onClick={() => onSelectShop(shop.id)}\n              className=\"group flex w-full items-center justify-between gap-3.5 rounded-2xl border border-slate-100 bg-white p-3.5 text-left shadow-sm transition-all hover:border-slate-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500\"\n            >\n              <div className=\"flex min-w-0 items-center gap-3.5\">\n                <span className=\"relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-900 text-white shadow-xs\">\n                  <Wrench className=\"h-[18px] w-[18px]\" aria-hidden=\"true\" />\n                  <span className=\"absolute -top-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-400 ring-2 ring-white\" />\n                </span>\n\n                <div className=\"min-w-0\">\n                  <p className=\"truncate text-[13.5px] font-bold text-slate-900\">\n                    {shop.name}\n                  </p>\n                  <p className=\"mt-0.5 flex items-center gap-1.5 truncate font-sans text-[11.5px] font-medium tabular-nums text-slate-500\">\n                    <span\n                      className=\"inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500\"\n                      aria-hidden=\"true\"\n                    />\n                    <span className=\"truncate\">\n                      \304\220ang m\341\273\237 \342\200\242 {formatShopCompactMeta(shop.distanceMeters, shop.address)}\n