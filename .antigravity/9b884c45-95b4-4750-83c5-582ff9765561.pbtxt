          target_content: "\'use client\';\n\nimport { Map as MapLibreMap, Marker, setWorkerUrl } from \'maplibre-gl\';\nimport \'maplibre-gl/dist/maplibre-gl.css\';\nimport maplibreWorkerUrl from \'maplibre-gl/dist/maplibre-gl-worker.mjs?url\';\nimport { useEffect, useRef, useState } from \'react\';\nimport { useMapMarkersSync } from \'../hooks/useMapMarkersSync\';\nimport { useRescueMapMechanicOverlay } from \'../hooks/useRescueMapMechanicOverlay\';\nimport type { GasStation, GeoCoord, GeoJsonLineString, MapLayerFilter, MechanicInfo, PickupMode, RepairShop, RescueStep, SafeStation, TrackingStatus, UserLocation } from \'../types/rescue\';\nimport { computeBoundsBox } from \'../utils/rescueLogic\';\nimport {\n  ensureRescueRouteLayers,\n  fitMapBoundsSafely,\n  getViewportPadding,\n  setAccuracyCircleGeoJson,\n  setRouteSourceGeometry,\n} from \'./map/mapLayers\';\nimport { CenterPinOverlay } from \'./map/CenterPinOverlay\';\nimport { createUserMarkerElement } from \'./map/mapMarkers\';\nimport { StationPreviewCard } from \'./map/StationPreviewCard\';\n\nsetWorkerUrl(maplibreWorkerUrl);\n\nconst CARTO_POSITRON_STYLE_URL =\n  \'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json\';\n\ninterface RescueMapProps {\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  selectedStationId: string | null;\n  inspectedStationId: string | null;\n  selectedShopId: string | null;\n  selectedGasStationId: string | null;\n  mapFilter: MapLayerFilter;\n  pickupMode: PickupMode;\n  pickupCoord: GeoCoord;\n  walkingRoute: GeoJsonLineString | null;\n  shopRoute: GeoJsonLineString | null;\n  gasRoute: GeoJsonLineString | null;\n  mechanicRoute: GeoJsonLineString | null;\n  routeStartTimeMs: number | null;\n  initialEtaMinutes: number;\n  step: RescueStep;\n  trackingStatus: TrackingStatus;\n  mechanic: MechanicInfo;\n  recenterSignal: number;\n  isPinPickerMode?: boolean;\n  isPinDragging?: boolean;\n  onSelectStation: (stationId: string) => void;\n  onInspectStation: (stationId: string | null) => void;\n  onSelectShop: (shopId: string | null) => void;\n  onSelectGasStation: (stationId: string | null) => void;\n  onPinMoveStart?: () => void;\n  onPinMoveEnd?: (coord: GeoCoord) => void;\n  onEtaMinuteChange: (etaMinutes: number) => void;\n  onMechanicArrived: () => void;\n}\n\nexport function RescueMap(props: RescueMapProps) {\n  const {\n    userLocation, stations, openRepairShops, gasStations,\n    selectedStationId, inspectedStationId, selectedShopId, selectedGasStationId,\n    mapFilter, pickupMode, pickupCoord, walkingRoute, shopRoute, gasRoute,\n    mechanicRoute, routeStartTimeMs, initialEtaMinutes, step, trackingStatus,\n    mechanic, recenterSignal, isPinPickerMode = false, isPinDragging = false,\n    onSelectStation, onInspectStation, onSelectShop, onSelectGasStation,\n    onPinMoveStart, onPinMoveEnd, onEtaMinuteChange, onMechanicArrived,\n  } = props;\n  const containerRef = useRef<HTMLDivElement | null>(null);\n  const mapRef = useRef<MapLibreMap | null>(null);\n  const userMarkerRef = useRef<Marker | null>(null);\n  const [mapReady, setMapReady] = useState(false);\n\n  const mechanicMarkerRef = useRescueMapMechanicOverlay({\n    mapRef, containerRef, mapReady, step, trackingStatus, mechanicRoute,\n    routeStartTimeMs, initialEtaMinutes, pickupCoord, mechanicName: mechanic.name,\n    onEtaMinuteChange, onMechanicArrived,\n  });\n\n  const { clearAllMarkers } = useMapMarkersSync({\n    mapRef, containerRef, mapReady, userCoord: userLocation.coord, stations,\n    openRepairShops, gasStations, selectedStationId, inspectedStationId,\n    selectedShopId, selectedGasStationId, mapFilter, shopRoute, gasRoute,\n    step, pickupMode, onSelectStation, onInspectStation, onSelectShop, onSelectGasStation,\n  });\n\n  const inspectedStation =\n    stations.find((s) => s.id === inspectedStationId) ?? null;\n\n  useEffect(() => {\n    const el = containerRef.current;\n    if (!el || mapRef.current) return;\n\n    const map = new MapLibreMap({\n      container: el,\n      style: CARTO_POSITRON_STYLE_URL,\n      center: [userLocation.coord.lng, userLocation.coord.lat],\n      zoom: 15.2,\n      attributionControl: false,\n      pitchWithRotate: false,\n      dragRotate: false,\n    });\n\n    map.on(\'load\', () => {\n      ensureRescueRouteLayers(map);\n      map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\n      map.easeTo({\n        center: [userLocation.coord.lng, userLocation.coord.lat],\n        padding: getViewportPadding(el, false),\n        duration: 0,\n      });\n      setMapReady(true);\n    });\n\n    const observer = new ResizeObserver(() => map.resize());\n    observer.observe(el);\n    mapRef.current = map;\n\n    return () => {\n      observer.disconnect();\n      clearAllMarkers();\n      userMarkerRef.current?.remove();\n      mechanicMarkerRef.current?.remove();\n      map.remove();\n      mapRef.current = null;\n      setMapReady(false);\n    };\n  }, []);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    userMarkerRef.current?.remove();\n    const isSearching = step === \'tracking\' && trackingStatus === \'searching\';\n    const el = createUserMarkerElement(isSearching);\n    userMarkerRef.current = new Marker({ element: el })\n      .setLngLat([userLocation.coord.lng, userLocation.coord.lat])\n      .addTo(map);\n  }, [userLocation.coord.lat, userLocation.coord.lng, step, trackingStatus]);\n\n  const prevRecenterRef = useRef(recenterSignal);\n  const prevCoordRef = useRef(userLocation.coord);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    const recenterChanged = prevRecenterRef.current !== recenterSignal;\n    const coordChanged =\n      prevCoordRef.current.lat !== userLocation.coord.lat ||\n      prevCoordRef.current.lng !== userLocation.coord.lng;\n    prevRecenterRef.current = recenterSignal;\n    prevCoordRef.current = userLocation.coord;\n\n    if (!recenterChanged && !coordChanged) return;\n    map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\n    map.flyTo({\n      center: [userLocation.coord.lng, userLocation.coord.lat],\n      zoom: 15.2,\n      padding: getViewportPadding(containerRef.current, false),\n      duration: 600,\n    });\n  }, [userLocation.coord.lat, userLocation.coord.lng, recenterSignal, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n    setAccuracyCircleGeoJson(map, userLocation.coord, userLocation.accuracyMeters);\n  }, [userLocation.coord.lat, userLocation.coord.lng, userLocation.accuracyMeters, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady || !isPinPickerMode) return;\n\n    const handleMoveStart = () => onPinMoveStart?.();\n    const handleMoveEnd = () => {\n      const el = containerRef.current;\n      const point = el\n        ? map.unproject([el.clientWidth / 2, el.clientHeight * 0.33])\n        : map.getCenter();\n      onPinMoveEnd?.({ lat: point.lat, lng: point.lng });\n    };\n\n    map.on(\'movestart\', handleMoveStart);\n    map.on(\'moveend\', handleMoveEnd);\n    return () => {\n      map.off(\'movestart\', handleMoveStart);\n      map.off(\'moveend\', handleMoveEnd);\n    };\n  }, [mapReady, isPinPickerMode, onPinMoveStart, onPinMoveEnd]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    setRouteSourceGeometry(map, \'walking-route\', walkingRoute);\n    if (!walkingRoute || step === \'tracking\') return;\n\n    const bounds = computeBoundsBox(walkingRoute.coordinates);\n    if (bounds) {\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.5, 600);\n    }\n  }, [walkingRoute, step, mapReady]);\n\n  return (\n    <section\n      aria-label=\"B\341\272\243n \304\221\341\273\223 th\341\273\261c t\341\272\277 khu v\341\273\261c, Tr\341\272\241m An To\303\240n v\303\240 Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237\"\n      data-testid=\"rescue-map-canvas\"\n      className=\"relative h-full w-full bg-slate-100\"\n    >\n      <div ref={containerRef} className=\"h-full w-full\" />\n\n      {isPinPickerMode && <CenterPinOverlay isDragging={isPinDragging} />}\n\n      {inspectedStation && step === \'idle\' && !selectedShopId && !isPinPickerMode && (\n        <div className=\"pointer-events-none absolute inset-x-0 top-28 z-20 px-4\">\n          <div className=\"pointer-events-auto relative mx-auto max-w-md lg:mx-0\">\n            <StationPreviewCard\n              station={inspectedStation}\n              onClose={() => onInspectStation(null)}\n            />\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}"
          replacement_content: "import { Map as MapLibreMap, Marker, setWorkerUrl } from \'maplibre-gl\';\nimport \'maplibre-gl/dist/maplibre-gl.css\';\nimport maplibreWorkerUrl from \'maplibre-gl/dist/maplibre-gl-worker.mjs?url\';\nimport { useEffect, useRef, useState } from \'react\';\nimport { useMapMarkersSync } from \'../hooks/useMapMarkersSync\';\nimport { useRescueMapMechanicOverlay } from \'../hooks/useRescueMapMechanicOverlay\';\nimport type {\n  GasStation,\n  GeoCoord,\n  GeoJsonLineString,\n  InspectedPlace,\n  MapLayerFilter,\n  MechanicInfo,\n  PickupMode,\n  RepairShop,\n  RescueStep,\n  SafeStation,\n  TrackingStatus,\n  UserLocation,\n} from \'../types/rescue\';\nimport {\n  ensureRescueRouteLayers,\n  getViewportPadding,\n  setAccuracyCircleGeoJson,\n} from \'./map/mapLayers\';\nimport { CenterPinOverlay } from \'./map/CenterPinOverlay\';\nimport { createUserMarkerElement } from \'./map/mapMarkers\';\n\nsetWorkerUrl(maplibreWorkerUrl);\n\nconst CARTO_POSITRON_STYLE_URL =\n  \'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json\';\n\ninterface RescueMapProps {\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  selectedStationId: string | null;\n  inspectedPlace: InspectedPlace | null;\n  inspectRoute: GeoJsonLineString | null;\n  mapFilter: MapLayerFilter;\n  pickupMode: PickupMode;\n  pickupCoord: GeoCoord;\n  walkingRoute: GeoJsonLineString | null;\n  gasRoute: GeoJsonLineString | null;\n  mechanicRoute: GeoJsonLineString | null;\n  routeStartTimeMs: number | null;\n  initialEtaMinutes: number;\n  step: RescueStep;\n  trackingStatus: TrackingStatus;\n  mechanic: MechanicInfo;\n  recenterSignal: number;\n  isPinPickerMode?: boolean;\n  isPinDragging?: boolean;\n  onSelectStation: (stationId: string) => void;\n  onInspectPlace: (place: InspectedPlace) => void;\n  onSelectGasStation: (stationId: string | null) => void;\n  onPinMoveStart?: () => void;\n  onPinMoveEnd?: (coord: GeoCoord) => void;\n  onEtaMinuteChange: (etaMinutes: number) => void;\n  onMechanicArrived: () => void;\n}\n\nexport function RescueMap(props: RescueMapProps) {\n  const {\n    userLocation, stations, openRepairShops, gasStations,\n    selectedStationId, inspectedPlace, inspectRoute, mapFilter,\n    pickupMode, pickupCoord, walkingRoute, gasRoute,\n    mechanicRoute, routeStartTimeMs, initialEtaMinutes, step, trackingStatus,\n    mechanic, recenterSignal, isPinPickerMode = false, isPinDragging = false,\n    onSelectStation, onInspectPlace, onSelectGasStation,\n    onPinMoveStart, onPinMoveEnd, onEtaMinuteChange, onMechanicArrived,\n  } = props;\n  const containerRef = useRef<HTMLDivElement | null>(null);\n  const mapRef = useRef<MapLibreMap | null>(null);\n  const userMarkerRef = useRef<Marker | null>(null);\n  const [mapReady, setMapReady] = useState(false);\n\n  const mechanicMarkerRef = useRescueMapMechanicOverlay({\n    mapRef, containerRef, mapReady, step, trackingStatus, mechanicRoute,\n    routeStartTimeMs, initialEtaMinutes, pickupCoord, mechanicName: mechanic.name,\n    onEtaMinuteChange, onMechanicArrived,\n  });\n\n  const { clearAllMarkers } = useMapMarkersSync({\n    mapRef, containerRef, mapReady, userCoord: userLocation.coord, stations,\n    openRepairShops, gasStations, selectedStationId, inspectedPlace,\n    inspectRoute, walkingRoute, gasRoute, mapFilter, step, pickupMode,\n    onInspectPlace, onSelectStation, onSelectGasStation,\n  });\n\n  useEffect(() => {\n    const el = containerRef.current;\n    if (!el || mapRef.current) return;\n\n    const map = new MapLibreMap({\n      container: el,\n      style: CARTO_POSITRON_STYLE_URL,\n      center: [userLocation.coord.lng, userLocation.coord.lat],\n      zoom: 15.2,\n      attributionControl: false,\n      pitchWithRotate: false,\n      dragRotate: false,\n    });\n\n    map.on(\'load\', () => {\n      ensureRescueRouteLayers(map);\n      map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\n      map.easeTo({\n        center: [userLocation.coord.lng, userLocation.coord.lat],\n        padding: getViewportPadding(el, false),\n        duration: 0,\n      });\n      setMapReady(true);\n    });\n\n    const observer = new ResizeObserver(() => map.resize());\n    observer.observe(el);\n    mapRef.current = map;\n\n    return () => {\n      observer.disconnect();\n      clearAllMarkers();\n      userMarkerRef.current?.remove();\n      mechanicMarkerRef.current?.remove();\n      map.remove();\n      mapRef.current = null;\n      setMapReady(false);\n    };\n  }, []);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    userMarkerRef.current?.remove();\n    const isSearching = step === \'tracking\' && trackingStatus === \'searching\';\n    const el = createUserMarkerElement(isSearching);\n    userMarkerRef.current = new Marker({ element: el })\n      .setLngLat([userLocation.coord.lng, userLocation.coord.lat])\n      .addTo(map);\n  }, [userLocation.coord.lat, userLocation.coord.lng, step, trackingStatus]);\n\n  const prevRecenterRef = useRef(recenterSignal);\n  const prevCoordRef = useRef(userLocation.coord);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    const recenterChanged = prevRecenterRef.current !== recenterSignal;\n    const coordChanged =\n      prevCoordRef.current.lat !== userLocation.coord.lat ||\n      prevCoordRef.current.lng !== userLocation.coord.lng;\n    prevRecenterRef.current = recenterSignal;\n    prevCoordRef.current = userLocation.coord;\n\n    if (!recenterChanged && !coordChanged) return;\n    map.setPadding({ top: 0, bottom: 0, left: 0, right: 0 });\n    map.flyTo({\n      center: [userLocation.coord.lng, userLocation.coord.lat],\n      zoom: 15.2,\n      padding: getViewportPadding(containerRef.current, false),\n      duration: 600,\n    });\n  }, [userLocation.coord.lat, userLocation.coord.lng, recenterSignal, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n    setAccuracyCircleGeoJson(map, userLocation.coord, userLocation.accuracyMeters);\n  }, [userLocation.coord.lat, userLocation.coord.lng, userLocation.accuracyMeters, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady || !isPinPickerMode) return;\n\n    const handleMoveStart = () => onPinMoveStart?.();\n    const handleMoveEnd = () => {\n      const el = containerRef.current;\n      const point = el\n        ? map.unproject([el.clientWidth / 2, el.clientHeight * 0.33])\n        : map.getCenter();\n      onPinMoveEnd?.({ lat: point.lat, lng: point.lng });\n    };\n\n    map.on(\'movestart\', handleMoveStart);\n    map.on(\'moveend\', handleMoveEnd);\n    return () => {\n      map.off(\'movestart\', handleMoveStart);\n      map.off(\'moveend\', handleMoveEnd);\n    };\n  }, [mapReady, isPinPickerMode, onPinMoveStart, onPinMoveEnd]);\n\n  return (\n    <section\n      aria-label=\"B\341\272\243n \304\221\341\273\223 th\341\273\261c t\341\272\277 khu v\341\273\261c, Tr\341\272\241m An To\303\240n v\303\240 Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237\"\n      data-testid=\"rescue-map-canvas\"\n      className=\"relative h-full w-full bg-slate-100\"\n    >\n      <div ref={containerRef} className=\"h-full w-full\" />\n      {isPinPickerMode && <CenterPinOverlay isDragging={isPinDragging} />}\n    </section>\n  );\n}"
