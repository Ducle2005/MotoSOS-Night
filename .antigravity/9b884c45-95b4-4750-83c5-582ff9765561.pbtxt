  code_action {
    action_spec {
      create_file {
        instruction: "import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\nimport {\n  DEFAULT_HCMC_COORD,\n  FALLBACK_USER_LOCATION,\n  MOCK_SAFE_STATIONS,\n} from \'../data/mockRescueData\';\nimport type {\n  ActiveLocation,\n  GeoCoord,\n  GeoJsonLineString,\n  LocationSuggestion,\n  PickupMode,\n  RescueStep,\n  SafeStation,\n  UserLocation,\n} from \'../types/rescue\';\nimport { reverseGeocodeCoord } from \'../utils/geocodeApi\';\nimport { fetchNearbySafeStations, fetchWalkingRoute } from \'../utils/mapApi\';\nimport { getNearestSafeStation } from \'../utils/rescueLogic\';\n\nexport function useRescueGeo(\n  step: RescueStep,\n  pickupMode: PickupMode,\n  selectedStation: SafeStation | null,\n  onStationsReady: (stations: SafeStation[]) => void,\n) {\n  const [activeLocation, setActiveLocation] = useState<ActiveLocation>({\n    lat: DEFAULT_HCMC_COORD.lat,\n    lng: DEFAULT_HCMC_COORD.lng,\n    address: FALLBACK_USER_LOCATION.address,\n    isCurrentGPS: true,\n  });\n  const [isLocatingGps, setIsLocatingGps] = useState(false);\n  const [stations, setStations] = useState<SafeStation[]>(MOCK_SAFE_STATIONS);\n  const [isLoadingStations, setIsLoadingStations] = useState(false);\n  const [walkingRoute, setWalkingRoute] = useState<GeoJsonLineString | null>(\n    null,\n  );\n  const [routeSummary, setRouteSummary] = useState<{\n    distanceMeters: number;\n    durationMinutes: number;\n  } | null>(null);\n  const [isLoadingRoute, setIsLoadingRoute] = useState(false);\n  const geocodeAbortRef = useRef<AbortController | null>(null);\n\n  const applyReverseGeocodedCoord = useCallback(\n    async (coord: GeoCoord, isRealGps: boolean) => {\n      geocodeAbortRef.current?.abort();\n      const controller = new AbortController();\n      geocodeAbortRef.current = controller;\n\n      const resolvedAddress = await reverseGeocodeCoord(coord, controller.signal);\n      if (controller.signal.aborted) return;\n\n      setActiveLocation({\n        lat: coord.lat,\n        lng: coord.lng,\n        address:\n          isRealGps || !resolvedAddress.startsWith(\'V\341\273\213 tr\303\255 GPS\')\n            ? resolvedAddress\n            : FALLBACK_USER_LOCATION.address,\n        isCurrentGPS: true,\n      });\n    },\n    [],\n  );\n\n  const useCurrentGpsLocation = useCallback((): Promise<void> => {\n    setIsLocatingGps(true);\n    return new Promise((resolve) => {\n      if (typeof navigator === \'undefined\' || !navigator.geolocation) {\n        applyReverseGeocodedCoord(DEFAULT_HCMC_COORD, false).finally(() => {\n          setIsLocatingGps(false);\n          resolve();\n        });\n        return;\n      }\n\n      navigator.geolocation.getCurrentPosition(\n        (pos) => {\n          const coord = {\n            lat: pos.coords.latitude,\n            lng: pos.coords.longitude,\n          };\n          setActiveLocation((prev) => ({\n            lat: coord.lat,\n            lng: coord.lng,\n            address: prev.address,\n            isCurrentGPS: true,\n          }));\n          applyReverseGeocodedCoord(coord, true).finally(() => {\n            setIsLocatingGps(false);\n            resolve();\n          });\n        },\n        () => {\n          applyReverseGeocodedCoord(DEFAULT_HCMC_COORD, false).finally(() => {\n            setIsLocatingGps(false);\n            resolve();\n          });\n        },\n        { enableHighAccuracy: true, timeout: 6000, maximumAge: 60000 },\n      );\n    });\n  }, [applyReverseGeocodedCoord]);\n\n  useEffect(() => {\n    useCurrentGpsLocation();\n    return () => geocodeAbortRef.current?.abort();\n  }, [useCurrentGpsLocation]);\n\n  const selectSearchedLocation = useCallback((item: LocationSuggestion) => {\n    geocodeAbortRef.current?.abort();\n    setActiveLocation({\n      lat: item.lat,\n      lng: item.lng,\n      address: item.fullAddress,\n      isCurrentGPS: false,\n    });\n  }, []);\n\n  const userLocation: UserLocation = useMemo(\n    () => ({\n      address: activeLocation.address,\n      district: activeLocation.isCurrentGPS\n        ? \'V\341\273\213 tr\303\255 GPS hi\341\273\207n t\341\272\241i\'\n        : \'\304\220\341\273\213a \304\221i\341\273\203m \304\221\303\243 ch\341\273\215n\',\n      coord: { lat: activeLocation.lat, lng: activeLocation.lng },\n      source: activeLocation.isCurrentGPS ? \'gps\' : \'fallback\',\n    }),\n    [activeLocation],\n  );\n\n  useEffect(() => {\n    const controller = new AbortController();\n    setIsLoadingStations(true);\n\n    fetchNearbySafeStations(\n      { lat: activeLocation.lat, lng: activeLocation.lng },\n      controller.signal,\n    )\n      .then(({ stations: nextStations }) => {\n        if (controller.signal.aborted) return;\n        setStations(nextStations);\n        onStationsReady(nextStations);\n      })\n      .finally(() => {\n        if (!controller.signal.aborted) {\n          setIsLoadingStations(false);\n        }\n      });\n\n    return () => controller.abort();\n  }, [activeLocation.lat, activeLocation.lng]);\n\n  useEffect(() => {\n    const shouldRoute =\n      (step === \'pickup\' || step === \'tracking\') &&\n      pickupMode === \'safe_station\' &&\n      selectedStation !== null;\n\n    if (!shouldRoute || !selectedStation) {\n      setWalkingRoute(null);\n      setRouteSummary(null);\n      setIsLoadingRoute(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    setIsLoadingRoute(true);\n\n    fetchWalkingRoute(\n      { lat: activeLocation.lat, lng: activeLocation.lng },\n      selectedStation.coord,\n      controller.signal,\n    )\n      .then((res) => {\n        if (controller.signal.aborted) return;\n        setWalkingRoute(res.geometry);\n        setRouteSummary({\n          distanceMeters: res.distanceMeters,\n          durationMinutes: res.durationMinutes,\n        });\n      })\n      .finally(() => {\n        if (!controller.signal.aborted) {\n          setIsLoadingRoute(false);\n        }\n      });\n\n    return () => controller.abort();\n  }, [\n    step,\n    pickupMode,\n    activeLocation.lat,\n    activeLocation.lng,\n    selectedStation?.id,\n  ]);\n\n  const nearestStation = getNearestSafeStation(stations);\n\n  return {\n    activeLocation,\n    userLocation,\n    isLocatingGps,\n    selectSearchedLocation,\n    useCurrentGpsLocation,\n    stations,\n    nearestStation,\n    isLoadingStations,\n    walkingRoute,\n    routeSummary,\n    isLoadingRoute,\n    clearRoute: () => {\n      setWalkingRoute(null);\n      setRouteSummary(null);\n    },\n  };\n}\n"
        path {
          absolute_uri: "file:///src/hooks/useRescueGeo.ts"
        }
        overwrite: true
      }
    }
