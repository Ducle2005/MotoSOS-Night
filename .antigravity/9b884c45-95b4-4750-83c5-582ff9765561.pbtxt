    content: "    map.on(\'load\', () => {\n      ensureRescueRouteLayers(map);\n      setMapReady(true);\n    });\n\n    mapRef.current = map;\n\n    return () => {\n      stationMarkersRef.current.forEach((m) => m.remove());\n      stationMarkersRef.current = [];\n      userMarkerRef.current?.remove();\n      mechanicMarkerRef.current?.remove();\n      map.remove();\n      mapRef.current = null;\n      setMapReady(false);\n    };\n  }, []);\n\n  // Sync user GPS marker\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    userMarkerRef.current?.remove();\n    const isSearching = step === \'tracking\' && trackingStatus === \'searching\';\n    const el = createUserMarkerElement(isSearching);\n    userMarkerRef.current = new Marker({ element: el })\n      .setLngLat([userLocation.coord.lng, userLocation.coord.lat])\n      .addTo(map);\n  }, [userLocation.coord.lat, userLocation.coord.lng, step, trackingStatus]);\n\n  // Recenter camera when GPS resolves or user clicks \"V\341\273\201 v\341\273\213 tr\303\255 c\341\273\247a t\303\264i\"\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n    const isDesktop = window.innerWidth >= 1024;\n    map.flyTo({\n      center: [userLocation.coord.lng, userLocation.coord.lat],\n      zoom: 15.2,\n      padding: isDesktop\n        ? { top: 40, bottom: 40, left: 40, right: 440 }\n        : { top: 40, bottom: 300, left: 20, right: 20 },\n      duration: 650,\n    });\n  }, [userLocation.coord.lat, userLocation.coord.lng, recenterSignal]);\n\n  // Sync Safe Station emerald markers\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    stationMarkersRef.current.forEach((marker) => marker.remove());\n    stationMarkersRef.current = stations.map((station) => {\n      const isHighlighted =\n        inspectedStationId === station.id ||\n        (selectedStationId === station.id &&\n          (step === \'pickup\' || step === \'tracking\') &&\n          pickupMode === \'safe_station\');\n\n      const el = createStationMarkerElement(station, isHighlighted, () => {\n        onInspectStation(station.id);\n        onSelectStation(station.id);\n      });\n\n      return new Marker({ element: el, anchor: \'top\' })\n        .setLngLat([station.coord.lng, station.coord.lat])\n        .addTo(map);\n    });\n  }, [stations, selectedStationId, inspectedStationId, step, pickupMode]);\n\n  // Sync OSRM walking route & smart fitBounds\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    setRouteSourceGeometry(map, \'walking-route\', walkingRoute);\n    if (!walkingRoute) return;\n\n    const bounds = computeBoundsBox(walkingRoute.coordinates);\n    if (bounds) {\n      const isDesktop = window.innerWidth >= 1024;\n      map.fitBounds(bounds, {\n        padding: isDesktop\n          ? { top: 80, bottom: 80, left: 60, right: 480 }\n          : { top: 80, bottom: 380, left: 40, right: 40 },\n        duration: 650,\n        maxZoom: 16.5,\n      });\n    }\n  }, [walkingRoute, mapReady]);\n\n  // Sync Mechanic marker & approach route in Step 3\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    const showMechanic =\n      step === \'tracking\' &&\n      (trackingStatus === \'accepted\' || trackingStatus === \'completed\');\n\n    mechanicMarkerRef.current?.remove();\n    mechanicMarkerRef.current = null;\n\n    if (!showMechanic) {\n      setRouteSourceGeometry(map, \'mechanic-route\', null);\n      return;\n    }\n\n    const isCompleted = trackingStatus === \'completed\';\n    const currentPos = isCompleted ? pickupCoord : mechanicCoord;\n    const el = createMechanicMarkerElement("
