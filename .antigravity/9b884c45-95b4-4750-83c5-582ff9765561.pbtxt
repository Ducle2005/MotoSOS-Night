      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Trim multi-line formatting in useRescueOrderState so file stays well under 250 lines\", \"EndLine\":254, \"Instruction\":\"Make return object and helper calls compact in useRescueOrderState.ts\", \"ReplacementContent\":\"  return {\\n    activeTab, setActiveTab, step, setStep,\\n    selectedIssue, setSelectedIssue, customNote, setCustomNote,\\n    pickupMode, handleChangePickupMode, selectedVoucherId, setSelectedVoucherId,\\n    selectedStationId, setSelectedStationId, inspectedStationId, setInspectedStationId,\\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\\n    recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\\n    activityHistory, geo, pickupTarget, issueSummary, pricing, mechanicSim,\\n    handleResetFlow, handleCompleteAndLog, handleConfirmRescue, handleDemoAdvance,\\n    handleOpenMapWithStation, handleQuickCategory, handleQuickIssue, handleQuickSos,\\n  };\\n}\", \"StartLine\":215, \"TargetContent\":\"  return {\\n    activeTab,\\n    setActiveTab,\\n    step,\\n    setStep,\\n    selectedIssue,\\n    setSelectedIssue,\\n    customNote,\\n    setCustomNote,\\n    pickupMode,\\n    handleChangePickupMode,\\n    selectedVoucherId,\\n    setSelectedVoucherId,\\n    selectedStationId,\\n    setSelectedStationId,\\n    inspectedStationId,\\n    setInspectedStationId,\\n    trackingStatus,\\n    isSubmitting,\\n    enteredFromQuickStations,\\n    setEnteredFromQuickStations,\\n    recenterSignal,\\n    triggerRecenter: () => setRecenterSignal((c) => c + 1),\\n    activityHistory,\\n    geo,\\n    pickupTarget,\\n    issueSummary,\\n    pricing,\\n    mechanicSim,\\n    handleResetFlow,\\n    handleCompleteAndLog,\\n    handleConfirmRescue,\\n    handleDemoAdvance,\\n    handleOpenMapWithStation,\\n    handleQuickCategory,\\n    handleQuickIssue,\\n    handleQuickSos,\\n  };\\n}\", \"TargetFile\":\"/src/hooks/useRescueOrderState.ts\", \"toolAction\":\"Compacting return object in useRescueOrderState.ts\", \"toolSummary\":\"Compact useRescueOrderState.ts\"}"
      original_name: "replace_file_content"
