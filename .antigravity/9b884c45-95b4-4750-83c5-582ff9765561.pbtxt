      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Support police_station in useActivePlaceInspect destination resolver\", \"EndLine\":48, \"Instruction\":\"Add police_station branch to destination resolution in useActivePlaceInspect\", \"ReplacementContent\":\"      const destination =\\n        place.kind === \'safe_station\'\\n          ? place.station.coord\\n          : place.kind === \'repair_shop\'\\n            ? place.shop.coord\\n            : place.kind === \'gas_station\'\\n              ? place.gasStation.coord\\n              : place.policeStation.coord;\", \"StartLine\":36, \"TargetContent\":\"      const destination =\\n        place.kind === \'safe_station\'\\n          ? place.station.coord\\n          : place.kind === \'repair_shop\'\\n            ? place.shop.coord\\n            : place.gasStation.coord;\", \"TargetFile\":\"/src/hooks/useActivePlaceInspect.ts\", \"toolAction\":\"Supporting police_station in useActivePlaceInspect\", \"toolSummary\":\"Active place inspect update\"}"
