      arguments_json: "{\"Description\":\"Add GPS accuracy badge, high-accuracy loading text, and Choose directly on map button to LocationSearchModal.tsx\", \"Instruction\":\"Update GPS button copy/badge and add map pin picker button while keeping file under 250 lines\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":28, \"ReplacementContent\":\"import { Loader2, LocateFixed, MapPin, Search, X } from \'lucide-react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { useEffect, useRef, useState } from \'react\';\\nimport type { ActiveLocation, LocationSuggestion } from \'../../types/rescue\';\\nimport { fetchAddressAutocomplete, formatSuggestionDistance } from \'../../utils/geocodeApi\';\\nimport { formatGpsAccuracyBadge } from \'../../utils/gpsWatcher\';\\n\\ninterface LocationSearchModalProps {\\n  isOpen: boolean;\\n  activeLocation: ActiveLocation;\\n  isLocatingGps: boolean;\\n  onSelectSuggestion: (suggestion: LocationSuggestion) => void;\\n  onUseCurrentGps: () => Promise<void>;\\n  onStartMapPinPicker: () => void;\\n  onClose: () => void;\\n}\\n\\nexport function LocationSearchModal({\\n  isOpen, activeLocation, isLocatingGps,\\n  onSelectSuggestion, onUseCurrentGps, onStartMapPinPicker, onClose,\\n}: LocationSearchModalProps) {\", \"StartLine\":1, \"TargetContent\":\"import { Loader2, LocateFixed, MapPin, Search, X } from \'lucide-react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { useEffect, useRef, useState } from \'react\';\\nimport type { ActiveLocation, LocationSuggestion } from \'../../types/rescue\';\\nimport {\\n  fetchAddressAutocomplete,\\n  formatSuggestionDistance,\\n} from \'../../utils/geocodeApi\';\\n\\ninterface LocationSearchModalProps {\\n  isOpen: boolean;\\n  activeLocation: ActiveLocation;\\n  isLocatingGps: boolean;\\n  onSelectSuggestion: (suggestion: LocationSuggestion) => void;\\n  onUseCurrentGps: () => Promise<void>;\\n  onClose: () => void;\\n}\\n\\nexport function LocationSearchModal({\\n  isOpen,\\n  activeLocation,\\n  isLocatingGps,\\n  onSelectSuggestion,\\n  onUseCurrentGps,\\n  onClose,\\n}: LocationSearchModalProps) {\"}, {\"AllowMultiple\":false, \"EndLine\":86, \"ReplacementContent\":\"  const accuracyBadge = formatGpsAccuracyBadge(activeLocation.accuracyMeters);\\n\\n  const handleUseGpsClick = async () => {\\n    await onUseCurrentGps();\\n    onClose();\\n  };\\n\\n  const handlePinOnMapClick = () => {\\n    onClose();\\n    onStartMapPinPicker();\\n  };\", \"StartLine\":80, \"TargetContent\":\"  const handleUseGpsClick = async () => {\\n    await onUseCurrentGps();\\n    onClose();\\n  };\"}, {\"AllowMultiple\":false, \"EndLine\":196, \"ReplacementContent\":\"            {/* High-accuracy GPS & Direct Map Pin quick rows */}\\n            <div className=\\\"shrink-0 space-y-2 border-y border-slate-100 px-5 py-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                data-testid=\\\"use-current-gps-btn\\\"\\n                onClick={handleUseGpsClick}\\n                disabled={isLocatingGps}\\n                className=\\\"flex w-full items-center gap-3 rounded-2xl bg-emerald-50/80 px-3.5 py-2.5 text-left transition-colors hover:bg-emerald-50 active:scale-[0.99] disabled:opacity-75\\\"\\n              >\\n                <span className=\\\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white shadow-sm shadow-emerald-500/30\\\">\\n                  {isLocatingGps ? <Loader2 className=\\\"h-4 w-4 animate-spin\\\" aria-hidden=\\\"true\\\" /> : <LocateFixed className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />}\\n                </span>\\n                <div className=\\\"min-w-0 flex-1\\\">\\n                  <div className=\\\"flex flex-wrap items-center gap-1.5\\\">\\n                    <p className=\\\"text-sm font-bold text-emerald-900\\\">\\n                      {isLocatingGps ? \'\304\220ang kh\303\263a t\341\273\215a \304\221\341\273\231 GPS ch\303\255nh x\303\241c...\' : \'S\341\273\255 d\341\273\245ng v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\'}\\n                    </p>\\n                    {!isLocatingGps && accuracyBadge && (\\n                      <span className=\\\"rounded-full bg-emerald-500/15 px-2 py-0.5 font-sans text-[10px] font-bold tabular-nums text-emerald-700\\\">\\n                        {accuracyBadge}\\n                      </span>\\n                    )}\\n                  </div>\\n                  <p className=\\\"mt-0.5 truncate text-xs text-emerald-700/85\\\">\\n                    {isLocatingGps\\n                      ? \'Thu th\341\272\255p t\303\255n hi\341\273\207u v\341\273\207 tinh c\303\263 sai s\341\273\221 nh\341\273\217 nh\341\272\245t\'\\n                      : activeLocation.isCurrentGPS\\n                        ? activeLocation.address\\n                        : \'\304\220\341\273\213nh v\341\273\213 l\341\272\241i qua GPS c\341\273\247a thi\341\272\277t b\341\273\213\'}\\n                  </p>\\n                </div>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                data-testid=\\\"open-map-pin-picker-btn\\\"\\n                onClick={handlePinOnMapClick}\\n                className=\\\"flex w-full items-center gap-3 rounded-2xl border border-slate-200/80 bg-white px-3.5 py-2 text-left transition-colors hover:border-amber-300 hover:bg-amber-50/40 active:scale-[0.99]\\\"\\n              >\\n                <span className=\\\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-500/15 text-amber-600\\\">\\n                  <MapPin className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />\\n                </span>\\n                <div className=\\\"min-w-0 flex-1\\\">\\n                  <p className=\\\"text-xs font-bold text-slate-900\\\">Ch\341\273\215n tr\341\273\261c ti\341\272\277p tr\303\252n b\341\272\243n \304\221\341\273\223</p>\\n                  <p className=\\\"truncate text-[11px] text-slate-500\\\">K\303\251o ghim t\303\242m b\341\272\243n \304\221\341\273\223 t\341\273\233i ch\303\255nh x\303\241c v\341\273\213 tr\303\255 xe h\341\273\217ng</p>\\n                </div>\\n              </button>\\n            </div>\", \"StartLine\":166, \"TargetContent\":\"            {/* Prominent current GPS quick row */}\\n            <div className=\\\"shrink-0 border-y border-slate-100 px-5 py-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleUseGpsClick}\\n                disabled={isLocatingGps}\\n                className=\\\"flex w-full items-center gap-3 rounded-2xl bg-emerald-50/70 px-3.5 py-2.5 text-left transition-colors hover:bg-emerald-50 active:scale-[0.99] disabled:opacity-70\\\"\\n              >\\n                <span className=\\\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white shadow-sm shadow-emerald-500/30\\\">\\n                  {isLocatingGps ? (\\n                    <Loader2 className=\\\"h-4 w-4 animate-spin\\\" aria-hidden=\\\"true\\\" />\\n                  ) : (\\n                    <LocateFixed className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />\\n                  )}\\n                </span>\\n                <div className=\\\"min-w-0 flex-1\\\">\\n                  <p className=\\\"text-sm font-bold text-emerald-800\\\">\\n                    S\341\273\255 d\341\273\245ng v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\\n                  </p>\\n                  <p className=\\\"truncate text-xs text-emerald-700/80\\\">\\n                    {isLocatingGps\\n                      ? \'\304\220ang l\341\272\245y t\341\273\215a \304\221\341\273\231 GPS th\341\273\261c t\341\272\277...\'\\n                      : activeLocation.isCurrentGPS\\n                        ? activeLocation.address\\n                        : \'\304\220\341\273\213nh v\341\273\213 l\341\272\241i qua GPS c\341\273\247a thi\341\272\277t b\341\273\213\'}\\n                  </p>\\n                </div>\\n              </button>\\n            </div>\"}], \"TargetFile\":\"/src/components/modals/LocationSearchModal.tsx\", \"toolAction\":\"Updating LocationSearchModal with GPS badge and map pin button\", \"toolSummary\":\"Update LocationSearchModal\"}"
