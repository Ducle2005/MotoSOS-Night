      arguments_json: "{\"Description\":\"Add amber Fuel marker creator createGasStationMarkerElement to mapMarkers.ts\", \"Instruction\":\"Import GasStation and add createGasStationMarkerElement right after createRepairShopMarkerElement\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":6, \"ReplacementContent\":\"import type {\\n  GasStation,\\n  RepairShop,\\n  SafeStation,\\n  SafeStationCategory,\\n} from \'../../types/rescue\';\", \"StartLine\":1, \"TargetContent\":\"import type {\\n  RepairShop,\\n  SafeStation,\\n  SafeStationCategory,\\n} from \'../../types/rescue\';\"}, {\"AllowMultiple\":false, \"EndLine\":103, \"ReplacementContent\":\"  button.appendChild(pin);\\n  return button;\\n}\\n\\nexport function createGasStationMarkerElement(\\n  station: GasStation,\\n  isHighlighted: boolean,\\n  onClick: () => void,\\n): HTMLButtonElement {\\n  const button = document.createElement(\'button\');\\n  button.type = \'button\';\\n  button.setAttribute(\'data-testid\', `gas-station-marker-${station.id}`);\\n  button.setAttribute(\\n    \'aria-label\',\\n    `${station.name}, ${station.walkingDistanceMeters}m \302\267 ${station.walkingMinutes} ph\303\272t d\341\272\257t b\341\273\231`,\\n  );\\n  button.setAttribute(\'aria-pressed\', String(isHighlighted));\\n  button.className =\\n    \'group relative flex h-11 w-11 items-center justify-center rounded-full focus:outline-none cursor-pointer\';\\n  button.addEventListener(\'click\', (event) => {\\n    event.stopPropagation();\\n    onClick();\\n  });\\n\\n  const pin = document.createElement(\'span\');\\n  pin.className = isHighlighted\\n    ? \'relative flex items-center justify-center bg-amber-500 text-white rounded-full p-2 border-2 border-white shadow-lg shadow-amber-500/40 ring-4 ring-amber-500/25 scale-110 transition-transform\'\\n    : \'relative flex items-center justify-center bg-amber-500 text-white rounded-full p-2 border-2 border-white shadow-md transition-transform group-hover:scale-110\';\\n  pin.innerHTML = getCategorySvgMarkup(\'gas_station\');\\n\\n  button.appendChild(pin);\\n  return button;\\n}\", \"StartLine\":97, \"TargetContent\":\"  button.appendChild(pin);\\n  return button;\\n}\"}], \"TargetFile\":\"/src/components/map/mapMarkers.ts\", \"toolAction\":\"Adding amber Fuel marker to mapMarkers.ts\", \"toolSummary\":\"Add gas station marker\"}"
