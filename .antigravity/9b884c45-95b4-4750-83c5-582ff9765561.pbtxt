      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add createPoliceStationMarkerElement with indigo Shield badge and G\341\272\247n nh\341\272\245t label\", \"EndLine\":136, \"Instruction\":\"Import PoliceStation type and add createPoliceStationMarkerElement helper\", \"ReplacementContent\":\"import type {\\n  GasStation,\\n  PoliceStation,\\n  RepairShop,\\n  SafeStation,\\n  SafeStationCategory,\\n} from \'../../types/rescue\';\", \"StartLine\":1, \"TargetContent\":\"import type {\\n  GasStation,\\n  RepairShop,\\n  SafeStation,\\n  SafeStationCategory,\\n} from \'../../types/rescue\';\", \"TargetFile\":\"/src/components/map/mapMarkers.ts\", \"toolAction\":\"Importing PoliceStation type in mapMarkers.ts\", \"toolSummary\":\"Police marker import\"}"
