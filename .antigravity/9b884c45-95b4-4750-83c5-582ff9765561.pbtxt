      arguments_json: "{\"Description\":\"Wire LocationSearchModal and activeLocation props into App.tsx\", \"Instruction\":\"Import LocationSearchModal, pass activeLocation/onOpenLocationSearch to HomeTab, and render LocationSearchModal inside the 430px phone container\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":8, \"ReplacementContent\":\"import { BottomNavBar } from \'./components/BottomNavBar\';\\nimport { LocationSearchModal } from \'./components/modals/LocationSearchModal\';\\nimport { ActivityTab } from \'./components/tabs/ActivityTab\';\", \"StartLine\":1, \"TargetContent\":\"import { BottomNavBar } from \'./components/BottomNavBar\';\\nimport { ActivityTab } from \'./components/tabs/ActivityTab\';\"}, {\"AllowMultiple\":false, \"EndLine\":39, \"ReplacementContent\":\"          {s.activeTab === \'home\' && (\\n            <HomeTab\\n              activeLocation={s.geo.activeLocation}\\n              userLocation={s.geo.userLocation}\\n              stations={s.geo.stations}\\n              isLoadingStations={s.geo.isLoadingStations}\\n              openRepairShops={s.repairShops.openRepairShops}\\n              isLoadingShops={s.repairShops.isLoadingShops}\\n              onOpenLocationSearch={() => s.setIsLocationSearchOpen(true)}\\n              onCallMechanicNow={() => {\", \"StartLine\":16, \"TargetContent\":\"          {s.activeTab === \'home\' && (\\n            <HomeTab\\n              userLocation={s.geo.userLocation}\\n              stations={s.geo.stations}\\n              isLoadingStations={s.geo.isLoadingStations}\\n              openRepairShops={s.repairShops.openRepairShops}\\n              isLoadingShops={s.repairShops.isLoadingShops}\\n              onCallMechanicNow={() => {\"}, {\"AllowMultiple\":false, \"EndLine\":143, \"ReplacementContent\":\"        <BottomNavBar\\n          activeTab={s.activeTab}\\n          hasActiveOrder={s.step === \'tracking\'}\\n          onSelectTab={s.setActiveTab}\\n        />\\n\\n        <LocationSearchModal\\n          isOpen={s.isLocationSearchOpen}\\n          activeLocation={s.geo.activeLocation}\\n          isLocatingGps={s.geo.isLocatingGps}\\n          onSelectSuggestion={s.handleSelectSearchLocation}\\n          onUseCurrentGps={s.handleResetToGpsLocation}\\n          onClose={() => s.setIsLocationSearchOpen(false)}\\n        />\\n      </div>\\n    </div>\\n  );\\n}\", \"StartLine\":132, \"TargetContent\":\"        <BottomNavBar\\n          activeTab={s.activeTab}\\n          hasActiveOrder={s.step === \'tracking\'}\\n          onSelectTab={s.setActiveTab}\\n        />\\n      </div>\\n    </div>\\n  );\\n}\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring LocationSearchModal in App.tsx\", \"toolSummary\":\"Update App.tsx\"}"
