        instruction: "import type { IssueType, PickupMode, VoucherId } from \'../types/rescue\';\n\nexport interface CampaignBannerItem {\n  id: string;\n  tag: string;\n  tagTone: \'gold\' | \'emerald\' | \'amber\' | \'glass\';\n  title: string;\n  ctaLabel: string;\n  imageUrl: string;\n  fallbackGradient: string;\n  voucherId: VoucherId | null;\n  targetIssue?: IssueType;\n  targetPickupMode?: PickupMode;\n  targetStep: \'issue\' | \'pickup\';\n}\n\nexport interface PartnerPerkItem {\n  id: string;\n  title: string;\n  description: string;\n  imageUrl: string;\n  fallbackGradient: string;\n  voucherId: VoucherId | null;\n  targetPickupMode?: PickupMode;\n}\n\nexport const CAMPAIGN_BANNERS: CampaignBannerItem[] = [\n  {\n    id: \'night-safe-station\',\n    tag: \'\304\220\341\273\230C QUY\341\273\200N BAN \304\220\303\212M\',\n    tagTone: \'gold\',\n    title: \'Gi\341\272\243m 20.000\304\221 khi ch\341\273\235 th\341\273\243 t\341\272\241i Tr\341\272\241m An To\303\240n\',\n    ctaLabel: \'\303\201p d\341\273\245ng ngay\',\n    imageUrl: \'https://images.unsplash.com/photo-1514924013411-cbf25faa35bb?auto=format&fit=crop&w=800&q=80\',\n    fallbackGradient: \'from-slate-900 via-slate-800 to-amber-950\',\n    voucherId: \'ANTOAN20\',\n    targetPickupMode: \'safe_station\',\n    targetStep: \'issue\',\n  },\n  {\n    id: \'new-member-25k\',\n    tag: \'TH\303\200NH VI\303\212N M\341\273\232I\',\n    tagTone: \'emerald\',\n    title: \'T\341\272\267ng 25.000\304\221 cho l\341\272\247n c\341\273\251u h\341\273\231 \304\221\341\272\247u ti\303\252n\',\n    ctaLabel: \'Nh\341\272\255n \306\260u \304\221\303\243i\',\n    imageUrl: \'https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=800&q=80\',\n    fallbackGradient: \'from-slate-950 via-emerald-950 to-slate-900\',\n    voucherId: \'BANMOI25\',\n    targetStep: \'issue\',\n  },\n  {\n    id: \'fuel-rescue-night\',\n    tag: \'C\341\273\250U H\341\273\230 H\341\272\276T X\304\202NG\',\n    tagTone: \'amber\',\n    title: \'Giao 2L x\304\203ng RON 95 t\341\272\255n n\306\241i ch\341\273\211 t\341\273\253 65.000\304\221\',\n    ctaLabel: \'G\341\273\215i ngay\',\n    imageUrl: \'https://images.unsplash.com/photo-1565610222536-ef125c59da2e?auto=format&fit=crop&w=800&q=80\',\n    fallbackGradient: \'from-slate-950 via-orange-950 to-slate-900\',\n    voucherId: \'DEMKHUYA15\',\n    targetIssue: \'out_of_fuel\',\n    targetPickupMode: \'current_location\',\n    targetStep: \'pickup\',\n  },\n  {\n    id: \'verified-fixed-price\',\n    tag: \'AN T\303\202M TUY\341\273\206T \304\220\341\273\220I\',\n    tagTone: \'glass\',\n    title: \'100% Th\341\273\243 x\303\241c minh danh t\303\255nh & B\303\241o gi\303\241 c\341\273\221 \304\221\341\273\213nh\',\n    ctaLabel: \'Xem b\341\272\243ng gi\303\241\',\n    imageUrl: \'https://images.unsplash.com/photo-1604719312566-8912e9227c6a?auto=format&fit=crop&w=800&q=80\',\n    fallbackGradient: \'from-slate-900 via-slate-800 to-slate-950\',\n    voucherId: null,\n    targetStep: \'issue\',\n  },\n];\n\nexport const PARTNER_PERKS: PartnerPerkItem[] = [\n  {\n    id: \'perk-circle-k\',\n    title: \'Circle K x MotoSOS\',\n    description: \'Ch\341\273\235 th\341\273\243 t\341\272\241i c\341\273\255a h\303\240ng ti\341\273\207n l\341\273\243i, nh\341\272\255n ngay \306\260u \304\221\303\243i gi\341\272\243m 20k.\',\n    imageUrl: \'https://images.unsplash.com/photo-1604719312566-8912e9227c6a?auto=format&fit=crop&w=600&q=80\',\n    fallbackGradient: \'from-emerald-900 to-slate-900\',\n    voucherId: \'ANTOAN20\',\n    targetPickupMode: \'safe_station\',\n  },\n  {\n    id: \'perk-night-check\',\n    title: \'\304\220\341\272\267c quy\341\273\201n C\341\273\251u H\341\273\231 \304\220\303\252m\',\n    description: \'Mi\341\273\205n ph\303\255 ki\341\273\203m tra \303\241p su\341\272\245t l\341\273\221p & b\303\254nh \341\272\257c quy t\341\272\255n n\306\241i.\',\n    imageUrl: \'https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=600&q=80\',\n    fallbackGradient: \'from-slate-800 to-slate-950\',\n    voucherId: \'BANMOI25\',\n  },\n  {\n    id: \'perk-long-road\',\n    title: \'G\303\263i An T\303\242m \304\220\306\260\341\273\235ng D\303\240i\',\n    description: \'Gi\341\272\243m 15k m\341\273\215i khung gi\341\273\235 t\341\273\253 22h00 \342\200\223 05h00.\',\n    imageUrl: \'https://images.unsplash.com/photo-1514924013411-cbf25faa35bb?auto=format&fit=crop&w=600&q=80\',\n    fallbackGradient: \'from-amber-900 to-slate-950\',\n    voucherId: \'DEMKHUYA15\',\n  },\n];\n"
