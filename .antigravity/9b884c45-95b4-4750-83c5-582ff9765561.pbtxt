      arguments_json: "{\"Description\":\"Wire FloatingPushBanner, NotificationCenterModal, Bell trigger, and MapTabView notification callbacks in App.tsx\", \"Instruction\":\"Import notification components/context, render FloatingPushBanner and NotificationCenterModal inside the 430px shell, pass Bell & voucher/approaching callbacks\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":12, \"ReplacementContent\":\"import { useState } from \'react\';\\nimport { BottomNavBar } from \'./components/BottomNavBar\';\\nimport { LocationSearchModal } from \'./components/modals/LocationSearchModal\';\\nimport { FloatingPushBanner } from \'./components/notifications/FloatingPushBanner\';\\nimport { NotificationCenterModal } from \'./components/notifications/NotificationCenterModal\';\\nimport { ActivityTab } from \'./components/tabs/ActivityTab\';\\nimport { HomeTab } from \'./components/tabs/HomeTab\';\\nimport { MapTabView } from \'./components/tabs/MapTabView\';\\nimport { SafetyTab } from \'./components/tabs/SafetyTab\';\\nimport { useNotifications } from \'./context/NotificationContext\';\\nimport { MOCK_MECHANIC } from \'./data/mockRescueData\';\\nimport { useRescueOrderState } from \'./hooks/useRescueOrderState\';\\nimport type { AppNotification } from \'./types/notification\';\\n\\nexport default function App() {\\n  const s = useRescueOrderState();\\n  const notif = useNotifications();\\n  const [isNotificationCenterOpen, setIsNotificationCenterOpen] = useState(false);\\n\\n  const handleOpenNotificationItem = (item: AppNotification) => {\\n    notif.markAsRead(item.id);\\n    notif.dismissBanner();\\n    setIsNotificationCenterOpen(false);\\n    s.setActiveTab(item.targetTab);\\n  };\", \"StartLine\":1, \"TargetContent\":\"import { BottomNavBar } from \'./components/BottomNavBar\';\\nimport { LocationSearchModal } from \'./components/modals/LocationSearchModal\';\\nimport { ActivityTab } from \'./components/tabs/ActivityTab\';\\nimport { HomeTab } from \'./components/tabs/HomeTab\';\\nimport { MapTabView } from \'./components/tabs/MapTabView\';\\nimport { SafetyTab } from \'./components/tabs/SafetyTab\';\\nimport { MOCK_MECHANIC } from \'./data/mockRescueData\';\\nimport { useRescueOrderState } from \'./hooks/useRescueOrderState\';\\n\\nexport default function App() {\\n  const s = useRescueOrderState();\"}, {\"AllowMultiple\":false, \"EndLine\":42, \"ReplacementContent\":\"              onSelectCampaignBanner={s.handleSelectCampaignBanner}\\n              onSelectPartnerPerk={s.handleSelectPartnerPerk}\\n              onOpenNotifications={() => setIsNotificationCenterOpen(true)}\\n            />\\n          )}\", \"StartLine\":38, \"TargetContent\":\"              onSelectCampaignBanner={s.handleSelectCampaignBanner}\\n              onSelectPartnerPerk={s.handleSelectPartnerPerk}\\n            />\\n          )}\"}, {\"AllowMultiple\":false, \"EndLine\":103, \"ReplacementContent\":\"                onSelectVoucher={s.handleSelectVoucher}\\n                onEtaMinuteChange={s.mechanicSim.setLiveEtaMinutes}\\n                onMechanicApproaching={s.handleMechanicApproaching}\\n                onMechanicArrived={s.handleMechanicArrived}\", \"StartLine\":98, \"TargetContent\":\"                onSelectVoucher={s.setSelectedVoucherId}\\n                onEtaMinuteChange={s.mechanicSim.setLiveEtaMinutes}\\n                onMechanicArrived={s.handleMechanicArrived}\"}, {\"AllowMultiple\":false, \"EndLine\":182, \"ReplacementContent\":\"        <LocationSearchModal\\n          isOpen={s.isLocationSearchOpen}\\n          activeLocation={s.geo.activeLocation}\\n          isLocatingGps={s.geo.isLocatingGps}\\n          onSelectSuggestion={s.handleSelectSearchLocation}\\n          onUseCurrentGps={s.handleResetToGpsLocation}\\n          onStartMapPinPicker={s.handleStartMapPinPicker}\\n          onClose={() => s.setIsLocationSearchOpen(false)}\\n        />\\n\\n        <FloatingPushBanner\\n          banner={notif.activeBanner}\\n          onDismiss={notif.dismissBanner}\\n          onSelect={handleOpenNotificationItem}\\n        />\\n\\n        <NotificationCenterModal\\n          isOpen={isNotificationCenterOpen}\\n          notifications={notif.notifications}\\n          unreadCount={notif.unreadCount}\\n          permission={notif.permission}\\n          isDevicePushEnabled={notif.isDevicePushEnabled}\\n          onToggleDevicePush={() => void notif.toggleDevicePush()}\\n          onMarkAllRead={notif.markAllAsRead}\\n          onSelectNotification={handleOpenNotificationItem}\\n          onClose={() => setIsNotificationCenterOpen(false)}\\n        />\\n      </div>\\n    </div>\\n  );\\n}\", \"StartLine\":169, \"TargetContent\":\"        <LocationSearchModal\\n          isOpen={s.isLocationSearchOpen}\\n          activeLocation={s.geo.activeLocation}\\n          isLocatingGps={s.geo.isLocatingGps}\\n          onSelectSuggestion={s.handleSelectSearchLocation}\\n          onUseCurrentGps={s.handleResetToGpsLocation}\\n          onStartMapPinPicker={s.handleStartMapPinPicker}\\n          onClose={() => s.setIsLocationSearchOpen(false)}\\n        />\\n      </div>\\n    </div>\\n  );\\n}\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring notification UI into App.tsx\", \"toolSummary\":\"Wire notification UI in App.tsx\"}"
      original_name: "multi_replace_file_content"
