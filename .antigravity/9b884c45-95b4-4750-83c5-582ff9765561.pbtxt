      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add amber-orange gas-route casing and line layers to MapLibre style setup\", \"EndLine\":117, \"Instruction\":\"Add gas-route source and casing/line layers right after shop-route layers in ensureRescueRouteLayers\", \"ReplacementContent\":\"  if (!map.getLayer(\'shop-route-line\')) {\\n    map.addLayer({\\n      id: \'shop-route-line\',\\n      type: \'line\',\\n      source: \'shop-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#2563eb\',\\n        \'line-width\': 4.5,\\n        \'line-opacity\': 1,\\n      },\\n    });\\n  }\\n\\n  if (!map.getSource(\'gas-route\')) {\\n    map.addSource(\'gas-route\', {\\n      type: \'geojson\',\\n      data: EMPTY_FEATURE_COLLECTION,\\n    });\\n  }\\n\\n  if (!map.getLayer(\'gas-route-casing\')) {\\n    map.addLayer({\\n      id: \'gas-route-casing\',\\n      type: \'line\',\\n      source: \'gas-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#ffffff\',\\n        \'line-width\': 7,\\n        \'line-opacity\': 0.95,\\n      },\\n    });\\n  }\\n\\n  if (!map.getLayer(\'gas-route-line\')) {\\n    map.addLayer({\\n      id: \'gas-route-line\',\\n      type: \'line\',\\n      source: \'gas-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#ea580c\',\\n        \'line-width\': 4.5,\\n        \'line-opacity\': 1,\\n      },\\n    });\\n  }\\n}\", \"StartLine\":99, \"TargetContent\":\"  if (!map.getLayer(\'shop-route-line\')) {\\n    map.addLayer({\\n      id: \'shop-route-line\',\\n      type: \'line\',\\n      source: \'shop-route\',\\n      layout: { \'line-join\': \'round\', \'line-cap\': \'round\' },\\n      paint: {\\n        \'line-color\': \'#2563eb\',\\n        \'line-width\': 4.5,\\n        \'line-opacity\': 1,\\n      },\\n    });\