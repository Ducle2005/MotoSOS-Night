  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  CheckCircle2,\n  Clock,\n  Loader2,\n  MapPin,\n  Phone,\n  ShieldCheck,\n  Star,\n  Wrench,\n} from \'lucide-react\';\nimport { useState } from \'react\';\nimport type { MechanicInfo, TrackingStatus } from \'../../types/rescue\';\n\ninterface TrackingStepProps {\n  status: TrackingStatus;\n  issueSummary: string;\n  pickupTitle: string;\n  pickupAddress: string;\n  mechanic: MechanicInfo;\n  onCancelOrder: () => void;\n  onCompleteReset: () => void;\n}\n\nexport function TrackingStep({\n  status,\n  issueSummary,\n  pickupTitle,\n  pickupAddress,\n  mechanic,\n  onCancelOrder,\n  onCompleteReset,\n}: TrackingStepProps) {\n  const [callFeedback, setCallFeedback] = useState(false);\n\n  if (status === \'searching\') {\n    return (\n      <div className=\"flex flex-col gap-4\" data-testid=\"tracking-searching\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-500/15 text-amber-400\">\n            <Loader2 className=\"h-5 w-5 animate-spin\" aria-hidden=\"true\" />\n          </div>\n          <div>\n            <h1 className=\"text-lg font-bold tracking-tight text-slate-50\">\n              \304\220ang t\303\254m th\341\273\243 g\341\272\247n b\341\272\241n...\n            </h1>\n            <p className=\"text-xs text-slate-400\">\n              \304\220ang k\341\272\277t n\341\273\221i \304\221\341\273\231i c\341\273\251u h\341\273\231 tr\341\273\261c \304\221\303\252m trong b\303\241n k\303\255nh 3km\n            </p>\n          </div>\n        </div>\n\n        {/* Loading skeleton preview for mechanic */}\n        <div className=\"rounded-2xl border border-slate-800 bg-slate-950/70 p-4\" aria-hidden=\"true\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"h-11 w-11 rounded-full bg-slate-800 animate-pulse\" />\n            <div className=\"flex-1 space-y-2\">\n              <div className=\"h-3.5 w-2/3 rounded bg-slate-800 animate-pulse\" />\n              <div className=\"h-3 w-1/2 rounded bg-slate-800/70 animate-pulse\" />\n            </div>\n          </div>\n        </div>\n\n        <div className=\"space-y-2 rounded-2xl border border-slate-800 bg-slate-950/50 p-3.5 text-sm\">\n          <div className=\"flex items-center justify-between gap-2\">\n            <span className=\"text-slate-400\">S\341\273\261 c\341\273\221</span>\n            <span className=\"font-semibold text-slate-100\">{issueSummary}</span>\n          </div>\n          <div className=\"flex items-start justify-between gap-3 border-t border-slate-800/80 pt-2\">\n            <span className=\"shrink-0 text-slate-400\">\304\220i\341\273\203m \304\221\303\263n</span>\n            <span className=\"text-right font-medium text-slate-200\">\n              {pickupTitle} \302\267 {pickupAddress}\n            </span>\n          </div>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={onCancelOrder}\n          className=\"min-h-[48px] w-full rounded-xl border border-slate-800 bg-slate-950 px-4 text-sm font-semibold text-slate-300 transition-colors hover:border-rose-500/40 hover:bg-rose-950/30 hover:text-rose-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400\"\n        >\n          H\341\273\247y y\303\252u c\341\272\247u c\341\273\251u h\341\273\231\n        </button>\n      </div>\n    );\n  }\n\n  if (status === \'accepted\') {\n    return (\n      <div className=\"flex flex-col gap-4\" data-testid=\"tracking-accepted\">\n        <div className=\"flex items-start justify-between gap-3\">\n          <div>\n            <p className=\"text-xs font-semibold text-emerald-400\">\n              Th\341\273\243 \304\221\303\243 nh\341\272\255n \304\221\306\241n \302\267 \304\220ang di chuy\341\273\203n t\341\273\233i b\341\272\241n\n            </p>\n            <h1 className=\"mt-0.5 text-lg font-bold tracking-tight text-slate-50\">\n              D\341\273\261 ki\341\272\277n t\341\273\233i sau {mechanic.etaMinutes} ph\303\272t\n            </h1>\n          </div>\n          <div className=\"flex shrink-0 items-center gap-1.5 rounded-xl border border-amber-500/30 bg-amber-500/15 px-3 py-1.5 text-amber-300\">\n            <Clock className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span className=\"font-mono text-sm font-bold tabular-nums\">\n              {mechanic.etaMinutes}p\n            </span>\n          </div>\n        </div>\n\n        {/* Mechanic Info Card */}\n        <div className=\"rounded-2xl border border-slate-800 bg-slate-950/75 p-4\">\n          <div className=\"flex items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-3 min-w-0\">\n              <div className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-500/15 text-amber-400 border border-amber-500/30\">\n                <Wrench className=\"h-5 w-5\" aria-hidden=\"true\" />\n              </div>\n              <div className=\"min-w-0\">\n                <h2 className=\"truncate text-base font-bold text-slate-100\">\n                  {mechanic.name}\n                </h2>\n                <p className=\"mt-0.5 flex items-center gap-1.5 text-xs text-slate-400\">\n                  <Star className=\"h-3.5 w-3.5 fill-amber-400 text-amber-400\" aria-hidden=\"true\" />\n                  <span className=\"font-mono tabular-nums text-slate-200\">\n                    {mechanic.rating}\n                  </span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-mono tabular-nums\">\n                    {mechanic.completedRescues} ca c\341\273\251u h\341\273\231\n                  </span>\n                </p>\n              </div>\n            </div>\n\n            <div className=\"text-right shrink-0\">\n              <p className=\"text-[11px] text-slate-400\">Bi\341\273\203n s\341\273\221 xe</p>\n              <p className=\"mt-0.5 font-mono text-sm font-bold tabular-nums text-amber-300\">\n                {mechanic.licensePlate}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"mt-3 border-t border-slate-800/80 pt-3 text-xs text-slate-300\">\n            <p className=\"truncate\">{mechanic.vehicleModel}</p>\n            <p className=\"mt-1 flex items-center gap-1.5 text-slate-400\">\n              <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-400\" aria-hidden=\"true\" />\n              <span className=\"truncate\">\n                \304\220i\341\273\203m h\341\272\271n: {pickupTitle} ({pickupAddress})\n              </span>\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2.5\">\n          <button\n            type=\"button\"\n            onClick={() => setCallFeedback(true)}\n            className=\"inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 text-sm font-bold text-slate-950 transition-colors hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 active:scale-[0.98]\"\n          >\n            <Phone className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>\n              {callFeedback\n                ? `\304\220ang g\341\273\215i ${mechanic.phone}...`\n                : `G\341\273\215i th\341\273\243 (${mechanic.phone})`}\n            </span>\n          </button>\n        </div>\n\n        <p className=\"flex items-center justify-center gap-1.5 text-xs text-slate-400\">\n          <ShieldCheck className=\"h-3.5 w-3.5 text-emerald-400\" aria-hidden=\"true\" />\n          <span>S\341\273\261 c\341\273\221: {issueSummary} \302\267 B\303\241o gi\303\241 minh b\341\272\241ch tr\306\260\341\273\233c khi s\341\273\255a</span>\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex flex-col gap-4\" data-testid=\"tracking-completed\">\n      <div className=\"flex items-center gap-3\">\n        <div className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-500/15 text-emerald-400 border border-emerald-500/30\">\n          <CheckCircle2 className=\"h-6 w-6\" aria-hidden=\"true\" />\n        </div>\n        <div>\n          <p className=\"text-xs font-semibold text-emerald-400\">\n            C\341\273\251u h\341\273\231 ho\303\240n t\341\272\245t\n          </p>\n          <h1 className=\"text-lg font-bold tracking-tight text-slate-50\">\n            Xe b\341\272\241n \304\221\303\243 an to\303\240n l\304\203n b\303\241nh!\n          </h1>\n        </div>\n      </div>\n\n      <div className=\"space-y-2 rounded-2xl border border-slate-800 bg-slate-950/60 p-4 text-sm\">\n        <div className=\"flex items-center justify-between gap-2\">\n          <span className=\"text-slate-400\">Th\341\273\243 ph\341\273\245 tr\303\241ch</span>\n          <span className=\"font-semibold text-slate-100\">\n            {mechanic.name} \302\267 <span className=\"font-mono text-amber-300\">{mechanic.licensePlate}</span>\n          </span>\n        </div>\n        <div className=\"flex items-center justify-between gap-2 border-t border-slate-800/80 pt-2\">\n          <span className=\"text-slate-400\">S\341\273\261 c\341\273\221 \304\221\303\243 x\341\273\255 l\303\275</span>\n          <span className=\"font-semibold text-slate-100\">{issueSummary}</span>\n        </div>\n        <div className=\"flex items-start justify-between gap-3 border-t border-slate-800/80 pt-2\">\n          <span className=\"shrink-0 text-slate-400\">\304\220i\341\273\203m \304\221\303\263n</span>\n          <span className=\"text-right text-slate-200\">{pickupAddress}</span>\n        </div>\n      </div>\n\n      <button\n        type=\"button\"\n        onClick={onCompleteReset}\n        className=\"min-h-[50px] w-full rounded-xl bg-amber-500 px-5 text-sm font-extrabold text-slate-950 transition-colors hover:bg-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 active:scale-[0.98]\"\n      >\n        V\341\273\201 m\303\240n h\303\254nh ch\303\255nh\n      </button>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/steps/TrackingStep.tsx"
        }
        overwrite: true
      }
    }
