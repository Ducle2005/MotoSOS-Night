  code_action {
    action_spec {
      create_file {
        instruction: "import test from \'node:test\';\nimport assert from \'node:assert/strict\';\nimport {\n  ISSUE_OPTIONS,\n  MOCK_SAFE_STATIONS,\n  MOCK_USER_LOCATION,\n} from \'../data/mockRescueData\';\nimport {\n  computeRouteMidpoint,\n  formatWalkingDistance,\n  getIssueLabel,\n  getNearestSafeStation,\n  getNextDemoTrackingStatus,\n  interpolatePoint,\n  resolvePickupTarget,\n} from \'./rescueLogic\';\n\ntest(\'getNearestSafeStation returns the closest station by walking meters\', () => {\n  const nearest = getNearestSafeStation(MOCK_SAFE_STATIONS);\n  assert.ok(nearest);\n  assert.equal(nearest.id, \'station-circle-k\');\n  assert.equal(nearest.walkingDistanceMeters, 160);\n});\n\ntest(\'resolvePickupTarget returns user current location when mode is current_location\', () => {\n  const result = resolvePickupTarget(\n    \'current_location\',\n    MOCK_USER_LOCATION,\n    MOCK_SAFE_STATIONS,\n    \'station-police\',\n  );\n  assert.equal(result.address, MOCK_USER_LOCATION.address);\n  assert.equal(result.station, null);\n  assert.deepEqual(result.point, MOCK_USER_LOCATION.position);\n});\n\ntest(\'resolvePickupTarget updates pickup address to selected Safe Station automatically\', () => {\n  const result = resolvePickupTarget(\n    \'safe_station\',\n    MOCK_USER_LOCATION,\n    MOCK_SAFE_STATIONS,\n    \'station-police\',\n  );\n  assert.equal(result.title, \'C\303\264ng an Ph\306\260\341\273\235ng 25\');\n  assert.equal(result.address, \'118 Ung V\304\203n Khi\303\252m, P.25, B\303\254nh Th\341\272\241nh\');\n  assert.equal(result.station?.id, \'station-police\');\n});\n\ntest(\'resolvePickupTarget falls back to nearest station when safe_station selected without id\', () => {\n  const result = resolvePickupTarget(\n    \'safe_station\',\n    MOCK_USER_LOCATION,\n    MOCK_SAFE_STATIONS,\n    null,\n  );\n  assert.equal(result.station?.id, \'station-circle-k\');\n});\n\ntest(\'getNextDemoTrackingStatus advances searching -> accepted -> completed\', () => {\n  assert.equal(getNextDemoTrackingStatus(\'searching\'), \'accepted\');\n  assert.equal(getNextDemoTrackingStatus(\'accepted\'), \'completed\');\n  assert.equal(getNextDemoTrackingStatus(\'completed\'), \'completed\');\n});\n\ntest(\'formatWalkingDistance formats meters and minutes cleanly\', () => {\n  assert.equal(formatWalkingDistance(160, 2), \'160m \302\267 2 ph\303\272t \304\221i b\341\273\231\');\n  assert.equal(formatWalkingDistance(0, 0), \'0m \302\267 1 ph\303\272t \304\221i b\341\273\231\');\n});\n\ntest(\'getIssueLabel handles custom note for other issue\', () => {\n  assert.equal(getIssueLabel(\'flat_tire\', ISSUE_OPTIONS), \'L\341\273\247ng l\341\273\221p\');\n  assert.equal(\n    getIssueLabel(\'other\', ISSUE_OPTIONS, \'\304\220\341\273\251t d\303\242y curoa\'),\n    \'S\341\273\261 c\341\273\221 kh\303\241c (\304\220\341\273\251t d\303\242y curoa)\',\n  );\n});\n\ntest(\'interpolatePoint clamps progress between 0 and 1 and computeRouteMidpoint returns valid coords\', () => {\n  const start = { x: 10, y: 20 };\n  const end = { x: 50, y: 60 };\n  assert.deepEqual(interpolatePoint(start, end, 0.5), { x: 30, y: 40 });\n  assert.deepEqual(interpolatePoint(start, end, 2), end);\n  const mid = computeRouteMidpoint(start, end);\n  assert.ok(Number.isFinite(mid.x) && Number.isFinite(mid.y));\n});\n"
        path {
          absolute_uri: "file:///src/utils/rescueLogic.test.ts"
        }
        overwrite: true
      }
    }
