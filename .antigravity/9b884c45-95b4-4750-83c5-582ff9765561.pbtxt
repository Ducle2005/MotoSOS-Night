        replacement_chunks {
          target_content: "  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    setRouteSourceGeometry(map, \'walking-route\', walkingRoute);\n    if (!walkingRoute || step === \'tracking\') return;\n\n    const bounds = computeBoundsBox(walkingRoute.coordinates);\n    if (bounds) {\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.5, 600);\n    }\n  }, [walkingRoute, step, mapReady]);\n\n  return (\n    <section\n      aria-label=\"B\341\272\243n \304\221\341\273\223 th\341\273\261c t\341\272\277 khu v\341\273\261c, Tr\341\272\241m An To\303\240n v\303\240 Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237\"\n      data-testid=\"rescue-map-canvas\"\n      className=\"relative h-full w-full bg-slate-100\"\n    >\n      <div ref={containerRef} className=\"h-full w-full\" />\n\n      {inspectedStation && step === \'idle\' && !selectedShopId && (\n        <div className=\"pointer-events-none absolute inset-x-0 top-28 z-20 px-4\">\n          <div className=\"pointer-events-auto relative mx-auto max-w-md lg:mx-0\">\n            <StationPreviewCard\n              station={inspectedStation}\n              onClose={() => onInspectStation(null)}\n            />\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}"
          replacement_content: "  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n    setAccuracyCircleGeoJson(map, userLocation.coord, userLocation.accuracyMeters);\n  }, [userLocation.coord.lat, userLocation.coord.lng, userLocation.accuracyMeters, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady || !isPinPickerMode) return;\n\n    const handleMoveStart = () => onPinMoveStart?.();\n    const handleMoveEnd = () => {\n      const el = containerRef.current;\n      const point = el\n        ? map.unproject([el.clientWidth / 2, el.clientHeight * 0.33])\n        : map.getCenter();\n      onPinMoveEnd?.({ lat: point.lat, lng: point.lng });\n    };\n\n    map.on(\'movestart\', handleMoveStart);\n    map.on(\'moveend\', handleMoveEnd);\n    return () => {\n      map.off(\'movestart\', handleMoveStart);\n      map.off(\'moveend\', handleMoveEnd);\n    };\n  }, [mapReady, isPinPickerMode, onPinMoveStart, onPinMoveEnd]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n\n    setRouteSourceGeometry(map, \'walking-route\', walkingRoute);\n    if (!walkingRoute || step === \'tracking\') return;\n\n    const bounds = computeBoundsBox(walkingRoute.coordinates);\n    if (bounds) {\n      fitMapBoundsSafely(map, containerRef.current, bounds, 16.5, 600);\n    }\n  }, [walkingRoute, step, mapReady]);\n\n  return (\n    <section\n      aria-label=\"B\341\272\243n \304\221\341\273\223 th\341\273\261c t\341\272\277 khu v\341\273\261c, Tr\341\272\241m An To\303\240n v\303\240 Ti\341\273\207m s\341\273\255a xe \304\221ang m\341\273\237\"\n      data-testid=\"rescue-map-canvas\"\n      className=\"relative h-full w-full bg-slate-100\"\n    >\n      <div ref={containerRef} className=\"h-full w-full\" />\n\n      {isPinPickerMode && <CenterPinOverlay isDragging={isPinDragging} />}\n\n      {inspectedStation && step === \'idle\' && !selectedShopId && !isPinPickerMode && (\n        <div className=\"pointer-events-none absolute inset-x-0 top-28 z-20 px-4\">\n          <div className=\"pointer-events-auto relative mx-auto max-w-md lg:mx-0\">\n            <StationPreviewCard\n              station={inspectedStation}\n              onClose={() => onInspectStation(null)}\n            />\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}"
