    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "export async function fetchWalkingRoute(\n  fromCoord: GeoCoord,\n  toCoord: GeoCoord,\n  signal?: AbortSignal,\n): Promise<{\n  geometry: GeoJsonLineString;\n  distanceMeters: number;\n  durationMinutes: number;\n  source: \'osrm\' | \'fallback\';\n}> {\n  const url = `https://router.project-osrm.org/route/v1/foot/${fromCoord.lng},${fromCoord.lat};${toCoord.lng},${toCoord.lat}?overview=full&geometries=geojson`;\n\n  try {\n    const response = await fetch(url, { signal });\n    if (response.ok) {\n      const data = (await response.json()) as {\n        routes?: Array<{\n          geometry?: GeoJsonLineString;\n          distance?: number;\n          duration?: number;\n        }>;\n      };\n      const firstRoute = data.routes?.[0];\n      if (\n        firstRoute?.geometry?.type === \'LineString\' &&\n        Array.isArray(firstRoute.geometry.coordinates) &&\n        firstRoute.geometry.coordinates.length >= 2\n      ) {\n        const dist = Math.round(firstRoute.distance ?? 0);\n        const mins = estimateWalkingMinutes(dist);\n        return {\n          geometry: firstRoute.geometry,\n          distanceMeters: dist,\n          durationMinutes: mins,\n          source: \'osrm\',\n        };\n      }\n    }\n  } catch {\n    // Fallback to direct segment below\n  }\n\n  const fallbackDist = computeHaversineMeters(fromCoord, toCoord);\n  return {\n    geometry: {\n      type: \'LineString\',\n      coordinates: [\n        [fromCoord.lng, fromCoord.lat],\n        [toCoord.lng, toCoord.lat],\n      ],\n    },\n    distanceMeters: fallbackDist,\n    durationMinutes: estimateWalkingMinutes(fallbackDist),\n    source: \'fallback\',\n  };\n}"
        replacement_content: "export {\n  fetchMechanicDrivingRoute,\n  fetchWalkingRoute,\n  type RouteFetchResult,\n} from \'./osrmApi\';"
        start_line: 154
        end_line: 210
      }
      num_matches: 1
    }
    description: "Re-export OSRM route helpers from osrmApi so mapApi stays concise and backward-compatible"
    diff_stats {
      additions: 5
      deletions: 56
    }
  }
