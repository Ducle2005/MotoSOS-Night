41 t\341\272\241i ch\341\273\227\',\n    fixedPrice: 50000,\n  },\n];\n\nexport const VOUCHER_OPTIONS: VoucherOption[] = [\n  {\n    id: \'ANTOAN20\',\n    code: \'ANTOAN20\',\n    title: \'Gi\341\272\243m 20.000\304\221\',\n    description: \'\303\201p d\341\273\245ng khi ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 t\341\272\241i Tr\341\272\241m An To\303\240n 24/7\',\n    discountAmount: 20000,\n    requiresSafeStation: true,\n  },\n  {\n    id: \'DEMKHUYA15\',\n    code: \'DEMKHUYA15\',\n    title: \'Gi\341\272\243m 15.000\304\221\',\n    description: \'\303\201p d\341\273\245ng cho m\341\273\215i \304\221\306\241n c\341\273\251u h\341\273\231 \304\221\303\252m\',\n    discountAmount: 15000,\n    requiresSafeStation: false,\n  },\n  {\n    id: \'BANMOI25\',\n    code: \'BANMOI25\',\n    title: \'Gi\341\272\243m 25.000\304\221\',\n    description: \'\306\257u \304\221\303\243i th\303\240nh vi\303\252n m\341\273\233i MotoSOS\',\n    discountAmount: 25000,\n    requiresSafeStation: false,\n  },\n];\n\nexport const QUICK_CHAT_SUGGESTIONS: string[] = [\n  \'M\303\254nh \304\221ang \304\221\341\273\251ng \341\273\237 Tr\341\272\241m An To\303\240n s\303\241ng \304\221\303\250n\',\n  \'Xe m\303\254nh d\341\273\261ng ngay tr\306\260\341\273\233c c\341\273\255a\',\n  \'B\341\272\241n ch\341\272\241y t\341\273\233i g\341\272\247n ch\306\260a?\',\n];\n\nexport const MOCK_MECHANIC: MechanicInfo = {\n  id: \'mech-nguyen-minh-tuan\',\n  name: \'Nguy\341\273\205n Minh Tu\341\272\245n\',\n  phone: \'0909 888 999\',\n  licensePlate: \'59-P2 842.19\',\n  vehicleModel: \'Honda Winner X \302\267 \304\220\341\273\223 ngh\341\273\201 \304\221\341\272\247y \304\221\341\273\247\',\n  rating: 4.9,\n  completedRescues: 318,\n  etaMinutes: 6,\n  distanceKm: 1.3,\n  coord: { lat: 10.7687, lng: 106.7094 },\n};\n\nexport const SAFETY_BANNER_SLIDES = [\n  {\n    id: \'safe-station\',\n    badge: \'Khuy\341\272\277n ngh\341\273\213 an to\303\240n 24/7\',\n    title: \'\304\220\303\252