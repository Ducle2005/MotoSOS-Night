        target_content: "  const handleQuickCategory = (category: SafeStationCategory) => {\n    if (category === \'gas_station\') {\n      handleOpenMapWithGasStations();\n      return;\n    }\n    const match = findStationByCategory(geo.stations, category);\n    handleOpenMapWithStation(match?.id ?? \'\');\n  };\n\n  const handleQuickIssue = (issue: IssueType) => {\n    clearOverlays(false);\n    setSelectedIssue(issue);\n    setEnteredFromQuickStations(false);\n    setStep(\'issue\');\n    setActiveTab(\'map\');\n  };\n\n  const handleQuickSos = () => {\n    clearOverlays(false);\n    setSelectedIssue(\'other\');\n    setCustomNote(\'SOS kh\341\272\251n c\341\272\245p ban \304\221\303\252m\');\n    handleChangePickupMode(\'current_location\');\n    setEnteredFromQuickStations(false);\n    setStep(\'pickup\');\n    setActiveTab(\'map\');\n  };\n\n  const handleMechanicArrived = useCallback(() => {\n    setTrackingStatus((prev) => (prev === \'accepted\' ? \'arrived\' : prev));\n  }, []);\n\n  const handleStartMapPinPicker = () => {\n    clearOverlays(true);\n    setStep(\'idle\');\n    pinPicker.startPinPicker(geo.userLocation.coord, geo.userLocation.address);\n    setIsLocationSearchOpen(false);\n    setActiveTab(\'map\');\n  };\n\n  const handleConfirmMapPinPicker = () => {\n    const { coord, address } = pinPicker.finishPinPicker();\n    clearOverlays(true);\n    geo.confirmPinnedLocation(coord, address);\n  };\n\n  const handleSelectSearchLocation = (item: LocationSuggestion) => {\n    pinPicker.cancelPinPicker();\n    clearOverlays(true);\n    geo.selectSearchedLocation(item);\n  };\n\n  const handleResetToGpsLocation = async () => {\n    pinPicker.cancelPinPicker();\n    clearOverlays(true);\n    await geo.useCurrentGpsLocation();\n  };"
        replacement_content: "  const handleQuickCategory = (category: SafeStationCategory) => {\n    if (category === \'gas_station\') return handleOpenMapWithGasStations();\n    handleOpenMapWithStation(findStationByCategory(geo.stations, category)?.id ?? \'\');\n  };\n\n  const handleQuickIssue = (issue: IssueType) => {\n    clearOverlays(false);\n    setSelectedIssue(issue);\n    setEnteredFromQuickStations(false);\n    setStep(\'issue\');\n    setActiveTab(\'map\');\n  };\n\n  const handleQuickSos = () => {\n    clearOverlays(false);\n    setSelectedIssue(\'other\');\n    setCustomNote(\'SOS kh\341\272\251n c\341\272\245p ban \304\221\303\252m\');\n    handleChangePickupMode(\'current_location\');\n    setEnteredFromQuickStations(false);\n    setStep(\'pickup\');\n    setActiveTab(\'map\');\n  };\n\n  const handleMechanicArrived = useCallback(() => {\n    setTrackingStatus((prev) => (prev === \'accepted\' ? \'arrived\' : prev));\n  }, []);\n\n  const handleStartMapPinPicker = () => {\n    clearOverlays(true);\n    setStep(\'idle\');\n    pinPicker.startPinPicker(geo.userLocation.coord, geo.userLocation.address);\n    setIsLocationSearchOpen(false);\n    setActiveTab(\'map\');\n  };\n\n  const handleConfirmMapPinPicker = () => {\n    const { coord, address } = pinPicker.finishPinPicker();\n    clearOverlays(true);\n    geo.confirmPinnedLocation(coord, address);\n  };\n\n  const handleSelectSearchLocation = (item: LocationSuggestion) => {\n    pinPicker.cancelPinPicker(); clearOverlays(true); geo.selectSearchedLocation(item);\n  };\n\n  const handleResetToGpsLocation = async () => {\n    pinPicker.cancelPinPicker(); clearOverlays(true); await geo.useCurrentGpsLocation();\n  };"
