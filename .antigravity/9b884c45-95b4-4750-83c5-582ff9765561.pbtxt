      arguments_json: "{\"Description\":\"Wire useMapPinPicker into useRescueOrderState while keeping file strictly under 250 lines\", \"Instruction\":\"Integrate useMapPinPicker hook, handlers, and exports in useRescueOrderState.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":12, \"ReplacementContent\":\"import { useGasStationState } from \'./useGasStationState\';\\nimport { useMapPinPicker } from \'./useMapPinPicker\';\\nimport { useMechanicSimulation } from \'./useMechanicSimulation\';\\nimport { useRepairShopState } from \'./useRepairShopState\';\\nimport { useRescueGeo } from \'./useRescueGeo\';\", \"StartLine\":6, \"TargetContent\":\"import { useGasStationState } from \'./useGasStationState\';\\nimport { useMechanicSimulation } from \'./useMechanicSimulation\';\\nimport { useRepairShopState } from \'./useRepairShopState\';\\nimport { useRescueGeo } from \'./useRescueGeo\';\"}, {\"AllowMultiple\":false, \"EndLine\":48, \"ReplacementContent\":\"  const geo = useRescueGeo(step, pickupMode, activeStationForRoute, handleStationsReady);\\n  const repairShops = useRepairShopState(geo.userLocation.coord);\\n  const gasStations = useGasStationState(geo.userLocation.coord);\\n  const pinPicker = useMapPinPicker();\", \"StartLine\":42, \"TargetContent\":\"  const geo = useRescueGeo(step, pickupMode, activeStationForRoute, handleStationsReady);\\n  const repairShops = useRepairShopState(geo.userLocation.coord);\\n  const gasStations = useGasStationState(geo.userLocation.coord);\"}, {\"AllowMultiple\":false, \"EndLine\":116, \"ReplacementContent\":\"  const clearOverlays = (clearGasStationChoice = false) => {\\n    setInspectedStationId(null);\\n    if (clearGasStationChoice) setChosenGasSafeStation(null);\\n    repairShops.selectShop(null);\\n    gasStations.clearGasRoute();\\n  };\\n\\n  const handleResetFlow = (returnToHome = false) => {\\n    if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current);\\n    setIsSubmitting(false);\\n    setStep(\'idle\');\\n    setSelectedIssue(null);\\n    setCustomNote(\'\');\\n    setPickupMode(\'current_location\');\\n    setSelectedVoucherId(null);\\n    setTrackingStatus(\'searching\');\\n    setEnteredFromQuickStations(false);\\n    pinPicker.cancelPinPicker();\\n    clearOverlays(true);\\n    geo.clearRoute();\\n    if (returnToHome) setActiveTab(\'home\');\\n  };\", \"StartLine\":89, \"TargetContent\":\"  const clearOverlays = (clearGasStationChoice = false) => {\\n    setInspectedStationId(null);\\n    if (clearGasStationChoice) setChosenGasSafeStation(null);\\n    repairShops.selectShop(null);\\n    gasStations.clearGasRoute();\\n  };\\n\\n  const handleResetFlow = (returnToHome = false) => {\\n    if (submitTimerRef.current !== null) window.clearTimeout(submitTimerRef.current);\\n    setIsSubmitting(false);\\n    setStep(\'idle\');\\n    setSelectedIssue(null);\\n    setCustomNote(\'\');\\n    setPickupMode(\'current_location\');\\n    setSelectedVoucherId(null);\\n    setTrackingStatus(\'searching\');\\n    setEnteredFromQuickStations(false);\\n    clearOverlays(true);\\n    geo.clearRoute();\\n    if (returnToHome) setActiveTab(\'home\');\\n  };\"}, {\"AllowMultiple\":false, \"EndLine\":242, \"ReplacementContent\":\"  const handleStartMapPinPicker = () => {\\n    clearOverlays(true);\\n    setStep(\'idle\');\\n    pinPicker.startPinPicker(geo.userLocation.coord, geo.userLocation.address);\\n    setIsLocationSearchOpen(false);\\n    setActiveTab(\'map\');\\n  };\\n\\n  const handleConfirmMapPinPicker = () => {\\n    const { coord, address } = pinPicker.finishPinPicker();\\n    clearOverlays(true);\\n    geo.confirmPinnedLocation(coord, address);\\n  };\\n\\n  const handleSelectSearchLocation = (item: LocationSuggestion) => {\\n    pinPicker.cancelPinPicker();\\n    clearOverlays(true);\\n    geo.selectSearchedLocation(item);\\n  };\\n\\n  const handleResetToGpsLocation = async () => {\\n    pinPicker.cancelPinPicker();\\n    clearOverlays(true);\\n    await geo.useCurrentGpsLocation();\\n  };\\n\\n  return {\\n    activeTab, setActiveTab, step, setStep,\\n    selectedIssue, setSelectedIssue, customNote, setCustomNote,\\n    pickupMode, handleChangePickupMode, selectedVoucherId, setSelectedVoucherId,\\n    selectedStationId, setSelectedStationId, inspectedStationId, setInspectedStationId,\\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\\n    isLocationSearchOpen, setIsLocationSearchOpen,\\n    recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\\n    activityHistory, geo, repairShops, gasStations, pinPicker, effectiveStations,\\n    pickupTarget, issueSummary, pricing, mechanicSim, handleResetFlow,\\n    handleCompleteAndLog, handleConfirmRescue, handleDemoAdvance,\\n    handleMechanicArrived, handleOpenMapWithStation, handleOpenMapWithRepairShop,\\n    handleChangeMapFilter, handleSelectGasStationForRescue, handleQuickCategory,\\n    handleQuickIssue, handleQuickSos, handleStartMapPinPicker,\\n    handleConfirmMapPinPicker, handleSelectSearchLocation, handleResetToGpsLocation,\\n  };\\n}\", \"StartLine\":213, \"TargetContent\":\"  const handleSelectSearchLocation = (item: LocationSuggestion) => {\\n    clearOverlays(true);\\n    geo.selectSearchedLocation(item);\\n  };\\n\\n  const handleResetToGpsLocation = async () => {\\n    clearOverlays(true);\\n    await geo.useCurrentGpsLocation();\\n  };\\n\\n  return {\\n    activeTab, setActiveTab, step, setStep,\\n    selectedIssue, setSelectedIssue, customNote, setCustomNote,\\n    pickupMode, handleChangePickupMode, selectedVoucherId, setSelectedVoucherId,\\n    selectedStationId, setSelectedStationId, inspectedStationId, setInspectedStationId,\\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\\n    isLocationSearchOpen, setIsLocationSearchOpen,\\n    recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\\n    activityHistory, geo, repairShops, gasStations, effectiveStations, pickupTarget,\\n    issueSummary, pricing, mechanicSim, handleResetFlow, handleCompleteAndLog,\\n    handleConfirmRescue, handleDemoAdvance, handleMechanicArrived,\\n    handleOpenMapWithStation, handleOpenMapWithRepairShop, handleChangeMapFilter,\\n    handleSelectGasStationForRescue, handleQuickCategory, handleQuickIssue,\\n    handleQuickSos, handleSelectSearchLocation, handleResetToGpsLocation,\\n  };\\n}\"}], \"TargetFile\":\"/src/hooks/useRescueOrderState.ts\", \"toolAction\":\"Integrating pinPicker into useRescueOrderState\", \"toolSummary\":\"Wire useMapPinPicker in state\"}"
