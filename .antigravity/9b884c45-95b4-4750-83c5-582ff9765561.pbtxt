    content: "import { CheckCircle2, Clock, MapPin, Navigation, Wrench } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type {\n  MechanicInfo,\n  RescueActivityItem,\n  RescueStep,\n  TrackingStatus,\n} from \'../../types/rescue\';\n\ninterface ActivityTabProps {\n  step: RescueStep;\n  trackingStatus: TrackingStatus;\n  activeIssueLabel: string;\n  activePickupAddress: string;\n  mechanic: MechanicInfo;\n  history: RescueActivityItem[];\n  onOpenMapTracking: () => void;\n  onTriggerDemoAdvance: () => void;\n  onStartNewRescue: () => void;\n}\n\nexport function ActivityTab({\n  step,\n  trackingStatus,\n  activeIssueLabel,\n  activePickupAddress,\n  mechanic,\n  history,\n  onOpenMapTracking,\n  onTriggerDemoAdvance,\n  onStartNewRescue,\n}: ActivityTabProps) {\n  const isLiveOrder = step === \'tracking\';\n\n  return (\n    <div className=\"relative flex-1 overflow-y-auto bg-[#F8FAFC] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n      <div\n        aria-hidden=\"true\"\n        className=\"pointer-events-none absolute inset-x-0 top-0 h-44 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-500/12 via-slate-50/50 to-transparent\"\n      />\n\n      <motion.div\n        initial={{ opacity: 0, y: 12 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.28, ease: [0.16, 1, 0.3, 1] }}\n        className=\"relative z-10 px-4 pt-4 pb-28\"\n      >\n        <header>\n          <h1 className=\"text-lg font-extrabold tracking-tight text-slate-900\">\n            Ho\341\272\241t \304\221\341\273\231ng c\341\273\251u h\341\273\231\n          </h1>\n          <p className=\"mt-0.5 text-xs text-slate-500\">\n            Theo d\303\265i chuy\341\272\277n c\341\273\251u h\341\273\231 hi\341\273\207n t\341\272\241i v\303\240 l\341\273\213ch s\341\273\255 h\341\273\227 tr\341\273\243 ban \304\221\303\252m.\n          </p>\n        </header>\n\n        {isLiveOrder ? (\n          <section\n            aria-label=\"Chuy\341\272\277n c\341\273\251u h\341\273\231 \304\221ang di\341\273\205n ra\"\n            className=\"mt-4 rounded-2xl border border-emerald-200 bg-white p-4 shadow-[0_10px_28px_-10px_rgba(16,185,129,0.22)]\"\n          >\n            <div className=\"flex items-center justify-between gap-2\">\n              <span className=\"text-xs font-bold text-emerald-600\">\n                {trackingStatus === \'searching\' && \'\304\220ang t\303\254m th\341\273\243 g\341\272\247n b\341\272\241n\'}\n                {trackingStatus === \'accepted\' && `Th\341\273\243 \304\221ang t\341\273\233i \302\267 ${mechanic.etaMinutes} ph\303\272t`}\n                {trackingStatus === \'completed\' && \'\304\220\303\243 ho\303\240n th\303\240nh c\341\273\251u h\341\273\231\'}\n              </span>\n              <span className=\"font-mono text-xs font-semibold text-slate-600\">\n                {mechanic.licensePlate}\n              </span>\n            </div>\n\n            <h2 className=\"mt-1.5 text-base font-bold text-slate-900\">\n              {activeIssueLabel}\n            </h2>\n            <p className=\"mt-1 flex items-center gap-1.5 text-xs text-slate-600\">\n              <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n              <span className=\"truncate\">{activePickupAddress}</span>\n            </p>\n\n            <div className=\"mt-3.5 flex items-center gap-2\">\n              <motion.button\n                type=\"button\"\n                whileTap={{ scale: 0.96 }}\n                onClick={onOpenMapTracking}\n                className=\"inline-flex min-h-[40px] flex-1 items-center justify-center gap-1.5 rounded-xl bg-emerald-500 px-3 text-xs font-bold text-white shadow-sm shadow-emerald-500/20 hover:bg-emerald-600\"\n              >\n                <Navigation className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                <span>Xem tr\303\252n b\341\272\243n \304\221\341\273\223</span>\n              </motion.button>\n              <motion.button\n                type=\"button\"\n                whileTap={{ scale: 0.96 }}\n                onClick={onTriggerDemoAdvance}\n                className=\"inline-flex min-h-[40px] items-center justify-center rounded-xl border border-slate-200 bg-slate-50 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-100\"\n              >\n                {trackingStatus === \'completed\' ? \'Ho\303\240n t\341\272\245t\' : \'Gi\341\272\243 l\341\272\255p th\341\273\243\'}\n              </motion.button>\n            </div>\n          </section>\n        ) : (\n          <section\n            aria-label=\"Kh\303\264ng c\303\263 chuy\341\272\277n \304\221ang di\341\273\205n ra\"\n            className=\"mt-4 flex items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs\"\n          >\n            <div className=\"min-w-0\">\n              <p className=\"text-sm font-bold text-slate-900\">\n                Ch\306\260a c\303\263 y\303\252u c\341\272\247u \304\221ang ch\341\272\241y\n              </p>\n              <p className=\"mt-0.5 text-xs text-slate-500\">\n                \304\220\341\273\231i th\341\273\243 tr\341\273\261c \304\221\303\252m s\341\272\265n s\303\240ng h\341\273\227 tr\341\273\243 trong 6\342\200\22310 ph\303\272t.\n              </p>\n            </div>\n            <motion.button\n              type=\"button\"\n              whileTap={{ scale: 0.95 }}\n              onClick={onStartNewRescue}\n              className=\"shrink-0 rounded-xl bg-emerald-500 px-3.5 py-2 text-xs font-bold text-white shadow-sm shadow-emerald-500/20 hover:bg-emerald-600\"\n            >\n              G\341\273\215i ngay\n            </motion.button>\n          </section>\n        )}\n\n        <section aria-label=\"L\341\273\213ch s\341\273\255 c\341\273\251u h\341\273\231\" className=\"mt-6\">\n          <h2 className=\"text-sm font-bold text-slate-900\">L\341\273\213ch s\341\273\255 g\341\272\247n \304\221\303\242y</h2>\n          <div className=\"mt-3 divide-y divide-slate-100 rounded-2xl border border-slate-200/80 bg-white shadow-xs\">\n            {history.map((item) => (\n              <div key={item.id} className=\"flex items-start gap-3 p-3.5\">\n                <span className=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-black/5\">\n                  {item.status === \'completed\' ? (\n                    <CheckCircle2 className=\"h-4 w-4\" aria-hidden=\"true\" />\n                  ) : (\n                    <Wrench className=\"h-4 w-4\" aria-hidden=\"true\" />\n                  )}\n                </span>\n                <div className=\"min-w-0 flex-1\">\n                  <div className=\"flex items-center justify-between gap-2\">\n                    <p className=\"truncate text-sm font-bold text-slate-900\">\n                      {item.issueLabel}\n                    </p>\n                    <span className=\"shrink-0 text-[11px] font-semibold text-emerald-600\">\n                      Ho\303\240n th\303\240nh\n                    </span>\n                  </div>\n                  <p className=\"mt-0.5 truncate text-xs text-slate-500\">\n                    {item.pickupAddress}\n                  </p>\n                  <p className=\"mt-1 flex items-center gap-1.5 text-[11px] text-slate-400\">\n                    <Clock className=\"h-3 w-3 shrink-0\" aria-hidden=\"true\" />\n                    <span>{item.timestampLabel}</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span>\n                      {item.mechanicName} ({item.licensePlate})\n                    </span>\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      </motion.div>\n    </div>\n  );\n}\n"
    num_lines: 166
