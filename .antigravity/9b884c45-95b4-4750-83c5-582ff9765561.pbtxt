        instruction: "import { ArrowUpRight, Fuel, Loader2, Shield, Store } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport type { SafeStation, SafeStationCategory } from \'../../types/rescue\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\n\ninterface NearbyStationsCarouselProps {\n  stations: SafeStation[];\n  isLoadingStations: boolean;\n  onSelectStationCard: (stationId: string) => void;\n  onViewMap: () => void;\n}\n\nfunction StationPillIcon({ category }: { category: SafeStationCategory }) {\n  if (category === \'convenience\') {\n    return <Store className=\"h-4 w-4 text-emerald-600\" aria-hidden=\"true\" />;\n  }\n  if (category === \'gas_station\') {\n    return <Fuel className=\"h-4 w-4 text-amber-600\" aria-hidden=\"true\" />;\n  }\n  return <Shield className=\"h-4 w-4 text-sky-600\" aria-hidden=\"true\" />;\n}\n\nexport function NearbyStationsCarousel({\n  stations,\n  isLoadingStations,\n  onSelectStationCard,\n  onViewMap,\n}: NearbyStationsCarouselProps) {\n  return (\n    <section aria-label=\"Tr\341\272\241m An To\303\240n g\341\272\247n b\341\272\241n\" className=\"mt-5\">\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"text-sm font-bold tracking-tight text-slate-900\">\n          Tr\341\272\241m An To\303\240n g\341\272\247n b\341\272\241n\n        </h2>\n        {isLoadingStations ? (\n          <span className=\"inline-flex items-center gap-1 text-xs font-medium text-emerald-600\">\n            <Loader2 className=\"h-3 w-3 animate-spin\" aria-hidden=\"true\" />\n            <span>\304\220ang qu\303\251t</span>\n          </span>\n        ) : (\n          <button\n            type=\"button\"\n            onClick={onViewMap}\n            className=\"text-xs font-semibold text-emerald-600 transition-colors hover:text-emerald-700\"\n          >\n            Xem b\341\272\243n \304\221\341\273\223 \342\206\222\n          </button>\n        )}\n      </div>\n\n      <div className=\"mt-3 flex gap-3 overflow-x-auto pb-2 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n        {stations.map((station) => (\n          <motion.button\n            key={station.id}\n            type=\"button\"\n            whileTap={{ scale: 0.96 }}\n            onClick={() => onSelectStationCard(station.id)}\n            className=\"group flex w-[232px] shrink-0 flex-col justify-between rounded-2xl border border-slate-200/80 bg-white p-3.5 text-left shadow-[0_6px_20px_-8px_rgba(15,23,42,0.08)] transition-colors hover:border-emerald-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500\"\n          >\n            <div>\n              <div className=\"flex items-center justify-between gap-2\">\n                <span className=\"flex h-8 w-8 items-center justify-center rounded-xl bg-slate-50 ring-1 ring-inset ring-black/5\">\n                  <StationPillIcon category={station.category} />\n                </span>\n                <span className=\"font-mono text-[11px] font-semibold tabular-nums text-emerald-600\">\n                  {formatWalkingDistance(\n                    station.walkingDistanceMeters,\n                    station.walkingMinutes,\n                  )}\n                </span>\n              </div>\n\n              <p className=\"mt-2.5 truncate text-sm font-bold text-slate-900\">\n                {station.name}\n              </p>\n              <p className=\"mt-0.5 truncate text-xs text-slate-500\">\n                {station.categoryLabel} \302\267 {station.openHours}\n              </p>\n            </div>\n\n            <div className=\"mt-3 flex items-center justify-between gap-2 border-t border-slate-100 pt-2.5\">\n              <p className=\"min-w-0 truncate text-[11px] text-slate-400\">\n                {station.address}\n              </p>\n              <span className=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 transition-colors group-hover:bg-emerald-500 group-hover:text-white group-active:bg-emerald-500 group-active:text-white\">\n                <ArrowUpRight className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n              </span>\n            </div>\n          </motion.button>\n        ))}\n      </div>\n    </section>\n  );\n}\n"
        path {
