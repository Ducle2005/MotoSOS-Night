    content: "import { Fuel, ShieldCheck, Wrench } from \'lucide-react\';\nimport { useRef, useState, type MouseEvent } from \'react\';\nimport type { MapLayerFilter } from \'../../types/rescue\';\n\ninterface MapFilterChipsProps {\n  activeFilter: MapLayerFilter;\n  openShopCount: number;\n  gasStationCount: number;\n  stationCount: number;\n  onSelectFilter: (filter: MapLayerFilter) => void;\n}\n\nconst DRAG_THRESHOLD_PX = 5;\n\nexport function MapFilterChips({\n  activeFilter,\n  openShopCount,\n  gasStationCount,\n  stationCount,\n  onSelectFilter,\n}: MapFilterChipsProps) {\n  const scrollerRef = useRef<HTMLDivElement | null>(null);\n  const isPointerDownRef = useRef(false);\n  const startXRef = useRef(0);\n  const startScrollLeftRef = useRef(0);\n  const didDragRef = useRef(false);\n  const [isDragging, setIsDragging] = useState(false);\n\n  const handleMouseDown = (event: MouseEvent<HTMLDivElement>) => {\n    const el = scrollerRef.current;\n    if (!el) return;\n    isPointerDownRef.current = true;\n    startXRef.current = event.pageX;\n    startScrollLeftRef.current = el.scrollLeft;\n    didDragRef.current = false;\n  };\n\n  const handleMouseMove = (event: MouseEvent<HTMLDivElement>) => {\n    const el = scrollerRef.current;\n    if (!isPointerDownRef.current || !el) return;\n    const dx = event.pageX - startXRef.current;\n    if (Math.abs(dx) > DRAG_THRESHOLD_PX) {\n      didDragRef.current = true;\n      if (!isDragging) setIsDragging(true);\n      el.scrollLeft = startScrollLeftRef.current - dx;\n    }\n  };\n\n  const endMouseDrag = () => {\n    if (!isPointerDownRef.current && !isDragging) return;\n    isPointerDownRef.current = false;\n    setIsDragging(false);\n    window.setTimeout(() => {\n      didDragRef.current = false;\n    }, 0);\n  };\n\n  const handleChipClick = (\n    filter: MapLayerFilter,\n    event: MouseEvent<HTMLButtonElement>,\n  ) => {\n    if (didDragRef.current) {\n      event.preventDefault();\n      event.stopPropagation();\n      didDragRef.current = false;\n      return;\n    }\n    onSelectFilter(filter);\n    event.currentTarget.scrollIntoView({\n      behavior: \'smooth\',\n      inline: \'center\',\n      block: \'nearest\',\n    });\n  };\n\n  return (\n    <div\n      ref={scrollerRef}\n      role=\"tablist\"\n      aria-label=\"B\341\273\231 l\341\273\215c l\341\273\233p b\341\272\243n \304\221\341\273\223\"\n      data-testid=\"map-filter-chips\"\n      onMouseDown={handleMouseDown}\n      onMouseMove={handleMouseMove}\n      onMouseUp={endMouseDrag}\n      onMouseLeave={endMouseDrag}\n      onDragStart={(event) => event.preventDefault()}\n      onTouchStart={(event) => event.stopPropagation()}\n      className={`pointer-events-auto absolute inset-x-0 top-14 z-30 flex w-full touch-pan-x items-center gap-2 overflow-x-auto px-4 py-1.5 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] ${\n        isDragging ? \'cursor-grabbing\' : \'cursor-grab\'\n      }`}\n    >\n      <button\n        type=\"button\"\n        role=\"tab\"\n        aria-selected={activeFilter === \'all\'}\n        onClick={(e) => handleChipClick(\'all\', e)}\n        className={`inline-flex h-8 shrink-0 select-none items-center gap-1.5 rounded-full px-3 text-xs font-semibold backdrop-blur-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap ${\n          activeFilter === \'all\'\n            ? \'bg-slate-900 text-white shadow-sm\'\n            : \'border border-slate-200/80 bg-white/95 text-slate-700 shadow-sm hover:border-slate-300\'\n        }`}\n      >\n        <span>T\341\272\245t c\341\272\243</span>\n      </button>\n\n      <button\n        type=\"button\"\n        role=\"tab\"\n        aria-selected={activeFilter === \'gas_stations\'}\n        onClick={(e) => handleChipClick(\'gas_stations\', e)}\n        className={`inline-flex h-8 shrink-0 select-none items-center gap-1.5 rounded-full px-3 text-xs font-semibold backdrop-blur-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 whitespace-nowrap ${\n          activeFilter === \'gas_stations\'\n            ? \'bg-amber-500 text-white shadow-sm\'\n            : \'border border-slate-200/80 bg-white/95 text-slate-700 shadow-sm hover:border-amber-300\'\n        }`}\n      >\n        <Fuel className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n        <span>C\303\242y x\304\203ng</span>\n        {gasStationCount > 0 && (\n          <span\n            className={`font-sans text-[10px] font-bold tabular-nums ${\n              activeFilter === \'gas_stations\' ? \'text-amber-100\' : \'text-slate-400\'\n            }`}\n          >\n            {gasStationCount}\n          </span>\n        )}\n      </button>\n\n      <button\n        type=\"button\"\n        role=\"tab\"\n        aria-selected={activeFilter === \'repair_shops\'}\n        onClick={(e) => handleChipClick(\'repair_shops\', e)}\n        className={`inline-flex h-8 shrink-0 select-none items-center gap-1.5 rounded-full px-3 text-xs font-semibold backdrop-blur-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 whitespace-nowrap ${\n          activeFilter === \'repair_shops\'\n            ? \'bg-blue-600 text-white shadow-sm\'\n            : \'border border-slate-200/80 bg-white/95 text-slate-700 shadow-sm hover:border-blue-300\'\n        }`}\n      >\n        <span\n          className={`h-2 w-2 shrink-0 rounded-full ${\n            activeFilter === \'repair_shops\' ? \'bg-emerald-300\' : \'bg-emerald-500\'\n          }`}\n          aria-hidden=\"true\"\n        />\n        <Wrench className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n        <span>Ti\341\273\207m s\341\273\255a xe (\304\220ang m\341\273\237)</span>\n        {openShopCount > 0 && (\n          <span\n            className={`font-sans text-[10px] font-bold tabular-nums ${\n              activeFilter === \'repair_shops\' ? \'text-blue-100\' : \'text-slate-400\'\n            }`}\n          >\n            {openShopCount}\n          </span>\n        )}\n      </button>\n\n      <button\n        type=\"button\"\n        role=\"tab\"\n        aria-selected={activeFilter === \'safe_stations\'}\n        onClick={(e) => handleChipClick(\'safe_stations\', e)}\n        className={`inline-flex h-8 shrink-0 select-none items-center gap-1.5 rounded-full px-3 text-xs font-semibold backdrop-blur-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 whitespace-nowrap ${\n          activeFilter === \'safe_stations\'\n            ? \'bg-emerald-600 text-white shadow-sm\'\n            : \'border border-slate-200/80 bg-white/95 text-slate-700 shadow-sm hover:border-emerald-300\'\n        }`}\n      >\n        <ShieldCheck className=\"h-3.5 w-3.5 shrink-0\" aria-hidden=\"true\" />\n        <span>Tr\341\272\241m An To\303\240n 24/7</span>\n        {stationCount > 0 && (\n          <span\n            className={`font-sans text-[10px] font-bold tabular-nums ${\n              activeFilter === \'safe_stations\' ? \'text-emerald-100\' : \'text-slate-400\'\n            }`}\n          >\n            {stationCount}\n          </span>\n        )}\n      </button>\n    </div>\n  );\n}\n"
