    content: "import { Marker, type Map as MapLibreMap } from \'maplibre-gl\';\nimport { useEffect, useRef, type MutableRefObject } from \'react\';\nimport {\n  fitMapBoundsSafely,\n  setRouteSourceGeometry,\n} from \'../components/map/mapLayers\';\nimport {\n  createGasStationMarkerElement,\n  createRepairShopMarkerElement,\n  createStationMarkerElement,\n} from \'../components/map/mapMarkers\';\nimport type {\n  GasStation,\n  GeoCoord,\n  GeoJsonLineString,\n  MapLayerFilter,\n  PickupMode,\n  RepairShop,\n  RescueStep,\n  SafeStation,\n} from \'../types/rescue\';\nimport { computeBoundsBox } from \'../utils/rescueLogic\';\n\ninterface UseMapMarkersSyncParams {\n  mapRef: MutableRefObject<MapLibreMap | null>;\n  containerRef: MutableRefObject<HTMLDivElement | null>;\n  mapReady: boolean;\n  userCoord: GeoCoord;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  selectedStationId: string | null;\n  inspectedStationId: string | null;\n  selectedShopId: string | null;\n  selectedGasStationId: string | null;\n  mapFilter: MapLayerFilter;\n  shopRoute: GeoJsonLineString | null;\n  gasRoute: GeoJsonLineString | null;\n  step: RescueStep;\n  pickupMode: PickupMode;\n  onSelectStation: (stationId: string) => void;\n  onInspectStation: (stationId: string | null) => void;\n  onSelectShop: (shopId: string | null) => void;\n  onSelectGasStation: (stationId: string | null) => void;\n}\n\nexport function useMapMarkersSync({\n  mapRef,\n  containerRef,\n  mapReady,\n  userCoord,\n  stations,\n  openRepairShops,\n  gasStations,\n  selectedStationId,\n  inspectedStationId,\n  selectedShopId,\n  selectedGasStationId,\n  mapFilter,\n  shopRoute,\n  gasRoute,\n  step,\n  pickupMode,\n  onSelectStation,\n  onInspectStation,\n  onSelectShop,\n  onSelectGasStation,\n}: UseMapMarkersSyncParams) {\n  const stationMarkersRef = useRef<Marker[]>([]);\n  const repairShopMarkersRef = useRef<Marker[]>([]);\n  const gasMarkersRef = useRef<Marker[]>([]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    stationMarkersRef.current.forEach((marker) => marker.remove());\n    const showStations =\n      step !== \'idle\' || mapFilter === \'all\' || mapFilter === \'safe_stations\';\n\n    if (!showStations) {\n      stationMarkersRef.current = [];\n      return;\n    }\n\n    stationMarkersRef.current = stations.map((station) => {\n      const isHighlighted =\n        inspectedStationId === station.id ||\n        (selectedStationId === station.id &&\n          (step === \'pickup\' || step === \'tracking\') &&\n          pickupMode === \'safe_station\');\n\n      const el = createStationMarkerElement(station, isHighlighted, () => {\n        onSelectShop(null);\n        onInspectStation(station.id);\n        onSelectStation(station.id);\n      });\n\n      return new Marker({ element: el, anchor: \'center\' })\n        .setLngLat([station.coord.lng, station.coord.lat])\n        .addTo(map);\n    });\n  }, [mapReady, stations, selectedStationId, inspectedStationId, step, pickupMode, mapFilter]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    repairShopMarkersRef.current.forEach((marker) => marker.remove());\n    const showShops =\n      step === \'idle\' && (mapFilter === \'all\' || mapFilter === \'repair_shops\');\n\n    if (!showShops) {\n      repairShopMarkersRef.current = [];\n      return;\n    }\n\n    repairShopMarkersRef.current = openRepairShops.map((shop) => {\n      const el = createRepairShopMarkerElement(shop, selectedShopId === shop.id, () => {\n        onInspectStation(null);\n        onSelectShop(shop.id);\n      });\n\n      return new Marker({ element: el, anchor: \'center\' })\n        .setLngLat([shop.coord.lng, shop.coord.lat])\n        .addTo(map);\n    });\n  }, [mapReady, openRepairShops, selectedShopId, mapFilter, step]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map) return;\n\n    gasMarkersRef.current.forEach((marker) => marker.remove());\n    const showGas = step === \'idle\' && mapFilter === \'gas_stations\';\n\n    if (!showGas) {\n      gasMarkersRef.current = [];\n      return;\n    }\n\n    gasMarkersRef.current = gasStations.map((station) => {\n      const el = createGasStationMarkerElement(\n        station,\n        selectedGasStationId === station.id,\n        () => onSelectGasStation(station.id),\n      );\n      return new Marker({ element: el, anchor: \'center\' })\n        .setLngLat([station.coord.lng, station.coord.lat])\n        .addTo(map);\n    });\n  }, [mapReady, gasStations, selectedGasStationId, mapFilter, step]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n    const active = step === \'idle\' ? shopRoute : null;\n    setRouteSourceGeometry(map, \'shop-route\', active);\n    if (!active) return;\n    const bounds = computeBoundsBox(active.coordinates);\n    if (bounds) fitMapBoundsSafely(map, containerRef.current, bounds, 16.2, 600);\n  }, [shopRoute, step, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady) return;\n    const active = step === \'idle\' && mapFilter === \'gas_stations\' ? gasRoute : null;\n    setRouteSourceGeometry(map, \'gas-route\', active);\n    if (!active) return;\n    const bounds = computeBoundsBox(active.coordinates);\n    if (bounds) fitMapBoundsSafely(map, containerRef.current, bounds, 16.2, 600);\n  }, [gasRoute, mapFilter, step, mapReady]);\n\n  useEffect(() => {\n    const map = mapRef.current;\n    if (!map || !mapReady || step !== \'idle\') return;\n\n    if (mapFilter === \'repair_shops\' && shopRoute === null && openRepairShops.length > 0) {\n      const points: [number, number][] = [\n        [userCoord.lng, userCoord.lat],\n        ...openRepairShops.slice(0, 5).map((s): [number, number] => [s.coord.lng, s.coord.lat]),\n      ];\n      const bounds = computeBoundsBox(points);\n      if (bounds) fitMapBoundsSafely(map, containerRef.current, bounds, 15.0, 550);\n    }\n\n    if (mapFilter === \'gas_stations\' && gasRoute === null && gasStations.length > 0) {\n      const points: [number, number][] = [\n        [userCoord.lng, userCoord.lat],\n        ...gasStations.slice(0, 5).map((g): [number, number] => [g.coord.lng, g.coord.lat]),\n      ];\n      const bounds = computeBoundsBox(points);\n      if (bounds) fitMapBoundsSafely(map, containerRef.current, bounds, 15.2, 550);\n    }\n  }, [mapFilter, step, mapReady, openRepairShops, gasStations, shopRoute, gasRoute, userCoord.lat, userCoord.lng]);\n\n  return {\n    clearAllMarkers: () => {\n      stationMarkersRef.current.forEach((m) => m.remove());\n      stationMarkersRef.current = [];\n      repairShopMarkersRef.current.forEach((m) => m.remove());\n      repairShopMarkersRef.current = [];\n      gasMarkersRef.current.forEach((m) => m.remove());\n      gasMarkersRef.current = [];\n    },\n  };\n}\n"
    num_lines: 208
