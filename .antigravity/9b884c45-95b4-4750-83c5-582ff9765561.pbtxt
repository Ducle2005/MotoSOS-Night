      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Allow Police list sheet to use expanded BottomSheetShell height in idle mode\", \"EndLine\":45, \"Instruction\":\"Add isPoliceListOpen prop to BottomSheetShell and include it alongside isGasListOpen\", \"ReplacementContent\":\"interface BottomSheetShellProps {\\n  step: RescueStep;\\n  isShopDetailOpen?: boolean;\\n  isGasListOpen?: boolean;\\n  isPoliceListOpen?: boolean;\\n  floatingTopSlot?: ReactNode;\\n  onRecenter: () => void;\\n  children: ReactNode;\\n}\\n\\nconst STEP_INDEX: Record<RescueStep, number> = {\\n  idle: 0,\\n  issue: 1,\\n  pickup: 2,\\n  tracking: 3,\\n};\\n\\nexport function BottomSheetShell({\\n  step,\\n  isShopDetailOpen = false,\\n  isGasListOpen = false,\\n  isPoliceListOpen = false,\\n  floatingTopSlot,\\n  onRecenter,\\n  children,\\n}: BottomSheetShellProps) {\\n  const [isCollapsed, setIsCollapsed] = useState(false);\\n\\n  useEffect(() => {\\n    setIsCollapsed(false);\\n  }, [step]);\\n\\n  const currentIndex = STEP_INDEX[step];\\n  const expandedHeightClass =\\n    step === \'idle\'\\n      ? isGasListOpen || isPoliceListOpen\\n        ? \'max-h-[50%]\'\\n        : isShopDetailOpen\\n          ? \'max-h-[44%]\'\\n          : \'max-h-[34%]\'\", \"StartLine\":5, \"TargetContent\":\"interface BottomSheetShellProps {\\n  step: RescueStep;\\n  isShopDetailOpen?: boolean;\\n  isGasListOpen?: boolean;\\n  floatingTopSlot?: ReactNode;\\n  onRecenter: () => void;\\n  children: ReactNode;\\n}\\n\\nconst STEP_INDEX: Record<RescueStep, number> = {\\n  idle: 0,\\n  issue: 1,\\n  pickup: 2,\\n  tracking: 3,\\n};\\n\\nexport function BottomSheetShell({\\n  step,\\n  isShopDetailOpen = false,\\n  isGasListOpen = false,\\n  floatingTopSlot,\\n  onRecenter,\\n  children,\\n}: BottomSheetShellProps) {\\n  const [isCollapsed, setIsCollapsed] = useState(false);\\n\\n  useEffect(() => {\\n    setIsCollapsed(false);\\n  }, [step]);\\n\\n  const currentIndex = STEP_INDEX[step];\\n  const expandedHeightClass =\\n    step === \'idle\'\\n      ? isGasListOpen\\n        ? \'max-h-[48%]\'\\n        : isShopDetailOpen\\n          ? \'max-h-[44%]\'\\n          : \'max-h-[34%]\'\", \"TargetFile\":\"/src/components/BottomSheetShell.tsx\", \"toolAction\":\"Updating BottomSheetShell height for police list\", \"toolSummary\":\"BottomSheetShell height update\"}"
      original_name: "replace_file_content"
    }
