      thinking_signature: "\022\353\004\n\350\004\001i\024}\023j\305\304\r\r\a\362P\237x\320\257\2774\346\232&\033\036/\033\251\24723h\023\223$\320\312T\0031\037\n\255/\032\220\036\262KF\350\211\335\306#\236\274\"V\017\370\225\267\223\373m(\211\212*\330\2125\306\361x\202\367\000gc:\3207\324W\206}\363\ve!;\335*K\nxC\\\320\204\357a\344\270\316*\237\214\234\370\335,\037\335\207/:\204<\256\370u\373>\243\305\371\366<\336\030K^\tE\232\266\305\001Z\331\250\362\267H\346\302`;\332U(\225& \207K\335\306\026 \274\317C\332\221\334\367\274k\274\325\032\301\226v\026z\323J\357\241\363IqB\275\034@\n\206\231\030\002\250\357\000\236\350H\364\260=\324\0319\021\350\320\017\t\342\3665\274\a\276%\362\244\261K_G\352\331\355\032c\2635\225y\357\350\367\247t\343h]\357\027\346\264\200W?\225\b\v\230\273U\217\356\337R\247\375\352q\371\315dE^\033\276\335r\333.)Uqc\022\304\t\034?b\307\270&\022r\320\275%\312\235?[\240g+v\317\202\203\022l\225\350!z\212\374\242r_\255\023]N\235\273\267\367~E\373\221\267&|_\r\032\025+\355\364\"\363Yn-\267\177\353\nl\026\215M\355\274\230\030\225\354\r\267\n\t^\346\371Z\341\030gL1\223\031MRl\274f\374\001\360\365\244k\025\306>0S>\357Q\324\351v\024_\346\361\231\351R}\000\303\365y\230\3402\370{\257_+\2773\n\021\237\220X\347{j]A\002\326\372\f\016\n\341\255B\211\310\3432K\360\327\307\356E9\227\245\332\034g\027\371\215Mj?\021d>F\240>\016:\347\016\022<\262\366\213\307)(\340\341E\002\272M\353u\224&\316uj\301J\330jl6\312dZ\365\255\017\3658c\t\330\211c\324\232{\000 n\224\031\236\270\212\024y\361mI\3103\345\232\211\331N:\373zS\344Nw7O\325\234\2056.\026\254\305*\314\a\317\253\364\363\016\v\222R\317p%\310-\256\232\'\240\351\275{\351\304\025\v\b\rDM\227\224D\260,@\017W>\377\274\027\254\222C#\267\243\254S\324#\307u\214f\246\365\212\322\002\204\244\301\201\032}\304\273\027"
