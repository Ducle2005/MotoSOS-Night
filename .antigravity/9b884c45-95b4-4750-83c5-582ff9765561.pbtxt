        instruction: "Update top padding for forRoute in getViewportPadding from 72 to 108"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/map/mapLayers.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "export function getViewportPadding(\n  container: HTMLDivElement | null,\n  forRoute: boolean,\n) {\n  const height = container?.clientHeight ?? window.innerHeight;\n  const safeBottom = forRoute\n    ? Math.min(Math.round(height * 0.61), Math.max(220, height - 180))\n    : Math.min(240, Math.max(160, Math.round(height * 0.34)));\n  return { top: forRoute ? 72 : 52, bottom: safeBottom, left: 36, right: 36 };\n}"
          replacement_content: "export function getViewportPadding(\n  container: HTMLDivElement | null,\n  forRoute: boolean,\n) {\n  const height = container?.clientHeight ?? window.innerHeight;\n  const safeBottom = forRoute\n    ? Math.min(Math.round(height * 0.61), Math.max(220, height - 180))\n    : Math.min(240, Math.max(160, Math.round(height * 0.34)));\n  return { top: forRoute ? 108 : 52, bottom: safeBottom, left: 36, right: 36 };\n}"
          start_line: 135
          end_line: 147
        }
      }
