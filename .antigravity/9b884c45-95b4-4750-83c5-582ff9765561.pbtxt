  view_file {
    absolute_path_uri: "file:///src/hooks/useRescueOrderState.ts"
    start_line: 159
    end_line: 262
    content: "    setStep(\'idle\');\n    repairShops.setMapFilter(\'repair_shops\');\n    repairShops.selectShop(shopId ?? null);\n    setActiveTab(\'map\');\n  };\n\n  const handleOpenMapWithGasStations = () => {\n    clearOverlays(false);\n    repairShops.setMapFilter(\'gas_stations\');\n    setStep(\'idle\');\n    setActiveTab(\'map\');\n  };\n\n  const handleChangeMapFilter = (nextFilter: MapLayerFilter) => {\n    if (nextFilter !== \'gas_stations\') gasStations.clearGasRoute();\n    repairShops.setMapFilter(nextFilter);\n  };\n\n  const handleSelectGasStationForRescue = (station: GasStation) => {\n    const safe = gasStationToSafeStation(station);\n    setChosenGasSafeStation(safe);\n    setSelectedStationId(safe.id);\n    setPickupMode(\'safe_station\');\n    setSelectedVoucherId(\'ANTOAN20\');\n    clearOverlays(false);\n    setEnteredFromQuickStations(true);\n    setStep(\'pickup\');\n  };\n\n  const handleQuickCategory = (category: SafeStationCategory) => {\n    if (category === \'gas_station\') {\n      handleOpenMapWithGasStations();\n      return;\n    }\n    const match = findStationByCategory(geo.stations, category);\n    handleOpenMapWithStation(match?.id ?? \'\');\n  };\n\n  const handleQuickIssue = (issue: IssueType) => {\n    clearOverlays(false);\n    setSelectedIssue(issue);\n    setEnteredFromQuickStations(false);\n    setStep(\'issue\');\n    setActiveTab(\'map\');\n  };\n\n  const handleQuickSos = () => {\n    clearOverlays(false);\n    setSelectedIssue(\'other\');\n    setCustomNote(\'SOS kh\341\272\251n c\341\272\245p ban \304\221\303\252m\');\n    handleChangePickupMode(\'current_location\');\n    setEnteredFromQuickStations(false);\n    setStep(\'pickup\');\n    setActiveTab(\'map\');\n  };\n\n  const handleMechanicArrived = useCallback(() => {\n    setTrackingStatus((prev) => (prev === \'accepted\' ? \'arrived\' : prev));\n  }, []);\n\n  const handleStartMapPinPicker = () => {\n    clearOverlays(true);\n    setStep(\'idle\');\n    pinPicker.startPinPicker(geo.userLocation.coord, geo.userLocation.address);\n    setIsLocationSearchOpen(false);\n    setActiveTab(\'map\');\n  };\n\n  const handleConfirmMapPinPicker = () => {\n    const { coord, address } = pinPicker.finishPinPicker();\n    clearOverlays(true);\n    geo.confirmPinnedLocation(coord, address);\n  };\n\n  const handleSelectSearchLocation = (item: LocationSuggestion) => {\n    pinPicker.cancelPinPicker();\n    clearOverlays(true);\n    geo.selectSearchedLocation(item);\n  };\n\n  const handleResetToGpsLocation = async () => {\n    pinPicker.cancelPinPicker();\n    clearOverlays(true);\n    await geo.useCurrentGpsLocation();\n  };\n\n  return {\n    activeTab, setActiveTab, step, setStep,\n    selectedIssue, setSelectedIssue, customNote, setCustomNote,\n    pickupMode, handleChangePickupMode, selectedVoucherId, setSelectedVoucherId,\n    selectedStationId, setSelectedStationId, inspectedStationId, setInspectedStationId,\n    trackingStatus, isSubmitting, enteredFromQuickStations, setEnteredFromQuickStations,\n    isLocationSearchOpen, setIsLocationSearchOpen,\n    recenterSignal, triggerRecenter: () => setRecenterSignal((c) => c + 1),\n    activityHistory, geo, repairShops, gasStations, pinPicker, effectiveStations,\n    pickupTarget, issueSummary, pricing, mechanicSim, handleResetFlow,\n    handleCompleteAndLog, handleConfirmRescue, handleDemoAdvance,\n    handleMechanicArrived, handleOpenMapWithStation, handleOpenMapWithRepairShop,\n    handleChangeMapFilter, handleSelectGasStationForRescue, handleQuickCategory,\n    handleQuickIssue, handleQuickSos, handleStartMapPinPicker,\n    handleConfirmMapPinPicker, handleSelectSearchLocation, handleResetToGpsLocation,\n  };\n}\n"
    num_lines: 263
    num_bytes: 10401
    line_range_bytes: 3532
  }
}
