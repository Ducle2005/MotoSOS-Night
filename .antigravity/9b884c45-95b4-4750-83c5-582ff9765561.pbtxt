      create_file {
        instruction: "import { MessageCircle, ShieldAlert, Tag, Wrench, X } from \'lucide-react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport type { AppNotification, NotificationType } from \'../../types/notification\';\nimport type { AppTab } from \'../../types/rescue\';\n\ninterface FloatingPushBannerProps {\n  banner: AppNotification | null;\n  onDismiss: () => void;\n  onSelect: (item: AppNotification) => void;\n}\n\nfunction getTypeStyle(type: NotificationType) {\n  switch (type) {\n    case \'promo\':\n      return {\n        bg: \'bg-amber-400/20 text-amber-300 border-amber-400/30\',\n        Icon: Tag,\n      };\n    case \'safety\':\n      return {\n        bg: \'bg-rose-500/20 text-rose-300 border-rose-400/30\',\n        Icon: ShieldAlert,\n      };\n    case \'chat\':\n      return {\n        bg: \'bg-sky-500/20 text-sky-300 border-sky-400/30\',\n        Icon: MessageCircle,\n      };\n    default:\n      return {\n        bg: \'bg-emerald-500/20 text-emerald-300 border-emerald-400/30\',\n        Icon: Wrench,\n      };\n  }\n}\n\nexport function getNotificationTabLabel(tab: AppTab): string {\n  switch (tab) {\n    case \'map\':\n      return \'B\341\272\243n \304\221\341\273\223\';\n    case \'safety\':\n      return \'An to\303\240n\';\n    case \'activity\':\n      return \'Ho\341\272\241t \304\221\341\273\231ng\';\n    default:\n      return \'Trang ch\341\273\247\';\n  }\n}\n\nexport function FloatingPushBanner({\n  banner,\n  onDismiss,\n  onSelect,\n}: FloatingPushBannerProps) {\n  return (\n    <div className=\"pointer-events-none absolute inset-x-0 top-3 z-[100] px-3\">\n      <AnimatePresence mode=\"wait\">\n        {banner && (\n          <motion.div\n            key={banner.id}\n            data-testid=\"floating-push-banner\"\n            initial={{ opacity: 0, y: -48, scale: 0.96 }}\n            animate={{ opacity: 1, y: 0, scale: 1 }}\n            exit={{ opacity: 0, y: -44, scale: 0.96 }}\n            transition={{ type: \'spring\', stiffness: 420, damping: 32 }}\n            drag=\"y\"\n            dragConstraints={{ top: -80, bottom: 0 }}\n            dragElastic={0.2}\n            onDragEnd={(_, info) => {\n              if (info.offset.y < -24 || info.velocity.y < -150) onDismiss();\n            }}\n            onClick={() => onSelect(banner)}\n            role=\"status\"\n            aria-live=\"polite\"\n            className=\"pointer-events-auto flex w-full cursor-pointer items-start gap-3 rounded-2xl border border-white/10 bg-slate-950/95 p-3.5 text-white shadow-2xl backdrop-blur-xl\"\n          >\n            {(() => {\n              const { bg, Icon } = getTypeStyle(banner.type);\n              return (\n                <div\n                  className={`mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border ${bg}`}\n                >\n                  <Icon className=\"h-4 w-4\" aria-hidden=\"true\" />\n                </div>\n              );\n            })()}\n\n            <div className=\"min-w-0 flex-1\">\n              <div className=\"flex items-center justify-between gap-2\">\n                <p className=\"truncate text-[13px] font-bold leading-snug text-white\">\n                  {banner.title}\n                </p>\n                <span className=\"shrink-0 text-[10px] font-medium text-emerald-300\">\n                  {getNotificationTabLabel(banner.targetTab)}\n                </span>\n              </div>\n              <p className=\"mt-0.5 line-clamp-2 text-xs leading-relaxed text-slate-300\">\n                {banner.message}\n              </p>\n            </div>\n\n            <button\n              type=\"button\"\n              aria-label=\"\304\220\303\263ng th\303\264ng b\303\241o\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onDismiss();\n              }}\n              className=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-white/10 hover:text-white\"\n            >\n              <X className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n            </button>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/notifications/FloatingPushBanner.tsx"
        }
        overwrite: true
      }
    }
