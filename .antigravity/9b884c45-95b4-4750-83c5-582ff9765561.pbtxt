        target_content: "export function createMechanicMarkerElement(\n  mechanicName: string,\n  etaMinutes: number,\n  isCompleted: boolean,\n): HTMLDivElement {\n  const wrapper = document.createElement(\'div\');\n  wrapper.className = \'flex flex-col items-center pointer-events-none\';\n  wrapper.setAttribute(\'data-testid\', \'mechanic-map-marker\');\n\n  const iconBox = document.createElement(\'div\');\n  iconBox.className =\n    \'flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-amber-500 text-white shadow-lg shadow-amber-500/35\';\n  iconBox.innerHTML = `<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"18.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"5.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"15\" cy=\"5\" r=\"1\"/><path d=\"M12 17.5V14l-3-3 4-3 2 3h2\"/></svg>`;\n\n  const label = document.createElement(\'span\');\n  label.setAttribute(\'data-role\', \'mechanic-eta-label\');\n  label.className =\n    \'mt-1 rounded-full border border-amber-200 bg-white px-2.5 py-0.5 font-sans text-[10px] font-bold tabular-nums text-amber-700 whitespace-nowrap shadow-md\';\n\n  wrapper.appendChild(iconBox);\n  wrapper.appendChild(label);\n  updateMechanicMarkerElement(wrapper, mechanicName, etaMinutes, isCompleted);\n  return wrapper;\n}\n\nexport function updateMechanicMarkerElement(\n  wrapper: HTMLElement,\n  mechanicName: string,\n  etaMinutes: number,\n  isCompleted: boolean,\n): void {\n  const label = wrapper.querySelector(\'[data-role=\"mechanic-eta-label\"]\');\n  if (!label) return;\n  const shortName = mechanicName.split(\' \').pop() || mechanicName;\n  if (isCompleted) {\n    label.textContent = `Th\341\273\243 ${shortName} \302\267 \304\220\303\243 \304\221\341\272\277n`;\n    return;\n  }\n  label.textContent =\n    etaMinutes <= 0\n      ? `Th\341\273\243 ${shortName} \302\267 S\341\272\257p t\341\273\233i`\n      : `Th\341\273\243 ${shortName} \302\267 ${etaMinutes}p`;\n}"
        replacement_content: "export function createMechanicMarkerElement(\n  mechanicName: string,\n  etaMinutes: number,\n  isArrivedOrCompleted: boolean,\n): HTMLDivElement {\n  const wrapper = document.createElement(\'div\');\n  wrapper.className = \'relative flex h-10 w-10 items-center justify-center pointer-events-none\';\n  wrapper.setAttribute(\'data-testid\', \'mechanic-map-marker\');\n\n  const iconBox = document.createElement(\'div\');\n  iconBox.className =\n    \'flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-amber-500 text-white shadow-lg shadow-amber-500/35\';\n  iconBox.innerHTML = `<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"18.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"5.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"15\" cy=\"5\" r=\"1\"/><path d=\"M12 17.5V14l-3-3 4-3 2 3h2\"/></svg>`;\n\n  const label = document.createElement(\'span\');\n  label.setAttribute(\'data-role\', \'mechanic-eta-label\');\n  label.className =\n    \'absolute top-full left-1/2 mt-1 -translate-x-1/2 rounded-full border border-amber-200 bg-white px-2.5 py-0.5 font-sans text-[10px] font-bold tabular-nums text-amber-700 whitespace-nowrap shadow-md\';\n\n  wrapper.appendChild(iconBox);\n  wrapper.appendChild(label);\n  updateMechanicMarkerElement(wrapper, mechanicName, etaMinutes, isArrivedOrCompleted);\n  return wrapper;\n}\n\nexport function updateMechanicMarkerElement(\n  wrapper: HTMLElement,\n  mechanicName: string,\n  etaMinutes: number,\n  isArrivedOrCompleted: boolean,\n): void {\n  const label = wrapper.querySelector(\'[data-role=\"mechanic-eta-label\"]\');\n  if (!label) return;\n  const shortName = mechanicName.split(\' \').pop() || mechanicName;\n  if (isArrivedOrCompleted || etaMinutes <= 0) {\n    label.textContent = `Th\341\273\243 ${shortName} \302\267 \304\220\303\243 t\341\273\233i n\306\241i`;\n    return;\n  }\n  label.textContent = `Th\341\273\243 ${shortName} \302\267 ${etaMinutes}p`;\n}"
        start_line: 65
