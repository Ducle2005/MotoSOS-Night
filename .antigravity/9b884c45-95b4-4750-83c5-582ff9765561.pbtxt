            }
            lines {
              text: "  if (stepIndex >= totalSteps - 1) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const progress = Math.min(1, Math.max(0, stepIndex / (totalSteps - 1)));"
