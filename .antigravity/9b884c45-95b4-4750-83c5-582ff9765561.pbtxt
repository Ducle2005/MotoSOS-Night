      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Ensure RepairShopDetailSheet action buttons stay single-line at 430px width\", \"EndLine\":134, \"Instruction\":\"Use text-[11px] px-2 and whitespace-nowrap on the 3-column action row buttons\", \"ReplacementContent\":\"      <div className=\\\"grid grid-cols-3 gap-2\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onNavigate}\\n          disabled={isLoadingRoute}\\n          className=\\\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl bg-blue-600 px-2 py-2.5 text-[11px] font-bold text-white shadow-md shadow-blue-600/25 transition-all hover:bg-blue-700 active:scale-[0.98] disabled:opacity-70 whitespace-nowrap\\\"\\n        >\\n          {isLoadingRoute ? (\\n            <Loader2 className=\\\"h-3.5 w-3.5 shrink-0 animate-spin\\\" aria-hidden=\\\"true\\\" />\\n          ) : (\\n            <Navigation className=\\\"h-3.5 w-3.5 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n          )}\\n          <span>D\341\272\253n \304\221\306\260\341\273\235ng</span>\\n        </button>\\n\\n        <a\\n          href={`tel:${shop.phone.replace(/\\\\s+/g, \'\')}`}\\n          onClick={() => setCallNotice(true)}\\n          className=\\\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl border border-emerald-200 bg-emerald-50 px-2 py-2.5 text-[11px] font-bold text-emerald-700 transition-colors hover:bg-emerald-100 active:scale-[0.98] whitespace-nowrap\\\"\\n        >\\n          <Phone className=\\\"h-3.5 w-3.5 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n          <span>G\341\273\215i ti\341\273\207m</span>\\n        </a>\\n\\n        <a\\n          href={buildGoogleMapsSearchUrl(shop)}\\n          target=\\\"_blank\\\"\\n          rel=\\\"noopener noreferrer\\\"\\n          className=\\\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-2 py-2.5 text-[11px] font-bold text-slate-700 transition-colors hover:bg-slate-50 active:scale-[0.98] whitespace-nowrap\\\"\\n        >\\n          <ExternalLink className=\\\"h-3.5 w-3.5 shrink-0 text-slate-500\\\" aria-hidden=\\\"true\\\" />\\n          <span>Google Maps</span>\\n        </a>\\n      </div>\", \"StartLine\":97, \"TargetContent\":\"      <div className=\\\"grid grid-cols-3 gap-2\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onNavigate}\\n          disabled={isLoadingRoute}\\n          className=\\\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl bg-blue-600 px-3 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-600/25 transition-all hover:bg-blue-700 active:scale-[0.98] disabled:opacity-70\\\"\\n        >\\n          {isLoadingRoute ? (\\n            <Loader2 className=\\\"h-4 w-4 animate-spin\\\" aria-hidden=\\\"true\\\" />\\n          ) : (\\n            <Navigation className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />\\n          )}\\n          <span>D\341\272\253n \304\221\306\260\341\273\235ng</span>\\n        </button>\\n\\n        <a\\n          href={`tel:${shop.phone.replace(/\\\\s+/g, \'\')}`}\\n          onClick={() => setCallNotice(true)}\\n          className=\\\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-bold text-emerald-700 transition-colors hover:bg-emerald-100 active:scale-[0.98]\\\"\\n        >\\n          <Phone className=\\\"h-4 w-4\\\" aria-hidden=\\\"true\\\" />\\n          <span>G\341\273\215i ti\341\273\207m</span>\\n        </a>\\n\\n        <a\\n          href={buildGoogleMapsSearchUrl(shop)}\\n          target=\\\"_blank\\\"\\n          rel=\\\"noopener noreferrer\\\"\\n          className=\\\"flex min-h-[44px] items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-bold text-slate-700 transition-colors hover:bg-slate-50 active:scale-[0.98]\\\"\\n        >\\n          <ExternalLink className=\\\"h-4 w-4 text-slate-500\\\" aria-hidden=\\\"true\\\" />\\n          <span>Google Maps</span>\\n        </a>\\n      </div>\", \"TargetFile\":\"/src/components/steps/RepairShopDetailSheet.tsx\", \"toolAction\":\"Keeping detail sheet buttons single-line\", \"toolSummary\":\"Fix button wrapping in RepairShopDetailSheet\"}"
      original_name: "replace_file_content"
