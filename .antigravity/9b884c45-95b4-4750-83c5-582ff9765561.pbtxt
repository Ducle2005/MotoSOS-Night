      command {
        instruction: "Add normalizeRepairShopName and replace Saigon with TP.HCM in address normalization"
        is_edit: true
        file {
          absolute_uri: "file:///src/utils/repairShopApi.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "export function estimateMotorbikeMinutes(distanceMeters: number): number {\n  return Math.max(1, Math.round(Math.max(0, distanceMeters) / 350));\n}\n\nexport function formatShopDistanceLabel(\n  distanceMeters: number,\n  rideMinutes: number,\n): string {\n  const safeMeters = Math.max(0, Math.round(distanceMeters));\n  if (safeMeters < 1000) {\n    return `${safeMeters}m \302\267 ${rideMinutes} ph\303\272t ch\341\272\241y xe`;\n  }\n  return `${(safeMeters / 1000).toFixed(1)} km \302\267 ${rideMinutes} ph\303\272t ch\341\272\241y xe`;\n}"
          replacement_content: "const GENERIC_ENGLISH_REPAIR_REGEX =\n  /^(motor(cycle|bike|scooter)?\\s*(repair|service|shop|garage)?|bike\\s*repair|repair(\\s*shop)?|auto\\s*repair|mechanic|garage|service)$/i;\n\nexport function normalizeRepairShopName(rawName?: string | null): string {\n  const cleaned = (rawName ?? \'\')\n    .trim()\n    .replace(/\\bSaigon\\b/gi, \'TP.HCM\');\n  if (!cleaned || GENERIC_ENGLISH_REPAIR_REGEX.test(cleaned)) {\n    return \'Ti\341\273\207m S\341\273\255a Xe L\306\260u \304\220\341\273\231ng\';\n  }\n  return cleaned;\n}\n\nexport function normalizeRepairShopAddress(rawAddress: string): string {\n  return formatCompactStationAddress(rawAddress)\n    .replace(/\\bSaigon\\b/gi, \'TP.HCM\')\n    .replace(/\\bS\303\240i G\303\262n\\b/gi, \'TP.HCM\');\n}\n\nexport function formatShopCompactMeta(\n  distanceMeters: number,\n  address: string,\n): string {\n  const safeMeters = Math.max(0, Math.round(distanceMeters));\n  const distText =\n    safeMeters < 1000 ? `${safeMeters}m` : `${(safeMeters / 1000).toFixed(1)} km`;\n  const cleanAddr = address.replace(/\\bSaigon\\b/gi, \'TP.HCM\').trim();\n  return `${distText} \342\200\242 ${cleanAddr}`;\n}\n\nexport function estimateMotorbikeMinutes(distanceMeters: number): number {\n  return Math.max(1, Math.round(Math.max(0, distanceMeters) / 350));\n}\n\nexport function formatShopDistanceLabel(\n  distanceMeters: number,\n  rideMinutes: number,\n): string {\n  const safeMeters = Math.max(0, Math.round(distanceMeters));\n  if (safeMeters < 1000) {\n    return `${safeMeters}m \302\267 ${rideMinutes} ph\303\272t ch\341\272\241y xe`;\n  }\n  return `${(safeMeters / 1000).toFixed(1)} km \302\267 ${rideMinutes} ph\303\272t ch\341\272\241y xe`;\n}"
          start_line: 18
          end_line: 32
        }
        replacement_chunks {
          target_content: "    const name =\n      props.name?.trim() ||\n      props.address_line1?.trim() ||\n      `Ti\341\273\207m s\341\273\255a xe m\303\241y #${idx + 1}`;\n\n    const rawAddress =\n      props.address_line2?.trim() ||\n      props.formatted?.trim() ||\n      [props.street, props.suburb, props.district].filter(Boolean).join(\', \') ||\n      \'Khu v\341\273\261c g\341\272\247n v\341\273\213 tr\303\255 c\341\273\247a b\341\272\241n\';\n\n    const phone =\n      props.contact?.phone?.trim() ||\n      props.datasource?.raw?.phone?.trim() ||\n      \'0909 777 666\';\n\n    mapped.push({\n      id: props.place_id || `shop-${idx}-${lng.toFixed(4)}-${lat.toFixed(4)}`,\n      name,\n      address: formatCompactStationAddress(rawAddress),\n      phone,\n      distanceMeters,\n      rideMinutes: estimateMotorbikeMinutes(distanceMeters),\n      openingHoursRaw,\n      isOpen: hoursEval.isOpen,\n      openStatusLabel: hoursEval.statusLabel,\n      hasExplicitHours: hoursEval.hasExplicitHours,\n      coord: { lat, lng },\n    });"
          replacement_content: "    const rawName = props.name?.trim() || props.address_line1?.trim();\n    const name = normalizeRepairShopName(rawName);\n\n    const rawAddress =\n      props.address_line2?.trim() ||\n      props.formatted?.trim() ||\n      [props.street, props.suburb, props.district].filter(Boolean).join(\', \') ||\n      \'Khu v\341\273\261c TP.HCM\';\n\n    const phone =\n      props.contact?.phone?.trim() ||\n      props.datasource?.raw?.phone?.trim() ||\n      \'0909 777 666\';\n\n    mapped.push({\n      id: props.place_id || `shop-${idx}-${lng.toFixed(4)}-${lat.toFixed(4)}`,\n      name,\n      address: normalizeRepairShopAddress(rawAddress),\n      phone,\n      distanceMeters,\n      rideMinutes: estimateMotorbikeMinutes(distanceMeters),\n      openingHoursRaw,\n      isOpen: hoursEval.isOpen,\n      openStatusLabel: hoursEval.statusLabel,\n      hasExplicitHours: hoursEval.hasExplicitHours,\n      coord: { lat, lng },\n    });"
          start_line: 87
