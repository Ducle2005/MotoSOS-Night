      arguments_json: "{\"CommandLine\":\"trap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\\nmkdir -p .playwright-cli\\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\\\\nplaywright-cli resize 430 900 && \\\\\\nplaywright-cli video-start .playwright-cli/carousel-motion.webm && \\\\\\nplaywright-cli run-code \'async (page) => {\\n  await page.waitForTimeout(600);\\n  // Move mouse safely outside carousels (e.g., over top dark header) so initial hover does not pause them\\n  await page.mouse.move(215, 40);\\n\\n  const counts = await page.evaluate(() => ({\\n    campaignChildren: document.querySelector(\\\"[data-testid=\\\\\\\"campaign-banner-carousel\\\\\\\"]\\\")?.children.length ?? 0,\\n    partnerChildren: document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.children.length ?? 0,\\n  }));\\n\\n  // Scroll partner perks into view so both carousels are visible in video\\n  await page.locator(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\").scrollIntoViewIfNeeded();\\n  await page.waitForTimeout(300);\\n\\n  // Measure PartnerPerksCarousel smooth continuous glide over 1.6s\\n  const partnerT0 = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n  const campaignT0 = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"campaign-banner-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n  await page.waitForTimeout(1600);\\n  const partnerT1 = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n\\n  // Test hover pause on PartnerPerksCarousel\\n  const partnerBox = await page.locator(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\").boundingBox();\\n  if (partnerBox) {\\n    await page.mouse.move(partnerBox.x + partnerBox.width / 2, partnerBox.y + partnerBox.height / 2);\\n  }\\n  await page.waitForTimeout(200);\\n  const partnerHoverStart = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n  await page.waitForTimeout(700);\\n  const partnerHoverEnd = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n\\n  // Move mouse out to test 1.5s resume delay\\n  await page.mouse.move(215, 40);\\n  await page.waitForTimeout(600);\\n  const partnerBeforeResume = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n  await page.waitForTimeout(1600); // crosses 1.5s delay + ~0.7s glide\\n  const partnerAfterResume = await page.evaluate(() => document.querySelector(\\\"[data-testid=\\\\\\\"partner-perks-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1);\\n\\n  // Verify CampaignBannerCarousel auto-stepped & check active dot\\n  await page.locator(\\\"[data-testid=\\\\\\\"campaign-banner-carousel\\\\\\\"]\\\").scrollIntoViewIfNeeded();\\n  await page.waitForTimeout(1200);\\n  const campaignAfterStep = await page.evaluate(() => ({\\n    scrollLeft: document.querySelector(\\\"[data-testid=\\\\\\\"campaign-banner-carousel\\\\\\\"]\\\")?.scrollLeft ?? -1,\\n    activeDotLabel: document.querySelector(\\\"button[aria-label^=\\\\\\\"Xem banner\\\\\\\"][aria-pressed=\\\\\\\"true\\\\\\\"]\\\")?.getAttribute(\\\"aria-label\\\") ?? null,\\n  }));\\n\\n  // Verify small mouse click (< 6px drag) on campaign banner applies promo & navigates cleanly\\n  await page.locator(\\\"[data-testid=\\\\\\\"campaign-banner-night-safe-station\\\\\\\"]\\\").click();\\n  await page.waitForTimeout(500);\\n  const afterPromoClickText = await page.locator(\\\"body\\\").innerText();\\n  const hasPromoOrMapStep = /L\341\273\247ng l\341\273\221p|Ch\341\273\215n s\341\273\261 c\341\273\221|B\306\260\341\273\233c 1|ANTOAN20/i.test(afterPromoClickText);\\n\\n  return JSON.stringify({\\n    counts,\\n    partnerGlide: { partnerT0, partnerT1, movedPx: Math.round((partnerT1 - partnerT0) * 10) / 10 },\\n    hoverPause: { partnerHoverStart, partnerHoverEnd, deltaDuringHover: Math.round((partnerHoverEnd - partnerHoverStart) * 10) / 10 },\\n    resumeAfterDelay: { partnerBeforeResume, partnerAfterResume, deltaAfterResume: Math.round((partnerAfterResume - partnerBeforeResume) * 10) / 10 },\\n    campaignStep: { campaignT0, ...campaignAfterStep },\\n    hasPromoOrMapStep,\\n  }, null, 2);\\n}\' && \\\\\\nplaywright-cli video-stop && \\\\\\nplaywright-cli console error\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Recording carousel animation & testing interactions\", \"toolSummary\":\"Carousel motion verification\"}"
