        target_content: "import {\n  ArrowLeft,\n  Loader2,\n  MapPin,\n  Navigation,\n  ShieldCheck,\n} from \'lucide-react\';\nimport type {\n  OrderPricing,\n  PickupMode,\n  SafeStation,\n  UserLocation,\n} from \'../../types/rescue\';\nimport { formatVnd } from \'../../utils/pricingAndSimLogic\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\nimport { OrderInvoiceBar } from \'./OrderInvoiceBar\';\nimport { SafeStationListPicker } from \'./SafeStationListPicker\';\n\ninterface PickupSelectionStepProps {\n  issueLabel: string;\n  pickupMode: PickupMode;\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  selectedStationId: string | null;\n  resolvedAddress: string;\n  routeSummary: { distanceMeters: number; durationMinutes: number } | null;\n  isLoadingRoute: boolean;\n  isSubmitting: boolean;\n  pricing: OrderPricing;\n  availableVoucherCount: number;\n  onChangeMode: (mode: PickupMode) => void;\n  onSelectStation: (stationId: string) => void;\n  onOpenVouchers: () => void;\n  onBack: () => void;\n  onConfirm: () => void;\n}\n\nexport function PickupSelectionStep({\n  issueLabel,\n  pickupMode,\n  userLocation,\n  stations,\n  selectedStationId,\n  resolvedAddress,\n  routeSummary,\n  isLoadingRoute,\n  isSubmitting,\n  pricing,\n  availableVoucherCount,\n  onChangeMode,\n  onSelectStation,\n  onOpenVouchers,\n  onBack,\n  onConfirm,\n}: PickupSelectionStepProps) {\n  const hasDiscount =\n    pricing.appliedVoucher !== null && pricing.discountAmount > 0;\n\n  return (\n    <div className=\"flex min-h-0 flex-1 flex-col\">\n      <div className=\"flex-1 overflow-y-auto px-5 pt-1 pb-2.5 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n        <div className=\"flex items-center justify-between gap-2\">\n          <h1 className=\"shrink-0 text-base font-extrabold tracking-tight text-slate-900\">\n            B\341\272\241n mu\341\273\221n ch\341\273\235 th\341\273\243 \341\273\237 \304\221\303\242u?\n          </h1>\n          <span className=\"max-w-[130px] truncate text-right text-xs font-semibold text-emerald-600\">\n            {issueLabel}\n          </span>\n        </div>\n        <p className=\"mt-0.5 text-xs text-slate-500\">\n          Ban \304\221\303\252m n\303\252n di chuy\341\273\203n t\341\273\233i n\306\241i s\303\241ng \304\221\303\250n n\341\272\277u xe c\303\262n d\341\272\257t b\341\273\231 \304\221\306\260\341\273\243c.\n        </p>\n\n        {/* Two explicit pickup options */}\n        <div\n          className=\"mt-2.5 grid grid-cols-1 gap-2\"\n          role=\"radiogroup\"\n          aria-label=\"Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 th\341\273\243\"\n        >\n          <button\n            type=\"button\"\n            role=\"radio\"\n            aria-checked={pickupMode === \'current_location\'}\n            onClick={() => onChangeMode(\'current_location\')}\n            className={`flex min-h-[50px] items-center gap-3 rounded-2xl border px-3.5 py-2 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${\n              pickupMode === \'current_location\'\n                ? \'border-emerald-500 bg-emerald-50/70\'\n                : \'border-slate-200 bg-white hover:border-slate-300\'\n            }`}\n          >\n            <span\n              className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-xl ${\n                pickupMode === \'current_location\'\n                  ? \'bg-emerald-500 text-white\'\n                  : \'bg-sky-50 text-sky-600\'\n              }`}\n            >\n              <Navigation className=\"h-4 w-4\" aria-hidden=\"true\" />\n            </span>\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"text-sm font-bold text-slate-900\">\n                Ch\341\273\235 t\341\272\241i v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i\n              </p>\n              <p className=\"truncate text-xs text-slate-500\">\n                {userLocation.address}\n              </p>\n            </div>\n          </button>\n\n          <button\n            type=\"button\"\n            role=\"radio\"\n            aria-checked={pickupMode === \'safe_station\'}\n            onClick={() => onChangeMode(\'safe_station\')}\n            className={`flex min-h-[50px] items-center gap-3 rounded-2xl border px-3.5 py-2 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${\n              pickupMode === \'safe_station\'\n                ? \'border-emerald-500 bg-emerald-50/70\'\n                : \'border-slate-200 bg-white hover:border-slate-300\'\n            }`}\n          >\n            <span\n              className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-xl ${\n                pickupMode === \'safe_station\'\n                  ? \'bg-emerald-500 text-white\'\n                  : \'bg-emerald-50 text-emerald-600\'\n              }`}\n            >\n              <ShieldCheck className=\"h-4 w-4\" aria-hidden=\"true\" />\n            </span>\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"text-sm font-bold text-slate-900\">\n                Di chuy\341\273\203n t\341\273\233i Tr\341\272\241m An To\303\240n g\341\272\247n nh\341\272\245t\n              </p>\n              <p className=\"truncate text-xs text-slate-500\">\n                D\303\271ng \304\221\306\260\341\273\243c m\303\243 ANTOAN20 \302\267 {stations.length} tr\341\272\241m m\341\273\237 24/7\n              </p>\n            </div>\n          </button>\n        </div>\n\n        {pickupMode === \'safe_station\' && (\n          <SafeStationListPicker\n            stations={stations}\n            selectedStationId={selectedStationId}\n            isLoadingRoute={isLoadingRoute}\n            onSelectStation={onSelectStation}\n          />\n        )}\n\n        <div className=\"mt-2.5 flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2\">\n          <MapPin className=\"h-4 w-4 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n          <div className=\"min-w-0 flex-1\">\n            <div className=\"flex items-center justify-between gap-2\">\n              <p className=\"text-[11px] font-medium text-slate-500\">\304\220i\341\273\203m \304\221\303\263n c\341\273\247a th\341\273\243</p>\n              {pickupMode === \'safe_station\' && routeSummary && (\n                <p className=\"font-sans text-[11px] font-semibold tabular-nums text-emerald-600\">\n                  {formatWalkingDistance(\n                    routeSummary.distanceMeters,\n                    routeSummary.durationMinutes,\n                  )}\n                </p>\n              )}\n            </div>\n            <p\n              className=\"truncate text-xs font-bold text-slate-900\"\n              data-testid=\"pickup-address\"\n            >\n              {resolvedAddress}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Pinned Invoice, Voucher Bar & Confirm Action */}\n      <div className=\"shrink-0 border-t border-slate-100 bg-white px-5 py-3\">\n        <OrderInvoiceBar\n          pricing={pricing}\n          availableVoucherCount={availableVoucherCount}\n          onOpenVouchers={onOpenVouchers}\n        />\n\n        <div className=\"flex items-center gap-2.5\">\n          <button\n            type=\"button\"\n            disabled={isSubmitting}\n            onClick={onBack}\n            className=\"inline-flex min-h-[46px] items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 disabled:opacity-50\"\n          >\n            <ArrowLeft className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>Quay l\341\272\241i</span>\n          </button>\n\n          <button\n            type=\"button\"\n            disabled={isSubmitting}\n            onClick={onConfirm}\n            data-testid=\"confirm-order-btn\"\n            className=\"inline-flex min-h-[46px] flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 text-sm font-extrabold text-white shadow-md shadow-emerald-500/20 transition-all hover:bg-emerald-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 disabled:cursor-wait disabled:opacity-80 active:scale-[0.98]\"\n          >\n            {isSubmitting ? (\n              <>\n                <Loader2 className=\"h-4 w-4 animate-spin\" aria-hidden=\"true\" />\n                <span>\304\220ang g\341\273\255i y\303\252u c\341\272\247u...</span>\n              </>\n            ) : (\n              <span className=\"flex items-center gap-1.5 whitespace-nowrap\">\n                <span>X\303\241c nh\341\272\255n g\341\273\215i th\341\273\243 \302\267</span>\n                {hasDiscount && (\n                  <span className=\"font-sans text-xs font-medium line-through tabular-nums text-emerald-100\">\n                    {formatVnd(pricing.basePrice)}\n                  </span>\n                )}\n                <span className=\"font-sans tabular-nums\">\n                  {formatVnd(pricing.finalPrice)}\n                </span>\n              </span>\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}"
        replacement_content: "import {\n  ArrowLeft,\n  Loader2,\n  MapPin,\n  Navigation,\n  ShieldCheck,\n} from \'lucide-react\';\nimport type {\n  GasStation,\n  InspectedPlace,\n  MapLayerFilter,\n  OrderPricing,\n  PickupMode,\n  RepairShop,\n  SafeStation,\n  UserLocation,\n} from \'../../types/rescue\';\nimport { formatVnd } from \'../../utils/pricingAndSimLogic\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\nimport { OrderInvoiceBar } from \'./OrderInvoiceBar\';\nimport { Step2PlaceListPicker } from \'./Step2PlaceListPicker\';\n\ninterface PickupSelectionStepProps {\n  issueLabel: string;\n  pickupMode: PickupMode;\n  mapFilter: MapLayerFilter;\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  selectedStationId: string | null;\n  inspectedPlace: InspectedPlace | null;\n  resolvedAddress: string;\n  routeSummary: { distanceMeters: number; durationMinutes: number } | null;\n  isLoadingRoute: boolean;\n  isSubmitting: boolean;\n  pricing: OrderPricing;\n  availableVoucherCount: number;\n  onChangeMode: (mode: PickupMode) => void;\n  onSelectSafeStation: (station: SafeStation) => void;\n  onSelectGasStation: (station: GasStation) => void;\n  onRouteShop: (shop: RepairShop) => void;\n  onOpenVouchers: () => void;\n  onBack: () => void;\n  onConfirm: () => void;\n}\n\nexport function PickupSelectionStep({\n  issueLabel,\n  pickupMode,\n  mapFilter,\n  userLocation,\n  stations,\n  openRepairShops,\n  gasStations,\n  selectedStationId,\n  inspectedPlace,\n  resolvedAddress,\n  routeSummary,\n  isLoadingRoute,\n  isSubmitting,\n  pricing,\n  availableVoucherCount,\n  onChangeMode,\n  onSelectSafeStation,\n  onSelectGasStation,\n  onRouteShop,\n  onOpenVouchers,\n  onBack,\n  onConfirm,\n}: PickupSelectionStepProps) {\n  const hasDiscount =\n    pricing.appliedVoucher !== null && pricing.discountAmount > 0;\n\n  return (\n    <div className=\"flex min-h-0 flex-1 flex-col\">\n      <div className=\"min-h-0 flex-1 overflow-y-auto px-5 pt-1 pb-2 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n        <div className=\"flex items-center justify-between gap-2\">\n          <h1 className=\"shrink-0 text-sm font-extrabold tracking-tight text-slate-900\">\n            B\341\272\241n mu\341\273\221n ch\341\273\235 th\341\273\243 \341\273\237 \304\221\303\242u?\n          </h1>\n          <span className=\"max-w-[130px] truncate text-right text-xs font-semibold text-emerald-600\">\n            {issueLabel}\n          </span>\n        </div>\n\n        {/* Compact 2-column pickup mode toggle */}\n        <div\n          className=\"mt-2 grid grid-cols-2 gap-2\"\n          role=\"radiogroup\"\n          aria-label=\"Ch\341\273\215n \304\221i\341\273\203m ch\341\273\235 th\341\273\243\"\n        >\n          <button\n            type=\"button\"\n            role=\"radio\"\n            aria-checked={pickupMode === \'current_location\'}\n            onClick={() => onChangeMode(\'current_location\')}\n            className={`flex items-center gap-2 rounded-xl border px-2.5 py-2 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${\n              pickupMode === \'current_location\'\n                ? \'border-emerald-500 bg-emerald-50/80\'\n                : \'border-slate-200 bg-white hover:border-slate-300\'\n            }`}\n          >\n            <span\n              className={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg ${\n                pickupMode === \'current_location\'\n                  ? \'bg-emerald-500 text-white\'\n                  : \'bg-sky-50 text-sky-600\'\n              }`}\n            >\n              <Navigation className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n            </span>\n            <div className=\"min-w-0\">\n              <p className=\"truncate text-xs font-bold text-slate-900\">T\341\272\241i ch\341\273\227</p>\n              <p className=\"truncate text-[10px] text-slate-500\">{userLocation.address}</p>\n            </div>\n          </button>\n\n          <button\n            type=\"button\"\n            role=\"radio\"\n            aria-checked={pickupMode === \'safe_station\'}\n            onClick={() => onChangeMode(\'safe_station\')}\n            className={`flex items-center gap-2 rounded-xl border px-2.5 py-2 text-left transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${\n              pickupMode === \'safe_station\'\n                ? \'border-emerald-500 bg-emerald-50/80\'\n                : \'border-slate-200 bg-white hover:border-slate-300\'\n            }`}\n          >\n            <span\n              className={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg ${\n                pickupMode === \'safe_station\'\n                  ? \'bg-emerald-500 text-white\'\n                  : \'bg-emerald-50 text-emerald-600\'\n              }`}\n            >\n              <ShieldCheck className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n            </span>\n            <div className=\"min-w-0\">\n              <p className=\"truncate text-xs font-bold text-slate-900\">Tr\341\272\241m An To\303\240n</p>\n              <p className=\"truncate text-[10px] text-emerald-700\">M\303\243 ANTOAN20</p>\n            </div>\n          </button>\n        </div>\n\n        <Step2PlaceListPicker\n          mapFilter={mapFilter}\n          stations={stations}\n          openRepairShops={openRepairShops}\n          gasStations={gasStations}\n          selectedStationId={selectedStationId}\n          inspectedPlace={inspectedPlace}\n          isLoadingRoute={isLoadingRoute}\n          onSelectSafeStation={onSelectSafeStation}\n          onSelectGasStation={onSelectGasStation}\n          onRouteShop={onRouteShop}\n        />\n\n        <div className=\"mt-2 flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5\">\n          <MapPin className=\"h-3.5 w-3.5 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n          <div className=\"min-w-0 flex-1\">\n            <div className=\"flex items-center justify-between gap-2\">\n              <p className=\"text-[10.5px] font-medium text-slate-500\">\304\220i\341\273\203m \304\221\303\263n c\341\273\247a th\341\273\243</p>\n              {pickupMode === \'safe_station\' && routeSummary && (\n                <p className=\"font-sans text-[10.5px] font-semibold tabular-nums text-emerald-600\">\n                  {formatWalkingDistance(\n                    routeSummary.distanceMeters,\n                    routeSummary.durationMinutes,\n                  )}\n                </p>\n              )}\n            </div>\n            <p\n              className=\"truncate text-xs font-bold text-slate-900\"\n              data-testid=\"pickup-address\"\n            >\n              {resolvedAddress}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Pinned Invoice, Voucher Bar & Confirm Action */}\n      <div className=\"shrink-0 border-t border-slate-100 bg-white px-5 pt-2.5 pb-3\">\n        <OrderInvoiceBar\n          pricing={pricing}\n          availableVoucherCount={availableVoucherCount}\n          onOpenVouchers={onOpenVouchers}\n        />\n\n        <div className=\"flex items-center gap-2.5\">\n          <button\n            type=\"button\"\n            disabled={isSubmitting}\n            onClick={onBack}\n            className=\"inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 disabled:opacity-50\"\n          >\n            <ArrowLeft className=\"h-4 w-4\" aria-hidden=\"true\" />\n            <span>Quay l\341\272\241i</span>\n          </button>\n\n          <button\n            type=\"button\"\n            disabled={isSubmitting}\n            onClick={onConfirm}\n            data-testid=\"confirm-order-btn\"\n            className=\"inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 text-sm font-extrabold text-white shadow-md shadow-emerald-500/20 transition-all hover:bg-emerald-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 disabled:cursor-wait disabled:opacity-80 active:scale-[0.98]\"\n          >\n            {isSubmitting ? (\n              <>\n                <Loader2 className=\"h-4 w-4 animate-spin\" aria-hidden=\"true\" />\n                <span>\304\220ang g\341\273\255i y\303\252u c\341\272\247u...</span>\n              </>\n            ) : (\n              <span className=\"flex items-center gap-1.5 whitespace-nowrap\">\n                <span>X\303\241c nh\341\272\255n g\341\273\215i th\341\273\243 \302\267</span>\n                {hasDiscount && (\n                  <span className=\"font-sans text-xs font-medium line-through tabular-nums text-emerald-100\">\n                    {formatVnd(pricing.basePrice)}\n                  </span>\n                )}\n                <span className=\"font-sans tabular-nums\">\n                  {formatVnd(pricing.finalPrice)}\n                </span>\n              </span>\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}"
        start_line: 1
        end_line: 223
      }
      num_matches: 1
    }
