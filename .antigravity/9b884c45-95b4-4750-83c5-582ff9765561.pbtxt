      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type {\\n  GeoCoord,\\n  IssueOption,\\n  MechanicInfo,\\n  RescueActivityItem,\\n  SafeStation,\\n  UserLocation,\\n} from \'../types/rescue\';\\n\\nexport const DEFAULT_HCMC_COORD: GeoCoord = {\\n  lat: 10.7769,\\n  lng: 106.7009,\\n};\\n\\nexport const FALLBACK_USER_LOCATION: UserLocation = {\\n  address: \'Trung t\303\242m Qu\341\272\255n 1, TP. H\341\273\223 Ch\303\255 Minh\',\\n  district: \'Qu\341\272\255n 1, TP.HCM\',\\n  coord: DEFAULT_HCMC_COORD,\\n  source: \'fallback\',\\n};\\n\\nexport const MOCK_SAFE_STATIONS: SafeStation[] = [\\n  {\\n    id: \'mock-station-circle-k\',\\n    name: \'Circle K L\303\252 Th\303\241nh T\303\264n\',\\n    category: \'convenience\',\\n    categoryLabel: \'C\341\273\255a h\303\240ng ti\341\273\207n l\341\273\243i 24/7\',\\n    address: \'84 L\303\252 Th\303\241nh T\303\264n, P. B\341\272\277n Ngh\303\251, Qu\341\272\255n 1\',\\n    walkingDistanceMeters: 185,\\n    walkingMinutes: 2,\\n    openHours: \'M\341\273\237 c\341\273\255a 24/7\',\\n    amenities: [\'\304\220\303\250n s\303\241ng\', \'Camera an ninh\', \'Gh\341\272\277 ng\341\273\223i ch\341\273\235\'],\\n    coord: { lat: 10.7782, lng: 106.7021 },\\n  },\\n  {\\n    id: \'mock-station-familymart\',\\n    name: \'FamilyMart Pasteur\',\\n    category: \'convenience\',\\n    categoryLabel: \'C\341\273\255a h\303\240ng ti\341\273\207n l\341\273\243i 24/7\',\\n    address: \'158 Pasteur, P. B\341\272\277n Ngh\303\251, Qu\341\272\255n 1\',\\n    walkingDistanceMeters: 320,\\n    walkingMinutes: 4,\\n    openHours: \'M\341\273\237 c\341\273\255a 24/7\',\\n    amenities: [\'\304\220\303\250n s\303\241ng\', \'Camera an ninh\', \'N\306\260\341\273\233c u\341\273\221ng\'],\\n    coord: { lat: 10.7796, lng: 106.6994 },\\n  },\\n  {\\n    id: \'mock-station-petrolimex\',\\n    name: \'C\303\242y x\304\203ng Petrolimex H\303\240m Nghi\',\\n    category: \'gas_station\',\\n    categoryLabel: \'C\303\242y x\304\203ng 24/7\',\\n    address: \'136 H\303\240m Nghi, P. B\341\272\277n Th\303\240nh, Qu\341\272\255n 1\',\\n    walkingDistanceMeters: 410,\\n    walkingMinutes: 5,\\n    openHours: \'M\341\273\237 c\341\273\255a 24/7\',\\n    amenities: [\'Tr\341\273\261c ban \304\221\303\252m\', \'Khu v\341\273\261c tho\303\241ng\', \'C\303\263 m\303\241i che\'],\\n    coord: { lat: 10.7718, lng: 106.6991 },\\n  },\\n  {\\n    id: \'mock-station-police\',\\n    name: \'C\303\264ng an Ph\306\260\341\273\235ng B\341\272\277n Ngh\303\251\',\\n    category: \'police\',\\n    categoryLabel: \'Tr\341\273\261c ban 24/7\',\\n    address: \'27 Nguy\341\273\205n Trung Tr\341\273\261c, P. B\341\272\277n Ngh\303\251, Qu\341\272\255n 1\',\\n    walkingDistanceMeters: 530,\\n    walkingMinutes: 7,\\n    openHours: \'Tr\341\273\261c ban 24/7\',\\n    amenities: [\'An ninh t\341\273\221i \304\221a\', \'B\303\243i \304\221\341\273\227 an to\303\240n\', \'H\341\273\227 tr\341\273\243 kh\341\272\251n c\341\272\245p\'],\\n    coord: { lat: 10.7751, lng: 106.6968 },\\n  },\\n];\\n\\nexport const ISSUE_OPTIONS: IssueOption[] = [\\n  {\\n    id: \'flat_tire\',\\n    label: \'L\341\273\247ng l\341\273\221p\',\\n    subtitle: \'V\303\241 \303\251p, thay ru\341\273\231t ho\341\272\267c thay v\341\273\217 l\306\260u \304\221\341\273\231ng\',\\n    estimatedRange: \'80.000\304\221 \342\200\223 150.000\304\221\',\\n  },\\n  {\\n    id: \'engine_dead\',\\n    label: \'Ch\341\272\277t m\303\241y\',\\n    subtitle: \'Bugi, ng\341\272\255p n\306\260\341\273\233c ho\341\272\267c \304\221\341\273\201 kh\303\264ng n\341\273\225\',\\n    estimatedRange: \'120.000\304\221 \342\200\223 250.000\304\221\',\\n  },\\n  {\\n    id: \'out_of_fuel\',\\n    label: \'H\341\272\277t x\304\203ng\',\\n    subtitle: \'Ti\341\272\277p x\304\203ng RON 95 t\341\272\255n n\306\241i (t\341\273\221i \304\221a 3 l\303\255t)\',\\n    estimatedRange: \'50.000\304\221 + ti\341\273\201n x\304\203ng\',\\n  },\\n  {\\n    id: \'battery_jump\',\\n    label: \'K\303\255ch b\303\254nh\',\\n    subtitle: \'K\303\255ch b\303\254nh \341\272\257c quy t\341\272\241i ch\341\273\227, ki\341\273\203m tra s\341\272\241c\',\\n    estimatedRange: \'70.000\304\221 \342\200\223 120.000\304\221\',\\n  },\\n  {\\n    id: \'other\',\\n    label: \'Kh\303\241c\',\\n    subtitle: \'\304\220\341\273\251t s\303\252n, k\341\272\271t kh\303\263a ho\341\272\267c h\341\273\217ng phanh\',\\n    estimatedRange: \'B\303\241o gi\303\241 tr\306\260\341\273\233c khi s\341\273\255a\',\\n  },\\n];\\n\\nexport const MOCK_MECHANIC: MechanicInfo = {\\n  id: \'mech-nguyen-minh-tuan\',\\n  name: \'Nguy\341\273\205n Minh Tu\341\272\245n\',\\n  phone: \'0908 421 903\',\\n  licensePlate: \'59-P2 842.19\',\\n  vehicleModel: \'Honda Winner X \302\267 \304\220\341\273\223 ngh\341\273\201 \304\221\341\272\247y \304\221\341\273\247\',\\n  rating: 4.9,\\n  completedRescues: 318,\\n  etaMinutes: 6,\\n  distanceKm: 1.4,\\n  coord: { lat: 10.7704, lng: 106.7068 },\\n};\\n\\nexport const SAFETY_BANNER_SLIDES = [\\n  {\\n    id: \'safe-station\',\\n    badge: \'Khuy\341\272\277n ngh\341\273\213 an to\303\240n 24/7\',\\n    title: \'\304\220\303\252m khuya xe h\341\273\217ng? D\341\272\257t xe t\341\273\233i Tr\341\272\241m An To\303\240n g\341\272\247n nh\341\272\245t \304\221\341\273\203 ch\341\273\235 th\341\273\243\',\\n    cta: \'Xem tuy\341\272\277n \304\221i b\341\273\231\',\\n  },\\n  {\\n    id: \'transparent-price\',\\n    badge: \'Minh b\341\272\241ch chi ph\303\255\',\\n    title: \'Th\341\273\243 MotoSOS lu\303\264n b\303\241o gi\303\241 tr\341\273\215n g\303\263i tr\306\260\341\273\233c khi s\341\273\255a, kh\303\264ng ph\341\273\245 thu \341\272\251n\',\\n    cta: \'G\341\273\215i c\341\273\251u h\341\273\231 ngay\',\\n  },\\n  {\\n    id: \'night-escort\',\\n    badge: \'Gi\303\241m s\303\241t h\303\240nh tr\303\254nh\',\\n    title: \'Theo d\303\265i v\341\273\213 tr\303\255 th\341\273\243 theo th\341\273\235i gian th\341\273\261c v\303\240 x\303\241c nh\341\272\255n bi\341\273\203n s\341\273\221 khi \304\221\303\263n\',\\n    cta: \'M\341\273\237 b\341\272\243n \304\221\341\273\223 tr\341\273\261c tuy\341\272\277n\',\\n  },\\n];\\n\\nexport const INITIAL_ACTIVITY_HISTORY: RescueActivityItem[] = [\\n  {\\n    id: \'act-101\',\\n    issueLabel: \'L\341\273\247ng l\341\273\221p\',\\n    pickupAddress: \'Circle K \302\267 84 L\303\252 Th\303\241nh T\303\264n, Qu\341\272\255n 1\',\\n    mechanicName: \'Tr\341\272\247n V\304\203n H\303\271ng\',\\n    licensePlate: \'59-H1 612.88\',\\n    timestampLabel: \'23:15 \302\267 H\303\264m qua\',\\n    status: \'completed\',\\n  },\\n  {\\n    id: \'act-102\',\\n    issueLabel: \'K\303\255ch b\303\254nh\',\\n    pickupAddress: \'Petrolimex H\303\240m Nghi, Qu\341\272\255n 1\',\\n    mechanicName: \'Nguy\341\273\205n Minh Tu\341\272\245n\',\\n    licensePlate: \'59-P2 842.19\',\\n    timestampLabel: \'21:40 \302\267 3 ng\303\240y tr\306\260\341\273\233c\',\\n    status: \'completed\',\\n  },\\n];\\n\\nexport const EMERGENCY_CONTACTS = [\\n  { label: \'T\341\273\225ng \304\221\303\240i MotoSOS 24/7\', phone: \'1900 636 812\', note: \'H\341\273\227 tr\341\273\243 \304\221i\341\273\201u ph\341\273\221i kh\341\272\251n c\341\272\245p\' },\\n  { label: \'C\341\272\243nh s\303\241t 113\', phone: \'113\', note: \'Kh\341\272\251n c\341\272\245p an ninh tr\341\272\255t t\341\273\261\' },\\n  { label: \'C\341\272\245p c\341\273\251u 115\', phone: \'115\', note: \'H\341\273\227 tr\341\273\243 y t\341\272\277 kh\341\272\251n c\341\272\245p\' },\\n];\\n\", \"Description\":\"Update mockRescueData with battery_jump, safety banners, activity history, and emergency contacts\", \"Overwrite\":true, \"TargetFile\":\"/src/data/mockRescueData.ts\", \"toolAction\":\"Updating mockRescueData.ts\", \"toolSummary\":\"Update mockRescueData.ts\"}"
