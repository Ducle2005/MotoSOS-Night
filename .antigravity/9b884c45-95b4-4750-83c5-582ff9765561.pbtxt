        target_content: "interface BottomSheetShellProps {\n  step: RescueStep;\n  isShopDetailOpen?: boolean;\n  isGasListOpen?: boolean;\n  floatingTopSlot?: ReactNode;\n  onRecenter: () => void;\n  children: ReactNode;\n}\n\nconst STEP_INDEX: Record<RescueStep, number> = {\n  idle: 0,\n  issue: 1,\n  pickup: 2,\n  tracking: 3,\n};\n\nexport function BottomSheetShell({\n  step,\n  isShopDetailOpen = false,\n  isGasListOpen = false,\n  floatingTopSlot,\n  onRecenter,\n  children,\n}: BottomSheetShellProps) {\n  const [isCollapsed, setIsCollapsed] = useState(false);\n\n  useEffect(() => {\n    setIsCollapsed(false);\n  }, [step]);\n\n  const currentIndex = STEP_INDEX[step];\n  const expandedHeightClass =\n    step === \'idle\'\n      ? isGasListOpen\n        ? \'max-h-[48%]\'\n        : isShopDetailOpen\n          ? \'max-h-[44%]\'\n          : \'max-h-[34%]\'"
        replacement_content: "interface BottomSheetShellProps {\n  step: RescueStep;\n  isShopDetailOpen?: boolean;\n  isGasListOpen?: boolean;\n  isPoliceListOpen?: boolean;\n  floatingTopSlot?: ReactNode;\n  onRecenter: () => void;\n  children: ReactNode;\n}\n\nconst STEP_INDEX: Record<RescueStep, number> = {\n  idle: 0,\n  issue: 1,\n  pickup: 2,\n  tracking: 3,\n};\n\nexport function BottomSheetShell({\n  step,\n  isShopDetailOpen = false,\n  isGasListOpen = false,\n  isPoliceListOpen = false,\n  floatingTopSlot,\n  onRecenter,\n  children,\n}: BottomSheetShellProps) {\n  const [isCollapsed, setIsCollapsed] = useState(false);\n\n  useEffect(() => {\n    setIsCollapsed(false);\n  }, [step]);\n\n  const currentIndex = STEP_INDEX[step];\n  const expandedHeightClass =\n    step === \'idle\'\n      ? isGasListOpen || isPoliceListOpen\n        ? \'max-h-[50%]\'\n        : isShopDetailOpen\n          ? \'max-h-[44%]\'\n          : \'max-h-[34%]\'"
        start_line: 5
        end_line: 45
      }
      num_matches: 1
    }
    description: "Allow Police list sheet to use expanded BottomSheetShell height in idle mode"
    diff_stats {
