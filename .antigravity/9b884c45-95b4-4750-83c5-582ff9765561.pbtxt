    command_line: "mkdir -p _verify\ntrap \'playwright-cli close || true\' EXIT\nplaywright-cli open http://localhost:3000 --viewport-size=430,900 --headless\nsleep 1.5\nplaywright-cli run-code \"async page => {\n  await page.waitForSelector(\'text=MotoSOS Priority\');\n  await page.waitForSelector(\'text=24/7 VIP Rescue\');\n  await page.waitForSelector(\'[data-testid=\\\"campaign-banner-carousel\\\"]\');\n  await page.waitForTimeout(800);\n}\"\nplaywright-cli screenshot --filename=_verify/home-luxury-top.png\nplaywright-cli run-code \"async page => {\n  const box = await page.locator(\'[data-testid=\\\"campaign-banner-carousel\\\"]\').boundingBox();\n  if (!box) throw new Error(\'Missing campaign-banner-carousel\');\n  const cx = box.x + box.width * 0.7;\n  const cy = box.y + box.height * 0.5;\n  await page.mouse.move(cx, cy);\n  await page.mouse.down();\n  await page.mouse.move(cx - 180, cy, { steps: 10 });\n  await page.mouse.up();\n  await page.waitForTimeout(350);\n  const stillHome = await page.getByText(\'MotoSOS Priority\').isVisible();\n  const scrollLeft = await page.locator(\'[data-testid=\\\"campaign-banner-carousel\\\"]\').evaluate(el => el.scrollLeft);\n  console.log(\'DRAG_RESULT:\', JSON.stringify({ stillHome, scrollLeft }));\n  if (!stillHome) throw new Error(\'Dragging banner accidentally navigated away from Home!\');\n  if (scrollLeft <= 10) throw new Error(\'Expected carousel scrollLeft > 10 after drag, got \' + scrollLeft);\n  await page.locator(\'[data-testid=\\\"campaign-banner-carousel\\\"]\').evaluate(el => { el.scrollLeft = 0; });\n  await page.locator(\'[data-testid=\\\"partner-perks-carousel\\\"]\').scrollIntoViewIfNeeded();\n  await page.waitForTimeout(500);\n}\"\nplaywright-cli screenshot --filename=_verify/home-luxury-bottom.png\nplaywright-cli run-code \"async page => {\n  await page.locator(\'[data-testid=\\\"campaign-banner-night-safe-station\\\"]\').scrollIntoViewIfNeeded();\n  await page.waitForTimeout(200);\n  await page.locator(\'[data-testid=\\\"campaign-banner-night-safe-station\\\"]\').click();\n  await page.waitForTimeout(500);\n  const issueBtn = page.getByRole(\'button\', { name: /L\341\273\247ng l\341\273\221p/i }).first();\n  await issueBtn.click();\n  await page.waitForTimeout(600);\n  const hasSafeMode = await page.getByText(\'\304\220i b\341\273\231 t\341\273\233i Tr\341\272\241m An To\303\240n\').isVisible();\n  const hasDiscount = await page.getByText(\'-20.000\304\221\', { exact: true }).isVisible();\n  console.log(\'BANNER_VOUCHER_CHECK:\', JSON.stringify({ hasSafeMode, hasDiscount }));\n  if (!hasDiscount) throw new Error(\'Expected -20.000\304\221 discount applied from Banner 1\');\n}\"\nplaywright-cli screenshot --filename=_verify/banner-voucher-applied.png\nplaywright-cli console error"
