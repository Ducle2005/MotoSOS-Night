  code_action {
    action_spec {
      create_file {
        instruction: "import { MapPin, Phone, ShieldAlert, ShieldCheck } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport { useState } from \'react\';\nimport { EMERGENCY_CONTACTS } from \'../../data/mockRescueData\';\nimport type { SafeStation } from \'../../types/rescue\';\nimport { formatWalkingDistance } from \'../../utils/rescueLogic\';\n\ninterface SafetyTabProps {\n  stations: SafeStation[];\n  onRouteToStation: (stationId: string) => void;\n}\n\nconst SAFETY_TIPS = [\n  \'B\341\272\255t \304\221\303\250n c\341\272\243nh b\303\241o ho\341\272\267c xi-nhan, d\341\272\257t xe s\303\241t l\341\273\201 ph\341\272\243i c\303\263 \304\221\303\250n \304\221\306\260\341\273\235ng.\',\n  \'\306\257u ti\303\252n di chuy\341\273\203n v\303\240o C\341\273\255a h\303\240ng 24/7, C\303\242y x\304\203ng ho\341\272\267c C\303\264ng an ph\306\260\341\273\235ng g\341\272\247n nh\341\272\245t.\',\n  \'\304\220\341\273\221i chi\341\272\277u \304\221\303\272ng t\303\252n th\341\273\243 v\303\240 bi\341\273\203n s\341\273\221 xe tr\303\252n \341\273\251ng d\341\273\245ng tr\306\260\341\273\233c khi giao xe.\',\n];\n\nexport function SafetyTab({ stations, onRouteToStation }: SafetyTabProps) {\n  const [dialedPhone, setDialedPhone] = useState<string | null>(null);\n\n  return (\n    <div className=\"relative flex-1 overflow-y-auto bg-[#F8FAFC] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n      <div\n        aria-hidden=\"true\"\n        className=\"pointer-events-none absolute inset-x-0 top-0 h-44 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-500/12 via-slate-50/50 to-transparent\"\n      />\n\n      <motion.div\n        initial={{ opacity: 0, y: 12 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.28, ease: [0.16, 1, 0.3, 1] }}\n        className=\"relative z-10 px-4 pt-4 pb-28\"\n      >\n        <header className=\"flex items-center justify-between gap-2\">\n          <div>\n            <h1 className=\"text-lg font-extrabold tracking-tight text-slate-900\">\n              Trung t\303\242m An to\303\240n\n            </h1>\n            <p className=\"mt-0.5 text-xs text-slate-500\">\n              \304\220i\341\273\203m tr\303\272 \341\272\251n 24/7 & \304\221\306\260\341\273\235ng d\303\242y n\303\263ng h\341\273\227 tr\341\273\243 kh\341\272\251n c\341\272\245p.\n            </p>\n          </div>\n          <span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-black/5\">\n            <ShieldCheck className=\"h-5 w-5\" aria-hidden=\"true\" />\n          </span>\n        </header>\n\n        {/* Emergency Hotlines */}\n        <section aria-label=\"\304\220\306\260\341\273\235ng d\303\242y kh\341\272\251n c\341\272\245p\" className=\"mt-4 space-y-2\">\n          {EMERGENCY_CONTACTS.map((contact) => {\n            const isDialed = dialedPhone === contact.phone;\n            return (\n              <motion.button\n                key={contact.phone}\n                type=\"button\"\n                whileTap={{ scale: 0.98 }}\n                onClick={() => setDialedPhone(contact.phone)}\n                className=\"flex min-h-[58px] w-full items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white px-3.5 py-2.5 text-left shadow-xs transition-colors hover:border-emerald-300\"\n              >\n                <div className=\"min-w-0\">\n                  <p className=\"text-sm font-bold text-slate-900\">{contact.label}</p>\n                  <p className=\"text-xs text-slate-500\">{contact.note}</p>\n                </div>\n                <span className=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-500 px-3 py-1.5 font-mono text-xs font-bold text-white shadow-xs whitespace-nowrap\">\n                  <Phone className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n                  <span>{isDialed ? `\304\220ang g\341\273\215i ${contact.phone}` : contact.phone}</span>\n                </span>\n              </motion.button>\n            );\n          })}\n        </section>\n\n        {/* Night Safety Tips */}\n        <section\n          aria-label=\"Nguy\303\252n t\341\272\257c an to\303\240n ban \304\221\303\252m\"\n          className=\"mt-5 rounded-2xl border border-emerald-200/70 bg-emerald-50/70 p-4\"\n        >\n          <div className=\"flex items-center gap-2 text-emerald-800\">\n            <ShieldAlert className=\"h-4 w-4 shrink-0 text-emerald-600\" aria-hidden=\"true\" />\n            <h2 className=\"text-sm font-bold\">L\306\260u \303\275 khi xe h\341\273\217ng ban \304\221\303\252m</h2>\n          </div>\n          <ul className=\"mt-2.5 space-y-2 text-xs leading-relaxed text-slate-700\">\n            {SAFETY_TIPS.map((tip, index) => (\n              <li key={tip} className=\"flex items-start gap-2\">\n                <span className=\"font-mono text-[11px] font-bold text-emerald-600\">\n                  0{index + 1}.\n                </span>\n                <span>{tip}</span>\n              </li>\n            ))}\n          </ul>\n        </section>\n\n        {/* Nearby 24/7 Safe Stations */}\n        <section aria-label=\"Danh s\303\241ch Tr\341\272\241m An To\303\240n 24/7\" className=\"mt-5\">\n          <h2 className=\"text-sm font-bold text-slate-900\">\n            Tr\341\272\241m An To\303\240n quanh v\341\273\213 tr\303\255 hi\341\273\207n t\341\272\241i\n          </h2>\n          <div className=\"mt-2.5 space-y-2\">\n            {stations.map((station) => (\n              <motion.button\n                key={station.id}\n                type=\"button\"\n                whileTap={{ scale: 0.98 }}\n                onClick={() => onRouteToStation(station.id)}\n                className=\"flex min-h-[58px] w-full items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white px-3.5 py-2.5 text-left shadow-xs transition-colors hover:border-emerald-300\"\n              >\n                <div className=\"min-w-0 flex-1\">\n                  <p className=\"truncate text-sm font-bold text-slate-900\">\n                    {station.name}\n                  </p>\n                  <p className=\"mt-0.5 flex items-center gap-1 truncate text-xs text-slate-500\">\n                    <MapPin className=\"h-3 w-3 shrink-0 text-emerald-500\" aria-hidden=\"true\" />\n                    <span className=\"truncate\">{station.address}</span>\n                  </p>\n                </div>\n                <span className=\"shrink-0 font-mono text-xs font-semibold tabular-nums text-emerald-600\">\n                  {formatWalkingDistance(\n                    station.walkingDistanceMeters,\n                    station.walkingMinutes,\n                  )}\n                </span>\n              </motion.button>\n            ))}\n          </div>\n        </section>\n      </motion.div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/tabs/SafetyTab.tsx"
        }
        overwrite: true
      }
    }
