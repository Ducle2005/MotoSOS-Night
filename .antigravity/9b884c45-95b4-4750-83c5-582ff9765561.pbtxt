    end_line: 237
    content: "import { useEffect, useState } from \'react\';\nimport { MOCK_MECHANIC, QUICK_CHAT_SUGGESTIONS, VOUCHER_OPTIONS } from \'../../data/mockRescueData\';\nimport type { RouteSummaryInfo } from \'../../hooks/useActivePlaceInspect\';\nimport type { ChatMessage, GasStation, GeoCoord, GeoJsonLineString, InspectedPlace, IssueType, MapLayerFilter, OrderPricing, PickupMode, RepairShop, RescueStep, SafeStation, TrackingStatus, UserLocation, VoucherId } from \'../../types/rescue\';\nimport { BottomSheetShell } from \'../BottomSheetShell\';\nimport { RescueMap } from \'../RescueMap\';\nimport { TopOverlayBar } from \'../TopOverlayBar\';\nimport { FloatingPlaceCard } from \'../map/FloatingPlaceCard\';\nimport { MapFilterChips } from \'../map/MapFilterChips\';\nimport { MechanicChatDrawer } from \'../steps/MechanicChatDrawer\';\nimport { VoucherDrawerModal } from \'../steps/VoucherDrawerModal\';\nimport { MapBottomSheetContent } from \'./MapBottomSheetContent\';\n\ninterface MapTabViewProps {\n  userLocation: UserLocation;\n  stations: SafeStation[];\n  openRepairShops: RepairShop[];\n  gasStations: GasStation[];\n  mapFilter: MapLayerFilter;\n  selectedStationId: string | null;\n  inspectedPlace: InspectedPlace | null;\n  inspectRoute: GeoJsonLineString | null;\n  inspectRouteSummary: RouteSummaryInfo | null;\n  isLoadingInspectRoute: boolean;\n  selectedGasStationId: string | null;\n  gasRoute: GeoJsonLineString | null;\n  isLoadingGasStations: boolean;\n  isLoadingGasRoute: boolean;\n  pickupMode: PickupMode;\n  pickupCoord: GeoCoord;\n  pickupTitle: string;\n  pickupAddress: string;\n  walkingRoute: GeoJsonLineString | null;\n  routeSummary: { distanceMeters: number; durationMinutes: number } | null;\n  isLoadingRoute: boolean;\n  isSubmitting: boolean;\n  step: RescueStep;\n  trackingStatus: TrackingStatus;\n  selectedIssue: IssueType | null;\n  customNote: string;\n  issueSummary: string;\n  pricing: OrderPricing;\n  selectedVoucherId: VoucherId | null;\n  mechanicRoute: GeoJsonLineString | null;\n  routeStartTimeMs: number | null;\n  initialEtaMinutes: number;\n  liveEtaMinutes: number;\n  chatMessages: ChatMessage[];\n  isMechanicTyping: boolean;\n  recenterSignal: number;\n  enteredFromQuickStations: boolean;\n  onSelectStation: (id: string) => void;\n  onInspectPlace: (place: InspectedPlace) => void;\n  onClearInspection: () => void;\n  onChangeMapFilter: (filter: MapLayerFilter) => void;\n  onSelectGasStation: (stationId: string | null) => void;\n  onDrawGasRoute: (station: GasStation) => void;\n  onPickGasStationForRescue: (station: GasStation) => void;\n  onPickSafeStationForRescue: (station: SafeStation) => void;\n  onSelectVoucher: (id: VoucherId | null) => void;\n  onEtaMinuteChange: (etaMinutes: number) => void;\n  onMechanicArrived: () => void;\n  onSendChatMessage: (text: string) => void;\n  onBackToHome: () => void;\n  onDemoAdvance: () => void;\n  onRecenter: () => void;\n  onStartOrder: () => void;\n  onOpenSafeStations: () => void;\n  onSelectIssue: (issue: IssueType) => void;\n  onChangeNote: (note: string) => void;\n  onChangeMode: (mode: PickupMode) => void;\n  onSetStep: (step: RescueStep) => void;\n  onConfirmRescue: () => void;\n  onCancelOrder: () => void;\n  onCompleteOrder: () => void;\n  pinPicker: {\n    isActive: boolean; isDragging: boolean; coord: GeoCoord;\n    address: string; isResolving: boolean; onMoveStart: () => void;\n    onMoveEnd: (coord: GeoCoord) => void; onConfirm: () => void; onCancel: () => void;\n  };\n}\n\nexport function MapTabView(props: MapTabViewProps) {\n  const [isVoucherDrawerOpen, setIsVoucherDrawerOpen] = useState(false);\n  const [isChatDrawerOpen, setIsChatDrawerOpen] = useState(false);\n  const { step, trackingStatus } = props;\n\n  useEffect(() => {\n    if (step !== \'pickup\') setIsVoucherDrawerOpen(false);\n    if (step !== \'tracking\' || (trackingStatus !== \'accepted\' && trackingStatus !== \'arrived\')) {\n      setIsChatDrawerOpen(false);\n    }\n  }, [step, trackingStatus]);\n\n  const floatingCard =\n    props.inspectedPlace && step !== \'tracking\' && !props.pinPicker.isActive ? (\n      <FloatingPlaceCard\n        place={props.inspectedPlace}\n        routeSummary={props.inspectRouteSummary}\n        isLoadingRoute={props.isLoadingInspectRoute}\n        onRoutePlace={props.onInspectPlace}\n        onPickSafeStation={props.onPickSafeStationForRescue}\n        onPickGasStation={props.onPickGasStationForRescue}\n        onClose={props.onClearInspection}\n      />\n    ) : null;\n\n  return (\n    <div className=\"relative flex min-h-0 flex-1 flex-col\">\n      <RescueMap\n        userLocation={props.userLocation}\n        stations={props.stations}\n        openRepairShops={props.openRepairShops}\n        gasStations={props.gasStations}\n        selectedStationId={props.selectedStationId}\n        inspectedPlace={props.inspectedPlace}\n        inspectRoute={props.inspectRoute}\n        mapFilter={props.mapFilter}\n        pickupMode={props.pickupMode}\n        pickupCoord={props.pickupCoord}\n        walkingRoute={props.walkingRoute}\n        gasRoute={props.gasRoute}\n        mechanicRoute={props.mechanicRoute}\n        routeStartTimeMs={props.routeStartTimeMs}\n        initialEtaMinutes={props.initialEtaMinutes}\n        step={step}\n        trackingStatus={trackingStatus}\n        mechanic={MOCK_MECHANIC}\n        recenterSignal={props.recenterSignal}\n        isPinPickerMode={props.pinPicker.isActive}\n        isPinDragging={props.pinPicker.isDragging}\n        onSelectStation={(id) => {\n          props.onSelectStation(id);\n          if (step === \'pickup\') props.onChangeMode(\'safe_station\');\n        }}\n        onInspectPlace={props.onInspectPlace}\n        onSelectGasStation={props.onSelectGasStation}\n        onPinMoveStart={props.pinPicker.onMoveStart}\n        onPinMoveEnd={props.pinPicker.onMoveEnd}\n        onEtaMinuteChange={props.onEtaMinuteChange}\n        onMechanicArrived={props.onMechanicArrived}\n      />\n\n      <TopOverlayBar\n        step={step}\n        trackingStatus={trackingStatus}\n        onBackToHome={props.onBackToHome}\n        onDemoAdvance={props.onDemoAdvance}\n      />\n\n      {!props.pinPicker.isActive && (\n        <MapFilterChips\n          activeFilter={props.mapFilter}\n          openShopCount={props.openRepairShops.length}\n          gasStationCount={props.gasStations.length}\n          stationCount={props.stations.length}\n          onSelectFilter={props.onChangeMapFilter}\n        />\n      )}\n\n      <BottomSheetShell\n        step={step}\n        floatingTopSlot={floatingCard}\n        isGasListOpen={\n          step === \'idle\' &&\n          props.mapFilter === \'gas_stations\' &&\n          !props.pinPicker.isActive\n        }\n        onRecenter={props.onRecenter}\n      >\n        <MapBottomSheetContent\n          step={step}\n          trackingStatus={trackingStatus}\n          mapFilter={props.mapFilter}\n          userLocation={props.userLocation}\n          stations={props.stations}\n          openRepairShops={props.openRepairShops}\n          selectedStationId={props.selectedStationId}\n          inspectedPlace={props.inspectedPlace}\n          pickupMode={props.pickupMode}\n          pickupTitle={props.pickupTitle}\n          pickupAddress={props.pickupAddress}\n          routeSummary={props.routeSummary}\n          isLoadingRoute={props.isLoadingRoute || props.isLoadingInspectRoute}\n          isSubmitting={props.isSubmitting}\n          selectedIssue={props.selectedIssue}\n          customNote={props.customNote}\n          issueSummary={props.issueSummary}\n          pricing={props.pricing}\n          liveEtaMinutes={props.liveEtaMinutes}\n          enteredFromQuickStations={props.enteredFromQuickStations}\n          gasStations={props.gasStations}\n          selectedGasStationId={props.selectedGasStationId}\n          hasGasRoute={props.gasRoute !== null}\n          isLoadingGasStations={props.isLoadingGasStations}\n          isLoadingGasRoute={props.isLoadingGasRoute}\n          onDrawGasRoute={props.onDrawGasRoute}\n          onPickGasStationForRescue={props.onPickGasStationForRescue}\n          onPickSafeStationForRescue={props.onPickSafeStationForRescue}\n          onInspectPlace={props.onInspectPlace}\n          onStartOrder={props.onStartOrder}\n          onOpenSafeStations={props.onOpenSafeStations}\n          onSelectIssue={props.onSelectIssue}\n          onChangeNote={props.onChangeNote}\n          onChangeMode={props.onChangeMode}\n          onOpenVouchers={() => setIsVoucherDrawerOpen(true)}\n          onSetStep={props.onSetStep}\n          onConfirmRescue={props.onConfirmRescue}\n          onOpenChat={() => setIsChatDrawerOpen(true)}\n          onDemoAdvance={props.onDemoAdvance}\n          onCancelOrder={props.onCancelOrder}\n          onCompleteOrder={props.onCompleteOrder}\n          pinPicker={props.pinPicker}\n        />\n      </BottomSheetShell>\n\n      <VoucherDrawerModal\n        isOpen={isVoucherDrawerOpen}\n        vouchers={VOUCHER_OPTIONS}\n        selectedVoucherId={props.selectedVoucherId}\n        pickupMode={props.pickupMode}\n        onApplyVoucher={props.onSelectVoucher}\n        onClose={() => setIsVoucherDrawerOpen(false)}\n      />\n\n      <MechanicChatDrawer\n        isOpen={isChatDrawerOpen}\n        mechanic={MOCK_MECHANIC}\n        messages={props.chatMessages}\n        quickSuggestions={QUICK_CHAT_SUGGESTIONS}\n        isMechanicTyping={props.isMechanicTyping}\n        onSendMessage={props.onSendChatMessage}\n        onClose={() => setIsChatDrawerOpen(false)}\n      />\n    </div>\n  );\n}\n"
    num_lines: 238
    num_bytes: 9358
    line_range_bytes: 9358
  }
}
