      arguments_json: "{\"Description\":\"Add unit test for computeActiveCarouselIndex in rescueLogic.test.ts\", \"Instruction\":\"Import computeActiveCarouselIndex and test edge cases including end-of-scroll snapping\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":14, \"ReplacementContent\":\"  computeActiveCarouselIndex,\\n  computeBoundsBox,\", \"StartLine\":9, \"TargetContent\":\"  computeBoundsBox,\"}, {\"AllowMultiple\":false, \"EndLine\":124, \"ReplacementContent\":\"  assert.equal(\\n    formatCompactStationAddress(\'\304\220\306\260\341\273\235ng Pasteur, District 3, Ho Chi Minh City, Vietnam\'),\\n    \'\304\220. Pasteur, Q.3\',\\n  );\\n});\\n\\ntest(\'computeActiveCarouselIndex resolves snapped card index and end-of-scroll index\', () => {\\n  assert.equal(computeActiveCarouselIndex(0, 600, 4, 274), 0);\\n  assert.equal(computeActiveCarouselIndex(270, 600, 4, 274), 1);\\n  assert.equal(computeActiveCarouselIndex(550, 600, 4, 274), 2);\\n  assert.equal(computeActiveCarouselIndex(598, 600, 4, 274), 3);\\n  assert.equal(computeActiveCarouselIndex(100, 0, 1, 274), 0);\\n});\", \"StartLine\":115, \"TargetContent\":\"  assert.equal(\\n    formatCompactStationAddress(\'\304\220\306\260\341\273\235ng Pasteur, District 3, Ho Chi Minh City, Vietnam\'),\\n    \'\304\220. Pasteur, Q.3\',\\n  );\\n});\"}], \"TargetFile\":\"/src/utils/rescueLogic.test.ts\", \"toolAction\":\"Adding carousel index unit tests\", \"toolSummary\":\"Add carousel index unit tests\"}"
      original_name: "multi_replace_file_content"
    }
